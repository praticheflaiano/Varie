---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "primary" | "secondary" | "ghost" | "whatsapp" | "accent";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  icon?: string;
  iconPosition?: "left" | "right";
  external?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  icon,
  iconPosition = "right",
  external = false,
  disabled = false,
  ariaLabel,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-bold rounded-full transition-all duration-150 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-brand-700 disabled:opacity-50 disabled:cursor-not-allowed text-center sm:whitespace-nowrap no-underline";

const variants: Record<string, string> = {
  primary:
    "bg-[#5B3DF5] text-white hover:text-white shadow-[0_6px_0_#14142B] hover:translate-y-[3px] hover:shadow-[0_3px_0_#14142B]",
  secondary:
    "bg-white text-[#14142B] border-2 border-[#14142B] hover:bg-[#14142B] hover:text-white",
  ghost:
    "bg-transparent text-[#14142B] hover:bg-[#F1EEFF]",
  accent:
    "bg-[#D4FF4F] text-[#14142B] hover:text-[#14142B] shadow-[0_6px_0_#14142B] hover:translate-y-[3px] hover:shadow-[0_3px_0_#14142B]",
  whatsapp:
    "bg-[#25D366] text-[#14142B] hover:text-[#14142B] shadow-[0_6px_0_#14142B] hover:translate-y-[3px] hover:shadow-[0_3px_0_#14142B]",
};

const sizes: Record<string, string> = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};

const cls = [base, variants[variant], sizes[size], className].join(" ");
const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{href ? (
  <a
    href={href}
    class={cls}
    aria-label={ariaLabel}
    aria-disabled={disabled}
    {...externalAttrs}
  >
    {icon && iconPosition === "left" && <Icon name={icon} class="size-5" aria-hidden="true" />}
    <slot />
    {icon && iconPosition === "right" && <Icon name={icon} class="size-5" aria-hidden="true" />}
    {external && (
      <Icon name="heroicons:arrow-top-right-on-square" class="size-4 opacity-70" aria-label="(apre in nuova scheda)" />
    )}
  </a>
) : (
  <button type={type} class={cls} disabled={disabled} aria-label={ariaLabel}>
    {icon && iconPosition === "left" && <Icon name={icon} class="size-5" aria-hidden="true" />}
    <slot />
    {icon && iconPosition === "right" && <Icon name={icon} class="size-5" aria-hidden="true" />}
  </button>
)}
