---
/**
 * Logo Centro Pratiche Flaiano - "Brand Mark"
 * Design system "Adriatic Blue" (handoff Anthropic 2026-04-26).
 * Monogramma "PF" stilizzato in stile lapide romana, integrato in glyph
 * tonale primary. Variante "full" mostra brand-mark completo (glyph + nome
 * + sottotitolo); "mark" solo il glyph.
 */
interface Props {
  variant?: "full" | "mark";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { variant = "full", size = "md", class: className = "" } = Astro.props;

const dims =
  size === "lg"
    ? { glyph: 56, name: "1.5rem", sub: "0.875rem" }
    : size === "sm"
    ? { glyph: 32, name: "1rem", sub: "0.6875rem" }
    : { glyph: 40, name: "1.1875rem", sub: "0.75rem" };
---

{variant === "mark" ? (
  <span
    class:list={["brand-glyph", className]}
    style={`width: ${dims.glyph}px; height: ${dims.glyph}px;`}
    aria-label="Centro Pratiche Flaiano"
  >
    <svg viewBox="0 0 40 40" width="60%" height="60%" fill="currentColor" aria-hidden="true">
      <path d="M8 6 L8 34 L13 34 L13 24 L18 24 Q24 24 24 18 Q24 12 18 12 L13 12 L13 6 z M13 16 L18 16 Q20 16 20 18 Q20 20 18 20 L13 20 z"/>
      <path d="M22 14 L22 34 L27 34 L27 26 L31 26 L31 22 L27 22 L27 18 L33 18 L33 14 z"/>
    </svg>
  </span>
) : (
  <span class:list={["brand-mark", className]}>
    <span class="brand-glyph" style={`width: ${dims.glyph}px; height: ${dims.glyph}px;`}>
      <svg viewBox="0 0 40 40" width="60%" height="60%" fill="currentColor" aria-hidden="true">
        <path d="M8 6 L8 34 L13 34 L13 24 L18 24 Q24 24 24 18 Q24 12 18 12 L13 12 L13 6 z M13 16 L18 16 Q20 16 20 18 Q20 20 18 20 L13 20 z"/>
        <path d="M22 14 L22 34 L27 34 L27 26 L31 26 L31 22 L27 22 L27 18 L33 18 L33 14 z"/>
      </svg>
    </span>
    <span>
      <span class="brand-name" style={`font-size: ${dims.name};`}>Centro Pratiche Flaiano</span>
      <span class="brand-sub block" style={`font-size: ${dims.sub};`}>CAF UNSIC · Patronato ENASC · Roma Nord</span>
    </span>
  </span>
)}
