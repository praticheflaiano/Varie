---
/**
 * Logo Centro Pratiche Flaiano - grafica "giovane" (nov 2026).
 * Quadrato viola con la "F" lime + nome in Bricolage Grotesque.
 * variant "full" = glifo + nome + sottotitolo; "mark" = solo glifo.
 */
interface Props {
  variant?: "full" | "mark";
  size?: "sm" | "md" | "lg";
  dark?: boolean;
  class?: string;
}
const { variant = "full", size = "md", dark = false, class: className = "" } = Astro.props;
const g = size === "lg" ? 52 : size === "sm" ? 32 : 40;
const fs = size === "lg" ? 28 : size === "sm" ? 18 : 22;
---
{variant === "mark" ? (
  <span class:list={["brand-glyph", className]} style={`width:${g}px;height:${g}px;font-size:${fs}px`} aria-label="Centro Pratiche Flaiano">F</span>
) : (
  <span class:list={["brand-mark", className]}>
    <span class="brand-glyph" style={`width:${g}px;height:${g}px;font-size:${fs}px`} aria-hidden="true">F</span>
    <span>
      <span class="brand-name block" style={dark ? "color:#fff" : ""}>Pratiche Flaiano</span>
      <span class="brand-sub block" style={dark ? "color:#A3A3BD" : ""}>CAF UNSIC · Patronato ENASC</span>
    </span>
  </span>
)}
