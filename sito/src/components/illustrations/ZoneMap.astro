---
/**
 * Mappa SVG stilizzata Municipio III di Roma con punti per le zone servite.
 * Asset distintivo del sito Centro Pratiche Flaiano.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const zones = [
  { name: "Vigne Nuove", x: 360, y: 220, primary: true },
  { name: "Tufello", x: 290, y: 240, primary: true },
  { name: "Conca d'Oro", x: 230, y: 280, primary: true },
  { name: "Bufalotta", x: 410, y: 170, primary: true },
  { name: "Porta di Roma", x: 470, y: 130, primary: true },
  { name: "Fidene", x: 520, y: 80, primary: false },
  { name: "Castel Giubileo", x: 410, y: 50, primary: false },
  { name: "Serpentara", x: 340, y: 150, primary: false },
  { name: "Talenti", x: 300, y: 320, primary: false },
  { name: "Nuovo Salario", x: 180, y: 220, primary: false },
];
---

<svg
  class={className}
  viewBox="0 0 600 400"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="zone-map-title zone-map-desc"
>
  <title id="zone-map-title">Zone servite dal Centro Pratiche Flaiano</title>
  <desc id="zone-map-desc">Mappa stilizzata del Municipio III di Roma con le zone servite: Vigne Nuove, Tufello, Conca d'Oro, Bufalotta, Porta di Roma e altre.</desc>
  <defs>
    <linearGradient id="mapBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--color-brand-50)" />
      <stop offset="100%" stop-color="var(--color-brand-100)" />
    </linearGradient>
    <radialGradient id="dotGradient">
      <stop offset="0%" stop-color="var(--color-accent-300)" />
      <stop offset="100%" stop-color="var(--color-accent-500)" />
    </radialGradient>
  </defs>

  <!-- Background area Municipio III -->
  <path
    d="M 80 120 Q 100 50 200 40 Q 320 30 440 30 Q 540 35 560 100 Q 580 180 540 270 Q 480 360 360 365 Q 220 370 140 320 Q 70 250 80 120 Z"
    fill="url(#mapBg)"
    stroke="var(--color-brand-300)"
    stroke-width="2"
    stroke-dasharray="4 6"
  />

  <!-- Grid leggera -->
  <g opacity="0.3">
    <line x1="0" y1="100" x2="600" y2="100" stroke="var(--color-brand-200)" />
    <line x1="0" y1="200" x2="600" y2="200" stroke="var(--color-brand-200)" />
    <line x1="0" y1="300" x2="600" y2="300" stroke="var(--color-brand-200)" />
    <line x1="200" y1="0" x2="200" y2="400" stroke="var(--color-brand-200)" />
    <line x1="400" y1="0" x2="400" y2="400" stroke="var(--color-brand-200)" />
  </g>

  <!-- Etichetta Municipio III -->
  <text x="300" y="60" text-anchor="middle"
    font-family="var(--font-display)" font-size="14" font-weight="700"
    fill="var(--color-brand-800)" opacity="0.7">
    MUNICIPIO III ROMA
  </text>

  <!-- Sede Pratiche Flaiano (Vigne Nuove) - punto principale -->
  <g>
    <circle cx="360" cy="220" r="22" fill="var(--color-accent-400)" opacity="0.25">
      <animate attributeName="r" values="22;30;22" dur="3s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.25;0;0.25" dur="3s" repeatCount="indefinite" />
    </circle>
    <circle cx="360" cy="220" r="14" fill="var(--color-brand-900)" />
    <circle cx="360" cy="220" r="6" fill="var(--color-accent-400)" />
    <text x="360" y="200" text-anchor="middle"
      font-family="var(--font-display)" font-size="13" font-weight="700"
      fill="var(--color-brand-900)">
      Vigne Nuove
    </text>
    <text x="360" y="186" text-anchor="middle"
      font-family="var(--font-sans)" font-size="9" font-weight="600"
      fill="var(--color-accent-700)" letter-spacing="0.06em">
      LA NOSTRA SEDE
    </text>
  </g>

  <!-- Altre zone -->
  {zones.filter(z => z.name !== "Vigne Nuove").map((z) => (
    <g>
      <circle cx={z.x} cy={z.y} r={z.primary ? 8 : 5}
        fill={z.primary ? "var(--color-brand-700)" : "var(--color-brand-400)"}
        opacity="0.9" />
      <circle cx={z.x} cy={z.y} r={z.primary ? 8 : 5}
        fill="none"
        stroke="white" stroke-width="2" />
      <text x={z.x} y={z.y - (z.primary ? 14 : 12)} text-anchor="middle"
        font-family="var(--font-sans)" font-size={z.primary ? "11" : "10"} font-weight="600"
        fill="var(--color-brand-800)">
        {z.name}
      </text>
    </g>
  ))}

  <!-- Linee tratteggiate dalla sede alle zone primarie (escluse) -->
</svg>
