---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 240 240"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  aria-hidden="true"
  role="presentation"
>
  <defs>
    <linearGradient id="shieldGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="var(--color-brand-500)" />
      <stop offset="100%" stop-color="var(--color-brand-900)" />
    </linearGradient>
  </defs>
  <!-- Scudo -->
  <path
    d="M120 30 L60 56 V128 C60 168 92 200 120 212 C148 200 180 168 180 128 V56 Z"
    fill="url(#shieldGradient)"
  />
  <path
    d="M120 30 L60 56 V128 C60 168 92 200 120 212 C148 200 180 168 180 128 V56 Z"
    fill="white"
    fill-opacity="0.05"
  />
  <!-- Famiglia stilizzata -->
  <g transform="translate(75 80)">
    <!-- Adulto 1 -->
    <circle cx="20" cy="20" r="11" fill="white" />
    <path d="M5 60 C5 45 13 38 20 38 C27 38 35 45 35 60 Z" fill="white" />
    <!-- Adulto 2 -->
    <circle cx="70" cy="20" r="11" fill="white" />
    <path d="M55 60 C55 45 63 38 70 38 C77 38 85 45 85 60 Z" fill="white" />
    <!-- Bambino -->
    <circle cx="45" cy="42" r="7" fill="var(--color-accent-300)" />
    <path d="M36 70 C36 60 40 55 45 55 C50 55 54 60 54 70 Z" fill="var(--color-accent-300)" />
  </g>
  <!-- Check accent -->
  <g transform="translate(155 160)">
    <circle r="20" fill="var(--color-accent-400)" />
    <path d="M-8 0 l5 5 l11 -11" stroke="var(--color-brand-950)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </g>
</svg>
