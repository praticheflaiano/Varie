---
import { SITE } from "~/consts";

interface Props {
  headline: string;
  description: string;
  datePublished: string;
  dateModified?: string;
  authorName: string;
  url: string;
  image?: string;
  isNews?: boolean;
  category?: string;
  keywords?: string[];
}

const {
  headline,
  description,
  datePublished,
  dateModified,
  authorName,
  url,
  image,
  isNews = false,
  category,
  keywords,
} = Astro.props;

const data = {
  "@context": "https://schema.org",
  "@type": isNews ? "NewsArticle" : "BlogPosting",
  headline,
  description,
  datePublished,
  dateModified: dateModified ?? datePublished,
  author: {
    "@type": "Organization",
    name: authorName,
    url: `${SITE.url}/chi-siamo`,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: { "@type": "ImageObject", url: `${SITE.url}/apple-touch-icon.png` },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": url,
  },
  image: [new URL(image ?? SITE.ogImage, SITE.url).toString()],
  ...(category && { articleSection: category }),
  ...(keywords && { keywords: keywords.join(", ") }),
  inLanguage: "it-IT",
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
