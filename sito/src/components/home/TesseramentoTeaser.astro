---
import { TESSERAMENTO } from "~/consts";
import Button from "~/components/ui/Button.astro";
import { Icon } from "astro-icon/components";

const benefits = [
  "Tariffe agevolate su tutte le pratiche",
  "Aggiornamenti normativi via WhatsApp",
  "Priorita sugli appuntamenti",
  "Conservazione documenti inclusa",
  "Consulenza fiscale e previdenziale illimitata",
  "Valido per tutto il nucleo familiare",
];
---

<section class="section">
  <div class="container-wide">
    <div class="grid gap-10 rounded-[var(--radius-2xl)] border border-[var(--color-brand-100)] bg-gradient-to-br from-[var(--color-brand-50)] via-white to-[var(--color-accent-50)] p-8 md:p-12 lg:grid-cols-12 lg:p-16">
      <div class="lg:col-span-7">
        <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent-100)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-accent-800)]">
          <Icon name="heroicons:sparkles" class="size-4" />
          Diventa Socio
        </p>
        <h2 class="font-display text-[var(--color-brand-950)]">
          Tessera Centro Pratiche Flaiano
        </h2>
        <p class="mt-4 max-w-xl text-lg text-[var(--color-ink-soft)] leading-relaxed">
          Una piccola quota annuale che ti da accesso a tariffe ridotte, priorita e a un canale diretto con noi. <strong>Vale per tutto il nucleo familiare</strong>.
        </p>

        <div class="mt-8 flex flex-wrap items-end gap-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent-700)]">Annuale</span>
            <p class="mt-1 font-display text-5xl font-extrabold text-[var(--color-brand-950)]">
              {TESSERAMENTO.annual.price}<span class="text-2xl font-bold text-[var(--color-ink-muted)]">€</span>
            </p>
            <p class="text-xs text-[var(--color-ink-muted)]">/ nucleo / 12 mesi</p>
          </div>
          <div class="text-[var(--color-ink-muted)] mb-2">oppure</div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-ink-muted)]">Semestrale</span>
            <p class="mt-1 font-display text-3xl font-bold text-[var(--color-ink-soft)]">
              {TESSERAMENTO.semester.price}<span class="text-lg font-bold text-[var(--color-ink-muted)]">€</span>
            </p>
            <p class="text-xs text-[var(--color-ink-muted)]">/ nucleo / 6 mesi</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button variant="primary" size="lg" href="/tesseramento" icon="heroicons:arrow-right">
            Scopri tutti i vantaggi
          </Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <ul class="grid gap-3">
          {benefits.map((b) => (
            <li class="flex items-start gap-3 rounded-lg bg-white/70 p-3 backdrop-blur">
              <Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 mt-0.5 text-[var(--color-success-600)]" aria-hidden="true" />
              <span class="text-sm text-[var(--color-ink)]">{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
