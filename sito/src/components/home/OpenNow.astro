---
/** Pill "aperti ora / chiusi" calcolata nel browser sull'ora di Roma (orari da consts). */
import { HOURS, CLOSURES } from "~/consts";
const data = JSON.stringify(HOURS);
const closures = JSON.stringify(CLOSURES.map((c) => [c.from, c.to]));
---
<a href="/contatti" class="pill pill-live" data-open-now={data} data-closures={closures} style="align-self:flex-start;font-weight:700;text-decoration:none" aria-label="Orari e contatti">Roma · Vigne Nuove</a>
<script>
  const el = document.querySelector<HTMLElement>("[data-open-now]");
  if (el) {
    try {
      const hours = JSON.parse(el.dataset.openNow || "[]");
      const parts = new Intl.DateTimeFormat("it-IT", { timeZone: "Europe/Rome", weekday: "short", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
      const wd = parts.find((p) => p.type === "weekday")?.value || "";
      const hh = parts.find((p) => p.type === "hour")?.value || "00";
      const mm = parts.find((p) => p.type === "minute")?.value || "00";
      const idx = ["lun", "mar", "mer", "gio", "ven", "sab", "dom"].findIndex((d) => wd.toLowerCase().startsWith(d));
      const now = `${hh}:${mm}`;
      const h = hours[idx];
      const slots = h && h.open ? [[h.open, h.close], ...(h.afternoon ? [[h.afternoon.open, h.afternoon.close]] : [])] : [];
      const oggi = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Rome" }).format(new Date());
      const chiusure = JSON.parse(el.dataset.closures || "[]") as [string, string][];
      const inFesta = (d: string) => chiusure.some(([a, b]) => d >= a && d <= b);
      const slotsOf = (i: number) => {
        const x = hours[i];
        return x && x.open ? [[x.open, x.close], ...(x.afternoon ? [[x.afternoon.open, x.afternoon.close]] : [])] : [];
      };
      const ora = (t: string) => t.replace(/^0/, "");
      // Prossima apertura dopo l'orario "da": più tardi oggi, oppure il primo giorno utile (saltando le feste).
      const prossima = (da: string) => {
        const base = new Date(oggi + "T12:00:00Z");
        for (let k = 0; k <= 40; k++) {
          const d = new Date(base.getTime() + k * 86400000);
          if (inFesta(d.toISOString().slice(0, 10))) continue;
          const s = slotsOf((idx + k) % 7).find(([a]) => k > 0 || a > da);
          if (!s) continue;
          const nome = new Intl.DateTimeFormat("it-IT", { timeZone: "UTC", weekday: "long" }).format(d);
          const giorno = k === 0 ? "oggi" : k === 1 ? "domani" : k < 7 ? nome : `${nome} ${new Intl.DateTimeFormat("it-IT", { timeZone: "UTC", day: "numeric", month: "long" }).format(d)}`;
          return { k, giorno, alle: ora(s[0]) };
        }
        return null;
      };
      const cur = inFesta(oggi) ? undefined : slots.find(([a, b]) => now >= a && now < b);
      if (cur) {
        const n = prossima(cur[1]);
        const poi = !n ? "" : n.k === 0 ? `, poi dalle ${n.alle}` : `, poi ${n.giorno} dalle ${n.alle}`;
        el.textContent = `Aperti ora · fino alle ${ora(cur[1])}${poi}`;
      } else {
        el.classList.remove("pill-live");
        const n = prossima(now);
        el.textContent = n ? `Ora chiusi · riapriamo ${n.giorno} alle ${n.alle}` : "Ora chiusi · prenota online quando vuoi";
      }
    } catch { /* lascia il testo di default */ }
  }
</script>
