---
import { SITE, CONTACT, BOOKING } from "~/consts";
import Button from "~/components/ui/Button.astro";
import HeroBlob from "~/components/illustrations/HeroBlob.astro";
import DocumentStack from "~/components/illustrations/DocumentStack.astro";
import { Icon } from "astro-icon/components";
---

<section class="relative overflow-hidden bg-mesh-brand">
  <div class="absolute inset-0 bg-grid-pattern opacity-30 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_70%)]" aria-hidden="true"></div>

  <div class="container-wide relative grid gap-12 py-16 md:py-24 lg:grid-cols-12 lg:py-32">
    <div class="lg:col-span-7 flex flex-col justify-center">
      <p class="mb-5 inline-flex items-center gap-2 self-start rounded-full border border-[var(--color-brand-200)] bg-white/80 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-brand-800)] backdrop-blur">
        <span class="size-2 rounded-full bg-[var(--color-success-500)]"></span>
        CAF UNSIC + Patronato ENASC - Roma Vigne Nuove
      </p>

      <h1 class="font-display text-[var(--color-brand-950)]">
        {SITE.claim}
      </h1>

      <p class="mt-6 max-w-xl text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Il <strong>Centro Pratiche Flaiano</strong> ti accompagna in ogni adempimento fiscale, previdenziale e amministrativo. <strong>730, ISEE, IMU, successioni, pensioni, NASpI, invalidita civile, assegno unico</strong>: ti guidiamo passo passo, in sede a Vigne Nuove o da remoto.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button variant="primary" size="lg" href={BOOKING.arcanisGroup} external icon="heroicons:calendar-days" iconPosition="left">
          Prenota appuntamento
        </Button>
        <Button variant="secondary" size="lg" href={`tel:${CONTACT.phone.landlineRaw}`} icon="heroicons:phone" iconPosition="left">
          {CONTACT.phone.landline}
        </Button>
      </div>

      <ul class="mt-10 grid gap-3 sm:grid-cols-3 text-sm">
        <li class="flex items-start gap-2">
          <Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[var(--color-success-600)]" aria-hidden="true" />
          <span class="text-[var(--color-ink-soft)]"><strong class="text-[var(--color-ink)]">In sede o da remoto</strong></span>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[var(--color-success-600)]" aria-hidden="true" />
          <span class="text-[var(--color-ink-soft)]"><strong class="text-[var(--color-ink)]">Tessera 30 €/anno</strong> per nucleo</span>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[var(--color-success-600)]" aria-hidden="true" />
          <span class="text-[var(--color-ink-soft)]"><strong class="text-[var(--color-ink)]">WhatsApp diretto</strong> con noi</span>
        </li>
      </ul>
    </div>

    <div class="relative hidden lg:col-span-5 lg:block">
      <HeroBlob class="absolute inset-0 size-full opacity-95" />
      <div class="relative flex h-full items-center justify-center p-6">
        <DocumentStack class="w-full max-w-[360px] drop-shadow-2xl" />
      </div>
    </div>
  </div>
</section>
