---
/**
 * Riquadro "Altri calcolatori gratuiti" (27/11/2026) da mettere in fondo alle pagine, dopo il testo.
 * Mostra 3-4 calcolatori dello stesso tema della pagina (escluso quello della pagina);
 * se il tema ne ha pochi completa con quelli della home e poi con gli altri. Dati in ~/data/calcolatori.ts.
 * Il titolo è un h2: usarlo solo dove il riquadro segue un h1 (o altri h2).
 *
 * Uso: <AltriCalcolatori current="/calcolo-naspi" />  (oppure current={Astro.url.pathname})
 * Facoltativi: tema (se la pagina non è un calcolatore, es. una guida NASpI: tema="lavoro"), max (predefinito 4).
 */
import { altriCalcolatori, type TemaCalcolatore } from "~/data/calcolatori";

interface Props {
  current: string;
  tema?: TemaCalcolatore;
  max?: number;
  class?: string;
}

const { current, tema, max = 4, class: className } = Astro.props;
const lista = altriCalcolatori(current, max, tema);
const id = "altri-calcolatori-titolo";
---
{lista.length > 0 && (
  <aside class:list={["altri-calc", className]} aria-labelledby={id} data-pagefind-ignore>
    <h2 id={id} class="altri-calc-title">Altri calcolatori gratuiti</h2>
    <ul class="altri-calc-list">
      {lista.map((c) => (
        <li class="altri-calc-item">
          <a href={c.url} class="altri-calc-btn">
            <span class="altri-calc-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 7h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 18h8" /></svg>
            </span>
            <span class="altri-calc-txt">
              <span class="altri-calc-t">{c.nome}</span>
              <span class="altri-calc-s">{c.breve}</span>
            </span>
            <svg class="altri-calc-go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="altri-calc-all"><a href="/calcolatori" class="altri-calc-link">Tutti i calcolatori gratuiti →</a></p>
  </aside>
)}

<style>
  .altri-calc {
    margin-block: 2.5rem;
    padding: 24px;
    border-radius: 28px;
    background: #f1eeff;
    color: #14142b;
  }
  .altri-calc-title {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    line-height: 1.15;
    color: #14142b;
  }
  .altri-calc-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .altri-calc-item {
    display: flex;
    margin: 0;
  }
  .altri-calc-item::marker {
    content: none;
  }
  .altri-calc-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 14px 16px;
    border-radius: 20px;
    background: #5b3df5;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 0 #14142b;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .altri-calc-btn:hover,
  .altri-calc-btn:focus-visible {
    color: #fff;
    transform: translateY(2px);
    box-shadow: 0 2px 0 #14142b;
  }
  .altri-calc-ico {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #d4ff4f;
    display: grid;
    place-items: center;
  }
  .altri-calc-txt {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.25;
  }
  .altri-calc-t {
    font-weight: 800;
    font-size: 17px;
    color: #fff;
  }
  .altri-calc-s {
    font-size: 15px;
    color: #f1eeff;
  }
  .altri-calc-go {
    flex: none;
    color: #d4ff4f;
  }
  .altri-calc-all {
    margin: 16px 0 0;
  }
  .altri-calc-link {
    display: inline-block;
    padding: 4px 0;
    font-weight: 800;
    color: #4b2fe0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .altri-calc-btn,
    .altri-calc-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>
