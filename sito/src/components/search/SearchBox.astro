---
/** Casella di ricerca: manda a /cerca?q=... (la ricerca vera gira lì, con l'indice Pagefind creato in build). */
interface Props { placeholder?: string; label?: string; id?: string; value?: string; autofocus?: boolean }
const { placeholder = "Cerca: ISEE, 730, NASpI, successione…", label = "Cerca nel sito", id = "q", autofocus = false } = Astro.props;
---
<form class="sbox" action="/cerca" method="get" role="search">
  <label class="sbox-label" for={id}>{label}</label>
  <div class="sbox-row">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input type="search" name="q" id={id} placeholder={placeholder} autocomplete="off" enterkeyhint="search" autofocus={autofocus} />
    <button type="submit">Cerca</button>
  </div>
</form>

<style is:global>
  .sbox { display: flex; flex-direction: column; gap: 6px; width: 100%; max-width: 620px; min-width: 0; }
  .sbox-label { font-weight: 800; font-size: 14px; color: #14142B; }
  .sbox-row { display: flex; align-items: center; gap: 8px; background: #fff; border: 2px solid #14142B; border-radius: 999px; padding: 6px 6px 6px 16px; min-width: 0; color: #14142B; }
  .sbox-row:focus-within { outline: 3px solid #5B3DF5; outline-offset: 2px; }
  .sbox-row svg { flex: none; }
  .sbox-row input { flex: 1 1 auto; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 16px; color: #14142B; padding: 8px 0; }
  .sbox-row input::placeholder { color: #6B6B85; }
  .sbox-row button { flex: none; border: 0; border-radius: 999px; background: #14142B; color: #fff; font: inherit; font-weight: 800; font-size: 15px; padding: 10px 18px; cursor: pointer; }
  .sbox-row button:hover { background: #5B3DF5; }
</style>
