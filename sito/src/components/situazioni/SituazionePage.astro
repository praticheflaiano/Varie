---
/**
 * Pagina "per situazione di vita" (27/11/2026). Dati in src/data/situazioni.ts.
 * Struttura: briciole, h1 e introduzione, passi (con la pagina da cui viene ogni dato), pratiche con Prenota,
 * calcolatori come pulsanti cta-tool, guide del blog, domande frequenti (FaqList + FAQPage), altre situazioni.
 * Le guide vengono lette dagli articoli pubblicati: se uno slug non esiste la build si ferma.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import FaqList from "~/components/ui/FaqList.astro";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { CONTACT } from "~/consts";
import { getVisibleArticles } from "~/utils/articles";
import { SITUAZIONI, type Situazione } from "~/data/situazioni";

interface Props {
  s: Situazione;
}
const { s } = Astro.props;

const articoli = await getVisibleArticles();
const guide = s.guide.map((slug) => {
  const a = articoli.find((x) => x.data.slug === slug);
  if (!a) throw new Error(`Situazione "${s.slug}": l'articolo "${slug}" non esiste o non è pubblicato.`);
  return { href: `/blog/${slug}`, title: a.data.title, desc: a.data.meta_description ?? "" };
});
const altre = SITUAZIONI.filter((x) => x.slug !== s.slug);
---

<BaseLayout title={s.title} description={s.description}>
  <JsonLdFaq slot="head" items={s.faq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-12">
      <Breadcrumb items={[{ name: "Cosa ti è successo?", href: "/situazioni" }, { name: s.nome, href: `/situazioni/${s.slug}` }]} class="mb-6" />
      <div class="flex flex-col gap-5" style="max-width:860px">
        <span class="eyebrow">Cosa ti è successo?</span>
        <h1 class="sit-h1">{s.h1}</h1>
        <p class="sit-intro">{s.intro}</p>
        <p class="sit-dove">Ti aiutiamo nel nostro ufficio a <strong>Roma Vigne Nuove</strong> ({CONTACT.address.street}) oppure in <strong>videochiamata</strong>, da casa tua.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/prenota">Prenota un appuntamento</a>
          <a class="btn btn-wa" href={CONTACT.whatsapp.link} target="_blank" rel="noopener">WhatsApp {CONTACT.phone.mobile}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide section-tight" aria-labelledby="passi">
    <h2 id="passi" class="sit-h2">{s.passiTitolo}</h2>
    <ol class="sit-passi">
      {s.passi.map((p, i) => (
        <li class="sit-passo">
          <span class="sit-num" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="sit-passo-t">{p.t}</p>
            <p class="sit-passo-d">{p.d}</p>
            {p.fonte && <p class="sit-fonte">Dove lo diciamo: <a href={p.fonte.href}>{p.fonte.label}</a></p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-wide pb-12" aria-labelledby="pratiche">
    <h2 id="pratiche" class="sit-h2">Le pratiche da fare</h2>
    <p class="sit-lead">Tocca il nome della pratica per leggere tutto, oppure prenota: in ufficio o in videochiamata.</p>
    <ul class="sit-grid">
      {s.pratiche.map((p) => (
        <li class="sit-card">
          <h3 class="sit-card-t"><a href={p.href}>{p.t}</a></h3>
          <p class="sit-card-d">{p.d}</p>
          <a class="btn btn-dark btn-sm sit-card-btn" href="/prenota">Prenota</a>
        </li>
      ))}
    </ul>
  </section>

  {s.strumenti.length > 0 && (
    <section class="container-wide pb-12" aria-labelledby="calcola">
      <h2 id="calcola" class="sit-h2">Calcola</h2>
      <div class="sit-tools">
        {s.strumenti.map((t) => (
          <a href={t.href} class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h2M14 10h2M8 14h2M14 14h2M8 18h8"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">{t.t}</span><span class="cta-tool-s">{t.s}</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        ))}
      </div>
    </section>
  )}

  <section class="container-wide pb-12" aria-labelledby="guide">
    <h2 id="guide" class="sit-h2">Leggi le guide</h2>
    <ul class="sit-guide">
      {guide.map((g) => (
        <li class="sit-guida">
          <h3 class="sit-guida-t"><a href={g.href}>{g.title}</a></h3>
          {g.desc && <p class="sit-guida-d">{g.desc}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="container-narrow pb-12" aria-labelledby="faq">
    <h2 id="faq" class="sit-h2">Domande frequenti</h2>
    <div class="mt-5"><FaqList items={s.faq} /></div>
  </section>

  <section class="container-wide pb-16" aria-labelledby="aiuto">
    <div class="sit-aiuto">
      <h2 id="aiuto" class="sit-aiuto-t">Non sai da dove cominciare? Ci pensiamo noi.</h2>
      <p class="sit-aiuto-d">Siamo CAF UNSIC e Patronato ENASC in {CONTACT.address.street}, a Roma Vigne Nuove (Municipio III). Lavoriamo anche in videochiamata: i documenti ce li mandi su WhatsApp o per email. Dal lunedì al giovedì 9:30-13:00 e 15:30-18:00, il venerdì 9:30-14:00.</p>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-lime" href="/prenota">Prenota un appuntamento</a>
        <a class="btn sit-tel" href={`tel:${CONTACT.phone.landlineRaw}`}>Chiama lo {CONTACT.phone.landline}</a>
      </div>
    </div>

    <h2 class="sit-h2 mt-12" id="altre">Altre situazioni</h2>
    <ul class="mt-4 flex flex-wrap gap-2" aria-labelledby="altre">
      {altre.map((a) => <li><a class="chip" href={`/situazioni/${a.slug}`}>{a.nome}</a></li>)}
      <li><a class="chip" href="/situazioni">Tutte le situazioni</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .sit-h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.04; }
  .sit-intro { font-size: 20px; line-height: 1.5; color: var(--color-ink); }
  .sit-dove { font-size: 17px; line-height: 1.5; color: var(--color-ink-soft); }
  .sit-h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1.1; }
  .sit-lead { margin-top: 8px; color: var(--color-ink-soft); }
  .sit-passi { margin-top: 24px; display: grid; gap: 14px; list-style: none; padding: 0; }
  .sit-passo { display: flex; gap: 16px; align-items: flex-start; background: #F7F7FB; border-radius: 24px; padding: 20px; }
  .sit-num { flex: none; width: 44px; height: 44px; border-radius: 14px; background: #D4FF4F; color: #14142B; display: grid; place-items: center; font-weight: 800; font-size: 20px; }
  .sit-passo-t { font-weight: 800; font-size: 19px; line-height: 1.3; color: var(--color-ink); }
  .sit-passo-d { margin-top: 6px; line-height: 1.5; color: var(--color-ink-soft); }
  .sit-fonte { margin-top: 8px; font-size: 14px; color: var(--color-ink-soft); }
  .sit-grid { margin-top: 20px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); list-style: none; padding: 0; }
  .sit-card { display: flex; flex-direction: column; gap: 8px; border: 2px solid #14142B; border-radius: 24px; padding: 20px; background: #fff; }
  .sit-card-t { font-size: 20px; line-height: 1.25; }
  .sit-card-t a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .sit-card-d { color: var(--color-ink-soft); line-height: 1.45; }
  .sit-card-btn { margin-top: auto; align-self: flex-start; }
  .sit-tools { margin-top: 20px; display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr)); }
  .sit-guide { margin-top: 20px; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr)); list-style: none; padding: 0; }
  .sit-guida { background: #F7F7FB; border-radius: 20px; padding: 18px 20px; }
  .sit-guida-t { font-size: 17px; line-height: 1.35; font-weight: 700; font-family: var(--font-sans); }
  .sit-guida-t a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .sit-guida-d { margin-top: 6px; font-size: 15px; line-height: 1.45; color: var(--color-ink-soft); }
  .sit-aiuto { background: #14142B; color: #fff; border-radius: 32px; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 14px; }
  .sit-aiuto-t { color: #fff; font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.1; }
  .sit-aiuto-d { color: #D7D7E6; line-height: 1.5; max-width: 760px; }
  .sit-tel { background: #fff; color: #14142B; }
  .sit-tel:hover { background: #F1EEFF; color: #14142B; }
</style>
