---
import { DISCLAIMER, BOOKING } from "~/consts";
import { Icon } from "astro-icon/components";

interface Props {
  lastUpdated?: string;
}

const { lastUpdated } = Astro.props;
---

<aside class="my-10 rounded-[var(--radius-lg)] border border-[var(--color-accent-200)] bg-[var(--color-accent-50)] p-6">
  <div class="flex items-start gap-3">
    <Icon name="heroicons:information-circle" class="size-6 shrink-0 text-[var(--color-accent-700)]" aria-hidden="true" />
    <div>
      <p class="font-alt text-sm font-bold uppercase tracking-wider text-[var(--color-accent-800)]">
        Avvertenze
      </p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
        {DISCLAIMER}
      </p>
      {lastUpdated && (
        <p class="mt-3 text-xs text-[var(--color-ink-muted)]">
          Ultimo aggiornamento di questo articolo: <strong>{lastUpdated}</strong>.
        </p>
      )}
      <a
        href={BOOKING.arcanisGroup}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex items-center gap-2 rounded-md bg-[var(--color-brand-900)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--color-brand-800)] no-underline"
      >
        Prenota un appuntamento
        <Icon name="heroicons:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</aside>
