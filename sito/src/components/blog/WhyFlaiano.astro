---
import { BOOKING, CONTACT } from "~/consts";
import { Icon } from "astro-icon/components";
---

<aside class="my-12 rounded-[var(--radius-2xl)] border border-[var(--color-brand-200)] bg-gradient-to-br from-[var(--color-brand-900)] to-[var(--color-brand-950)] p-8 text-white md:p-10">
  <h3 class="font-display text-2xl font-bold text-white">
    Vuoi che ce ne occupiamo noi?
  </h3>
  <p class="mt-3 max-w-2xl text-slate-300">
    Il <strong>Centro Pratiche Flaiano</strong>, CAF UNSIC e Patronato ENASC a Roma Vigne Nuove, ti segue passo passo. Prenoti un appuntamento, porti i documenti, alle scartoffie pensiamo noi.
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href={BOOKING.arcanisGroup}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-md bg-[var(--color-accent-400)] px-5 py-2.5 text-sm font-semibold text-[var(--color-brand-950)] hover:bg-[var(--color-accent-300)] no-underline"
    >
      <Icon name="heroicons:calendar-days" class="size-4" />
      Prenota appuntamento
    </a>
    <a
      href={`tel:${CONTACT.phone.landlineRaw}`}
      class="inline-flex items-center gap-2 rounded-md border border-white/20 bg-white/10 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/20 no-underline"
    >
      <Icon name="heroicons:phone" class="size-4" />
      {CONTACT.phone.landline}
    </a>
  </div>
</aside>
