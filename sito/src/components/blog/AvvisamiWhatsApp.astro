---
/** Riquadro "Avvisami": invito al canale WhatsApp ufficiale e alla pagina /scadenze. */
import { CONTACT } from "~/consts";
interface Props { scadenze?: boolean }
const { scadenze = true } = Astro.props;
---
<div style="background:#E7F8EE;border-radius:28px;padding:22px 24px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;color:#14142B">
  <div style="flex:1 1 280px;min-width:0">
    <p style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:22px;line-height:1.15">Non perdere le prossime scadenze</p>
    <p style="margin:6px 0 0;font-size:16px;line-height:1.5;color:#34344A">Segui il nostro canale WhatsApp: un messaggio quando esce un bonus o si avvicina una scadenza. Gratis, e puoi uscire quando vuoi.{scadenze && <> Oppure guarda <a href="/scadenze" style="color:#14142B;font-weight:800">tutte le scadenze</a>.</>}</p>
  </div>
  <a href={CONTACT.whatsapp.channel} target="_blank" rel="noopener" style="flex:none;display:inline-flex;align-items:center;gap:10px;background:#15803D;color:#fff;text-decoration:none;font-weight:800;font-size:17px;border-radius:999px;padding:14px 22px;box-shadow:0 5px 0 #14142B">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3z"/></svg>
    Segui il canale
  </a>
</div>
