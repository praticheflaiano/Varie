---
import JsonLdBreadcrumb from "~/components/seo/JsonLdBreadcrumb.astro";

interface Props {
  items: { name: string; href: string }[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;

const fullItems = [{ name: "Home", href: "/" }, ...items];
---

<nav aria-label="Briciole di pane" class:list={["text-sm", className]}>
  <ol class="flex flex-wrap items-center gap-1.5 text-[var(--color-ink-muted)]">
    {fullItems.map((item, i) => {
      const isLast = i === fullItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {isLast ? (
            <span class="font-medium text-[var(--color-ink-soft)]" aria-current="page">{item.name}</span>
          ) : (
            <>
              <a href={item.href} class="hover:text-[var(--color-brand-700)] no-underline">{item.name}</a>
              <svg viewBox="0 0 20 20" class="size-4 opacity-50" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.06 10 7.23 6.29a.75.75 0 0 1 1.04-1.08l4.39 4.25a.75.75 0 0 1 0 1.08l-4.39 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
              </svg>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<JsonLdBreadcrumb items={fullItems} />
