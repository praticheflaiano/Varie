---
import { SITE, CONTACT, HOURS, SOCIAL, ORG_CREDENTIALS, EXTERNAL_PORTALS, LANDING } from "~/consts";
import { CATEGORY_LIST } from "~/utils/categories";
import Logo from "~/components/illustrations/Logo.astro";

const year = new Date().getFullYear();
const fmt = (h: (typeof HOURS)[number]) =>
  `${h.open}–${h.close}${h.afternoon ? ` e ${h.afternoon.open}–${h.afternoon.close}` : ""}`;
---
<footer id="contatti" class="site-footer" style="background:#14142B;color:#D7D7E6;padding-block:72px 32px">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4 flex flex-col gap-5">
        <a href="/" class="no-underline" aria-label="Home"><Logo dark /></a>
        <p style="font-family:var(--font-display);font-weight:800;font-size:32px;line-height:1.05;color:#fff">
          Passa a trovarci.<br /><span style="color:#D4FF4F">O chiamaci.</span>
        </p>
        <div class="flex flex-wrap gap-2">
          <span style="border:1px solid #33334D;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:#fff">CAF UNSIC</span>
          <span style="border:1px solid #33334D;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:#fff">Patronato ENASC</span>
        </div>
        <div class="flex gap-4 text-sm">
          <a href={CONTACT.mapsUrl} target="_blank" rel="noopener" style="color:#D4FF4F;font-weight:800">★ Le recensioni su Google</a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={SOCIAL.whatsappChannel} target="_blank" rel="noopener">Canale WhatsApp</a>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h4>Servizi</h4>
        <ul class="space-y-2 text-sm">
          {LANDING.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/servizi">Tutti i servizi</a></li>
          <li><a href="/tesseramento">Tessera</a></li>
          <li><a href="/quale-isee">Quale ISEE ti serve</a></li>
          <li><a href="/calcolo-imposte-successione">Calcolo tasse di successione</a></li>
          <li><a href={EXTERNAL_PORTALS.naspi.url} target="_blank" rel="noopener" style="color:#D4FF4F;font-weight:700">Portale NASpI ↗</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h4>Dal blog</h4>
        <ul class="space-y-2 text-sm">
          {CATEGORY_LIST.slice(0, 7).map((c) => <li><a href={`/blog/categoria/${c.slug}`}>{c.label}</a></li>)}
          <li><a href="/blog" style="color:#D4FF4F;font-weight:700">Tutti gli articoli →</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h4>Dove e quando</h4>
        <address class="not-italic text-sm space-y-3">
          <p>
            <b style="color:#fff">{CONTACT.address.street}</b><br />
            {CONTACT.address.postalCode} {CONTACT.address.locality} · {CONTACT.address.landmark}
          </p>
          <p>
            {HOURS.filter((h) => h.open).length === 5 && (
              <>Lun–gio {fmt(HOURS[0])}<br />Ven {fmt(HOURS[4])}</>
            )}
          </p>
          <p>
            <a href={`tel:${CONTACT.phone.landlineRaw}`} style="color:#fff;font-weight:700">{CONTACT.phone.landline}</a><br />
            <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="color:#fff;font-weight:700">WhatsApp {CONTACT.phone.mobile}</a><br />
            <a href={`mailto:${CONTACT.email}`} class="break-all">{CONTACT.email}</a>
          </p>
        </address>
        <a href="/prenota" class="btn btn-lime btn-sm mt-5" style="box-shadow:none;color:#14142B">Prenota appuntamento</a>
      </div>
    </div>

    <hr class="my-10" style="border:0;border-top:1px solid #33334D" />

    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-xs" style="color:#A3A3BD">
      <p>&copy; {year} {SITE.legalName} · {ORG_CREDENTIALS.caf.network} e {ORG_CREDENTIALS.patronato.network}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/cookie">Cookie</a></li>
        <li><a href="/note-legali">Note legali</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/recensioni">Recensioni</a></li>
        <li><a href="/contatti">Contatti</a></li>
      </ul>
    </div>
    <p class="mt-4 text-xs" style="color:#6B6B85">
      {ORG_CREDENTIALS.caf.fullName} · {ORG_CREDENTIALS.patronato.fullName}. Riferimenti: {ORG_CREDENTIALS.legalReferences.join("; ")}.
    </p>
  </div>
</footer>
