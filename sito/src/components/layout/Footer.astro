---
import { SITE, CONTACT, HOURS, SOCIAL, ORG_CREDENTIALS, LANDING } from "~/consts";
import { CATEGORY_LIST } from "~/utils/categories";
import Logo from "~/components/illustrations/Logo.astro";

const year = new Date().getFullYear();
const fmt = (h: (typeof HOURS)[number]) =>
  `${h.open}–${h.close}${h.afternoon ? ` e ${h.afternoon.open}–${h.afternoon.close}` : ""}`;

/**
 * Colonne di link (27/11/2026). Su computer stanno affiancate; su telefono diventano riquadri apribili
 * (<details>, chiusi). Le due versioni sono nello stesso HTML e una delle due è nascosta con display:none,
 * così non serve JavaScript. I singoli calcolatori non stanno qui: sono tutti in /calcolatori.
 * aria-label "X: il servizio" / "X: articoli del blog": lo stesso testo porta a pagine diverse.
 */
type FLink = { label: string; href: string; aria?: string; evid?: boolean };
const servizio = (l: { label: string; href: string }): FLink => ({ label: l.label, href: l.href, aria: `${l.label}: il servizio` });
const colonne: { id: string; titolo: string; links: FLink[] }[] = [
  {
    id: "caf",
    titolo: "CAF e servizi vari",
    links: [
      ...LANDING.filter((l) => l.area === "caf").map(servizio),
      ...LANDING.filter((l) => l.area === "vari").map(servizio),
      { label: "Servizi vari", href: "/servizi/servizi-vari" },
      { label: "Tutti i servizi CAF", href: "/servizi/caf" },
    ],
  },
  {
    id: "patronato",
    titolo: "Patronato",
    links: [...LANDING.filter((l) => l.area === "patronato").map(servizio), { label: "Tutti i servizi Patronato", href: "/servizi/patronato" }],
  },
  {
    id: "strumenti",
    titolo: "Strumenti e info",
    links: [
      { label: "Cosa ti è successo?", href: "/situazioni" },
      { label: "Calcolatori gratuiti", href: "/calcolatori", evid: true },
      { label: "Quale ISEE ti serve", href: "/quale-isee" },
      { label: "Scopri cosa ti spetta", href: "/quale-isee?modo=bonus" },
      { label: "Pagamenti INPS: le date", href: "/pagamenti-inps" },
      { label: "Le prossime scadenze", href: "/scadenze" },
      { label: "Cosa portare", href: "/cosa-portare" },
      { label: "Prezzi", href: "/prezzi" },
      { label: "Tessera", href: "/tesseramento" },
      { label: "Tutti i servizi", href: "/servizi" },
    ],
  },
  {
    id: "blog",
    titolo: "Dal blog",
    links: [
      ...CATEGORY_LIST.slice(0, 7).map((c) => ({ label: c.label, href: `/blog/categoria/${c.slug}`, aria: `${c.label}: articoli del blog` })),
      { label: "Tutti gli articoli →", href: "/blog", evid: true },
    ],
  },
];
---
<footer id="contatti" class="site-footer" style="background:#14142B;color:#D7D7E6;padding-block:72px 32px">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <a href="/" class="no-underline" aria-label="Home"><Logo dark /></a>
        <p style="font-family:var(--font-display);font-weight:800;font-size:32px;line-height:1.05;color:#fff">
          Passa a trovarci.<br /><span style="color:#D4FF4F">O chiamaci.</span>
        </p>
        <div class="flex flex-wrap gap-2">
          <span style="border:1px solid #33334D;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:#fff">CAF UNSIC</span>
          <span style="border:1px solid #33334D;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:700;color:#fff">Patronato ENASC</span>
        </div>
        <div class="flex gap-4 text-sm">
          <a href={CONTACT.mapsUrl} target="_blank" rel="noopener" style="color:#D4FF4F;font-weight:800">★ Le recensioni su Google</a>
          <a href={CONTACT.reviewWriteUrl} target="_blank" rel="noopener">Lascia una recensione</a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={SOCIAL.whatsappChannel} target="_blank" rel="noopener">Canale WhatsApp</a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <h2 class="footer-title">Dove e quando</h2>
        <address class="not-italic text-sm space-y-3">
          <p>
            <b style="color:#fff">{CONTACT.address.street}</b><br />
            {CONTACT.address.postalCode} {CONTACT.address.locality} · {CONTACT.address.landmark}
          </p>
          <p>
            {HOURS.filter((h) => h.open).length === 5 && (
              <>Lun–gio {fmt(HOURS[0])}<br />Ven {fmt(HOURS[4])}</>
            )}
          </p>
          <p>
            <a href={`tel:${CONTACT.phone.landlineRaw}`} style="color:#fff;font-weight:700;display:inline-block;padding:4px 0">{CONTACT.phone.landline}</a><br />
            <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="color:#fff;font-weight:700;display:inline-block;padding:4px 0">WhatsApp {CONTACT.phone.mobile}</a><br />
            <a href={`mailto:${CONTACT.email}`} class="break-all" style="display:inline-block;padding:4px 0">{CONTACT.email}</a>
          </p>
        </address>
        <a href="/prenota" class="btn btn-lime btn-sm mt-5" style="box-shadow:none;color:#14142B">Vai alle prenotazioni</a>
      </div>
    </div>

    <!-- Computer e tablet: colonne affiancate -->
    <div class="f-cols">
      {colonne.map((c) => (
        <div>
          <h2 class="footer-title">{c.titolo}</h2>
          <ul class="f-list">
            {c.links.map((l) => <li><a href={l.href} aria-label={l.aria} class:list={[{ "f-evid": l.evid }]}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- Telefono: riquadri apribili, chiusi -->
    <div class="f-acc">
      {colonne.map((c) => (
        <details class="f-det">
          <summary class="f-sum">
            <h2 class="footer-title">{c.titolo}</h2>
            <svg class="f-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <ul class="f-list">
            {c.links.map((l) => <li><a href={l.href} aria-label={l.aria} class:list={[{ "f-evid": l.evid }]}>{l.label}</a></li>)}
          </ul>
        </details>
      ))}
    </div>

    <hr class="my-10" style="border:0;border-top:1px solid #33334D" />

    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-xs" style="color:#A3A3BD">
      <p>&copy; {year} {SITE.legalName} · {ORG_CREDENTIALS.caf.network} e {ORG_CREDENTIALS.patronato.network}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/cookie">Cookie</a></li>
        <li><a href="/cookie" data-preferenze-cookie>Preferenze cookie</a></li>
        <li><a href="/note-legali">Note legali</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/recensioni">Recensioni</a></li>
        <li><a href="/zone">Zone servite</a></li>
        <li><a href="/contatti">Contatti</a></li>
      </ul>
    </div>
    <p class="mt-4 text-xs" style="color:#A3A3BD">
      {ORG_CREDENTIALS.caf.fullName} · {ORG_CREDENTIALS.patronato.fullName}. Riferimenti: {ORG_CREDENTIALS.legalReferences.join("; ")}.
    </p>
  </div>
</footer>

<style>
  .f-cols {
    display: none;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid #33334d;
    gap: 40px 32px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .f-list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.35;
  }
  .f-list li + li {
    margin-top: 4px;
  }
  .f-list a {
    display: inline-block;
    padding: 4px 0;
  }
  .site-footer .f-list a.f-evid {
    color: #d4ff4f;
    font-weight: 700;
  }
  .f-acc {
    margin-top: 40px;
    border-top: 1px solid #33334d;
  }
  .f-det {
    border-bottom: 1px solid #33334d;
  }
  .f-sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    cursor: pointer;
    list-style: none;
    color: #fff;
  }
  .f-sum::-webkit-details-marker {
    display: none;
  }
  .site-footer .f-sum .footer-title {
    margin: 0;
    font-size: 14px;
  }
  .f-sum:focus-visible {
    outline: 3px solid #d4ff4f;
    outline-offset: 2px;
  }
  .f-chev {
    flex: none;
    color: #d4ff4f;
    transition: transform 0.15s;
  }
  .f-det[open] .f-chev {
    transform: rotate(180deg);
  }
  .f-det .f-list {
    padding-bottom: 16px;
    font-size: 16px;
  }
  .f-det .f-list a {
    padding: 8px 0;
  }
  .f-det .f-list li + li {
    margin-top: 0;
  }
  @media (min-width: 768px) {
    .f-cols {
      display: grid;
    }
    .f-acc {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .f-cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .f-chev {
      transition: none;
    }
  }
</style>
