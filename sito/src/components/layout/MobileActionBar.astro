---
import { CONTACT } from "~/consts";
// Barra fissa in basso solo su smartphone: le tre azioni che portano un contatto.
const wa = `${CONTACT.whatsapp.link}?text=${encodeURIComponent("Ciao, vorrei informazioni su...")}`;
---

<nav class="mab" aria-label="Contattaci subito">
  <a href="/prenota" class="mab__btn mab__btn--main">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
    Prenota
  </a>
  <a href={wa} class="mab__btn mab__btn--wa" target="_blank" rel="noopener">
    <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor"><path d="M16.03 5.05C10.3 5.05 5.64 9.7 5.64 15.44c0 1.96.54 3.87 1.58 5.51L5.11 26l5.16-1.96a10.34 10.34 0 0 0 5.76 1.73c5.73 0 10.38-4.65 10.38-10.39C26.41 9.65 21.76 5.05 16.03 5.05Zm-.21 19.1c-1.76 0-3.51-.59-4.87-1.65l-2.99 1.03 1.06-2.67a8.66 8.66 0 0 1-1.93-5.43c0-4.81 3.91-8.72 8.72-8.72s8.73 3.91 8.73 8.72c0 4.81-3.91 8.72-8.72 8.72Zm3.29-6.94c-.37 0-1.09 1.39-1.52 1.39-.1 0-.21-.04-.31-.1-.8-.4-1.5-.82-2.16-1.45-.55-.52-1.15-1.29-1.46-1.96-.04-.07-.07-.14-.07-.22 0-.33.99-.94.99-1.49 0-.14-.73-2.09-.83-2.33-.14-.37-.21-.49-.6-.49-.19 0-.36-.04-.53-.04-.3 0-.53.11-.7.31-.4.46-.96 1.29-.96 2.24 0 1.04.6 2.06 1.39 2.92 1.32 1.47 3.12 2.96 4.81 3.49.36.12.74.22 1.12.22.53 0 1.06-.11 1.5-.39.49-.3.7-.76.7-1.32 0-.36 0-.83-.43-.97-.36-.16-1.1-.57-1.39-.57Z"/></svg>
    WhatsApp
  </a>
  <a href={`tel:${CONTACT.phone.landlineRaw}`} class="mab__btn">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
    Chiama
  </a>
</nav>

<style>
  .mab { display: none; }
  @media (max-width: 767px) {
    .mab {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
      display: grid; grid-template-columns: 1.15fr 1.15fr 1fr; gap: 6px;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      border-top: 1px solid #E6E3F5;
      box-shadow: 0 -6px 20px rgba(20, 20, 43, 0.08);
    }
    .mab__btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      min-height: 46px; border-radius: 999px; font-weight: 800; font-size: 14px; padding: 0 6px; white-space: nowrap;
      text-decoration: none; color: #14142B; background: #F1EEFF;
    }
    .mab__btn svg { width: 18px; height: 18px; flex: none; }
    .mab__btn--main { background: #5B3DF5; color: #fff; }
    .mab__btn--wa { background: #25D366; color: #fff; }
    :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
    :global(.whatsapp-fab) { display: none !important; }
  }
</style>
