---
import { NAV, CONTACT, EXTERNAL_PORTALS } from "~/consts";
import Logo from "~/components/illustrations/Logo.astro";
import MobileMenu from "./MobileMenu.svelte";

const items = NAV.map((n) => ({
  label: n.label,
  href: n.href,
  external: "external" in n ? !!n.external : false,
  children: "children" in n ? n.children?.map((c) => ({ label: c.label, href: c.href })) : undefined,
}));

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
const serviziPaths = ["/servizi", "/isee", "/730", "/naspi", "/assegno-unico", "/invalidita-104", "/successioni"];
const serviziActive = serviziPaths.some((p) => path === p || path.startsWith(p + "/"));
---
<header class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="brand-mark" aria-label="Centro Pratiche Flaiano - Home">
      <Logo variant="full" />
    </a>

    <nav class="nav-main" aria-label="Navigazione principale">
      <a href="/servizi" class:list={[{ active: serviziActive }]}>Servizi</a>
      <a href="/tesseramento" class:list={[{ active: isActive("/tesseramento") }]}>Tessera</a>
      <a href="/blog" class:list={[{ active: isActive("/blog") }]}>Blog</a>
      <a href="/faq" class:list={[{ active: isActive("/faq") }]}>FAQ</a>
      <a href="/chi-siamo" class:list={[{ active: isActive("/chi-siamo") }]}>Chi siamo</a>
      <a href="/contatti" class:list={[{ active: isActive("/contatti") }]}>Contatti</a>
      <a href={EXTERNAL_PORTALS.naspi.url} target="_blank" rel="noopener" title={EXTERNAL_PORTALS.naspi.description}>
        Disoccupazione ↗
      </a>
    </nav>

    <div class="header-cta">
      <a class="btn btn-ghost btn-sm hide-sm" href={`tel:${CONTACT.phone.landlineRaw}`}>06 9784 5429</a>
      <a class="header-search" href="/cerca" aria-label="Cerca nel sito" title="Cerca nel sito">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <a class="btn btn-dark btn-sm" href="/prenota">Prenota</a>
      <MobileMenu
        client:load
        items={items}
        bookingUrl="/prenota"
        phoneRaw={CONTACT.phone.landlineRaw}
        whatsappLink={CONTACT.whatsapp.link}
      />
    </div>
  </div>
</header>
