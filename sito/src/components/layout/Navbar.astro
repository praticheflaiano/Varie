---
import { NAV, BOOKING, CONTACT, EXTERNAL_PORTALS } from "~/consts";
import Logo from "~/components/illustrations/Logo.astro";
import MobileMenu from "./MobileMenu.svelte";

const items = NAV.map((n) => ({
  label: n.label,
  href: n.href,
  external: "external" in n ? !!n.external : false,
  children: "children" in n ? n.children?.map((c) => ({ label: c.label, href: c.href })) : undefined,
}));
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="brand-mark" aria-label="Centro Pratiche Flaiano - Home">
      <Logo variant="full" />
    </a>

    <nav class="nav-main" aria-label="Navigazione principale">
      <a href="/chi-siamo">Chi siamo</a>
      <a href="/servizi">Servizi</a>
      <a href="/tesseramento">Tesseramento</a>
      <a href="/blog">Blog</a>
      <a href={EXTERNAL_PORTALS.naspi.url} target="_blank" rel="noopener" class="nav-external" title={EXTERNAL_PORTALS.naspi.description}>
        Disoccupazione
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-1px;margin-left:4px;">
          <path d="M7 17L17 7"/>
          <polyline points="7 7 17 7 17 17"/>
        </svg>
      </a>
      <a href="/contatti">Contatti</a>
    </nav>

    <div class="header-cta">
      <a class="btn btn-ghost btn-sm" href={`tel:${CONTACT.phone.landlineRaw}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        06 9784 5429
      </a>
      <a class="btn btn-primary btn-sm" href={BOOKING.arcanisGroup} target="_blank" rel="noopener">
        Prenota
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <MobileMenu
      client:load
      items={items}
      bookingUrl={BOOKING.arcanisGroup}
      phoneRaw={CONTACT.phone.landlineRaw}
      whatsappLink={CONTACT.whatsapp.link}
    />
  </div>
</header>
