---
import { HOURS } from "~/consts";
import { Icon } from "astro-icon/components";

// "oggi" calcolato nel browser (la pagina e statica)
const todayIdx = -1;
---

<div class="rounded-[28px] bg-[#F7F7FB] p-6">
  <h3 class="flex items-center gap-2 font-display text-lg font-bold text-[var(--color-ink)]">
    <Icon name="heroicons:clock" class="size-5 text-[var(--color-brand-700)]" aria-hidden="true" />
    Orari di apertura
  </h3>
  <dl class="mt-5 space-y-2 text-sm">
    {HOURS.map((h, i) => {
      const isToday = i === todayIdx;
      const closed = !h.open;
      return (
        <div data-day={i} class:list={[
          "flex items-center justify-between gap-4 rounded-xl px-3 py-2",
          isToday && "bg-[var(--color-brand-50)] font-semibold"
        ]}>
          <dt class:list={[
            "min-w-24",
            isToday ? "text-[var(--color-brand-900)]" : "text-[var(--color-ink-soft)]"
          ]}>
            {h.day}
            {isToday && <span class="ml-2 rounded bg-[var(--color-brand-900)] px-1.5 py-0.5 text-[10px] uppercase text-white">oggi</span>}
          </dt>
          <dd class:list={[
            "tabular-nums",
            closed ? "text-[var(--color-ink-muted)]" : "text-[var(--color-ink)]"
          ]}>
            {closed ? (
              "Chiuso"
            ) : (
              <>
                {h.open}-{h.close}
                {h.afternoon && ` / ${h.afternoon.open}-${h.afternoon.close}`}
              </>
            )}
          </dd>
        </div>
      );
    })}
  </dl>
</div>
<script>
  const wd = new Intl.DateTimeFormat("it-IT", { timeZone: "Europe/Rome", weekday: "short" }).format(new Date()).toLowerCase();
  const idx = ["lun", "mar", "mer", "gio", "ven", "sab", "dom"].findIndex((d) => wd.startsWith(d));
  const row = document.querySelector<HTMLElement>(`[data-day="${idx}"]`);
  if (row) {
    row.style.background = "#F1EEFF";
    row.style.fontWeight = "700";
    const dt = row.querySelector("dt");
    if (dt) dt.insertAdjacentHTML("beforeend", ' <span style="margin-left:6px;background:#14142B;color:#fff;border-radius:6px;padding:2px 6px;font-size:10px;text-transform:uppercase">oggi</span>');
  }
</script>
