---
/**
 * Pagine strumento (calcolatori) impaginate come gli articoli del blog: stessi elementi di ArticleLayout e
 * NaspiGuideLayout (copertina, autore, date, tempo di lettura, "In breve" con pulsante Prenota subito dopo,
 * fonti con link, "Vuoi che ce ne occupiamo noi?", avvertenze, articoli correlati, Condividi).
 * - slot "intro": riquadro "In breve"
 * - slot "tool": il calcolatore (fuori dallo stile articolo)
 * - slot predefinito: il testo (dentro .prose-article)
 * - slot "after": blocchi extra dopo il testo (es. preventivo)
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import ArticleMeta from "~/components/blog/ArticleMeta.astro";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import AvvisamiWhatsApp from "~/components/blog/AvvisamiWhatsApp.astro";
import WhyFlaiano from "~/components/blog/WhyFlaiano.astro";
import Disclaimer from "~/components/blog/Disclaimer.astro";
import RelatedArticles from "~/components/blog/RelatedArticles.astro";
import ShareBar from "~/components/ui/ShareBar.astro";
import { getArticlesByCategory } from "~/utils/articles";
import { readingTime } from "~/utils/reading-time";
import { formatDateIt } from "~/utils/date";
import { SITE } from "~/consts";
import { Icon } from "astro-icon/components";
import PageAside from "~/components/layout/PageAside.astro";

type Fonte = string | { t: string; url: string };
interface Props {
  title: string;
  description: string;
  path: string;          // es. "/naspi/domanda"
  h1: string;
  kicker: string;
  crumbs: { name: string; href: string }[]; // briciole di pane dopo "Home"
  category: string;      // categoria del blog per gli articoli correlati
  prenota?: { t: string; s: string };
  updated: string;       // YYYY-MM-DD
  published: string;     // YYYY-MM-DD
  image: string;         // copertina 1200x630, es. "/og/naspi-domanda.jpg"
  imageAlt: string;
  sources: Fonte[];
  faq?: { q: string; a: string }[];
  related?: string[];    // slug di articoli del blog da mostrare tra i correlati (in quest'ordine)
}
const { title, description, path, h1, kicker, crumbs, category, prenota = { t: "Prenota: la pratica la facciamo noi", s: "CAF UNSIC e Patronato ENASC a Roma Vigne Nuove o in videochiamata" }, updated, published, image, imageAlt, sources, faq = [], related = [] } = Astro.props;
const url = new URL(path, SITE.url).toString();
const imageUrl = new URL(image, SITE.url).toString();
const d = (iso: string) => { const [y, m, g] = iso.split("-").map(Number); return new Date(y, m - 1, g); };

const corpo = await Astro.slots.render("default");
const minuti = readingTime(corpo.replace(/<[^>]+>/g, " ") + " " + faq.map((f) => f.q + " " + f.a).join(" "));

// Articoli correlati: prima quelli indicati, poi i più recenti della categoria
const naspi = await getArticlesByCategory(category);
const scelti = [
  ...related.map((s) => naspi.find((a) => a.data.slug === s)).filter((a): a is (typeof naspi)[number] => !!a),
  ...naspi,
].filter((a, i, arr) => arr.findIndex((b) => b.data.slug === a.data.slug) === i).slice(0, 3);

const article = JSON.stringify({
  "@context": "https://schema.org", "@type": "Article", headline: h1, description, image: [imageUrl],
  datePublished: published, dateModified: updated, inLanguage: "it-IT",
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  author: { "@type": "Organization", name: "Redazione Centro Pratiche Flaiano", url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url, logo: { "@type": "ImageObject", url: new URL("/apple-touch-icon.png", SITE.url).toString() } },
});
---
<BaseLayout title={title} description={description} canonical={url} ogImage={image} ogType="article" publishedTime={published} modifiedTime={updated} share={false}>
  <script slot="head" is:inline type="application/ld+json" set:html={article} />
  <slot name="head" slot="head" />
  {faq.length >= 2 && <JsonLdFaq slot="head" items={faq.map((f) => ({ question: f.q, answer: f.a }))} />}

  <!-- Impaginazione (27/11/2026): .ps e .ps--tool in global.css. Da 1200 px: titolo su tutta la larghezza,
       copertina accanto a "In breve", strumento largo fino a 960 px, poi testo a sinistra e colonna laterale
       (PageAside) con Prenota, telefono, WhatsApp e calcolatori. Sotto i 1200 px una colonna come prima. -->
  <article class:list={["ps py-10 md:py-16", { "ps--tool": Astro.slots.has("tool") }]}>
    <div class="ps-head">
    <Breadcrumb items={crumbs} class="mb-6" />
    <p style="margin:0;display:inline-block;background:#F1EEFF;color:#4B2FE0;font-weight:800;font-size:13px;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:6px 14px">{kicker}</p>
    <h1 class="mt-5 font-display text-balance" style="font-size:clamp(2.1rem,5.5vw,3.4rem);line-height:1.04">{h1}</h1>
    <p class="ps-lede mt-5 text-lg text-[var(--color-ink-soft)] leading-relaxed">{description}</p>
    </div>

    <figure class="ps-cover mt-8 overflow-hidden rounded-[28px]">
      <img src={image} alt={imageAlt} width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto block" />
    </figure>

    <div class="ps-top">
    <div class="mt-7 border-y border-[var(--color-border)] py-4">
      <ArticleMeta date={d(published)} lastUpdated={d(updated)} author="Redazione Centro Pratiche Flaiano" readingTime={minuti} type="guida" />
      <p class="mt-3 flex items-center gap-2 text-sm font-semibold" style="color:#3B3B55">
        <Icon name="heroicons:check-badge" class="size-5" style="color:#5B3DF5" aria-hidden="true" />
        <span><b>Ultimo aggiornamento: {formatDateIt(d(updated))}</b> · controllato su {sources.length} fonti ufficiali (le trovi in fondo) · scritto da chi fa queste pratiche ogni giorno</span>
      </p>
      <div class="mt-4"><ShareBar title={h1} url={url} variant="inline" /></div>
    </div>

    {Astro.slots.has("intro") && <div class="prose-article mt-8"><slot name="intro" /></div>}

    <div class="mt-6">
      <a href="/prenota" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">{prenota.t}</span><span class="cta-tool-s">{prenota.s}</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    </div>

    {Astro.slots.has("tool") && <div class="ps-tool mt-8"><slot name="tool" /></div>}

    <div class="ps-main">
    <div class="prose-article mt-8">
      <Fragment set:html={corpo} />

      {faq.length > 0 && (
        <>
          <h2>Domande frequenti</h2>
          {faq.map((f) => (<details class="faq-item"><summary><h3 class="faq-q">{f.q}</h3></summary><div class="faq-a"><p>{f.a}</p></div></details>))}
        </>
      )}
    </div>

    <slot name="after" />
    <AvvisamiWhatsApp />

    <div class="mt-10"><ShareBar title={h1} url={url} heading="Conosci qualcuno a cui può servire?" /></div>

    <section class="mt-10" style="background:#F7F7FB;border-radius:24px;padding:20px 24px" aria-labelledby="fonti-title">
      <h2 id="fonti-title" style="font-size:1.25rem;margin:0 0 10px">Fonti ufficiali</h2>
      <ul style="margin:0;padding-left:1.1em;font-size:15px;line-height:1.55;color:#3F3F5A">
        {sources.map((s) => typeof s === "string"
          ? <li>{s}</li>
          : <li><a href={s.url} target="_blank" rel="noopener" style="color:#4B2FE0;text-decoration:underline;display:inline-block;padding:2px 0">{s.t}</a></li>)}
      </ul>
    </section>

    <WhyFlaiano />
    <Disclaimer lastUpdated={formatDateIt(d(updated))} />
    </div>

    <PageAside />

    <div class="ps-rel">
      <RelatedArticles articles={scelti} />
    </div>
  </article>
</BaseLayout>
