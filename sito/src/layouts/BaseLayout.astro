---
import "~/styles/global.css";
import { SITE } from "~/consts";
import SEO from "~/components/seo/SEO.astro";
import JsonLdLocalBusiness from "~/components/seo/JsonLdLocalBusiness.astro";
import Navbar from "~/components/layout/Navbar.astro";
import Footer from "~/components/layout/Footer.astro";
import WhatsAppFab from "~/components/layout/WhatsAppFab.astro";
import MobileActionBar from "~/components/layout/MobileActionBar.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  hideWhatsAppFab?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  publishedTime,
  modifiedTime,
  author,
  tags,
  hideWhatsAppFab = false,
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} - Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
    />
    <JsonLdLocalBusiness />

    <slot name="head" />
  </head>
  <body class:list={["min-h-screen flex flex-col bg-white text-[var(--color-ink-soft)]", bodyClass]}>
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>
    <Navbar />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {!hideWhatsAppFab && <WhatsAppFab />}
    {!hideWhatsAppFab && <MobileActionBar />}
  </body>
</html>
