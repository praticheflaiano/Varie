---
/**
 * Pagine guida su NASpI e disoccupazione (arrivate dal portale domandedisoccupazione.it).
 * - slot "intro": riquadro "In breve" (dentro lo stile articolo)
 * - slot "tool": strumento interattivo React, fuori dallo stile articolo e dentro la zona .nz
 * - slot predefinito: il testo della guida
 * Ogni guida indica fonti ufficiali e data di revisione (regola ZERO INVENZIONI).
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import PortaleNaspi from "~/components/blog/PortaleNaspi.astro";
import AvvisamiWhatsApp from "~/components/blog/AvvisamiWhatsApp.astro";
import { SITE } from "~/consts";

interface Props {
  title: string;
  description: string;
  path: string;          // es. "/naspi/domanda"
  h1: string;
  kicker: string;
  crumb: string;         // nome breve per le briciole di pane
  updated: string;       // YYYY-MM-DD
  published: string;     // YYYY-MM-DD
  sources: string[];
  faq?: { q: string; a: string }[];
}
const { title, description, path, h1, kicker, crumb, updated, published, sources, faq = [] } = Astro.props;
const url = new URL(path, SITE.url).toString();
const dataIt = (iso: string) => { const [y, m, d] = iso.split("-").map(Number); return new Date(y, m - 1, d).toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" }); };
const article = JSON.stringify({
  "@context": "https://schema.org", "@type": "Article", headline: h1, description,
  datePublished: published, dateModified: updated, inLanguage: "it-IT",
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  author: { "@type": "Organization", name: SITE.name, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
});
---
<BaseLayout title={title} description={description} canonical={url} ogType="article" publishedTime={published} modifiedTime={updated} share={false}>
  <script slot="head" is:inline type="application/ld+json" set:html={article} />
  {faq.length >= 2 && <JsonLdFaq slot="head" items={faq.map((f) => ({ question: f.q, answer: f.a }))} />}

  <article class="container-narrow py-10 md:py-16">
    <Breadcrumb items={[{ name: "NASpI", href: "/naspi" }, { name: crumb, href: path }]} class="mb-6" />
    <p style="margin:0;display:inline-block;background:#F1EEFF;color:#4B2FE0;font-weight:800;font-size:13px;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:6px 14px">{kicker}</p>
    <h1 class="mt-5 font-display text-balance" style="font-size:clamp(2.1rem,5.5vw,3.4rem);line-height:1.04">{h1}</h1>
    <p class="mt-5 text-lg text-[var(--color-ink-soft)] leading-relaxed">{description}</p>
    <p class="mt-4 text-sm font-semibold" style="color:#3B3B55">Aggiornato il <time datetime={updated}>{dataIt(updated)}</time> · controllato su {sources.length} fonti ufficiali (le trovi in fondo)</p>

    {Astro.slots.has("intro") && <div class="prose-article mt-8"><slot name="intro" /></div>}
    {Astro.slots.has("tool") && <div class="nz mt-8"><slot name="tool" /></div>}

    <div class="prose-article mt-8">
      <slot />

      {faq.length > 0 && (
        <>
          <h2>Domande frequenti</h2>
          {faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
        </>
      )}
    </div>

    <div class="mt-10">
      <a href="/prenota" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota: la pratica la facciamo noi</span><span class="cta-tool-s">Patronato ENASC a Roma Vigne Nuove o in videochiamata da tutta Italia</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>

    <section class="mt-10" style="background:#F7F7FB;border-radius:24px;padding:20px 24px" aria-labelledby="fonti-title">
      <h2 id="fonti-title" style="font-size:1.25rem;margin:0 0 10px">Fonti</h2>
      <ul style="margin:0;padding-left:1.1em;font-size:15px;line-height:1.55;color:#3F3F5A">
        {sources.map((s) => <li>{s}</li>)}
      </ul>
      <p style="margin:12px 0 0;font-size:14px;line-height:1.5;color:#3F3F5A">Le informazioni hanno carattere informativo e non sostituiscono una consulenza sul caso concreto. Regole e importi possono cambiare: fa fede quanto pubblicato dall'INPS.</p>
    </section>

    <PortaleNaspi current={path} heading="Altre guide e strumenti su NASpI e disoccupazione" />
    <AvvisamiWhatsApp />
  </article>
</BaseLayout>
