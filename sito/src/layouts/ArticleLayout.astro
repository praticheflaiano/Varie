---
import { render } from "astro:content";
import type { Article } from "~/utils/articles";
import { getRelatedArticles, tagSlug } from "~/utils/articles";
import { getCategory } from "~/utils/categories";
import { formatDateIt, toISODate } from "~/utils/date";
import { readingTime } from "~/utils/reading-time";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import ArticleMeta from "~/components/blog/ArticleMeta.astro";
import Disclaimer from "~/components/blog/Disclaimer.astro";
import RelatedArticles from "~/components/blog/RelatedArticles.astro";
import WhyFlaiano from "~/components/blog/WhyFlaiano.astro";
import AvvisamiWhatsApp from "~/components/blog/AvvisamiWhatsApp.astro";
import PortaleNaspi from "~/components/blog/PortaleNaspi.astro";
import BannerPagamenti from "~/components/ui/BannerPagamenti.astro";
import { PAG_CATEGORIE } from "~/data/pagamenti";
import ShareBar from "~/components/ui/ShareBar.astro";
import JsonLdArticle from "~/components/seo/JsonLdArticle.astro";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { SITE } from "~/consts";
import { Icon } from "astro-icon/components";

interface Props {
  article: Article;
  rawBody: string;
}

const { article, rawBody } = Astro.props;
const cat = getCategory(article.data.category);
const minutes = readingTime(rawBody);
const url = new URL(`/blog/${article.data.slug}`, SITE.url).toString();
const lastUpdated = article.data.last_updated ?? article.data.date;

const breadcrumbs = [
  { name: "Blog", href: "/blog" },
  ...(cat ? [{ name: cat.label, href: `/blog/categoria/${cat.slug}` }] : []),
  { name: article.data.title, href: `/blog/${article.data.slug}` },
];

const related = await getRelatedArticles(article, 3);

// Domande frequenti scritte nell'articolo -> dati strutturati FAQPage.
// Formati letti: "### Domanda?" oppure "**Domanda?**", sotto un titolo "## Domande frequenti..." (anche "## FAQ").
const faqBlock = rawBody.split(/^## (?:Domande frequenti|FAQ)\b.*$/m)[1]?.split(/^## /m)[0] ?? "";
const pulisci = (t: string) =>
  t.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/[*_\x60>]/g, "").replace(/\s+/g, " ").trim();
const faqItems = [...faqBlock.matchAll(/^(?:###\s+(.+?\?)\s*$|\*\*(.+?\?)\*\*\s*$)\n([\s\S]*?)(?=^###\s|^\*\*.+?\?\*\*\s*$|^---|^\*(?:Disclaimer|Nota|Le informazioni)|(?![\s\S]))/gm)]
  .map((m) => ({ question: pulisci(m[1] ?? m[2] ?? ""), answer: pulisci(m[3] ?? "") }))
  .filter((f) => f.question.length > 0 && f.answer.length > 0);
const sourcesCount = article.data.sources?.length ?? 0;

// Indice "In questa guida" (27/11/2026): i titoli h2 dell'articolo, se sono almeno 4.
// Gli id dei titoli li crea già Astro (rehypeHeadingIds, dopo i nostri plugin rehype): render() li
// restituisce in `headings` con lo stesso slug, quindi i link puntano sempre al titolo giusto.
// Fuori dall'indice solo "In breve" e "Articoli correlati". Offset per la barra in alto: scroll-margin-top
// degli h2 in global.css (.prose-article h2).
const { headings } = await render(article);
const tocItems = headings.filter(
  (h) => h.depth === 2 && h.slug && !/^\s*(in breve|articoli correlati)\b/i.test(h.text),
);
const showToc = tocItems.length >= 4;
---

<BaseLayout
  title={article.data.seo_title ?? article.data.title}
  description={article.data.meta_description}
  canonical={url}
  ogType="article"
  ogImage={article.data.image}
  publishedTime={toISODate(article.data.date)}
  modifiedTime={toISODate(lastUpdated)}
  author={article.data.author}
  tags={[...article.data.tags]}
  share={false}
>
  <JsonLdArticle
    slot="head"
    headline={article.data.title}
    description={article.data.meta_description}
    datePublished={toISODate(article.data.date)}
    dateModified={toISODate(lastUpdated)}
    authorName={article.data.author}
    url={url}
    isNews={article.data.type === "novita"}
    category={cat?.label}
    keywords={[...article.data.tags]}
  />
  {faqItems.length >= 2 && <JsonLdFaq slot="head" items={faqItems} />}

  <article class="container-narrow py-10 md:py-16">
    <Breadcrumb items={breadcrumbs} class="mb-6" />

    {cat && (
      <a
        href={`/blog/categoria/${cat.slug}`}
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider no-underline"
        style={`background-color: color-mix(in oklab, ${cat.color} 12%, white); color: ${cat.color}; border: 1px solid color-mix(in oklab, ${cat.color} 20%, white);`}
      >
        <Icon name={cat.icon} class="size-3.5" aria-hidden="true" />
        {cat.label}
      </a>
    )}

    <h1 class="mt-5 font-display text-balance">{article.data.title}</h1>

    <p class="mt-5 text-lg text-[var(--color-ink-soft)] leading-relaxed">
      {article.data.meta_description}
    </p>

    {article.data.image && (
      <figure class="mt-8 -mx-4 sm:mx-0 overflow-hidden rounded-[32px]">
        <img
          src={article.data.image}
          alt={article.data.image_alt ?? article.data.title}
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto block"
        />
      </figure>
    )}

    <div class="mt-7 border-y border-[var(--color-border)] py-4">
      <ArticleMeta
        date={article.data.date}
        lastUpdated={article.data.last_updated}
        author={article.data.author}
        readingTime={minutes}
        type={article.data.type}
      />
      {sourcesCount > 0 && (
        <p class="mt-3 flex items-center gap-2 text-sm font-semibold" style="color:#3B3B55">
          <Icon name="heroicons:check-badge" class="size-5" style="color:#5B3DF5" aria-hidden="true" />
          Controllato su {sourcesCount} {sourcesCount === 1 ? "fonte" : "fonti"} (le trovi in fondo) · scritto da chi fa queste pratiche ogni giorno
        </p>
      )}
      <div class="mt-4">
        <ShareBar title={article.data.title} url={url} variant="inline" />
      </div>
    </div>

    {article.data.deadline && article.data.deadline < new Date() && (
      <div class="mt-8" style="background:#FFE3EC;border-radius:24px;padding:20px 24px;color:#14142B">
        <b>Attenzione: la scadenza di questo articolo è passata</b> ({formatDateIt(article.data.deadline)}).
        Le regole possono essere cambiate: per la tua situazione di oggi <a href="/prenota" style="font-weight:800">chiedi a noi</a>.
      </div>
    )}

    {PAG_CATEGORIE.includes(article.data.category) && (
      <div class="mt-8"><BannerPagamenti variant="compatto" /></div>
    )}

    {showToc && (
      <details class="art-toc mt-8">
        <summary>In questa guida</summary>
        <nav aria-label="In questa guida">
          <ol>
            {tocItems.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <div class="prose-article mt-10">
      <slot />
    </div>

    <div class="mt-10">
      {article.data.category === "naspi-disoccupazione" && <PortaleNaspi heading="Calcolatori e guide su NASpI e disoccupazione" />}
      <AvvisamiWhatsApp />
    </div>

    <div class="mt-10">
      <ShareBar title={article.data.title} url={url} heading="Conosci qualcuno a cui può servire?" />
    </div>

    {article.data.tags.length > 0 && (
      <div class="mt-10 flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-[var(--color-ink-muted)]">Argomenti:</span>
        {article.data.tags.map((tag) => (
          <a
            href={`/blog/tag/${tagSlug(tag)}`}
            class="inline-flex items-center rounded-full border border-[var(--color-border-strong)] bg-white px-3 py-1 text-xs font-semibold text-[var(--color-ink-soft)] hover:border-[var(--color-brand-400)] hover:text-[var(--color-brand-700)] no-underline"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    {article.data.sources && article.data.sources.length > 0 && (
      <details class="mt-10 rounded-[28px] border border-[var(--color-border)] bg-[var(--color-surface-soft)] p-5">
        <summary class="cursor-pointer font-display text-base font-bold text-[var(--color-ink)]">
          Fonti normative ({article.data.sources.length})
        </summary>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-[var(--color-ink-soft)]">
          {article.data.sources.map((s) => <li>{s}</li>)}
        </ul>
      </details>
    )}

    <WhyFlaiano />

    <Disclaimer lastUpdated={formatDateIt(lastUpdated)} />

    <RelatedArticles articles={related} />
  </article>
</BaseLayout>

<style>
  /* Indice "In questa guida": chiuso di default, nessun titolo proprio (solo summary). */
  .art-toc {
    border: 2px solid #14142b;
    border-radius: 22px;
    background: #f7f7fb;
  }
  .art-toc summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 12px 20px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    color: #14142b;
    list-style: none;
  }
  .art-toc summary::-webkit-details-marker {
    display: none;
  }
  .art-toc summary::after {
    content: "";
    margin-left: auto;
    width: 10px;
    height: 10px;
    border-right: 3px solid #5b3df5;
    border-bottom: 3px solid #5b3df5;
    transform: rotate(45deg);
    transition: transform 0.15s;
  }
  .art-toc[open] summary::after {
    transform: rotate(-135deg);
  }
  .art-toc summary:focus-visible {
    outline: 3px solid #5b3df5;
    outline-offset: 2px;
    border-radius: 20px;
  }
  .art-toc ol {
    margin: 0;
    padding: 0 20px 16px 44px;
    list-style: decimal;
    color: #3b3b55;
  }
  .art-toc li + li {
    margin-top: 2px;
  }
  .art-toc a {
    display: inline-block;
    padding: 6px 0;
    color: #14142b;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .art-toc a:hover {
    color: #5b3df5;
  }
</style>
