---
/**
 * Pagina fissa "Pagamenti INPS": l'URL resta /pagamenti-inps, cambia solo il mese.
 * AGGIORNAMENTO MENSILE: modificare solo le costanti qui sotto (MESE, AGGIORNATO, ROWS, NOV_ROWS, NEXT_ROWS, FAQS).
 * Regola: solo date confermate da INPS/MEF (notizia, messaggio o circolare citati). Se non c'è la fonte, non si pubblica.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import { BOOKING, CONTACT } from "~/consts";

const MESE = "dicembre 2026";
const AGGIORNATO = "24 novembre 2026";
const SEO_TITLE = "Pagamenti INPS dicembre 2026: tutte le date";
const SEO_DESC = "Quando arrivano a dicembre 2026 pensioni, tredicesima, Assegno Unico, ADI e bonus mamme: date INPS, come controllare il pagamento e cosa fare se non arriva";

const INPS = "https://www.inps.it/it/it/inps-comunica/notizie/dettaglio-news-page.news.";
const SRC = {
  pensNov: { label: "INPS, cedolino di novembre 2026", href: INPS + "2026.10.pensionati-il-cedolino-di-pensione-di-novembre-2026.html" },
  pensCs: { label: "INPS, comunicato pensioni di novembre", href: "https://www.inps.it/content/dam/inps-site/it/scorporati/comunicati-stampa/2026/10/Allegati/4208_CS-Pensioni-di-novembre.pdf" },
  auuNews: { label: "INPS, Assegno unico: calendario 2026", href: INPS + "2025.12.assegno-unico-e-universale-calendario-dei-pagamenti-2026.html" },
  auuMsg: { label: "INPS, messaggio n. 3931 del 24 dicembre 2025", href: "https://www.inps.it/content/dam/inps-site/it/scorporati/circolari-e-messaggi/2025/12/Circolare_15121/Allegati/16503_Messaggio-numero-3931-del-24-12-2025.pdf" },
  adiNews: { label: "INPS, ADI: calendario 2026", href: INPS + "2026.01.assegno-di-inclusione-online-il-calendario-dei-pagamenti-2026.html" },
  adiMsg: { label: "INPS, messaggio n. 214 del 22 gennaio 2026", href: "https://www.inps.it/content/dam/inps-site/it/scorporati/circolari-e-messaggi/2026/01/Circolare_15143/Allegati/16533_Messaggio-numero-214-del-22-01-2026.pdf" },
  sfl: { label: "INPS, scheda SFL", href: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.supporto-per-la-formazione-e-il-lavoro-sfl-.html" },
  mamme: { label: "INPS, Nuovo Bonus mamme 2026: aggiornamenti (circolare n. 106/2026 e messaggio n. 3343/2026)", href: INPS + "2026.10.nuovo-bonus-mamme-2026-aggiornamenti.html" },
  mammeCs: { label: "INPS, comunicato stampa del 20 ottobre 2026 sul nuovo Bonus mamme", href: "https://www.inps.it/content/dam/inps-site/it/scorporati/comunicati-stampa/2026/10/Allegati/4197_CS-nuovo-Bonus-mamme-al-via-le-domande.pdf" },
  carta: { label: "INPS, Carta Dedicata a te 2026-2027", href: INPS + "2026.09.carta-dedicata-a-te-modalit-operative-per-il-2026-2027.html" },
  impAgg: { label: "INPS, Importo aggiuntivo delle pensioni", href: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.53721.importo-aggiuntivo-delle-pensioni.html" },
  pereq: { label: "INPS, comunicato dell'11 novembre 2026 sulla perequazione", href: "https://www.inps.it/content/dam/inps-site/it/scorporati/comunicati-stampa/2026/11/11/Comunicato_52671/Allegati/62003_cs-perequazioni-pensioni.pdf" },
  stato: { label: "INPS, Stato di un pagamento", href: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.stato-di-un-pagamento.html" },
  fascicolo: { label: "INPS, Fascicolo previdenziale del cittadino", href: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.fascicolo-previdenziale-del-cittadino-50865.fascicolo-previdenziale-del-cittadino.html" },
  mobile: { label: "INPS Mobile", href: "https://www.inps.it/it/it/dettaglio-app-mobile.app-mobile.inps-mobile.html" },
};

interface Row { date: string; what: string; who: string; note?: string; src: { label: string; href: string }[]; cta?: { label: string; href: string } }
const ISEE27 = { label: "Prenota l'ISEE 2027 gratis", href: "https://link.arcanis.it/widget/booking/PcX3eqVyShnXdizbkN1G" };
const CEDOLINO = { label: "Fai controllare il cedolino", href: "/prenota" };

const ROWS: Row[] = [
  { date: "Martedì 1° dicembre", what: "Pensioni INPS: pagamento di dicembre", who: "Tutti i pensionati INPS", note: "L'INPS paga il primo giorno bancabile del mese (solo a gennaio il secondo). La tredicesima arriva di norma con la pensione di dicembre: il dettaglio lo spiega l'INPS nella notizia sul cedolino di dicembre, non ancora uscita al 24 novembre. A chi ha pensione e redditi bassi l'INPS paga d'ufficio a dicembre anche l'importo aggiuntivo di 154,94 €.", src: [SRC.pensNov, SRC.pensCs, SRC.impAgg], cta: CEDOLINO },
  { date: "Martedì 15 dicembre", what: "Assegno di Inclusione (ADI): primi pagamenti ed eventuali arretrati", who: "Chi ha appena avuto l'ADI accolto", src: [SRC.adiMsg, SRC.adiNews], cta: ISEE27 },
  { date: "Mercoledì 16 e giovedì 17 dicembre", what: "Assegno Unico: rata ordinaria di dicembre (con eventuali conguagli)", who: "Famiglie che già ricevono l'Assegno Unico e non hanno avuto variazioni", note: "L'INPS indica due giorni: la data esatta sul conto dipende da banca o Poste.", src: [SRC.auuMsg, SRC.auuNews], cta: ISEE27 },
  { date: "Mercoledì 16 dicembre", what: "Carta Dedicata a te: ultimo giorno per il primo utilizzo", who: "Chi ha ricevuto la carta nel 2026 (500 €)", note: "Non è un pagamento: se non usi la carta entro questa data, perdi la quota 2026.", src: [SRC.carta] },
  { date: "Mercoledì 23 dicembre", what: "ADI: ricariche mensili sulla carta di inclusione", who: "Chi già riceve l'ADI e ha ancora i requisiti", src: [SRC.adiMsg, SRC.adiNews], cta: ISEE27 },
  { date: "Ultima settimana di dicembre", what: "Assegno Unico: prima rata per le domande presentate a novembre", who: "Chi ha fatto domanda a novembre 2026", note: "Regola INPS: la prima rata arriva di norma nell'ultima settimana del mese dopo la domanda. Non è indicato un giorno preciso.", src: [SRC.auuMsg] },
  { date: "Dicembre 2026 (giorno non indicato)", what: "Nuovo bonus mamme 2026: pagamento in un'unica soluzione", who: "Lavoratrici con due figli (il più piccolo sotto i 10 anni) o con tre o più figli (il più piccolo sotto i 18) che hanno fatto domanda", note: "Pagamento a dicembre solo se la domanda è già stata lavorata; altrimenti da gennaio 2027. Domanda entro il 31 dicembre 2026 (31 gennaio 2027 se i requisiti maturano a dicembre, messaggio INPS 3343/2026). L'INPS non ha indicato il giorno.", src: [SRC.mamme, SRC.mammeCs] },
  { date: "Ogni mese (giorno non fissato)", what: "Supporto per la Formazione e il Lavoro (SFL): 500 € al mese con bonifico", who: "Chi partecipa ai corsi o alle attività del percorso", note: "L'INPS non indica un giorno fisso: il pagamento dipende dalla partecipazione effettiva.", src: [SRC.sfl] },
];

const NOV_ROWS: Row[] = [
  { date: "Venerdì 27 novembre", what: "ADI: ricariche mensili sulla carta di inclusione", who: "Chi già riceve l'ADI e ha ancora i requisiti", src: [SRC.adiMsg] },
  { date: "Ultima settimana di novembre", what: "Assegno Unico: prima rata per le domande presentate a ottobre", who: "Chi ha fatto domanda a ottobre 2026", src: [SRC.auuMsg] },
];

const NEXT_ROWS = [
  "Pensioni: a gennaio l'INPS paga il secondo giorno bancabile del mese, non il primo. Nel 2027 il 1° gennaio è festivo e il 2 è sabato: il giorno esatto non è ancora stato comunicato dall'INPS. Lo aggiungiamo qui appena esce.",
  "Pensioni: l'INPS ha annunciato che la rivalutazione (perequazione) sarà applicata già dalla rata di gennaio 2027 (comunicato dell'11 novembre 2026).",
  "Assegno Unico e ADI: i calendari ufficiali arrivano fino a dicembre 2026. Al 24 novembre l'INPS non ha ancora pubblicato quelli del 2027: non scriviamo date che non esistono.",
  "ISEE: quello del 2026 scade il 31 dicembre. Per l'Assegno di Inclusione serve un ISEE valido; per l'Assegno Unico, senza ISEE aggiornato l'importo scende al minimo. Se vuoi arrivare pronto, prenota ora.",
];

const FAQS = [
  { q: "Quando arriva la pensione di dicembre 2026?", a: "L'INPS paga le pensioni il primo giorno bancabile del mese, con l'eccezione di gennaio. A dicembre 2026 è martedì 1° dicembre. Se riscuoti allo sportello, controlla l'orario dell'ufficio postale." },
  { q: "Quando arriva la tredicesima?", a: "Di norma con la pensione di dicembre. L'INPS spiega il dettaglio nella notizia sul cedolino di dicembre: aggiorniamo questa pagina appena esce." },
  { q: "Chi riceve i 154,94 euro con la pensione di dicembre?", a: "È l'importo aggiuntivo previsto dall'art. 70 della legge 388/2000: l'INPS lo paga d'ufficio a dicembre a chi ha una pensione bassa e redditi entro i limiti di legge. Per il 2026 i limiti sono 11.931,08 euro per chi è solo e 23.862,15 euro con il coniuge (scheda INPS sull'importo aggiuntivo)." },
  { q: "Quando arriva l'Assegno Unico di dicembre 2026?", a: "Secondo il calendario INPS, la rata ordinaria di dicembre è pagata il 16 e il 17 dicembre. Il giorno preciso sul conto dipende da banca o Poste." },
  { q: "Ho fatto domanda di Assegno Unico a novembre: quando arriva la prima rata?", a: "Di norma nell'ultima settimana del mese dopo la domanda, quindi nell'ultima settimana di dicembre. L'INPS non indica un giorno preciso." },
  { q: "Quando arriva la ricarica dell'ADI a dicembre?", a: "I primi pagamenti con eventuali arretrati sono il 15 dicembre. Le ricariche mensili sulla carta, per chi riceve già l'ADI, sono il 23 dicembre (messaggio INPS n. 214/2026)." },
  { q: "Il bonus mamme 2026 quando viene pagato?", a: "In un'unica soluzione. Arriva a dicembre 2026 se la domanda è già stata lavorata dall'INPS, altrimenti da gennaio 2027. La domanda va presentata entro il 31 dicembre 2026 (31 gennaio 2027 se i requisiti maturano a dicembre), come indica il messaggio INPS 3343 del 20 ottobre 2026. L'INPS non ha indicato il giorno del pagamento." },
  { q: "Come so quando arriva la mia NASpI?", a: "Non abbiamo trovato un calendario unico INPS per tutti. Guarda il pagamento nel tuo Fascicolo previdenziale o nel servizio \"Stato di un pagamento\": se non lo vedi, scrivici e controlliamo la tua domanda." },
];

const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: FAQS.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
---
<BaseLayout title={SEO_TITLE} description={SEO_DESC}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <style is:global>
    .pg-row{display:grid;grid-template-columns:minmax(150px,220px) 1fr;gap:8px 24px;background:#F7F7FB;border-radius:22px;padding:20px 24px}
    .pg-date{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:20px;line-height:1.15;color:#5B3DF5}
    .pg-what{margin:0;font-weight:700;font-size:18px;line-height:1.35;color:#14142B}
    .pg-who{margin:4px 0 0;font-size:15px;line-height:1.45;color:#3F3F5A}
    .pg-note{margin:6px 0 0;font-size:15px;line-height:1.45;color:#3F3F5A}
    .pg-src{margin:8px 0 0;font-size:13px;line-height:1.5;color:#5B5B72}
    .pg-src a{color:#4B2FE0}
    @media (max-width:640px){.pg-row{grid-template-columns:1fr}}
  </style>
  <div class="lp"><div class="c36">
    <section class="c28">
      <div class="c61">
        <Breadcrumb items={[{ name: "Pagamenti INPS", href: "/pagamenti-inps" }]} />
        <span class="c26">Calendario INPS · aggiornato ogni mese</span>
        <h1 class="c34">Pagamenti INPS di {MESE}: <span class="c57">tutte le date</span></h1>
        <p class="c63">Pensioni, Assegno Unico, Assegno di Inclusione, bonus mamme. Per ogni pagamento trovi la data, chi riguarda e il documento INPS da cui arriva. Aggiornato il {AGGIORNATO}.</p>
        <div class="c60">
          <a href="/prenota" class="c18">Prenota un appuntamento</a>
          <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" class="c20">Scrivici su WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="c46" id="date">
      <h2 class="c1" style="font-size:40px">Le date di {MESE}</h2>
      <p class="c4">Sono solo date confermate dall'INPS. Quando l'INPS non indica il giorno, lo scriviamo.</p>
      <div style="display:flex;flex-direction:column;gap:14px">
        {ROWS.map((r) => (
          <div class="pg-row">
            <div class="pg-date">{r.date}</div>
            <div>
              <p class="pg-what">{r.what}</p>
              <p class="pg-who"><b>Chi riguarda:</b> {r.who}</p>
              {r.note && <p class="pg-note">{r.note}</p>}
              <p class="pg-src"><b>Fonte:</b> {r.src.map((s, i) => <>{i > 0 && " · "}<a href={s.href} target="_blank" rel="noopener">{s.label}</a></>)}</p>
              {r.cta && <a href={r.cta.href} style="display:inline-flex;margin-top:10px;padding:10px 18px;border-radius:999px;background:#5B3DF5;color:#fff;font-weight:800;text-decoration:none">{r.cta.label} →</a>}
            </div>
          </div>
        ))}
      </div>
      <p class="c4">Più dettagli: <a href="/blog/cedolino-pensione-novembre-dicembre-2026-come-leggerlo" style="font-weight:700">come leggere il cedolino della pensione</a> · <a href="/pensioni" style="font-weight:700">pensioni</a> · <a href="/assegno-unico" style="font-weight:700">Assegno Unico</a> · <a href="/adi-sfl" style="font-weight:700">ADI e SFL</a> · <a href="/naspi" style="font-weight:700">NASpI</a></p>
    </section>

    <section class="c46" style="padding-top:0">
      <div style="background:#F1EEFF;border-radius:32px;padding:32px;display:flex;flex-direction:column;gap:14px">
        <h2 class="c55">NASpI: come si sa la data</h2>
        <p class="c4">Non abbiamo trovato un calendario INPS uguale per tutti. La data dipende dalla tua domanda. La vedi nel <a href={SRC.fascicolo.href} target="_blank" rel="noopener" style="font-weight:700">Fascicolo previdenziale</a> o nel servizio <a href={SRC.stato.href} target="_blank" rel="noopener" style="font-weight:700">Stato di un pagamento</a>. Se hai fatto la domanda con noi, scrivici su WhatsApp e controlliamo. Se devi ancora farla: <a href="/naspi" style="font-weight:700">domanda NASpI</a>.</p>
      </div>
    </section>

    <section class="c46" style="padding-top:0" id="novembre">
      <h2 class="c55">Novembre 2026: le date ancora utili</h2>
      <div style="display:flex;flex-direction:column;gap:14px">
        {NOV_ROWS.map((r) => (
          <div class="pg-row">
            <div class="pg-date">{r.date}</div>
            <div>
              <p class="pg-what">{r.what}</p>
              <p class="pg-who"><b>Chi riguarda:</b> {r.who}</p>
              <p class="pg-src"><b>Fonte:</b> {r.src.map((s, i) => <>{i > 0 && " · "}<a href={s.href} target="_blank" rel="noopener">{s.label}</a></>)}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="c4">Le pensioni di novembre sono già state pagate (valuta lunedì 2 novembre). Il primo pagamento ADI di novembre era venerdì 13 novembre. La rata ordinaria dell'Assegno Unico di novembre è stata pagata il 19 e 20 novembre.</p>
    </section>

    <section class="c32" style="padding-top:8px">
      <div class="c23" style="flex:1 1 420px">
        <h2 class="c43" style="font-size:32px">Come controllare il tuo pagamento</h2>
        <ul class="c27">
          <li>Entra nel <a href={SRC.fascicolo.href} target="_blank" rel="noopener" style="font-weight:700">Fascicolo previdenziale del cittadino</a> sul sito INPS, con le tue credenziali, e apri la sezione "prestazioni": vedi i pagamenti ricevuti.</li>
          <li>Per un pagamento preciso usa <a href={SRC.stato.href} target="_blank" rel="noopener" style="font-weight:700">Stato di un pagamento</a>. Si vedono i pagamenti degli ultimi due mesi.</li>
          <li>Per la pensione guarda il <a href={SRC.pensNov.href} target="_blank" rel="noopener" style="font-weight:700">cedolino</a>: importo lordo, trattenute e netto.</li>
          <li>Dal telefono puoi usare l'app <a href={SRC.mobile.href} target="_blank" rel="noopener" style="font-weight:700">INPS Mobile</a>.</li>
        </ul>
        <p class="c83">Non hai SPID o non sai da dove partire? Ti guidiamo in ufficio o in videochiamata.</p>
      </div>
      <div class="c45" style="flex:1 1 320px">
        <h2 class="c43" style="font-size:32px">Pagamento non arrivato? Cosa fare</h2>
        <ol class="c27" style="padding-left:20px;list-style:decimal">
          <li>Controlla che la data prevista sia davvero passata (vedi la tabella sopra).</li>
          <li>Guarda lo stato nel Fascicolo o in "Stato di un pagamento".</li>
          <li>Verifica che l'IBAN sul conto sia quello giusto e che non sia cambiato.</li>
          <li>Se non trovi la causa, <b>prenota un appuntamento</b>: guardiamo la tua pratica e ti diciamo cosa chiedere all'INPS.</li>
        </ol>
        <a href="/prenota" style="align-self:flex-start;display:inline-flex;padding:14px 22px;border-radius:999px;background:#14142B;color:#fff;font-weight:800;text-decoration:none">Prenota un appuntamento</a>
        <p class="c84" style="font-size:14px">Contact Center INPS: 803 164 (gratuito da rete fissa) o 06 164 164 da cellulare.</p>
      </div>
    </section>

    <section class="c46" style="padding-top:0" id="prossimo-mese">
      <h2 class="c55">Il mese prossimo: gennaio 2027</h2>
      <ul class="c4" style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px">
        {NEXT_ROWS.map((t) => <li>{t}</li>)}
      </ul>
      <p class="c4">Vuoi prepararti al rinnovo? <a href="/isee" style="font-weight:700">ISEE gratuito in ufficio</a>.</p>
    </section>

    <section class="c46" style="padding-top:0" id="faq">
      <h2 class="c1" style="font-size:36px">Domande frequenti</h2>
      <div style="display:flex;flex-direction:column;gap:10px">
        {FAQS.map((f) => (
          <details style="background:#F7F7FB;border-radius:18px;padding:16px 20px">
            <summary class="c16" style="cursor:pointer">{f.q}</summary>
            <p class="c6">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="c47" id="fonti">
      <h2 class="c55">Fonti ufficiali</h2>
      <p class="c4"><b>Aggiornato il {AGGIORNATO}.</b> Le date sono quelle pubblicate dall'INPS. Possono cambiare: se l'INPS le modifica, aggiorniamo questa pagina. Le testate giornalistiche le usiamo solo come riscontro.</p>
      <ul class="c4" style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px">
        {[SRC.pensNov, SRC.pensCs, SRC.impAgg, SRC.pereq, SRC.auuNews, SRC.auuMsg, SRC.adiNews, SRC.adiMsg, SRC.sfl, SRC.mamme, SRC.mammeCs, SRC.carta, SRC.stato, SRC.fascicolo].map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="c4">Hai un dubbio sul tuo caso? <a href={BOOKING.arcanisGroup} style="font-weight:700">Prenota un appuntamento</a> o <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="font-weight:700">scrivici su WhatsApp</a>. Centro Pratiche Flaiano, CAF UNSIC e Patronato ENASC, Via Filoteo Alberini 25 int. 10, Roma Vigne Nuove.</p>
    </section>
  </div></div>
</BaseLayout>
