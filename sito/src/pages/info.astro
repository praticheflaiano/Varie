---
/**
 * Biglietto da visita digitale: e la pagina dei QR stampati (prima su GHL a praticheflaiano.it/info).
 * Il modulo "Lasciaci i tuoi dati" e lo stesso modulo GHL di prima (REGISTRAZIONE ANAGRAFICA pratiche-online),
 * quindi i contatti arrivano nel CRM come oggi.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { CONTACT, BOOKING, SOCIAL, REVIEWS } from "~/consts";
const REMOTE = "https://link.arcanis.it/widget/bookings/consulenza_da_remoto";
const FORM_ID = "SIpBJREup0FjgpDAlprn";
const waText = encodeURIComponent("Buongiorno, vi scrivo dal vostro biglietto da visita. Vorrei informazioni su: ");
const actions = [
  { href: `tel:${CONTACT.phone.landlineRaw}`, label: "Chiama", sub: "06 9784 5429", tone: "ink" },
  { href: `${CONTACT.whatsapp.link}?text=${waText}`, label: "WhatsApp", sub: "371 623 0690", tone: "wa", ext: true },
  { href: BOOKING.arcanisGroup, label: "Prenota", sub: "in ufficio", tone: "accent", ext: true },
  { href: REMOTE, label: "A distanza", sub: "video o telefono", tone: "light", ext: true },
  { href: "/contatto.vcf", label: "Salva contatto", sub: "in rubrica", tone: "lime", download: true },
  { href: CONTACT.mapsUrl, label: "Indicazioni", sub: "apri Maps", tone: "light", ext: true },
];
const hours = [
  { d: "Lunedì", h: "9:30–13:00 · 15:30–18:00", i: 1 },
  { d: "Martedì", h: "9:30–13:00 · 15:30–18:00", i: 2 },
  { d: "Mercoledì", h: "9:30–13:00 · 15:30–18:00", i: 3 },
  { d: "Giovedì", h: "9:30–13:00 · 15:30–18:00", i: 4 },
  { d: "Venerdì", h: "9:30–14:00 orario continuato", i: 5 },
  { d: "Sabato e domenica", h: "chiuso", i: 6 },
];
---
<BaseLayout title="Contatti e orari CAF Bufalotta – Centro Pratiche Flaiano" description="Biglietto da visita del Centro Pratiche Flaiano, CAF e Patronato a Vigne Nuove e Bufalotta: chiama, scrivi su WhatsApp, prenota, salva il contatto e lasciaci i tuoi dati." hideWhatsAppFab={true}>
  <section class="bc">
    <div class="bc-card">
      <div class="bc-head">
        <span class="bc-logo" aria-hidden="true">F</span>
        <div class="bc-id">
          <h1>Centro Pratiche Flaiano</h1>
          <p>CAF UNSIC · Patronato ENASC · Servizi</p>
        </div>
      </div>
      <div class="bc-meta">
        <span class="bc-open" id="bc-open">Orari qui sotto</span>
        <a class="bc-rating" href={CONTACT.mapsUrl} target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span> {REVIEWS.rating} su Google · {REVIEWS.label}</a>
      </div>
      <div class="bc-grid">
        {actions.map((a) => (
          <a class={`bc-btn t-${a.tone}`} href={a.href} target={a.ext ? "_blank" : undefined} rel={a.ext ? "noopener" : undefined} download={a.download ? "Centro-Pratiche-Flaiano.vcf" : undefined}>
            <b>{a.label}</b><span>{a.sub}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="bc-cols">
      <div class="bc-box">
        <h2>Dove siamo</h2>
        <p class="bc-addr">Via Filoteo Alberini 25, int. 10<br />00139 Roma</p>
        <p class="bc-note">Dentro il Centro Acquisti Flaiano, tra Vigne Nuove e Bufalotta. Comodo da Porta di Roma, Tufello e Labaro.</p>
        <a class="bc-link" href={CONTACT.mapsUrl} target="_blank" rel="noopener">Apri in Google Maps ↗</a>
      </div>
      <div class="bc-box">
        <h2>Orari</h2>
        <ul class="bc-hours" id="bc-hours">
          {hours.map((r) => (<li data-day={r.i}><span>{r.d}</span><span>{r.h}</span></li>))}
        </ul>
      </div>
    </div>

    <div class="bc-box bc-form">
      <h2>Lasciaci i tuoi dati</h2>
      <p class="bc-note">Ti registriamo come cliente: così le prossime pratiche partono più veloci e ti avvisiamo delle scadenze che ti riguardano.</p>
      <iframe src={`https://link.arcanis.it/widget/form/${FORM_ID}`} id={`inline-${FORM_ID}`} title="Registrazione anagrafica" loading="lazy" style="width:100%;height:1040px;border:none;border-radius:16px" data-layout="{'id':'INLINE'}" data-trigger-type="alwaysShow" data-activation-type="alwaysActivated" data-deactivation-type="neverDeactivate" data-form-name="REGISTRAZIONE ANAGRAFICA pratiche-online" data-height="1040" data-layout-iframe-id={`inline-${FORM_ID}`} data-form-id={FORM_ID}></iframe>
    </div>

    <div class="bc-links">
      <a href="/servizi">Tutti i servizi</a>
      <a href="/tesseramento">Tessera</a>
      <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
      <a href={SOCIAL.whatsappChannel} target="_blank" rel="noopener">Canale WhatsApp</a>
      <span class="bc-mail">{CONTACT.email}</span>
    </div>
  </section>
  <script is:inline src="https://link.arcanis.it/js/form_embed.js"></script>
  <script is:inline>
    (function () {
      try {
        var parts = new Intl.DateTimeFormat("it-IT", { timeZone: "Europe/Rome", weekday: "short", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
        var get = function (t) { var p = parts.find(function (x) { return x.type === t; }); return p ? p.value : ""; };
        var map = { lun: 1, mar: 2, mer: 3, gio: 4, ven: 5, sab: 6, dom: 0 };
        var day = map[get("weekday").toLowerCase().slice(0, 3)];
        var m = parseInt(get("hour"), 10) * 60 + parseInt(get("minute"), 10);
        var slots = day >= 1 && day <= 4 ? [[570, 780], [930, 1080]] : day === 5 ? [[570, 840]] : [];
        var open = slots.some(function (s) { return m >= s[0] && m < s[1]; });
        var el = document.getElementById("bc-open");
        if (el) { el.textContent = open ? "Aperto ora" : "Chiuso ora"; el.classList.add(open ? "is-open" : "is-closed"); }
        var li = document.querySelector('#bc-hours li[data-day="' + (day === 0 ? 6 : day) + '"]');
        if (li) li.classList.add("is-today");
      } catch (e) {}
    })();
  </script>
</BaseLayout>

<style is:global>
  .bc { max-width: 760px; margin: 0 auto; padding: 24px 16px 64px; display: flex; flex-direction: column; gap: 20px; color: #14142B; }
  .bc-card { background: #14142B; color: #fff; border-radius: 32px; padding: 26px; display: flex; flex-direction: column; gap: 18px; box-shadow: 0 10px 0 #5B3DF5; }
  .bc-head { display: flex; align-items: center; gap: 14px; }
  .bc-logo { flex: none; width: 64px; height: 64px; border-radius: 18px; background: #D4FF4F; color: #14142B; display: flex; align-items: center; justify-content: center; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 36px; transform: rotate(-4deg); }
  .bc-id { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .bc .bc-card .bc-id h1 { color: #fff; margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(26px, 6vw, 36px); line-height: 1.02; letter-spacing: -0.02em; text-wrap: balance; }
  .bc-id p { margin: 0; color: #C9C3FF; font-size: 15px; font-weight: 600; }
  .bc-meta { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
  .bc-open { background: #2B2A4A; color: #fff; border-radius: 999px; padding: 6px 12px; font-size: 14px; font-weight: 800; }
  .bc-open.is-open { background: #D4FF4F; color: #14142B; }
  .bc-open.is-closed { background: #FF5C8A; color: #fff; }
  .bc-rating { color: #fff; text-decoration: none; font-size: 14px; font-weight: 600; }
  .bc-rating span { color: #F5B400; letter-spacing: 1px; }
  .bc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 620px) { .bc-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .bc-btn { display: flex; flex-direction: column; gap: 2px; padding: 16px; border-radius: 20px; text-decoration: none; min-height: 72px; justify-content: center; transition: transform .15s ease; }
  .bc-btn:hover { transform: translateY(-2px); }
  .bc-btn:focus-visible { outline: 3px solid #D4FF4F; outline-offset: 2px; }
  .bc-btn b { font-family: 'Bricolage Grotesque', sans-serif; font-size: 20px; font-weight: 800; line-height: 1.1; }
  .bc-btn span { font-size: 14px; opacity: .85; }
  .t-ink { background: #fff; color: #14142B; }
  .t-wa { background: #25D366; color: #0B2A16; }
  .t-accent { background: #5B3DF5; color: #fff; }
  .t-light { background: #2B2A4A; color: #fff; }
  .t-lime { background: #D4FF4F; color: #14142B; }
  .bc-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
  .bc-box { background: #F1EEFF; border-radius: 28px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .bc-box h2 { margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 24px; }
  .bc-addr { margin: 0; font-size: 19px; font-weight: 700; line-height: 1.35; }
  .bc-note { margin: 0; font-size: 15px; line-height: 1.5; color: #3F3F5A; }
  .bc-link { align-self: flex-start; color: #4B2FE0; font-weight: 800; text-decoration: none; }
  .bc-hours { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .bc-hours li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 10px; border-radius: 12px; }
  .bc-hours li span:first-child { font-weight: 700; }
  .bc-hours li span:last-child { text-align: right; color: #3F3F5A; }
  .bc-hours li.is-today { background: #14142B; color: #fff; }
  .bc-hours li.is-today span:last-child { color: #D4FF4F; }
  .bc-form { background: #fff; border: 2px solid #14142B; }
  .bc-links { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; font-size: 15px; }
  .bc-links a { color: #14142B; font-weight: 700; text-decoration: none; border: 2px solid #14142B; border-radius: 999px; padding: 8px 14px; }
  .bc-mail { width: 100%; text-align: center; color: #5B5B72; user-select: all; }
  @media (prefers-reduced-motion: reduce) { .bc-btn { transition: none; } }
</style>
