---
import AltriCalcolatori from "~/components/tools/AltriCalcolatori.astro";
import PageAside from "~/components/layout/PageAside.astro";
import "~/styles/calcolatori-larghi.css";
/**
 * Calcolo congedo parentale. Regole e numeri SOLO da fonti ufficiali (verificate il 24/11/2026):
 * - INPS, scheda "Indennità di congedo parentale per lavoratrici e lavoratori dipendenti" (agg. 16/06/2026):
 *   limiti 6 mesi madre, 6 (7) padre, 10 (11) coppia, 11 genitore solo; 9 mesi indennizzati (3+3+3); 30%; 80% per 3 mesi entro i 6 anni;
 *   entro i 14 anni (legge 199/2025, art. 1, c. 219; messaggio INPS 251 del 26/01/2026).
 * - INPS, schemi 2026 "ripartizione periodi indennizzabili" e "mesi indennizzabili all'80%" (1, 2 o 3 mesi secondo la fine di maternità/paternità).
 * - INPS, circolare 47 del 21/04/2026: limite di reddito 2026 = 19.885,13 € (2,5 volte il trattamento minimo).
 * - INPS, scheda Gestione separata (agg. 13/10/2026): 3+3+3 mesi, entro 12 anni, 30% di 1/365 del reddito.
 * - INPS, scheda lavoratori autonomi (agg. 13/07/2026): 3 mesi a genitore entro il primo anno, 30% della retribuzione convenzionale.
 * Il risultato è una stima: i contatori ufficiali sono nel servizio INPS "Domande di maternità e paternità".
 */
import BaseLayout from "~/layouts/BaseLayout.astro";

const LIMITE_REDDITO = "19.885,13";
const faqs = [
  { q: "Quanti mesi di congedo parentale spettano?", a: "Ai lavoratori dipendenti: fino a 6 mesi alla madre, fino a 6 al padre (7 se ne prende almeno 3), con un massimo di 10 mesi in due (11 se il padre ne prende almeno 3). Al genitore solo fino a 11 mesi. Si possono usare entro i 14 anni del figlio." },
  { q: "Quanto viene pagato il congedo parentale?", a: "Per i dipendenti sono pagati 9 mesi in tutto tra i due genitori: fino a 3 mesi all'80% della retribuzione se usati entro i 6 anni del figlio, gli altri al 30%. Oltre i 9 mesi il 30% spetta solo se il reddito personale è sotto 19.885,13 € (valore 2026)." },
  { q: "A chi spettano i tre mesi all'80%?", a: "Solo ai lavoratori dipendenti. Sono 3 se la maternità o la paternità obbligatoria è finita dopo il 31 dicembre 2024, 2 se è finita dopo il 31 dicembre 2023, 1 se è finita dopo il 31 dicembre 2022. Si dividono tra i genitori oppure li usa uno solo." },
  { q: "Il calcolatore è preciso?", a: "È una stima sulle regole INPS. L'importo vero dipende dalla retribuzione del mese prima del congedo e dai contatori INPS: per il conteggio esatto possiamo verificarlo insieme." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo congedo parentale", url: "https://praticheflaiano.it/calcolo-congedo-parentale", applicationCategory: "FinanceApplication", operatingSystem: "Web", isAccessibleForFree: true, inLanguage: "it", offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" } });
const H2 = "margin:24px 0 0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(28px,5vw,40px);line-height:1.05;color:#14142B";
const TD = "padding:10px;border-top:1px solid #E4E0FF";
const TH = "text-align:left;padding:10px;background:#14142B;color:#fff";
---

<BaseLayout title="Calcolo congedo parentale: mesi e quanto ti pagano" description="Calcola il congedo parentale: quanti mesi ti restano, quanti all'80% e quanti al 30%, fino a quando puoi usarli e quanto prendi. Dipendenti, Gestione separata, autonomi.">
  <script slot="head" type="application/ld+json" set:html={appLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <!-- Da 1200 px: titolo largo, strumento, testo e colonna laterale (calcolatori-larghi.css) -->
  <div class="cl">
  <section class="cl-hero" style="background:#F1EEFF">
    <div class="cl-hero-in" style="max-width:1120px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:18px">
      <div class="ps-head cl-head">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Calcolatore gratuito · regole INPS 2026</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Congedo parentale: quanti mesi e quanti soldi?</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A;max-width:780px">Rispondi a poche domande: ti diciamo <b>quanti mesi ti restano</b>, quanti sono pagati all'<b>80%</b> e quanti al <b>30%</b>, <b>fino a quando</b> puoi usarli e <b>quanto prendi</b>.</p>
      </div>

      <form id="cp" class="ps-tool" onsubmit="return false" novalidate style="background:#fff;border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:20px;box-shadow:0 6px 0 #14142B;max-width:780px">
        <fieldset class="cp-f"><legend>1. Che lavoro fai?</legend>
          <label class="cp-o cp-card"><input type="radio" name="cat" value="dip" checked> <span><b>Dipendente</b><br><small>Hai una busta paga, nel privato o nel pubblico</small></span></label>
          <label class="cp-o cp-card"><input type="radio" name="cat" value="gs"> <span><b>Gestione separata</b><br><small>Collaboratore o professionista senza una cassa</small></span></label>
          <label class="cp-o cp-card"><input type="radio" name="cat" value="aut"> <span><b>Autonomo</b><br><small>Artigiano, commerciante, agricolo</small></span></label>
          <label class="cp-o cp-card"><input type="radio" name="cat" value="no"> <span><b>Altro</b><br><small>Colf o badante, lavoro a domicilio, oppure non lavoro</small></span></label>
        </fieldset>

        <fieldset class="cp-f"><legend>2. Sei la mamma o il papà?</legend>
          <label class="cp-o"><input type="radio" name="ruolo" value="madre" checked> Mamma</label>
          <label class="cp-o"><input type="radio" name="ruolo" value="padre"> Papà</label>
          <label class="cp-o" style="display:flex"><input type="checkbox" id="cp-solo"> <span>Sono un genitore solo <small>(l'altro genitore non c'è, oppure ho l'affidamento esclusivo)</small></span></label>
        </fieldset>

        <label class="cp-l" for="cp-nasc"><span id="cp-nasc-l">3. Quando è nato tuo figlio?</span>
          <input id="cp-nasc" type="date" class="cp-in" style="max-width:220px">
          <span class="cp-o" style="margin-top:4px"><input type="checkbox" id="cp-adoz"> <span>È un'adozione o un affidamento <small>(metti il giorno in cui è entrato in famiglia)</small></span></span></label>

        <fieldset class="cp-f" id="cp-fine-box" style="display:none"><legend id="cp-fine-l">La maternità (o la paternità obbligatoria) è finita dopo il 31 dicembre?</legend>
          <label class="cp-o"><input type="radio" name="fine" value="si"> Sì</label>
          <label class="cp-o"><input type="radio" name="fine" value="no" checked> No</label>
          <label class="cp-o"><input type="radio" name="fine" value="boh"> Non lo so</label>
          <small style="display:block;color:#5B5B72">Serve per capire quanti mesi all'80% ti spettano.</small>
        </fieldset>

        <fieldset class="cp-f"><legend>4. Avete già usato il congedo parentale per questo figlio?</legend>
          <label class="cp-o"><input type="radio" name="usato" value="no" checked> No, mai</label>
          <label class="cp-o"><input type="radio" name="usato" value="si"> Sì</label>
          <div id="cp-usati" style="display:none;flex-wrap:wrap;gap:12px;margin-top:6px">
            <label class="cp-l" for="cp-io" style="flex:1 1 150px">Mesi usati da te<input id="cp-io" type="number" min="0" max="11" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
            <label class="cp-l cp-coppia" for="cp-altro" style="flex:1 1 150px">Mesi usati dall'altro genitore<input id="cp-altro" type="number" min="0" max="11" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
            <label class="cp-l cp-dip" for="cp-u80" style="flex:1 1 150px">Quanti di questi pagati all'80%?<input id="cp-u80" type="number" min="0" max="3" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
            <small style="flex:1 1 100%;color:#5B5B72">Mezzo mese si scrive 0,5. Se hai usato dei giorni, 30 giorni sono 1 mese.</small>
          </div>
        </fieldset>

        <label class="cp-l cp-dip" for="cp-ral">5. Quanto guadagni al mese, lordo? <small style="font-weight:400">(facoltativo: serve per calcolare i soldi)</small>
          <input id="cp-ral" type="number" min="0" step="1" inputmode="decimal" placeholder="es. 1800" class="cp-in" style="max-width:220px">
          <span class="cp-o" style="margin-top:4px"><input type="checkbox" id="cp-basso"> <span>In un anno guadagno meno di {LIMITE_REDDITO} € lordi</span></span></label>

        <label class="cp-l cp-gs" for="cp-red" style="display:none">5. Quanto hai guadagnato negli ultimi 12 mesi? <small style="font-weight:400">(reddito in Gestione separata, facoltativo)</small>
          <input id="cp-red" type="number" min="0" step="1" inputmode="decimal" placeholder="es. 20000" class="cp-in" style="max-width:220px"></label>

        <label class="cp-l cp-conta" for="cp-voglio"><span id="cp-voglio-l">6. Quanti mesi vuoi prendere adesso?</span> <small style="font-weight:400">(facoltativo: se lo lasci vuoto ti mostriamo tutti i mesi che hai)</small>
          <input id="cp-voglio" type="number" min="0.5" max="11" step="0.5" inputmode="decimal" placeholder="es. 2" class="cp-in" style="max-width:160px"></label>

        <button id="cp-b" type="button" style="align-self:flex-start;background:#5B3DF5;color:#fff;font-weight:800;border:0;border-radius:999px;padding:14px 26px;font-size:17px;cursor:pointer">Calcola</button>
        <div id="cp-out" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section class="ps-main" style="max-width:860px;margin:0 auto;padding:48px 16px 64px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#2A2A40">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: 24 novembre 2026.</b> Regole in vigore nel 2026 (schede e messaggi INPS).</p>

    <a href="/blog/congedo-parentale-guida-mesi-80-per-cento-domanda" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16l-8-4-8 4z"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Leggi la guida completa al congedo parentale</span><span class="cta-tool-s">Tutte le regole spiegate semplici, con esempi</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <a href="/calcolo-maternita-congedi" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 18h8"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Aspetti un bambino? Calcola anche la maternità</span><span class="cta-tool-s">Il calendario completo: maternità, paternità e congedo parentale</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <h2 style={H2}>Le regole in una tabella</h2>
    <div style="overflow-x:auto" tabindex="0"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Chi</th><th style={TH}>Mesi</th><th style={TH}>Entro</th><th style={TH}>Quanto</th></tr></thead>
      <tbody>
        <tr><td style={TD}><b>Dipendenti</b></td><td style={TD}>madre 6, padre 6 (7), in due 10 (11); genitore solo 11</td><td style={TD}>14 anni del figlio</td><td style={TD}>9 mesi pagati: fino a 3 all'80% (entro i 6 anni), gli altri al 30%</td></tr>
        <tr><td style={TD}><b>Gestione separata</b></td><td style={TD}>3 a testa + 3 da dividere (9 in due)</td><td style={TD}>12 anni del figlio</td><td style={TD}>30% del reddito</td></tr>
        <tr><td style={TD}><b>Autonomi</b></td><td style={TD}>3 a testa</td><td style={TD}>1 anno del figlio</td><td style={TD}>30% della retribuzione convenzionale</td></tr>
      </tbody>
    </table></div>

    <h2 style={H2}>Vuoi che lo facciamo noi?</h2>
    <p style="margin:0">Come patronato controlliamo i mesi che ti restano sui contatori INPS e inviamo la domanda. La domanda va fatta <b>prima</b> di iniziare il congedo.</p>
    <a href="/prenota" class="cta-tool" style="margin-top:6px"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota un appuntamento</span><span class="cta-tool-s">In ufficio a Vigne Nuove o in videochiamata</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <h2 style={H2}>Domande frequenti</h2>
    {faqs.map((f) => (
      <details style="background:#F7F7FB;border-radius:18px;padding:16px 20px"><summary style="font-weight:800;cursor:pointer">{f.q}</summary><p style="margin:10px 0 0">{f.a}</p></details>
    ))}
    <p style="margin:12px 0 0;font-size:14px;color:#5B5B72">Fonti: INPS, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50583.indennit-di-congedo-parentale-per-lavoratrici-e-lavoratori-dipendenti.html" target="_blank" rel="noopener">scheda congedo parentale dipendenti</a>, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50290.indennit-per-congedo-parentale-per-lavoratrici-e-lavoratori-iscritti-alla-gestione-separata.html" target="_blank" rel="noopener">scheda Gestione separata</a>, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.indennit-per-congedo-parentale-per-lavoratori-e-lavoratrici-autonome-50291.indennit-per-congedo-parentale-per-lavoratori-e-lavoratrici-autonome.html" target="_blank" rel="noopener">scheda autonomi</a>, <a href="https://www.inps.it/content/dam/inps-site/pdf/allegati/2026/Schema_ripartizione_mesi_congedo_parentale_indennizzabili_80.pdf" target="_blank" rel="noopener">schema dei mesi all'80%</a>; messaggio INPS n. 251 del 26 gennaio 2026; circolare INPS n. 47 del 21 aprile 2026; D.Lgs. 151/2001, artt. 32-36. Il calcolatore dà una stima e non sostituisce i contatori INPS.</p>
  </section>

  <style is:global>
    #cp-out{scroll-margin-top:90px}
    .cp-f{border:0;padding:0;margin:0}
    .cp-f legend{font-weight:800;margin-bottom:8px}
    .cp-l{display:flex;flex-direction:column;gap:6px;font-weight:800}
    .cp-in{border:2px solid #14142B;border-radius:14px;padding:11px 12px;font-size:17px;background:#fff;width:100%;max-width:100%;font-weight:400}
    .cp-o{display:inline-flex;align-items:flex-start;gap:8px;margin:0 16px 8px 0;font-size:16px;cursor:pointer;font-weight:400}
    .cp-o input{width:20px;height:20px;accent-color:#5B3DF5;flex:none;margin-top:2px}
    .cp-card{display:flex;border:2px solid #E4E0FF;border-radius:16px;padding:10px 12px;margin:0 0 8px}
    .cp-card:has(input:checked){border-color:#5B3DF5;background:#F1EEFF}
    .cp-o small,.cp-l small{color:#5B5B72}
    .cp-res{border-radius:20px;padding:18px 20px;line-height:1.5;margin-top:4px}
    .cp-ok{background:#D4FF4F;color:#14142B}
    .cp-warn{background:#FFF4D6;color:#14142B}
    .cp-res b.big{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:38px;line-height:1.05;margin:4px 0}
    .cp-res table{border-collapse:collapse;margin-top:8px;font-size:15px;width:100%}
    .cp-res td{padding:4px 8px 4px 0;vertical-align:top}
    .cp-res a{color:#14142B;font-weight:800;text-decoration:underline}
  </style>
  <script is:inline define:vars={{ LIMITE_REDDITO }}>
  (function(){
    var $=function(i){return document.getElementById(i)};
    var radio=function(n){return document.querySelector('input[name='+n+']:checked').value};
    var eur=function(n){var p=(Math.round(n*100)/100).toFixed(2).split('.');return p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1]+' €'};
    var mesi=function(n){n=Math.round(n*2)/2;var s=String(n).replace('.',',');return s+(n===1?' mese':' mesi')};
    var num=function(i){var v=parseFloat(String($(i).value).replace(',','.'));return v>=0?v:0};
    var dataIt=function(d){return d.toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric'})};
    var piu=function(d,anni){var x=new Date(d.getTime());x.setFullYear(x.getFullYear()+anni);return x};
    var nascita=function(){return $('cp-nasc').value?new Date($('cp-nasc').value+'T00:00:00'):null};
    function vista(){
      var c=radio('cat'),solo=$('cp-solo').checked,n=nascita(),y=n?n.getFullYear():0;
      [].forEach.call(document.querySelectorAll('.cp-dip'),function(e){e.style.display=c==='dip'?'':'none'});
      [].forEach.call(document.querySelectorAll('.cp-gs'),function(e){e.style.display=c==='gs'?'':'none'});
      [].forEach.call(document.querySelectorAll('.cp-coppia'),function(e){e.style.display=solo?'none':''});
      [].forEach.call(document.querySelectorAll('.cp-conta'),function(e){e.style.display=c==='no'?'none':''});
      $('cp-usati').style.display=radio('usato')==='si'?'flex':'none';
      $('cp-nasc-l').textContent=$('cp-adoz').checked?'3. Quando è entrato in famiglia?':'3. Quando è nato tuo figlio?';
      var serve=c==='dip'&&y>=2022&&y<=2024;
      $('cp-fine-box').style.display=serve?'':'none';
      if(serve)$('cp-fine-l').textContent='La maternità (o la paternità obbligatoria) è finita dopo il 31 dicembre '+y+'?';
      $('cp-voglio-l').textContent=(c==='dip'||c==='gs'?'6':'5')+'. Quanti mesi vuoi prendere adesso?';
    }
    $('cp').addEventListener('change',vista);vista();
    var cta='<p style="margin:10px 0 0">Vuoi il conteggio esatto e la domanda fatta da noi? <a href="/prenota">Prenota un appuntamento</a>.</p>';
    function show(c,h){$('cp-out').innerHTML='<div class="cp-res '+c+'">'+h+'</div>';$('cp-out').scrollIntoView({behavior:'smooth',block:'nearest'})}
    function lista(t,a){return a.length?'<p style="margin:12px 0 0;font-weight:800">'+t+'</p><ul style="margin:4px 0 0;padding-left:20px">'+a.map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul>':''}
    function riga(a,b,c){return '<tr><td>'+a+'</td><td style="text-align:right;white-space:nowrap"><b>'+b+'</b></td>'+(c!==undefined?'<td style="text-align:right;white-space:nowrap">'+c+'</td>':'')+'</tr>'}
    $('cp-b').onclick=function(){
      var cat=radio('cat'),padre=radio('ruolo')==='padre',solo=$('cp-solo').checked,adoz=$('cp-adoz').checked;
      if(cat==='no'){show('cp-warn','<b>Il congedo parentale non ti spetta.</b> Non è previsto per colf e badanti, per chi lavora a domicilio e per chi non ha un lavoro in corso.<br>Possono spettarti altri aiuti: Assegno Unico, bonus nido, bonus nuovi nati.'+cta);return}
      var nasc=nascita();
      if(!nasc){show('cp-warn','Scrivi la data '+(adoz?'in cui è entrato in famiglia.':'di nascita di tuo figlio.'));return}
      var oggi=new Date();oggi.setHours(0,0,0,0);
      if(nasc>oggi){show('cp-warn','La data è nel futuro. Il congedo parentale parte dopo la nascita: per la mamma, dopo la maternità obbligatoria.');return}
      var usato=radio('usato')==='si',io=usato?num('cp-io'):0,altro=usato&&!solo?num('cp-altro'):0,voglio=num('cp-voglio'),sapere=[],fare=[];
      var anni=cat==='dip'?14:cat==='gs'?12:1,fine=piu(nasc,anni);
      var cosa=adoz?"dall'ingresso in famiglia":'di tuo figlio';
      if(oggi>=fine){show('cp-warn','<b>Il tempo è scaduto.</b> Con il tuo lavoro il congedo parentale si può usare entro '+(anni===1?'il primo anno':'i '+anni+' anni')+' '+cosa+': il termine era il '+dataIt(fine)+'.'+cta);return}
      if(adoz) sapere.push('Con adozione o affidamento il congedo non può andare oltre i 18 anni del ragazzo.');
      if(!padre&&!adoz&&oggi<new Date(nasc.getTime()+91*864e5)) sapere.push('Per la mamma il congedo parentale inizia <b>dopo</b> la maternità obbligatoria.');
      fare.push('Fai la domanda all\u2019INPS <b>prima</b> di iniziare: se arriva dopo, vengono pagati solo i giorni successivi.');

      if(cat==='aut'){
        var rA=Math.max(0,3-io);
        if(!rA){show('cp-warn','<b>Hai già usato i tuoi 3 mesi.</b> A ogni genitore autonomo spettano 3 mesi per figlio.'+cta);return}
        var pA=voglio?Math.min(voglio,rA):rA;
        sapere.push('Sei pagato il <b>30%</b> di una retribuzione fissata per legge per la tua categoria (non del tuo guadagno reale).');
        sapere.push('Devi aver pagato i contributi del mese prima e non lavorare davvero in quei giorni.');
        if(!solo) sapere.push('Anche l\u2019altro genitore ha i suoi mesi, con le regole del suo lavoro.');
        show('cp-ok','Ti restano<b class="big">'+mesi(rA)+'</b>da usare entro il <b>'+dataIt(fine)+'</b> (primo anno '+cosa+').<table>'+(voglio?riga('Mesi che vuoi prendere ora',mesi(pA)):'')+riga('Pagati al 30%',mesi(pA))+'</table>'+lista('Da sapere',sapere)+lista('Cosa fare',fare)+cta);return;
      }

      var maxPag=solo&&cat==='dip'?9:6-Math.max(0,Math.min(altro,6)-3);
      if(cat==='gs'){
        var rG=Math.max(0,maxPag-io),red=num('cp-red');
        if(!rG){show('cp-warn','<b>Non ti restano mesi.</b> In Gestione separata spettano 3 mesi a testa più 3 a scelta: 9 in tutto tra i due genitori.'+cta);return}
        var pG=voglio?Math.min(voglio,rG):rG;
        if(voglio>rG) sapere.push('Hai chiesto '+mesi(voglio)+', ma te ne restano '+mesi(rG)+'.');
        if(solo) sapere.push('Sei un genitore solo: per te i mesi potrebbero essere di più. Chiedici una verifica.');
        sapere.push('L\u201980% non è previsto in Gestione separata: tutti i mesi sono al 30%.');
        sapere.push('Serve almeno 1 mese di contributi negli ultimi 12 mesi, un lavoro in corso e non lavorare davvero in quei giorni.');
        sapere.push('Si prende a mesi o a giorni, non a ore.');
        var tG='<table>'+(voglio?riga('Mesi che vuoi prendere ora',mesi(pG)):'')+riga('Pagati al 30%',mesi(pG),red?eur(red*0.3/12)+' al mese':undefined)+(red?riga('In tutto, circa','',eur(red*0.3/12*pG)):'')+'</table>';
        show('cp-ok','Ti restano<b class="big">'+mesi(rG)+'</b>da usare entro il <b>'+dataIt(fine)+'</b> (12 anni '+cosa+').'+tG+lista('Da sapere',sapere)+lista('Cosa fare',fare)+(red?'<p style="margin:10px 0 0;font-size:14px">Importi lordi stimati.</p>':'')+cta);return;
      }

      // Dipendenti
      var indiv=6,coppia=10;
      if(solo){indiv=11;coppia=11}
      else if(padre){if(Math.min(7-io,11-io-altro)+io>=3){indiv=7;coppia=11}}
      else if(altro>=3){coppia=11}
      var resta=Math.max(0,Math.min(indiv-io,coppia-io-altro));
      if(!resta){show('cp-warn','<b>Non ti restano mesi di congedo parentale</b> per questo figlio. Il limite è '+(solo?'11 mesi per il genitore solo':'6 mesi per la mamma, 6 per il papà (7 se ne prende almeno 3) e 10 in due (11 se il papà ne prende almeno 3)')+'.'+cta);return}
      var prendo=voglio?Math.min(voglio,resta):resta;
      if(voglio>resta) sapere.push('Hai chiesto '+mesi(voglio)+', ma te ne restano '+mesi(resta)+'.');
      var y=nasc.getFullYear(),quota=y>=2025?3:y===2024?2:y===2023?1:0,f=radio('fine');
      if(y>=2022&&y<=2024){if(f==='si')quota+=1;if(f==='boh')sapere.push('Non sai quando è finita la maternità: i mesi all\u201980% potrebbero essere uno in più. Possiamo controllarlo noi.')}
      var sei=piu(nasc,6),entro6=oggi<sei,u80=usato?Math.min(num('cp-u80'),quota):0;
      var m80=entro6?Math.max(0,Math.min(quota-u80,Math.max(0,3-io),prendo)):0;
      var pagRest=Math.max(0,maxPag-io);
      var m30=Math.max(0,Math.min(prendo-m80,pagRest-m80));
      var extra=Math.max(0,prendo-m80-m30),basso=$('cp-basso').checked,R=num('cp-ral'),tot=0,tab='<table>';
      if(voglio) tab+=riga('Mesi che vuoi prendere ora',mesi(prendo),R?'':undefined);
      if(m80){tot+=R*0.8*m80;tab+=riga('Pagati all\u201980%',mesi(m80),R?eur(R*0.8)+' al mese':undefined)}
      if(m30){tot+=R*0.3*m30;tab+=riga('Pagati al 30%',mesi(m30),R?eur(R*0.3)+' al mese':undefined)}
      if(extra){if(basso)tot+=R*0.3*extra;tab+=riga(basso?'Pagati al 30% perché guadagni meno di '+LIMITE_REDDITO+' €':'Non pagati',mesi(extra),R?(basso?eur(R*0.3)+' al mese':'0 €'):undefined)}
      if(R) tab+=riga('<b>In tutto, circa</b>','','<b>'+eur(tot)+'</b>');
      tab+='</table>';
      if(m80) sapere.push('I mesi all\u201980% vanno usati <b>entro il '+dataIt(sei)+'</b> (6 anni). Dopo sono pagati al 30%.');
      if(quota-u80-m80>0&&entro6&&!solo) sapere.push('Restano '+mesi(quota-u80-m80)+' all\u201980% che può usare l\u2019altro genitore, se è dipendente.');
      if(quota>0&&!entro6) sapere.push('Tuo figlio ha già compiuto 6 anni: l\u201980% non vale più, i mesi sono pagati al 30%.');
      if(quota===0) sapere.push('Per questo figlio non ci sono mesi all\u201980%: serve una maternità o paternità obbligatoria finita dopo il 31 dicembre 2022.');
      else if(quota-u80<=0&&entro6) sapere.push('I mesi all\u201980% sono già stati usati tutti.');
      if(extra&&!basso) sapere.push('I mesi non pagati restano un tuo diritto. Sono pagati al 30% solo a chi guadagna meno di '+LIMITE_REDDITO+' € l\u2019anno.');
      if(!solo){
        if(padre&&indiv===7) sapere.push('Se prendi almeno 3 mesi, come papà puoi arrivare a 7 mesi e in due a 11.');
        if(!padre&&altro<3) sapere.push('Se il papà prende almeno 3 mesi, in due potete arrivare a 11 mesi invece di 10.');
        var restoAltro;if(padre){var cp2=io+prendo>=3?11:10;restoAltro=Math.min(6-altro,cp2-io-prendo-altro)}else{restoAltro=Math.min(7-altro,11-io-prendo-altro);if(altro+restoAltro<3)restoAltro=Math.min(6-altro,10-io-prendo-altro)}restoAltro=Math.max(0,restoAltro);
        sapere.push('Se tu prendi '+mesi(prendo)+', all\u2019altro genitore ne restano fino a <b>'+mesi(restoAltro)+'</b>.');
      }
      if(voglio&&resta-prendo>0) sapere.push('Dopo questi ti restano ancora <b>'+mesi(resta-prendo)+'</b>.');
      fare.unshift('Avvisa il datore di lavoro almeno 5 giorni prima (2 giorni se lo prendi a ore).');
      show('cp-ok','Ti restano<b class="big">'+mesi(resta)+'</b>da usare entro il <b>'+dataIt(fine)+'</b> (14 anni '+cosa+').'+tab+lista('Da sapere',sapere)+lista('Cosa fare',fare)+(R?'<p style="margin:10px 0 0;font-size:14px">Importi lordi stimati sullo stipendio che hai scritto. L\u2019INPS usa lo stipendio del mese prima del congedo.</p>':'')+cta);
    };
  })();
  </script>
  <section class="wrap cl-altri" style="padding-top:8px;padding-bottom:48px"><div style="max-width:860px;margin:0 auto"><AltriCalcolatori current="/calcolo-congedo-parentale" /></div></section>
  <PageAside />
  </div>
</BaseLayout>
