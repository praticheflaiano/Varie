---
/**
 * Calcolo congedo parentale. Regole e numeri SOLO da fonti ufficiali (verificate il 24/11/2026):
 * - INPS, scheda "Indennità di congedo parentale per lavoratrici e lavoratori dipendenti" (agg. 16/06/2026):
 *   limiti 6 mesi madre, 6 (7) padre, 10 (11) coppia, 11 genitore solo; 9 mesi indennizzati (3+3+3); 30%; 80% per 3 mesi entro i 6 anni;
 *   entro i 14 anni (legge 199/2025, art. 1, c. 219; messaggio INPS 251 del 26/01/2026).
 * - INPS, schemi 2026 "ripartizione periodi indennizzabili" e "mesi indennizzabili all'80%" (1, 2 o 3 mesi secondo la fine di maternità/paternità).
 * - INPS, circolare 47 del 21/04/2026: limite di reddito 2026 = 19.885,13 € (2,5 volte il trattamento minimo).
 * - INPS, scheda Gestione separata (agg. 13/10/2026): 3+3+3 mesi, entro 12 anni, 30% di 1/365 del reddito.
 * - INPS, scheda lavoratori autonomi (agg. 13/07/2026): 3 mesi a genitore entro il primo anno, 30% della retribuzione convenzionale.
 * Il risultato è una stima: i contatori ufficiali sono nel servizio INPS "Domande di maternità e paternità".
 */
import BaseLayout from "~/layouts/BaseLayout.astro";

const LIMITE_REDDITO = "19.885,13";
const faqs = [
  { q: "Quanti mesi di congedo parentale spettano?", a: "Ai lavoratori dipendenti: fino a 6 mesi alla madre, fino a 6 al padre (7 se ne prende almeno 3), con un massimo di 10 mesi in due (11 se il padre ne prende almeno 3). Al genitore solo fino a 11 mesi. Si possono usare entro i 14 anni del figlio." },
  { q: "Quanto viene pagato il congedo parentale?", a: "Per i dipendenti sono pagati 9 mesi in tutto tra i due genitori: fino a 3 mesi all'80% della retribuzione se usati entro i 6 anni del figlio, gli altri al 30%. Oltre i 9 mesi il 30% spetta solo se il reddito personale è sotto 19.885,13 € (valore 2026)." },
  { q: "A chi spettano i tre mesi all'80%?", a: "Solo ai lavoratori dipendenti. Sono 3 se la maternità o la paternità obbligatoria è finita dopo il 31 dicembre 2024, 2 se è finita dopo il 31 dicembre 2023, 1 se è finita dopo il 31 dicembre 2022. Si dividono tra i genitori oppure li usa uno solo." },
  { q: "Il calcolatore è preciso?", a: "È una stima sulle regole INPS. L'importo vero dipende dalla retribuzione del mese prima del congedo e dai contatori INPS: per il conteggio esatto possiamo verificarlo insieme." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo congedo parentale", url: "https://praticheflaiano.it/calcolo-congedo-parentale", applicationCategory: "FinanceApplication", operatingSystem: "Web", isAccessibleForFree: true, inLanguage: "it", offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" } });
const H2 = "margin:24px 0 0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(28px,5vw,40px);line-height:1.05;color:#14142B";
const TD = "padding:10px;border-top:1px solid #E4E0FF";
const TH = "text-align:left;padding:10px;background:#14142B;color:#fff";
---

<BaseLayout title="Calcolo congedo parentale: mesi e quanto ti pagano" description="Calcola il congedo parentale: quanti mesi ti restano, quanti all'80% e quanti al 30%, fino a quando puoi usarli e quanto prendi. Dipendenti, Gestione separata, autonomi.">
  <script slot="head" type="application/ld+json" set:html={appLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <section style="background:#F1EEFF">
    <div style="max-width:1120px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:18px">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Calcolatore gratuito · regole INPS 2026</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Congedo parentale: quanti mesi e quanti soldi?</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A;max-width:780px">Rispondi a poche domande: ti diciamo <b>quanti mesi ti restano</b>, quanti sono pagati all'<b>80%</b> e quanti al <b>30%</b>, <b>fino a quando</b> puoi usarli e <b>quanto prendi</b>.</p>

      <form id="cp" onsubmit="return false" novalidate style="background:#fff;border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:16px;box-shadow:0 6px 0 #14142B;max-width:780px">
        <label class="cp-l" for="cp-cat">1. Che lavoro fai?
          <select id="cp-cat" class="cp-in">
            <option value="dip">Dipendente (privato o pubblico)</option>
            <option value="gs">Gestione separata (collaboratore o professionista senza cassa)</option>
            <option value="aut">Autonomo (artigiano, commerciante, agricolo)</option>
            <option value="no">Colf o badante, lavoro a domicilio, oppure non lavoro</option>
          </select></label>

        <fieldset class="cp-f"><legend>2. Chi sei?</legend>
          <label class="cp-o"><input type="radio" name="ruolo" value="madre" checked> Madre</label>
          <label class="cp-o"><input type="radio" name="ruolo" value="padre"> Padre</label>
          <label class="cp-o" style="display:flex"><input type="checkbox" id="cp-solo"> Sono genitore solo (l'altro genitore non c'è, non ha riconosciuto il figlio, oppure ho l'affidamento esclusivo)</label>
        </fieldset>

        <label class="cp-l" for="cp-nasc"><span id="cp-nasc-l">3. Data di nascita del figlio</span>
          <input id="cp-nasc" type="date" class="cp-in" style="max-width:220px">
          <span class="cp-o" style="margin-top:4px"><input type="checkbox" id="cp-adoz"> È un'adozione o un affidamento (metti la data di ingresso in famiglia)</span></label>

        <label class="cp-l cp-dip" for="cp-fine">4. Quando è finita l'ultima maternità o paternità obbligatoria (tua o dell'altro genitore)?
          <select id="cp-fine" class="cp-in">
            <option value="3">Dopo il 31 dicembre 2024</option>
            <option value="2">Nel 2024</option>
            <option value="1">Nel 2023</option>
            <option value="0">Prima del 2023</option>
            <option value="-1">Non lo so</option>
          </select></label>

        <fieldset class="cp-f"><legend>5. Mesi di congedo parentale già usati per questo figlio</legend>
          <div style="display:flex;flex-wrap:wrap;gap:12px">
            <label class="cp-l" for="cp-io" style="flex:1 1 150px">Da te<input id="cp-io" type="number" min="0" max="11" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
            <label class="cp-l cp-coppia" for="cp-altro" style="flex:1 1 150px">Dall'altro genitore<input id="cp-altro" type="number" min="0" max="11" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
            <label class="cp-l cp-dip" for="cp-u80" style="flex:1 1 150px">Di cui pagati all'80% (in due)<input id="cp-u80" type="number" min="0" max="3" step="0.5" value="0" inputmode="decimal" class="cp-in"></label>
          </div>
        </fieldset>

        <label class="cp-l" for="cp-voglio">6. Quanti mesi vuoi prendere adesso?
          <input id="cp-voglio" type="number" min="0.5" max="11" step="0.5" value="1" inputmode="decimal" class="cp-in" style="max-width:160px"></label>

        <label class="cp-l cp-dip" for="cp-ral">7. Retribuzione lorda mensile (in euro)
          <input id="cp-ral" type="number" min="0" step="1" inputmode="decimal" placeholder="es. 1800" class="cp-in" style="max-width:220px">
          <span class="cp-o" style="margin-top:4px"><input type="checkbox" id="cp-basso"> Il mio reddito personale di quest'anno è sotto {LIMITE_REDDITO} €</span></label>

        <label class="cp-l cp-gs" for="cp-red" style="display:none">7. Reddito da lavoro degli ultimi 12 mesi in Gestione separata (in euro)
          <input id="cp-red" type="number" min="0" step="1" inputmode="decimal" placeholder="es. 20000" class="cp-in" style="max-width:220px"></label>

        <button id="cp-b" type="button" style="align-self:flex-start;background:#5B3DF5;color:#fff;font-weight:800;border:0;border-radius:999px;padding:14px 26px;font-size:17px;cursor:pointer">Calcola</button>
        <div id="cp-out" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section style="max-width:860px;margin:0 auto;padding:48px 16px 64px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#2A2A40">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: 24 novembre 2026.</b> Regole in vigore nel 2026 (schede e messaggi INPS).</p>

    <a href="/blog/congedo-parentale-guida-mesi-80-per-cento-domanda" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16l-8-4-8 4z"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Leggi la guida completa al congedo parentale</span><span class="cta-tool-s">Tutte le regole spiegate semplici, con esempi</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <h2 style={H2}>Le regole in una tabella</h2>
    <div style="overflow-x:auto" tabindex="0"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Chi</th><th style={TH}>Mesi</th><th style={TH}>Entro</th><th style={TH}>Quanto</th></tr></thead>
      <tbody>
        <tr><td style={TD}><b>Dipendenti</b></td><td style={TD}>madre 6, padre 6 (7), in due 10 (11); genitore solo 11</td><td style={TD}>14 anni del figlio</td><td style={TD}>9 mesi pagati: fino a 3 all'80% (entro i 6 anni), gli altri al 30%</td></tr>
        <tr><td style={TD}><b>Gestione separata</b></td><td style={TD}>3 a testa + 3 da dividere (9 in due)</td><td style={TD}>12 anni del figlio</td><td style={TD}>30% del reddito</td></tr>
        <tr><td style={TD}><b>Autonomi</b></td><td style={TD}>3 a testa</td><td style={TD}>1 anno del figlio</td><td style={TD}>30% della retribuzione convenzionale</td></tr>
      </tbody>
    </table></div>

    <h2 style={H2}>Vuoi che lo facciamo noi?</h2>
    <p style="margin:0">Come patronato controlliamo i mesi che ti restano sui contatori INPS e inviamo la domanda. La domanda va fatta <b>prima</b> di iniziare il congedo.</p>
    <a href="/prenota" class="cta-tool" style="margin-top:6px"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota un appuntamento</span><span class="cta-tool-s">In ufficio a Vigne Nuove o in videochiamata</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <h2 style={H2}>Domande frequenti</h2>
    {faqs.map((f) => (
      <details style="background:#F7F7FB;border-radius:18px;padding:16px 20px"><summary style="font-weight:800;cursor:pointer">{f.q}</summary><p style="margin:10px 0 0">{f.a}</p></details>
    ))}
    <p style="margin:12px 0 0;font-size:14px;color:#5B5B72">Fonti: INPS, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50583.indennit-di-congedo-parentale-per-lavoratrici-e-lavoratori-dipendenti.html" target="_blank" rel="noopener">scheda congedo parentale dipendenti</a>, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50290.indennit-per-congedo-parentale-per-lavoratrici-e-lavoratori-iscritti-alla-gestione-separata.html" target="_blank" rel="noopener">scheda Gestione separata</a>, <a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.indennit-per-congedo-parentale-per-lavoratori-e-lavoratrici-autonome-50291.indennit-per-congedo-parentale-per-lavoratori-e-lavoratrici-autonome.html" target="_blank" rel="noopener">scheda autonomi</a>, <a href="https://www.inps.it/content/dam/inps-site/pdf/allegati/2026/Schema_ripartizione_mesi_congedo_parentale_indennizzabili_80.pdf" target="_blank" rel="noopener">schema dei mesi all'80%</a>; messaggio INPS n. 251 del 26 gennaio 2026; circolare INPS n. 47 del 21 aprile 2026; D.Lgs. 151/2001, artt. 32-36. Il calcolatore dà una stima e non sostituisce i contatori INPS.</p>
  </section>

  <style is:global>
    #cp-out{scroll-margin-top:90px}
    .cp-f{border:0;padding:0;margin:0}
    .cp-f legend{font-weight:800;margin-bottom:8px}
    .cp-l{display:flex;flex-direction:column;gap:6px;font-weight:800}
    .cp-in{border:2px solid #14142B;border-radius:14px;padding:11px 12px;font-size:17px;background:#fff;width:100%;max-width:100%;font-weight:400}
    .cp-o{display:inline-flex;align-items:flex-start;gap:8px;margin:0 16px 8px 0;font-size:16px;cursor:pointer;font-weight:400}
    .cp-o input{width:20px;height:20px;accent-color:#5B3DF5;flex:none;margin-top:2px}
    .cp-res{border-radius:20px;padding:18px 20px;line-height:1.5;margin-top:4px}
    .cp-ok{background:#D4FF4F;color:#14142B}
    .cp-warn{background:#FFF4D6;color:#14142B}
    .cp-res b.big{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:38px;line-height:1.05;margin:4px 0}
    .cp-res table{border-collapse:collapse;margin-top:8px;font-size:15px;width:100%}
    .cp-res td{padding:4px 8px 4px 0;vertical-align:top}
    .cp-res a{color:#14142B;font-weight:800;text-decoration:underline}
  </style>
  <script is:inline define:vars={{ LIMITE_REDDITO }}>
  (function(){
    var $=function(i){return document.getElementById(i)};
    var eur=function(n){var p=(Math.round(n*100)/100).toFixed(2).split('.');return p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1]+' €'};
    var mesi=function(n){n=Math.round(n*2)/2;var s=String(n).replace('.',',');return s+(n===1?' mese':' mesi')};
    var num=function(i){var v=parseFloat(String($(i).value).replace(',','.'));return v>=0?v:0};
    var dataIt=function(d){return d.toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric'})};
    var piu=function(d,anni){var x=new Date(d.getTime());x.setFullYear(x.getFullYear()+anni);return x};
    function vista(){
      var c=$('cp-cat').value,solo=$('cp-solo').checked;
      [].forEach.call(document.querySelectorAll('.cp-dip'),function(e){e.style.display=c==='dip'?'':'none'});
      [].forEach.call(document.querySelectorAll('.cp-gs'),function(e){e.style.display=c==='gs'?'':'none'});
      [].forEach.call(document.querySelectorAll('.cp-coppia'),function(e){e.style.display=solo?'none':''});
      $('cp-nasc-l').textContent=$('cp-adoz').checked?'3. Data di ingresso in famiglia':'3. Data di nascita del figlio';
    }
    ['cp-cat','cp-solo','cp-adoz'].forEach(function(i){$(i).addEventListener('change',vista)});vista();
    var cta='<p style="margin:10px 0 0">Vuoi il conteggio esatto e la domanda fatta da noi? <a href="/prenota">Prenota un appuntamento</a>.</p>';
    function show(c,h){$('cp-out').innerHTML='<div class="cp-res '+c+'">'+h+'</div>';$('cp-out').scrollIntoView({behavior:'smooth',block:'nearest'})}
    function lista(a){return a.length?'<ul style="margin:10px 0 0;padding-left:20px">'+a.map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul>':''}
    $('cp-b').onclick=function(){
      var cat=$('cp-cat').value,padre=document.querySelector('input[name=ruolo]:checked').value==='padre',solo=$('cp-solo').checked,adoz=$('cp-adoz').checked;
      if(cat==='no'){show('cp-warn','<b>Il congedo parentale non spetta</b> a colf e badanti, a chi lavora a domicilio e a chi ha il rapporto di lavoro finito o sospeso. Possono spettare altri aiuti: maternità, Assegno Unico, bonus nido.'+cta);return}
      if(!$('cp-nasc').value){show('cp-warn','Inserisci la data '+(adoz?'di ingresso in famiglia.':'di nascita del figlio.'));return}
      var nasc=new Date($('cp-nasc').value+'T00:00:00'),oggi=new Date();oggi.setHours(0,0,0,0);
      if(nasc>oggi){show('cp-warn','La data è nel futuro: il congedo parentale parte dopo la nascita (per la madre, dopo la maternità obbligatoria).');return}
      var io=num('cp-io'),altro=solo?0:num('cp-altro'),voglio=num('cp-voglio')||1,note=[];
      var anni=cat==='dip'?14:cat==='gs'?12:1,fine=piu(nasc,anni);
      var cosa=adoz?"dall'ingresso in famiglia":'del figlio';
      if(oggi>=fine){show('cp-warn','<b>Il tempo è scaduto.</b> Per la tua categoria il congedo parentale si può usare entro '+(anni===1?'il primo anno':'i '+anni+' anni')+' '+cosa+': il termine era il '+dataIt(fine)+'.'+cta);return}
      if(adoz) note.push('Adozione o affidamento: il congedo non può comunque andare oltre i 18 anni del minore.');

      if(cat==='aut'){
        var resta=Math.max(0,3-io),prendo=Math.min(voglio,resta);
        if(!resta){show('cp-warn','Hai già usato i <b>3 mesi</b> che spettano a ogni genitore lavoratore autonomo.'+cta);return}
        note.push('Devi avere versato i contributi del mese prima del congedo e non lavorare davvero in quei giorni.');
        note.push('Fai la domanda <b>prima</b> di iniziare: se arriva dopo, l’INPS paga solo i giorni successivi.');
        show('cp-ok','Puoi prendere ancora<b class="big">'+mesi(resta)+'</b>entro il <b>'+dataIt(fine)+'</b> (primo anno '+cosa+').<table><tr><td>Mesi che vuoi prendere ora</td><td style="text-align:right"><b>'+mesi(prendo)+'</b></td></tr><tr><td>Quanto spetta</td><td style="text-align:right"><b>30%</b> della retribuzione convenzionale della tua categoria</td></tr></table>'+lista(note)+cta);return;
      }

      var maxPag=solo&&cat==='dip'?9:6-Math.max(0,Math.min(altro,6)-3);
      if(cat==='gs'){
        var restaG=Math.max(0,maxPag-io),prendoG=Math.min(voglio,restaG),red=num('cp-red');
        if(!restaG){show('cp-warn','Non ti restano mesi: in Gestione separata spettano <b>3 mesi a testa più 3 da dividere</b>, 9 in tutto tra i due genitori.'+cta);return}
        if(solo) note.push('Per il genitore solo iscritto alla Gestione separata chiedi a noi una verifica: qui abbiamo contato i mesi di un genitore in coppia.');
        note.push('Serve almeno 1 mese di contributi con aliquota piena nei 12 mesi prima del congedo, il rapporto di lavoro in corso e l’astensione reale dal lavoro.');
        note.push('Si usa a mesi o a giorni, non a ore. La domanda va fatta <b>prima</b> di iniziare.');
        var soldi=red?'<tr><td>Indennità stimata (30% del reddito)</td><td style="text-align:right;white-space:nowrap"><b>'+eur(red*0.3/12*prendoG)+'</b></td></tr><tr><td>Al mese, circa</td><td style="text-align:right;white-space:nowrap"><b>'+eur(red*0.3/12)+'</b></td></tr>':'';
        show('cp-ok','Puoi prendere ancora<b class="big">'+mesi(restaG)+'</b>entro il <b>'+dataIt(fine)+'</b> (12 anni '+cosa+').<table><tr><td>Mesi che vuoi prendere ora</td><td style="text-align:right"><b>'+mesi(prendoG)+'</b></td></tr>'+soldi+'</table>'+lista(note)+'<p style="margin:10px 0 0;font-size:14px">Stima al lordo. L’INPS calcola il 30% di 1/365 del reddito per ogni giorno di congedo.</p>'+cta);return;
      }

      // Dipendenti
      var padreTot=padre?io+voglio:altro;
      var indiv=solo?11:(padre?(padreTot>=3?7:6):6),coppia=solo?11:(padreTot>=3?11:10);
      var resta=Math.max(0,Math.min(indiv-io,coppia-io-altro));
      if(!resta){show('cp-warn','<b>Non ti restano mesi di congedo parentale</b> per questo figlio: il limite è '+(solo?'11 mesi per il genitore solo':'6 mesi per la madre, 6 per il padre (7 se ne prende almeno 3) e 10 in due (11 se il padre ne prende almeno 3)')+'.'+cta);return}
      var prendo=Math.min(voglio,resta);
      if(prendo<voglio) note.push('Hai chiesto '+mesi(voglio)+', ma te ne restano '+mesi(resta)+'.');
      var perNascita=nasc>=new Date('2025-01-01T00:00:00')?3:nasc>=new Date('2024-01-01T00:00:00')?2:nasc>=new Date('2023-01-01T00:00:00')?1:0;
      var sel=parseInt($('cp-fine').value,10),quota=Math.max(perNascita,sel);
      if(sel<0&&perNascita<3) note.push('Non sai quando è finita la maternità o paternità obbligatoria: abbiamo contato i mesi all’80% solo in base alla data di nascita. Potrebbero essere di più.');
      var sei=piu(nasc,6),entro6=oggi<sei,u80=Math.min(num('cp-u80'),quota);
      var m80=entro6?Math.max(0,Math.min(quota-u80,Math.max(0,3-io),prendo)):0;
      var pagRest=Math.max(0,maxPag-io);
      var m30=Math.max(0,Math.min(prendo-m80,pagRest-m80));
      var extra=Math.max(0,prendo-m80-m30),basso=$('cp-basso').checked,R=num('cp-ral');
      var righe=[];
      if(m80) righe.push(['Pagati all’80%',m80,0.8]);
      if(m30) righe.push(['Pagati al 30%',m30,0.3]);
      if(extra) righe.push([basso?'Oltre i mesi pagati: 30% perché il reddito è sotto '+LIMITE_REDDITO+' €':'Oltre i mesi pagati: senza indennità',extra,basso?0.3:0]);
      var tot=0,tab='<table>'+righe.map(function(x){var e=R*x[2]*x[1];tot+=e;return '<tr><td>'+x[0]+'</td><td style="text-align:right;white-space:nowrap"><b>'+mesi(x[1])+'</b></td>'+(R?'<td style="text-align:right;white-space:nowrap">'+(x[2]?eur(e):'0 €')+'</td>':'')+'</tr>'}).join('')+'</table>';
      if(quota>0&&entro6&&quota-u80-m80>0) note.push('Mesi all’80% ancora disponibili dopo questi: '+mesi(quota-u80-m80)+' (in due), da usare <b>entro il '+dataIt(sei)+'</b>. Dopo i 6 anni sono pagati al 30%.');
      if(quota>0&&!entro6) note.push('Il figlio ha già compiuto 6 anni: i mesi all’80% non valgono più, il congedo è pagato al 30%.');
      if(quota===0) note.push('Per questo figlio non ci sono mesi all’80%: servono una maternità o paternità obbligatoria finita dopo il 31 dicembre 2022.');
      if(entro6&&quota-u80>0&&io>=3) note.push('Hai già usato i tuoi 3 mesi «non cedibili»: i mesi all’80% rimasti può usarli l’altro genitore.');
      if(extra&&!basso) note.push('I mesi oltre quelli pagati restano un tuo diritto, ma senza indennità. Il 30% spetta solo se il tuo reddito personale è sotto '+LIMITE_REDDITO+' € (limite 2026).');
      if(padre&&!solo&&padreTot>=3) note.push('Come padre prendi almeno 3 mesi: il tuo limite sale a 7 mesi e quello di coppia a 11.');
      note.push('Mesi che ti restano dopo questi: <b>'+mesi(resta-prendo)+'</b>. Hai tempo fino al <b>'+dataIt(fine)+'</b> (14 anni '+cosa+').');
      note.push('Avvisa il datore di lavoro almeno 5 giorni prima (2 giorni se lo usi a ore) e fai la domanda all’INPS <b>prima</b> di iniziare.');
      var testa=R?'Per '+mesi(prendo)+' di congedo prendi circa<b class="big">'+eur(tot)+' lordi</b>':'Puoi prendere<b class="big">'+mesi(prendo)+'</b>';
      show('cp-ok',testa+tab+lista(note)+'<p style="margin:10px 0 0;font-size:14px">Stima al lordo, calcolata sulla retribuzione mensile che hai inserito. L’INPS usa la retribuzione media giornaliera del mese prima del congedo.</p>'+cta);
    };
  })();
  </script>
</BaseLayout>
