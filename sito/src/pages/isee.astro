---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import body from "~/fragments/isee.html?raw";
const ld = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Ma \\u00e8 davvero gratis?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"S\\u00ec, la prima DSU dell'anno \\u00e8 gratis. La tessera \\u00e8 consigliata, non obbligatoria: conviene se fai anche altre pratiche.\"}}, {\"@type\": \"Question\", \"name\": \"E se dimentico un conto o un reddito?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Va presentata una nuova DSU. Se la rifacciamo perch\\u00e9 mancavano dati importanti, nello stesso anno e per la stessa famiglia, chiediamo 25 \\u20ac di servizio. Non li paghi se cambia la famiglia, per l'ISEE corrente o se l'errore \\u00e8 nostro. Per questo conviene controllare la guida prima di venire.\"}}, {\"@type\": \"Question\", \"name\": \"Quali anni contano per l'ISEE 2027?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"I redditi del 2025 e i risparmi e gli immobili al 31 dicembre 2025. La famiglia \\u00e8 quella alla data della domanda. Si pu\\u00f2 fare dal 1\\u00b0 gennaio 2027.\"}}, {\"@type\": \"Question\", \"name\": \"Ho buoni postali o titoli di Stato: contano?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Titoli di Stato, buoni e libretti postali sono esclusi dal calcolo fino a 50.000 \\u20ac per famiglia. Diccelo comunque: verifichiamo noi come vanno indicati.\"}}, {\"@type\": \"Question\", \"name\": \"Ho una casa di propriet\\u00e0 a Roma: cosa cambia?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Per Assegno Unico, bonus nido, bonus nuovi nati, ADI e SFL la casa in cui vivi pesa meno: a Roma \\u00e8 esclusa fino a 120.000 \\u20ac, pi\\u00f9 2.500 \\u20ac per ogni figlio convivente dopo il primo.\"}}, {\"@type\": \"Question\", \"name\": \"I genitori non vivono insieme, o lo studente vive fuori casa?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dillo prima di iniziare: per figli minorenni, universit\\u00e0 e ricoveri in RSA possono servire dati di familiari che non vivono con te. Il test \\\"Quale ISEE ti serve\\\" ti aiuta a capirlo.\"}}, {\"@type\": \"Question\", \"name\": \"Devo portare il 730 o la CU?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No, li recuperiamo noi online.\"}}, {\"@type\": \"Question\", \"name\": \"Posso farlo senza muovermi da casa?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"S\\u00ec: videochiamata o richiesta online, scegli tu.\"}}, {\"@type\": \"Question\", \"name\": \"Quando scade?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Il 31 dicembre dell'anno in cui lo fai. Per l'Assegno Unico pieno conviene rinnovarlo a inizio anno.\"}}]}";
---
<BaseLayout title={"ISEE gratis a Vigne Nuove, Roma"} description={"ISEE gratuito al CAF di Vigne Nuove o in videochiamata. Redditi e CU li recuperiamo noi. Prenota o invia la richiesta online."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="isee" name="ISEE e DSU" description={"Calcolo ISEE ordinario, corrente e universitario: compilazione e invio della DSU all'INPS. Gratuito."} serviceType="Assistenza fiscale - ISEE" offers={[{ name: "ISEE", price: 0 }]} />
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}
  <div class="lp"><Fragment set:html={body} /></div>
  <LandingArticles categories={["isee-dsu", "assegno-unico"]} />
</BaseLayout>
