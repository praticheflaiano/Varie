---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import body from "~/fragments/isee.html?raw";
const ld = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Ma \u00e8 davvero gratis?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"S\u00ec. La tessera \u00e8 consigliata, non obbligatoria: conviene se fai anche altre pratiche.\"}}, {\"@type\": \"Question\", \"name\": \"Devo portare il 730 o la CU?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No, li recuperiamo noi online.\"}}, {\"@type\": \"Question\", \"name\": \"Posso farlo senza muovermi da casa?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"S\u00ec: videochiamata o richiesta online, scegli tu.\"}}, {\"@type\": \"Question\", \"name\": \"Quando scade?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Il 31 dicembre dell'anno in cui lo fai. Per l'Assegno Unico pieno conviene rinnovarlo a inizio anno.\"}}]}";
---
<BaseLayout title={"ISEE gratis a Vigne Nuove, Roma"} description={"ISEE gratuito al CAF di Vigne Nuove o in videochiamata. Redditi e CU li recuperiamo noi. Prenota o invia la richiesta online."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="isee" name="ISEE e DSU" description={"Calcolo ISEE ordinario, corrente e universitario: compilazione e invio della DSU all'INPS. Gratuito."} serviceType="Assistenza fiscale - ISEE" offers={[{ name: "ISEE", price: 0 }]} />
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}
  <div class="lp"><Fragment set:html={body} /></div>
  <LandingArticles categories={["isee-dsu", "assegno-unico"]} />
</BaseLayout>
