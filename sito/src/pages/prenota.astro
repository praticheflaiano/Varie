---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import { BOOKING, CONTACT, GHL, LANDING } from "~/consts";
---
<BaseLayout
  title="Prenota CAF e patronato a Roma Nord"
  description="Prenota online al Centro Pratiche Flaiano: in ufficio a Vigne Nuove (Roma) o in videochiamata. Oppure manda una richiesta online e ti richiamiamo noi."
>
  <section class="wrap" style="padding-block:32px 40px">
    <Breadcrumb items={[{ name: "Prenota", href: "/prenota" }]} class="mb-8" />
    <div class="flex flex-col gap-5" style="max-width:820px">
      <span class="eyebrow">Prenotazioni</span>
      <h1>Come preferisci? <span class="hl-lime">Scegli tu.</span></h1>
      <p style="font-size:20px;line-height:1.5">Il calendario ti mostra subito i posti liberi. Ti arriva la conferma e, prima dell'appuntamento, la lista dei documenti.</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:48px">
    <div class="grid gap-5 lg:grid-cols-3">
      <div style="background:#5B3DF5;color:#fff;border-radius:32px;padding:32px" class="flex flex-col gap-3">
        <span style="font-size:14px;font-weight:700;color:#D4FF4F">Il più scelto</span>
        <h2 style="color:#fff;font-size:32px">In ufficio</h2>
        <p style="color:#E4DEFF">Ti accogliamo a Vigne Nuove, prendiamo i documenti e ti spieghiamo tutto a voce. Ideale per la prima volta o per le pratiche lunghe.</p>
        <a class="btn btn-lime mt-auto" href={BOOKING.arcanisGroup} target="_blank" rel="noopener">Scegli l'orario →</a>
      </div>
      <div style="background:#14142B;color:#fff;border-radius:32px;padding:32px" class="flex flex-col gap-3">
        <span style="font-size:14px;font-weight:700;color:#FF8FB0">Dal divano</span>
        <h2 style="color:#fff;font-size:32px">In videochiamata</h2>
        <p style="color:#D7D7E6">Ci vediamo in video o al telefono. I documenti ce li mandi su WhatsApp o per email.</p>
        <a class="btn mt-auto" style="background:#fff;color:#14142B" href={BOOKING.arcanisRemote} target="_blank" rel="noopener">Chiedila su WhatsApp →</a>
      </div>
      <div style="background:#D4FF4F;color:#14142B;border-radius:32px;padding:32px" class="flex flex-col gap-3">
        <span style="font-size:14px;font-weight:700">Quando vuoi</span>
        <h2 style="font-size:32px">Richiesta online</h2>
        <p style="color:#14142B">Due minuti di modulo e le foto dei documenti. Ti richiamiamo noi.</p>
        <a class="btn btn-dark mt-auto" href={GHL.richiesta}>Inizia ora →</a>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:56px">
    <div style="background:#F7F7FB;border-radius:32px;padding:clamp(24px,4vw,40px)" class="flex flex-col gap-5">
      <h2 style="font-size:clamp(26px,3vw,34px)">Sai già cosa ti serve? Vai dritto alla pagina giusta</h2>
      <div class="flex flex-wrap gap-3">
        {LANDING.map((l) => <a class="chip" href={l.href}>{l.label}{l.tag && <span style="font-size:12px;font-weight:800;background:#D4FF4F;border-radius:999px;padding:2px 8px;color:#14142B">{l.tag}</span>}</a>)}
      </div>
      <p>
        Preferisci parlarne? Chiama il <a href={`tel:${CONTACT.phone.landlineRaw}`} style="font-weight:800">{CONTACT.phone.landline}</a>
        o scrivi su <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="font-weight:800">WhatsApp {CONTACT.phone.mobile}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
