---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import Accordion from "~/components/ui/Accordion.svelte";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { Icon } from "astro-icon/components";
import ServiceBlock from "~/components/ui/ServiceBlock.astro";
import PortaleNaspi from "~/components/blog/PortaleNaspi.astro";

const services = [
  {
    title: "Pensioni",
    href: "/pensioni",
    desc: "Verifica contributi, simulazione pensione, presentazione domanda di pensione di vecchiaia, anticipata, APE sociale, reversibilità, ricongiunzioni.",
    icon: "heroicons:identification",
    bullets: [
      "Estratto contributivo INPS",
      "Calcolo pensione e finestre",
      "Domanda di pensione e ricongiunzioni",
      "Riscatto laurea e contributi figurativi",
    ],
  },
  {
    title: "NASpI e disoccupazione",
    href: "/naspi",
    desc: "Domanda NASpI, dimissioni online, indennità di disoccupazione, ricalcoli e integrazioni reddituali. Importante: la domanda va presentata <strong>entro 68 giorni</strong> dalla cessazione.",
    icon: "heroicons:briefcase",
    bullets: [
      "Presentazione domanda NASpI",
      "Dimissioni telematiche (anche senza SPID)",
      "DIS-COLL per co.co.co.",
      "Ricalcoli e integrazioni",
    ],
  },
  {
    title: "Invalidità civile e Legge 104",
    href: "/invalidita-104",
    desc: "Domanda di invalidità civile, indennità di accompagnamento, riconoscimento handicap (L. 104), aggravamento, integrazioni reddituali per invalidi civili.",
    icon: "heroicons:heart",
    bullets: [
      "Domanda di invalidità civile",
      "Riconoscimento Legge 104 (3 e 3 comma 3)",
      "Indennita di accompagnamento",
      "Aggravamento e ricorsi",
    ],
  },
  {
    title: "Assegno Unico Universale",
    href: "/assegno-unico",
    desc: "Domanda AUU, integrazioni ISEE, variazioni del nucleo familiare, calcolo importi, gestione decadenze.",
    icon: "heroicons:user-group",
    bullets: [
      "Prima domanda AUU",
      "Variazioni nucleo familiare",
      "Integrazione ISEE",
      "Importi e maggiorazioni",
    ],
  },
  {
    title: "Maternità e bonus famiglia",
    href: "/bonus-famiglia",
    desc: "Indennita di maternità, congedi parentali, bonus nido, bonus genitori, congedo di paternità.",
    icon: "heroicons:heart",
    bullets: [
      "Indennita di maternità lavoratrici",
      "Congedo parentale",
      "Bonus asilo nido",
      "Bonus mamme e bonus genitori",
    ],
  },
  {
    title: "ADI, SFL e sostegno reddito",
    href: "/adi-sfl",
    desc: "Assegno di Inclusione, Supporto Formazione e Lavoro, sostegno per famiglie e singoli in difficoltà economica.",
    icon: "heroicons:lifebuoy",
    bullets: [
      "Domanda ADI (Assegno di Inclusione)",
      "Supporto Formazione e Lavoro (SFL)",
      "Verifica requisiti ISEE",
      "Rinnovi e variazioni",
    ],
  },
  {
    title: "RED, INVCIV, ACCAS/PS",
    href: "/red-invciv",
    desc: "Modelli reddituali INPS obbligatori per pensionati, invalidi civili e percettori di prestazioni assistenziali.",
    icon: "heroicons:clipboard-document-list",
    bullets: [
      "Modello RED ordinario",
      "INVCIV per invalidi civili",
      "ACCAS/PS per pensioni sociali",
      "Sollecitati INPS e diffide",
    ],
  },
  {
    title: "Lavoro domestico (colf, badanti)",
    href: "/colf-badanti",
    desc: "Iscrizione INPS, contributi, contratti CCNL, dimissioni, deduzioni fiscali per il datore di lavoro.",
    icon: "heroicons:home",
    bullets: [
      "Iscrizione INPS lavoratori domestici",
      "Calcolo contributi trimestrali",
      "Dimissioni e licenziamenti",
      "Deduzioni fiscali datore di lavoro",
    ],
  },
];

const faq = [
  {
    question: "Dove trovo un patronato vicino a me a Roma nord?",
    answer: "Il nostro Patronato ENASC è a Roma in <strong>Via Filoteo Alberini 25, interno 10</strong>, dentro il Centro Acquisti Flaiano, nel quartiere Vigne Nuove (Municipio III). Seguiamo soprattutto chi abita a Vigne Nuove, Talenti, Montesacro, Conca d'Oro, Tufello, Val Melaina, Bufalotta, Porta di Roma, Fidene, Serpentara, Nuovo Salario e Colle Salario: come arrivare dalla tua zona è nelle pagine delle <a href='/zone'>zone servite</a>.",
  },
  {
    question: "Il patronato è aperto oggi? E il sabato?",
    answer: "<strong>Dal lunedì al giovedì 9:30-13:00 e 15:30-18:00, il venerdì 9:30-14:00. Il sabato e la domenica siamo chiusi.</strong> Riceviamo su appuntamento: <a href='/prenota'>prenota</a>, chiama lo 06 9784 5429 o scrivi su WhatsApp al 371 623 0690. Le chiusure per le feste sono nella <a href='/contatti'>pagina contatti</a>.",
  },
  {
    question: "Quanto costano le pratiche di patronato? C'è un listino prezzi?",
    answer: "Molte pratiche sono gratuite: per esempio la <a href='/pensioni'>domanda di pensione</a> e la domanda <a href='/naspi'>NASpI</a>. Dove c'è un costo lo trovi nella pagina del servizio: per esempio le <a href='/dimissioni-online'>dimissioni online</a> partono da 15 €. Con la <a href='/tesseramento'>tessera</a> (30 € all'anno per tutta la famiglia) molte pratiche costano meno. Per un preventivo scrivici su WhatsApp al 371 623 0690.",
  },
  {
    question: "Cos'è il mandato al Patronato ENASC?",
    answer: "È il modulo con cui autorizzi il Patronato ENASC ad assisterti e a presentare le pratiche all'INPS per tuo conto. Puoi compilarlo online nella pagina del <a href='/mandato'>mandato di patronato</a>.",
  },
  {
    question: "Quanto tempo ho per fare domanda di NASpI?",
    answer: "La domanda di NASpI va presentata <strong>entro 68 giorni</strong> dalla cessazione del rapporto di lavoro. Oltre questo termine il diritto decade.",
  },
  {
    question: "Quanto dura la pratica di invalidità civile?",
    answer: "Dipende dai tempi di convocazione della visita, che cambiano da zona a zona. Il primo passo è il certificato medico introduttivo: da noi il medico certificatore è nello stesso ufficio del patronato. <a href='/invalidita-104'>Come funziona</a>.",
  },
  {
    question: "Per l'Assegno Unico devo rifare l'ISEE ogni anno?",
    answer: "Sì. L'ISEE scade il 31 dicembre di ogni anno: per ricevere l'AUU pieno da gennaio devi rinnovarlo. Se non lo rinnovi, ricevi l'importo minimo.",
  },
  {
    question: "Devo essere socio per usare il Patronato?",
    answer: "No. Molte pratiche di patronato sono gratuite per tutti (per esempio la domanda NASpI). Dove c'è un costo lo trovi nella pagina del servizio, e con la <a href='/tesseramento'>tessera</a> spesso costa meno.",
  },
  {
    question: "Posso ottenere la Legge 104 e l'invalidità civile contemporaneamente?",
    answer: "Sì, sono due benefici diversi. L'invalidità civile è di natura economica (assegno o pensione di invalidità); la Legge 104 è di natura assistenziale (permessi lavorativi, agevolazioni fiscali, parcheggi). Spesso si richiedono insieme.",
  },
  {
    question: "Seguite anche colf e badanti, come un consulente del lavoro?",
    answer: "Per il lavoro domestico sì: prepariamo il contratto, facciamo l'assunzione all'INPS, ti diamo i prospetti paga e il conto dei contributi trimestrali. Il prezzo annuale lo chiedi su WhatsApp al 371 623 0690. <a href='/colf-badanti'>Il servizio colf e badanti</a>.",
  },
];
---

<BaseLayout
  title="Patronato a Roma Vigne Nuove: pensioni, NASpI, invalidità"
  description="Patronato ENASC a Roma Vigne Nuove, Via Filoteo Alberini 25: pensioni, NASpI, invalidità e 104, assegno unico, ADI. Aperti lun-ven, sabato chiuso."
>
  <JsonLdFaq slot="head" items={faq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Servizi", href: "/servizi" }, { name: "Patronato", href: "/servizi/patronato" }]} class="mb-6" />
      <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-accent-100)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-accent-800)]">
        <Icon name="heroicons:shield-check" class="size-3.5" /> Patronato ENASC
      </span>
      <SectionHeading
        title="Pratiche previdenziali e assistenziali"
        subtitle="Il nostro Patronato ENASC è a Roma, in Via Filoteo Alberini 25 a Vigne Nuove (Municipio III), aperto dal lunedì al venerdì. Pensioni, disoccupazione, invalidità, sostegno al reddito: ti seguiamo in tutte le pratiche INPS."
        class="mt-3"
        level="h1"
      />
    </div>
  </section>

  {/* NASpI e disoccupazione: strumenti e guide interne (dal 25/11/2026) */}
  <section class="section-tight">
    <div class="container-wide">
      <div class="relative overflow-hidden p-7 md:p-10" style="background:#D4FF4F;border-radius:36px">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-8">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#14142B] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
              <Icon name="heroicons:rocket-launch" class="size-3.5" />
              Disoccupazione
            </span>
            <h2 class="mt-3 font-display text-[var(--color-brand-950)]">
              NASpI: calcolo, anticipo e guide, tutto qui.
            </h2>
            <p class="mt-3 text-base text-[#14142B] leading-relaxed max-w-2xl">
              Calcola importo e durata della NASpI, guarda quanto ricevi con l'anticipo in due rate (70% e 30%), controlla le scadenze della domanda e leggi la guida al Fondo di garanzia INPS per TFR e stipendi non pagati.
            </p>
            <ul class="mt-5 grid gap-2 sm:grid-cols-2 text-sm text-[#14142B] font-semibold">
              <li class="flex items-start gap-2"><Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[#5B3DF5]" /><a href="/calcolo-naspi" class="underline">Calcolo NASpI online</a></li>
              <li class="flex items-start gap-2"><Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[#5B3DF5]" /><a href="/anticipo-naspi" class="underline">Anticipo NASpI in due rate</a></li>
              <li class="flex items-start gap-2"><Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[#5B3DF5]" /><a href="/naspi/domanda" class="underline">Domanda NASpI: tempi e scadenze</a></li>
              <li class="flex items-start gap-2"><Icon name="heroicons:check-circle-20-solid" class="size-5 shrink-0 text-[#5B3DF5]" /><a href="/naspi/fondo-garanzia-tfr" class="underline">Fondo di garanzia: TFR e stipendi</a></li>
            </ul>
          </div>
          <div class="lg:col-span-4 flex lg:justify-end">
            <a href="/naspi" class="btn btn-primary btn-lg">
              Vai alla pagina NASpI
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-6 md:grid-cols-2">
      {services.map((s, i) => <ServiceBlock {...s} i={i} />)}
    </div>
  </section>

  <section class="section bg-[var(--color-surface-soft)]">
    <div class="container-narrow">
      <SectionHeading eyebrow="Domande frequenti Patronato" title="Le risposte alle domande più comuni" align="center" />
      <div class="mt-10">
        <Accordion client:visible items={faq} />
      </div>
    </div>
  </section>

  <div class="wrap"><PortaleNaspi heading="Hai perso il lavoro? Guide e strumenti sulla NASpI" /></div>

  <BookingCTA />
</BaseLayout>
