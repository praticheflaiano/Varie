---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import Accordion from "~/components/ui/Accordion.svelte";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Pensioni",
    desc: "Verifica contributi, simulazione pensione, presentazione domanda di pensione di vecchiaia, anticipata, opzione donna, Quota 103, Ape sociale, ricongiunzioni.",
    icon: "heroicons:identification",
    bullets: [
      "Estratto contributivo INPS",
      "Calcolo pensione e finestre",
      "Domanda di pensione e ricongiunzioni",
      "Riscatto laurea e contributi figurativi",
    ],
  },
  {
    title: "NASpI e disoccupazione",
    desc: "Domanda NASpI, dimissioni online, indennita di disoccupazione, ricalcoli e integrazioni reddituali. Importante: la domanda va presentata <strong>entro 68 giorni</strong> dalla cessazione.",
    icon: "heroicons:briefcase",
    bullets: [
      "Presentazione domanda NASpI",
      "Dimissioni telematiche (anche senza SPID)",
      "DIS-COLL per co.co.co.",
      "Ricalcoli e integrazioni",
    ],
  },
  {
    title: "Invalidita civile e Legge 104",
    desc: "Domanda di invalidita civile, indennita di accompagnamento, riconoscimento handicap (L. 104), aggravamento, integrazioni reddituali per invalidi civili.",
    icon: "heroicons:heart",
    bullets: [
      "Domanda di invalidita civile",
      "Riconoscimento Legge 104 (3 e 3 comma 3)",
      "Indennita di accompagnamento",
      "Aggravamento e ricorsi",
    ],
  },
  {
    title: "Assegno Unico Universale",
    desc: "Domanda AUU, integrazioni ISEE, variazioni del nucleo familiare, calcolo importi, gestione decadenze.",
    icon: "heroicons:user-group",
    bullets: [
      "Prima domanda AUU",
      "Variazioni nucleo familiare",
      "Integrazione ISEE",
      "Importi e maggiorazioni",
    ],
  },
  {
    title: "Maternita e bonus famiglia",
    desc: "Indennita di maternita, congedi parentali, bonus nido, bonus genitori, congedo di paternita.",
    icon: "heroicons:heart",
    bullets: [
      "Indennita di maternita lavoratrici",
      "Congedo parentale",
      "Bonus asilo nido",
      "Bonus mamme e bonus genitori",
    ],
  },
  {
    title: "ADI, SFL e sostegno reddito",
    desc: "Assegno di Inclusione, Supporto Formazione e Lavoro, sostegno per famiglie e singoli in difficolta economica.",
    icon: "heroicons:lifebuoy",
    bullets: [
      "Domanda ADI (Assegno di Inclusione)",
      "Supporto Formazione e Lavoro (SFL)",
      "Verifica requisiti ISEE",
      "Rinnovi e variazioni",
    ],
  },
  {
    title: "RED, INVCIV, ACCAS/PS",
    desc: "Modelli reddituali INPS obbligatori per pensionati, invalidi civili e percettori di prestazioni assistenziali.",
    icon: "heroicons:clipboard-document-list",
    bullets: [
      "Modello RED ordinario",
      "INVCIV per invalidi civili",
      "ACCAS/PS per pensioni sociali",
      "Sollecitati INPS e diffide",
    ],
  },
  {
    title: "Lavoro domestico (colf, badanti)",
    desc: "Iscrizione INPS, contributi, contratti CCNL, dimissioni, deduzioni fiscali per il datore di lavoro.",
    icon: "heroicons:home",
    bullets: [
      "Iscrizione INPS lavoratori domestici",
      "Calcolo contributi trimestrali",
      "Dimissioni e licenziamenti",
      "Deduzioni fiscali datore di lavoro",
    ],
  },
];

const faq = [
  {
    question: "Quanto tempo ho per fare domanda di NASpI?",
    answer: "La domanda di NASpI va presentata <strong>entro 68 giorni</strong> dalla cessazione del rapporto di lavoro. Oltre questo termine il diritto decade.",
  },
  {
    question: "Quanto dura la pratica di invalidita civile?",
    answer: "Dalla domanda al verbale di visita medica passano in media <strong>3-6 mesi</strong>, ma i tempi variano da ASL a ASL. Per richieste urgenti (gravi patologie oncologiche) si attiva la procedura accelerata Onlus.",
  },
  {
    question: "Per l'Assegno Unico devo rifare l'ISEE ogni anno?",
    answer: "Si. L'ISEE scade il 31 dicembre di ogni anno: per ricevere l'AUU pieno da gennaio devi rinnovarlo. Se non lo rinnovi, ricevi l'importo minimo.",
  },
  {
    question: "Devo essere socio per usare il Patronato?",
    answer: "<strong>No, il Patronato e gratuito per legge</strong> per le prestazioni istituzionali (Legge 152/2001). La tessera ti da invece accesso a servizi aggiuntivi e priorita.",
  },
  {
    question: "Posso ottenere la Legge 104 e l'invalidita civile contemporaneamente?",
    answer: "Si, sono due benefici diversi. L'invalidita civile e di natura economica (assegno o pensione di invalidita); la Legge 104 e di natura assistenziale (permessi lavorativi, agevolazioni fiscali, parcheggi). Spesso si richiedono insieme.",
  },
];
---

<BaseLayout
  title="Servizi Patronato: pensioni, NASpI, invalidita, assegno unico"
  description="Patronato ENASC del Centro Pratiche Flaiano a Roma: pensioni, NASpI e disoccupazione, invalidita civile, Legge 104, assegno unico, maternita, ADI, RED. Tutela previdenziale gratuita."
>
  <JsonLdFaq slot="head" items={faq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Servizi", href: "/servizi" }, { name: "Patronato", href: "/servizi/patronato" }]} class="mb-6" />
      <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-accent-100)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-accent-800)]">
        <Icon name="heroicons:shield-check" class="size-3.5" /> Patronato ENASC
      </span>
      <SectionHeading
        title="Pratiche previdenziali e assistenziali"
        subtitle="Il nostro Patronato ENASC tutela i tuoi diritti previdenziali e assistenziali. Pensioni, disoccupazione, invalidita, sostegno al reddito: ti seguiamo gratuitamente per tutte le pratiche INPS."
        class="mt-3"
        level="h1"
      />
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <article class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <div class="flex size-12 items-center justify-center rounded-lg bg-[var(--color-accent-100)] text-[var(--color-accent-700)]">
            <Icon name={s.icon} class="size-6" aria-hidden="true" />
          </div>
          <h2 class="mt-5 font-display text-xl font-bold text-[var(--color-ink)]">{s.title}</h2>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed" set:html={s.desc} />
          <ul class="mt-5 space-y-1.5 text-sm text-[var(--color-ink-soft)]">
            {s.bullets.map((b) => (
              <li class="flex items-start gap-2">
                <Icon name="heroicons:check-20-solid" class="size-5 shrink-0 text-[var(--color-success-600)]" aria-hidden="true" />
                {b}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-[var(--color-surface-soft)]">
    <div class="container-narrow">
      <SectionHeading eyebrow="Domande frequenti Patronato" title="Le risposte alle domande piu comuni" align="center" />
      <div class="mt-10">
        <Accordion client:visible items={faq} />
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
