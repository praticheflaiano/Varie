---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import Accordion from "~/components/ui/Accordion.svelte";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { Icon } from "astro-icon/components";
import ServiceBlock from "~/components/ui/ServiceBlock.astro";

const services = [
  {
    title: "Modello 730 e Redditi PF",
    href: "/730",
    desc: "Compilazione e invio della dichiarazione dei redditi per dipendenti e pensionati. Massimizzazione di detrazioni e deduzioni, gestione della precompilata, rimborso veloce sulla busta paga o sulla pensione.",
    icon: "heroicons:document-text",
    bullets: [
      "Modello 730 ordinario, integrativo, congiunto",
      "Modello Redditi PF per autonomi e situazioni particolari",
      "Recupero spese sanitarie, mutuo, istruzione, sport, animali",
      "Gestione precompilata Agenzia Entrate",
    ],
  },
  {
    title: "ISEE e DSU",
    href: "/isee",
    desc: "Calcolo dell'ISEE per accedere a bonus, agevolazioni, asili nido, mensa scolastica, borse di studio, riduzione utenze.",
    icon: "heroicons:chart-bar-square",
    bullets: [
      "ISEE ordinario per benefici sociali",
      "ISEE corrente per variazioni reddituali",
      "ISEE universitario per tasse e borse",
      "ISEE minorenni con genitori non conviventi",
    ],
  },
  {
    title: "IMU e tributi locali",
    href: "/blog/categoria/imu-tributi-locali",
    desc: "Calcolo IMU, TASI, TARI con compilazione del modello F24. Verifica esenzioni, riduzioni e ravvedimento operoso.",
    icon: "heroicons:home-modern",
    bullets: [
      "Calcolo IMU prima e seconda casa",
      "Compilazione e stampa F24",
      "Ravvedimento operoso per ritardi",
      "Pratiche TARI e variazioni",
    ],
  },
  {
    title: "Successioni e Volture catastali",
    href: "/successioni",
    desc: "Apertura della successione, dichiarazione telematica, calcolo imposta successioni e donazioni, voltura catastale automatica al Catasto.",
    icon: "heroicons:document-duplicate",
    bullets: [
      "Dichiarazione di successione completa",
      "Calcolo imposte e modello F24",
      "Voltura catastale al Catasto",
      "Gestione conti correnti e quote ereditarie",
    ],
  },
  {
    title: "Contratti di affitto",
    href: "/contratti-affitto",
    desc: "Registrazione telematica dei contratti di locazione, gestione cedolare secca, proroghe, risoluzioni, cessioni.",
    icon: "heroicons:key",
    bullets: [
      "Registrazione contratti RLI",
      "Cedolare secca al 21% / 10%",
      "Proroghe, risoluzioni, cessioni",
      "Calcolo imposta di registro e marche",
    ],
  },
  {
    title: "Bonus fiscali e detrazioni",
    href: "/blog/categoria/bonus-fiscali",
    desc: "Assistenza per bonus ristrutturazione, ecobonus, bonus mobili, sismabonus, e tutte le detrazioni IRPEF.",
    icon: "heroicons:gift",
    bullets: [
      "Bonus ristrutturazione (50%)",
      "Ecobonus risparmio energetico",
      "Bonus mobili ed elettrodomestici",
      "Sismabonus, bonus barriere architettoniche",
    ],
  },
];

const faq = [
  {
    question: "Devo essere socio per fare il 730 con voi?",
    answer: "No. Il 730 e accessibile a tutti, soci e non soci. La <a href='/tesseramento'>tessera</a> ti da pero un costo agevolato e priorita sugli appuntamenti.",
  },
  {
    question: "Quanto costa fare il 730?",
    answer: "Il 730 ha un costo a partire da <strong>30 €</strong> per situazioni semplici (un solo CUD, poche detrazioni). Il prezzo aumenta con la complessita (piu redditi, immobili, casi particolari). Forniamo sempre un preventivo prima di iniziare.",
  },
  {
    question: "Posso fare il 730 da remoto?",
    answer: "Si. Puoi <a href='/prenota'>prenotare una consulenza video</a> e inviarci i documenti via email o WhatsApp. Ti seguiamo in tutte le fasi senza muoverti da casa.",
  },
  {
    question: "Cos'e l'ISEE corrente e quando serve?",
    answer: "L'ISEE corrente fotografa la situazione economica attuale (ultimi 12 mesi) invece che quella di 2 anni fa, ed e utile in caso di calo del reddito (perdita lavoro, riduzione attivita). E valido per 6 mesi dal rilascio.",
  },
  {
    question: "Quanto tempo ci vuole per una successione?",
    answer: "La dichiarazione di successione va presentata <strong>entro 12 mesi</strong> dal decesso. Da noi la pratica dura mediamente 2-4 settimane dalla raccolta dei documenti completi.",
  },
];
---

<BaseLayout
  title="Servizi CAF: 730, ISEE, IMU, Successioni, Contratti, Bonus"
  description="Servizi CAF UNSIC del Centro Pratiche Flaiano a Roma Vigne Nuove: dichiarazione 730, ISEE, IMU/TARI, successioni e volture, contratti di affitto, bonus fiscali. Prezzi chiari, appuntamenti rapidi."
>
  <JsonLdFaq slot="head" items={faq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Servizi", href: "/servizi" }, { name: "CAF", href: "/servizi/caf" }]} class="mb-6" />
      <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-brand-100)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-brand-800)]">
        <Icon name="heroicons:academic-cap" class="size-3.5" /> CAF UNSIC autorizzato
      </span>
      <SectionHeading
        title="Servizi fiscali e tributari"
        subtitle="Il nostro CAF UNSIC ti accompagna in ogni adempimento fiscale: dalla dichiarazione dei redditi alle pratiche catastali."
        class="mt-3"
        level="h1"
      />
    </div>
  </section>

  <section class="section">
    <div class="container-wide grid gap-6 md:grid-cols-2">
      {services.map((s, i) => <ServiceBlock {...s} i={i} />)}
    </div>
  </section>

  <section class="section bg-[var(--color-surface-soft)]">
    <div class="container-narrow">
      <SectionHeading eyebrow="Domande frequenti CAF" title="Le risposte alle domande piu comuni" align="center" />
      <div class="mt-10">
        <Accordion client:visible items={faq} />
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
