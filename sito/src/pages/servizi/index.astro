---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import { Icon } from "astro-icon/components";
import { LANDING } from "~/consts";

const clusters = [
  {
    href: "/servizi/caf",
    eyebrow: "CAF UNSIC",
    title: "Servizi fiscali e tributari",
    desc: "Dichiarazioni dei redditi, ISEE, IMU, successioni, contratti di affitto, bonus fiscali.",
    items: [
      "Modello 730 e Redditi PF",
      "ISEE ordinario, corrente e universitario",
      "Calcolo IMU, TARI, F24",
      "Dichiarazione di successione e voltura catastale",
      "Registrazione contratti di affitto (RLI)",
      "Bonus ristrutturazione, ecobonus, mobili",
    ],
    icon: "heroicons:document-text",
    color: "var(--color-brand-700)",
  },
  {
    href: "/servizi/patronato",
    eyebrow: "Patronato ENASC",
    title: "Pratiche previdenziali e assistenziali",
    desc: "Pensioni, disoccupazione, invalidita civile, Legge 104, assegno unico, maternita.",
    items: [
      "Domanda di pensione di vecchiaia/anticipata",
      "NASpI e dimissioni online",
      "Invalidita civile, Legge 104, accompagnamento",
      "Assegno Unico Universale",
      "ADI, SFL, sostegno al reddito",
      "RED, INVCIV, ACCAS/PS",
    ],
    icon: "heroicons:identification",
    color: "var(--color-accent-600)",
  },
  {
    href: "/servizi/servizi-vari",
    eyebrow: "Servizi amministrativi",
    title: "Pratiche di vita quotidiana",
    desc: "PEC, utenze, certificati, cambi residenza, comunicazioni con la PA.",
    items: [
      "Attivazione PEC e gestione",
      "Cambio residenza e certificati",
      "Confronto e cambio utenze (luce, gas)",
      "Assicurazioni auto e moto",
      "Rateizzazioni Agenzia Entrate Riscossione",
      "Comunicazioni con AdE e INPS",
    ],
    icon: "heroicons:cog-6-tooth",
    color: "var(--color-success-600)",
  },
];
---

<BaseLayout
  title="Tutti i servizi: CAF, Patronato e pratiche amministrative"
  description="I servizi del Centro Pratiche Flaiano a Roma: CAF UNSIC (730, ISEE, IMU, successioni), Patronato ENASC (pensioni, NASpI, AUU, invalidità) e servizi amministrativi (PEC, utenze, certificati)."
>
  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Servizi", href: "/servizi" }]} class="mb-6" />
      <SectionHeading
        eyebrow="I nostri servizi"
        title="Tutto quello che ti serve, in un unico posto"
        subtitle="Il Centro Pratiche Flaiano e CAF UNSIC e Patronato ENASC. Sotto lo stesso tetto trovi competenze fiscali, previdenziali e amministrative."
        level="h1"
      />
    </div>
  </section>

  <section class="wrap" style="padding-top:8px">
    <h2 class="mb-5" style="font-size:clamp(28px,3vw,36px)">I più richiesti</h2>
    <div class="grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))">
      {LANDING.map((l, i) => (
        <a href={l.href} class="tile" style={`min-height:150px;background:${["#D4FF4F","#5B3DF5","#14142B","#F1EEFF","#FFE3EC","#F7F7FB"][i]};color:${[1,2].includes(i) ? "#fff" : "#14142B"}`}>
          {l.tag && <span class="tile-tag" style={`background:${[1,2].includes(i) ? "#D4FF4F" : "#14142B"};color:${[1,2].includes(i) ? "#14142B" : "#fff"}`}>{l.tag}</span>}
          <span class="tile-title" style="font-size:28px">{l.label}</span>
          <span class="tile-go">Scopri →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-tight">
    <h2 class="container-wide mb-6" style="font-size:clamp(28px,3vw,36px)">Tutte le aree</h2>
    <div class="container-wide grid gap-6 lg:grid-cols-3">
      {clusters.map((c, i) => (
        <a href={c.href} class="tile" style={`min-height:0;color:${i === 2 ? "#fff" : "#14142B"};background:${["#F1EEFF", "#FFE3EC", "#14142B"][i]}`}>
          <span style={`width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:${["#5B3DF5", "#FF5C8A", "#D4FF4F"][i]};color:${i === 2 ? "#14142B" : "#fff"}`}>
            <Icon name={c.icon} class="size-6" aria-hidden="true" />
          </span>
          <span style={`font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:${i === 2 ? "#D4FF4F" : "#4B2FE0"}`}>{c.eyebrow}</span>
          <span style="font-family:var(--font-display);font-weight:800;font-size:28px;line-height:1.05">{c.title}</span>
          <span style={`font-size:16px;line-height:1.5;color:${i === 2 ? "#D7D7E6" : "#3F3F5A"}`}>{c.desc}</span>
          <ul class="flex flex-col gap-1.5" style={`font-size:15px;color:${i === 2 ? "#D7D7E6" : "#3F3F5A"}`}>
            {c.items.map((it) => (
              <li class="flex items-start gap-2"><span style="flex:none;margin-top:7px;width:8px;height:8px;border-radius:99px;background:#5B3DF5"></span>{it}</li>
            ))}
          </ul>
          <span class="tile-go" style={`color:${i === 2 ? "#D4FF4F" : "#4B2FE0"}`}>Apri l'area →</span>
        </a>
      ))}
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
