---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import { BOOKING, CONTACT } from "~/consts";
const props = {"eyebrow": "Pensioni · Patronato ENASC", "title": "Quando vai in pensione?", "highlight": "Te lo diciamo noi.", "lead": "Controlliamo i tuoi contributi, ti diciamo le strade possibili e quando conviene uscire. Poi la domanda all'INPS la presentiamo noi.", "chat": {"q": "Ho 40 anni di contributi, quando posso andare in pensione?", "a": "Mandaci l'estratto contributivo o vieni con lo SPID: lo controlliamo insieme.", "done": "Calcolo fatto, domanda pronta"}, "sticker": "Patronato · zero code", "strip": ["Estratto contributivo controllato", "Calcolo delle date di uscita", "Domanda INPS fatta da noi", "Anche in videochiamata"], "needTitle": "Ti serve se…", "needs": [{"t": "ti avvicini alla pensione", "d": "Vecchiaia, anticipata, APE sociale: vediamo quale strada si apre prima e con quale importo."}, {"t": "mancano dei contributi", "d": "Periodi che non risultano, lavori all'estero, servizio militare, laurea: controlliamo e chiediamo la correzione."}, {"t": "sei già in pensione", "d": "Reversibilità, ricostituzione, supplementi, RED e dichiarazioni INPS: non perdere soldi che ti spettano."}], "steps": [{"t": "Controlliamo", "d": "Leggiamo il tuo estratto contributivo e verifichiamo che non manchi niente."}, {"t": "Ti spieghiamo", "d": "Ti diciamo le date possibili e cosa cambia tra un'opzione e l'altra, in parole semplici."}, {"t": "Presentiamo la domanda", "d": "Inviamo la domanda all'INPS come patronato e la seguiamo fino al primo pagamento."}], "docs": ["Documento d'identità e codice fiscale", "SPID o CIE, per scaricare insieme l'estratto contributivo", "Estratto conto contributivo INPS, se ce l'hai già", "Buste paga o contratti dei periodi che non risultano", "IBAN per l'accredito della pensione", "Per la reversibilità: certificato di morte e dati del coniuge", "Per la reversibilità: stato di famiglia e redditi degli ultimi due anni del defunto e del coniuge"], "docsNote": "Non sai cosa portare? Scrivici su WhatsApp e ti facciamo la lista.", "faqs": [{"q": "Quanto prenderò di pensione?", "a": "Dipende dai contributi versati e dal sistema di calcolo. Partiamo dall'estratto contributivo e ti diamo una stima prima di decidere."}, {"q": "Posso andare in pensione prima dei 67 anni?", "a": "In alcuni casi sì: pensione anticipata con i contributi richiesti, APE sociale per alcune categorie, lavori usuranti o precoci. Verifichiamo la tua situazione."}, {"q": "Nel mio estratto mancano dei periodi: cosa faccio?", "a": "Ci porti buste paga, contratti o altri documenti e chiediamo all'INPS di correggere la posizione."}, {"q": "Il patronato si paga?", "a": "Le domande di pensione tramite patronato sono un servizio di tutela. Per eventuali consulenze e calcoli ti diciamo prima il costo; con la tessera hai consulenze gratis."}, {"q": "Quali requisiti servono per la pensione nel 2027?", "a": "Secondo l'INPS (circolare n. 28 del 16 marzo 2026): pensione di vecchiaia a 67 anni e 1 mese nel 2027 (67 anni e 3 mesi nel 2028). Pensione anticipata con 42 anni e 11 mesi di contributi per gli uomini e 41 anni e 11 mesi per le donne nel 2027 (43 anni e 1 mese e 42 anni e 1 mese nel 2028). I lavoratori precoci con mansioni pesanti mantengono 41 anni, e per i lavori usuranti e gravosi non c'è alcun adeguamento. Il tuo caso lo verifichiamo sull'estratto contributivo."}, {"q": "Chi ha diritto alla pensione di reversibilità?", "a": "Il coniuge o la parte dell'unione civile, anche separato; il coniuge divorziato se ha l'assegno di divorzio e non si è risposato (con altre condizioni). Poi i figli minorenni, quelli inabili al lavoro e gli studenti maggiorenni che non lavorano (fino a 21 anni, o fino alla durata del corso universitario e non oltre i 26). Se non ci sono coniuge e figli, i genitori con almeno 65 anni e i fratelli e le sorelle inabili al lavoro, con altre condizioni (fonte: INPS)."}, {"q": "Quanto spetta di reversibilità?", "a": "Dipende da chi resta: al coniuge solo il 60% della pensione del defunto; coniuge con un figlio 80%; coniuge con due o più figli 100%. Se restano solo figli: 70% con un figlio, 80% con due, 100% con tre o più. Ai genitori il 15% per uno e il 30% per due (fonte: INPS). Il calcolo sul tuo caso lo facciamo noi."}, {"q": "Cosa serve per chiedere la reversibilità?", "a": "L'INPS non pubblica un elenco fisso di documenti. La procedura online chiede: codice fiscale, data e luogo del decesso e stato civile della persona morta, il rapporto di parentela di chi chiede, la composizione del nucleo familiare (stato di famiglia) e i redditi degli ultimi due anni del defunto e del coniuge; per i figli studenti, i dati della scuola o dell'università. Portaci quello che hai e al resto pensiamo noi."}, {"q": "Entro quando si chiede la reversibilità e da quando si prende?", "a": "La pagina INPS non indica una scadenza per la domanda. La pensione decorre dal primo giorno del mese successivo al decesso. La domanda possiamo inviarla noi come patronato."}, {"q": "La reversibilità si può chiedere con il patronato?", "a": "Sì: la domanda si presenta online all'INPS, oppure tramite un ente di patronato, oppure chiamando il Contact center INPS al 803 164 (gratuito da rete fissa) o allo 06 164 164 da rete mobile."}], "related": [{"label": "Stima e Calcolo della pensione online", "href": "/stima-pensione"}, {"label": "APE sociale: scadenza 30 novembre", "href": "/blog/ape-sociale-2026-ultima-scadenza-30-novembre"}, {"label": "RED e dichiarazioni INPS", "href": "/blog/red-icric-iclav-accas-ps-2026-guida"}, {"label": "Invalidità e 104", "href": "/invalidita-104"}, {"label": "Modello 730", "href": "/730"}, {"label": "ISEE", "href": "/isee"}]};
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: props.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) });
---
<BaseLayout title={"Pensioni: patronato a Vigne Nuove, Roma"} description={"Patronato ENASC a Roma Vigne Nuove: controllo dei contributi, calcolo e domanda di pensione, APE sociale, reversibilità, ricostituzioni. In ufficio o in video."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="pensioni" name={"Pensioni e consulenza previdenziale"} description={"Controllo dell'estratto contributivo, calcolo della pensione e domanda all'INPS tramite patronato."} serviceType={"Patronato - pensioni"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <div class="lp"><section class="c47" id="fonti">
    <h2 class="c55">Fonti ufficiali</h2>
    <p class="c4"><b>Aggiornato il 13 novembre 2026.</b> Requisiti di età e contributi: quelli previsti per il 2027 e il 2028. Tengono conto dell'adeguamento alla speranza di vita, ma ogni caso va controllato sul tuo estratto contributivo.</p>
    <ul class="c4" style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px">
      <li><a href="https://www.inps.it/it/it/inps-comunica/notizie/dettaglio-news-page.news.2026.03.pensioni-requisiti-aggiornati-per-il-2027-e-il-2028.html" target="_blank" rel="noopener">INPS - Pensioni: requisiti aggiornati per il 2027 e il 2028 (circolare n. 28 del 16 marzo 2026)</a> · vecchiaia e anticipata</li>
      <li><a href="https://www.inps.it/content/dam/inps-site/it/scorporati/circolari-e-messaggi/2026/03/Circolare_15199/Allegati/16640_Circolare-numero-28-del-16-03-2026.pdf" target="_blank" rel="noopener">INPS - Circolare n. 28 del 16 marzo 2026 (testo)</a></li>
      <li><a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.pensione-ai-superstiti-indiretta-e-di-reversibilit--50605.pensione-ai-superstiti-indiretta-e-di-reversibilit-.html" target="_blank" rel="noopener">INPS - Pensione ai superstiti indiretta e di reversibilità (scheda, aggiornata il 12/06/2026)</a> · chi ha diritto, importi, domanda</li>
      <li><a href="https://servizi2.inps.it/servizi/PrestazioniPensionisticheOnline/PDFDaScaricare/ManualeCittPPO.pdf" target="_blank" rel="noopener">INPS - Manuale della procedura di domanda di pensione online</a> · dati richiesti per la reversibilità (versione del 31/03/2020)</li>
    </ul>
    <p class="c4">Hai un dubbio sul tuo caso? <a href={BOOKING.arcanisGroup} style="font-weight:700">Prenota un appuntamento</a> o <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="font-weight:700">scrivici su WhatsApp</a>.</p>
  </section></div>
  <LandingArticles categories={["pensioni", "red-invciv-accas"]} />
</BaseLayout>
