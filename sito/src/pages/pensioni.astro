---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
const props = {"eyebrow": "Pensioni · Patronato ENASC", "title": "Quando vai in pensione?", "highlight": "Te lo diciamo noi.", "lead": "Controlliamo i tuoi contributi, ti diciamo le strade possibili e quando conviene uscire. Poi la domanda all'INPS la presentiamo noi.", "chat": {"q": "Ho 40 anni di contributi, quando posso andare in pensione?", "a": "Mandaci l'estratto contributivo o vieni con lo SPID: lo controlliamo insieme.", "done": "Calcolo fatto, domanda pronta"}, "sticker": "Patronato · zero code", "strip": ["Estratto contributivo controllato", "Calcolo delle date di uscita", "Domanda INPS fatta da noi", "Anche in videochiamata"], "needTitle": "Ti serve se…", "needs": [{"t": "ti avvicini alla pensione", "d": "Vecchiaia, anticipata, APE sociale: vediamo quale strada si apre prima e con quale importo."}, {"t": "mancano dei contributi", "d": "Periodi che non risultano, lavori all'estero, servizio militare, laurea: controlliamo e chiediamo la correzione."}, {"t": "sei già in pensione", "d": "Reversibilità, ricostituzione, supplementi, RED e dichiarazioni INPS: non perdere soldi che ti spettano."}], "steps": [{"t": "Controlliamo", "d": "Leggiamo il tuo estratto contributivo e verifichiamo che non manchi niente."}, {"t": "Ti spieghiamo", "d": "Ti diciamo le date possibili e cosa cambia tra un'opzione e l'altra, in parole semplici."}, {"t": "Presentiamo la domanda", "d": "Inviamo la domanda all'INPS come patronato e la seguiamo fino al primo pagamento."}], "docs": ["Documento d'identità e codice fiscale", "SPID o CIE, per scaricare insieme l'estratto contributivo", "Estratto conto contributivo INPS, se ce l'hai già", "Buste paga o contratti dei periodi che non risultano", "IBAN per l'accredito della pensione", "Per la reversibilità: certificato di morte e dati del coniuge"], "docsNote": "Non sai cosa portare? Scrivici su WhatsApp e ti facciamo la lista.", "faqs": [{"q": "Quanto prenderò di pensione?", "a": "Dipende dai contributi versati e dal sistema di calcolo. Partiamo dall'estratto contributivo e ti diamo una stima prima di decidere."}, {"q": "Posso andare in pensione prima dei 67 anni?", "a": "In alcuni casi sì: pensione anticipata con i contributi richiesti, APE sociale per alcune categorie, lavori usuranti o precoci. Verifichiamo la tua situazione."}, {"q": "Nel mio estratto mancano dei periodi: cosa faccio?", "a": "Ci porti buste paga, contratti o altri documenti e chiediamo all'INPS di correggere la posizione."}, {"q": "Il patronato si paga?", "a": "Le domande di pensione tramite patronato sono un servizio di tutela. Per eventuali consulenze e calcoli ti diciamo prima il costo; con la tessera hai consulenze gratis."}], "related": [{"label": "APE sociale: scadenza 30 novembre", "href": "/blog/ape-sociale-2026-ultima-scadenza-30-novembre"}, {"label": "RED e dichiarazioni INPS", "href": "/blog/red-icric-iclav-accas-ps-2026-guida"}, {"label": "Invalidità e 104", "href": "/invalidita-104"}, {"label": "Modello 730", "href": "/730"}, {"label": "ISEE", "href": "/isee"}]};
const faqLd = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Quanto prenderò di pensione?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dipende dai contributi versati e dal sistema di calcolo. Partiamo dall'estratto contributivo e ti diamo una stima prima di decidere.\"}}, {\"@type\": \"Question\", \"name\": \"Posso andare in pensione prima dei 67 anni?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"In alcuni casi sì: pensione anticipata con i contributi richiesti, APE sociale per alcune categorie, lavori usuranti o precoci. Verifichiamo la tua situazione.\"}}, {\"@type\": \"Question\", \"name\": \"Nel mio estratto mancano dei periodi: cosa faccio?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ci porti buste paga, contratti o altri documenti e chiediamo all'INPS di correggere la posizione.\"}}, {\"@type\": \"Question\", \"name\": \"Il patronato si paga?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Le domande di pensione tramite patronato sono un servizio di tutela. Per eventuali consulenze e calcoli ti diciamo prima il costo; con la tessera hai consulenze gratis.\"}}]}";
---
<BaseLayout title={"Pensioni: patronato a Vigne Nuove, Roma"} description={"Patronato ENASC a Roma Vigne Nuove: controllo dei contributi, calcolo e domanda di pensione, APE sociale, reversibilità, ricostituzioni. In ufficio o in video."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="pensioni" name={"Pensioni e consulenza previdenziale"} description={"Controllo dell'estratto contributivo, calcolo della pensione e domanda all'INPS tramite patronato."} serviceType={"Patronato - pensioni"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <LandingArticles categories={["pensioni", "red-invciv-accas"]} />
</BaseLayout>
