---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import { BOOKING, CONTACT } from "~/consts";
const props = {"eyebrow": "RED e INVCIV · Patronato", "title": "L'INPS ti chiede il RED?", "highlight": "Lo facciamo noi.", "lead": "Se prendi una pensione legata al reddito o una prestazione di invalidità, ogni anno l'INPS vuole sapere redditi, ricoveri o lavoro. Se non rispondi rischi trattenute e la revoca. RED e ACC.AS/PS li trasmettiamo noi come CAF convenzionato; ICRIC e ICLAV li compiliamo con te, online, con il tuo SPID o la tua CIE.", "chat": {"q": "Mi è arrivata una lettera dall'INPS sul modello RED, cosa devo fare?", "a": "Portaci la lettera e i redditi dell'anno: controlliamo cosa va dichiarato e inviamo il RED. Se c'è già una trattenuta, vediamo come sistemarla.", "done": "RED inviato"}, "sticker": "Campagna RED 2026", "strip": ["Modello RED", "ICRIC ricoveri", "ICLAV lavoro", "ACC.AS/PS"], "needs": [{"t": "prendi una pensione legata al reddito", "d": "Integrazione al minimo, maggiorazioni, assegno sociale, reversibilità: se hai redditi fuori dal 730 serve il RED."}, {"t": "prendi l'accompagnamento", "d": "Ogni anno va presentato l'ICRIC, anche se non sei mai stato ricoverato."}, {"t": "hai l'assegno di invalidità", "d": "L'ICLAV dichiara se hai lavorato e quanto. Si presenta insieme al RED."}, {"t": "ti hanno già scritto o trattenuto", "d": "Portaci la comunicazione: controlliamo se c'è ancora margine per sistemare la posizione."}], "steps": [{"t": "Ci porti la lettera o i redditi", "d": "CU, interessi di conti e titoli, redditi esteri, eventuali ricoveri."}, {"t": "Controlliamo cosa dichiarare", "d": "Ti diciamo quali dichiarazioni servono a te e ai familiari che contano."}, {"t": "Inviamo o compiliamo con te", "d": "RED e ACC.AS/PS li trasmettiamo noi come CAF convenzionato, con ricevuta. ICRIC e ICLAV si fanno online: li compiliamo insieme in ufficio con il tuo SPID o la tua CIE."}], "docs": ["Documento e codice fiscale", "Lettera o richiesta dell'INPS, se l'hai ricevuta", "Certificazione Unica e altri redditi dell'anno", "Interessi di conti, libretti, titoli e buoni postali", "Per ICRIC e ACC.AS/PS: date e struttura di eventuali ricoveri", "Per ICLAV: buste paga o redditi da lavoro", "Per il ricovero in una struttura sanitaria pubblica: il documento che attesta il contributo a carico di enti pubblici o tuo e dei familiari"], "docsNote": "Hai fatto il 730 con tutti i redditi? Spesso il RED non serve: lo verifichiamo insieme.", "faqs": [{"q": "Ho fatto il 730: devo fare anche il RED?", "a": "No, se tu e i familiari che contano avete dichiarato nel 730 tutti i redditi richiesti. Servono però interessi su conti, titoli e buoni postali o redditi esteri non presenti nel 730."}, {"q": "Prendo solo l'accompagnamento: cosa devo presentare?", "a": "L'ICRIC, anche se non sei mai stato ricoverato. Il RED no, perché l'accompagnamento non ha limiti di reddito."}, {"q": "Cosa succede se non presento il RED?", "a": "L'INPS sollecita, poi applica una trattenuta e sospende la prestazione; alla fine la revoca e chiede indietro le somme non dovute."}, {"q": "Ho più di 76 anni: devo farlo?", "a": "Sì se nell'ultima dichiarazione avevi almeno un reddito, o se in famiglia c'è qualcuno sotto i 76 anni con redditi che contano."}, {"q": "Entro quando va presentato il RED 2026?", "a": "Per la campagna RED 2026, sui redditi del 2025, il termine indicato dall'INPS è il 1° marzo 2027, sia per il RED sia per la dichiarazione di responsabilità ACC.AS/PS (INPS, messaggio n. 3697 del 12 novembre 2026)."}, {"q": "Chi deve presentare il RED?", "a": "Chi prende prestazioni collegate al reddito: per esempio maggiorazione sociale, integrazione al trattamento minimo, assegno sociale e somma aggiuntiva (la quattordicesima). I titolari di pensione e assegno sociale presentano anche la dichiarazione di responsabilità."}, {"q": "Cos'è l'ACC.AS/PS?", "a": "È il modello con cui si dichiara di risiedere davvero in Italia. Per la pensione sociale basta questo; per l'assegno sociale e l'assegno sociale sostitutivo di invalidità civile si dichiara anche l'eventuale ricovero gratuito."}, {"q": "Posso presentare il RED da solo?", "a": "Sì: il RED si può fare dal servizio online \"RED Precompilato\" o da MyINPS con la tua identità digitale, oppure tramite un CAF o un professionista abilitato. Se preferisci non farlo da solo, lo trasmettiamo noi."}, {"q": "ICRIC e ICLAV sono obbligatori ogni anno?", "a": "Sì, l'invio è annuale ed è obbligatorio per continuare a ricevere le prestazioni assistenziali. Si fanno online con le credenziali del titolare: in ufficio li compiliamo insieme (fonte: INPS)."}], "related": [{"label": "Guida RED e INVCIV 2026", "href": "/blog/red-icric-iclav-accas-ps-2026-guida"}, {"label": "Pensioni", "href": "/pensioni"}, {"label": "Invalidità e 104", "href": "/invalidita-104"}, {"label": "Modello 730", "href": "/730"}]};
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: props.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") } })) });
---
<BaseLayout title={"Modello RED, ICRIC, ICLAV e ACC.AS/PS a Roma"} description={"RED 2026 sui redditi 2025 e ACC.AS/PS entro il 1° marzo 2027, ICRIC e ICLAV per invalidi civili: le facciamo con te. CAF e patronato a Vigne Nuove, Roma."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="red-invciv" name={"Modello RED e dichiarazioni invalidi civili"} description={"Invio all'INPS del modello RED e delle dichiarazioni di responsabilità ICRIC, ICLAV e ACC.AS/PS per pensionati e invalidi civili."} serviceType={"Patronato - dichiarazioni reddituali INPS"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <div class="lp"><section class="c47" id="fonti">
    <h2 class="c55">Fonti ufficiali</h2>
    <p class="c4"><b>Aggiornato il 13 novembre 2026.</b> Il termine del 1° marzo 2027 riguarda il RED ordinario 2026 e le dichiarazioni di responsabilità. L'INPS non indica una data unica per ICRIC e ICLAV: per le tue scadenze scrivici o prenota.</p>
    <ul class="c4" style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px">
      <li><a href="https://www.inps.it/it/it/inps-comunica/notizie/dettaglio-news-page.news.2026.11.avvio-campagna-red-ordinaria-2026-e-dichiarazioni-di-responsabilit.html" target="_blank" rel="noopener">INPS - Avvio Campagna RED ordinaria 2026 e dichiarazioni di responsabilità (messaggio n. 3697 del 12 novembre 2026)</a> · termine del 1° marzo 2027</li>
      <li><a href="https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Dichiarazioni-di-responsabilita-e-ricoveri-indennizzati.html" target="_blank" rel="noopener">INPS - Dichiarazioni di responsabilità e ricoveri indennizzati (ICRIC, ICLAV, ACC.AS/PS)</a> · chi li presenta e come</li>
    </ul>
    <p class="c4">Hai un dubbio sul tuo caso? <a href={BOOKING.arcanisGroup} style="font-weight:700">Prenota un appuntamento</a> o <a href={CONTACT.whatsapp.link} target="_blank" rel="noopener" style="font-weight:700">scrivici su WhatsApp</a>.</p>
  </section></div>
  <LandingArticles categories={["red-invciv-accas", "pensioni"]} />
</BaseLayout>
