---
/**
 * Calcolatore del costo di colf, badanti e baby sitter 2026 (25/11/2026).
 * Dati e regole in src/lib/costo-colf.ts (con le fonti). Gli esempi della pagina sono calcolati con la stessa funzione.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { calcola, eur, LIVELLI, MENSILE_CONVIVENTI, MENSILE_CONVIVENTI_30, ORARIA, VITTO_ALLOGGIO_GIORNO, IND_BABYSITTER, IND_PIU_ASSISTITI, INDENNITA_FUNZIONE, AGGIORNATO, DEDUZIONE_MAX } from "~/lib/costo-colf";

const WA = "393716230690";
const esempi = [
  { t: "Badante convivente di persona non autosufficiente (C super), 54 ore", i: { tipo: "convivente", livello: "CS", ore: 54 } },
  { t: "Badante convivente di persona autosufficiente (B super), 54 ore", i: { tipo: "convivente", livello: "BS", ore: 54 } },
  { t: "Colf a ore (B), 10 ore a settimana, paga minima", i: { tipo: "orario", livello: "B", ore: 10 } },
  { t: "Colf a ore (B), 20 ore a settimana, 9 € l'ora", i: { tipo: "orario", livello: "B", ore: 20, paga: 9 } },
].map((e) => ({ ...e, r: calcola(e.i as any) }));

const faqs = [
  { q: "Quanto costa una badante convivente nel 2026?", a: `Con la paga minima, una badante convivente di persona non autosufficiente (livello C super) per 54 ore a settimana costa circa ${eur(esempi[0].r.costoAnno)} l'anno, cioè ${eur(esempi[0].r.costoMese)} al mese in media: stipendio, tredicesima, contributi INPS e Cassa Colf a carico tuo e TFR. Vitto e alloggio dati in casa sono a parte.` },
  { q: "Quanto si paga una colf a ore nel 2026?", a: `Il minimo orario 2026 per una colf di livello B (pulizie, cucina e lavanderia) è di ${eur(ORARIA.B)} lordi l'ora. Oltre alla paga ci sono tredicesima, contributi INPS (da 1,24 a 2,34 € l'ora in totale) e TFR.` },
  { q: "Quanto costano i contributi INPS di una colf o badante?", a: "Dipende dalla paga oraria effettiva e dalle ore: nel 2026 da 1,70 a 2,34 € l'ora fino a 24 ore a settimana, 1,24 € l'ora sopra le 24 ore (contratti a tempo indeterminato). Una parte, da 0,31 a 0,59 € l'ora, è a carico della lavoratrice e si trattiene dallo stipendio." },
  { q: "Vitto e alloggio fanno parte dello stipendio?", a: `Per chi vive in casa vitto e alloggio si danno in natura e non si pagano in denaro, ma il loro valore convenzionale (${eur(VITTO_ALLOGGIO_GIORNO)} al giorno nel 2026) conta per tredicesima, TFR e contributi. Se non li dai, li paghi come indennità.` },
  { q: "Cosa si può scaricare nel 730?", a: `I contributi INPS a carico tuo si deducono dal reddito fino a ${eur(DEDUZIONE_MAX)} l'anno. Per la badante di una persona non autosufficiente c'è anche la detrazione del 19% su massimo 2.100 € di spesa, se il tuo reddito è sotto i 40.000 €.` },
  { q: "I valori cambiano nel 2027?", a: "Sì. Il contratto nazionale prevede un aumento dal 1° gennaio 2027 più l'adeguamento ISTAT, e l'INPS aggiorna i contributi ogni anno. Le nuove tabelle escono di solito tra gennaio e febbraio: aggiorneremo il calcolatore appena pubblicate." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo costo colf e badante 2026", url: "https://praticheflaiano.it/calcolo-costo-colf-badante", applicationCategory: "FinanceApplication", operatingSystem: "Web", isAccessibleForFree: true, inLanguage: "it", offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" } });
const H2 = "margin:24px 0 0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(28px,5vw,40px);line-height:1.05;color:#14142B";
const TD = "padding:10px;border-top:1px solid #E4E0FF;vertical-align:top";
const TDR = TD + ";text-align:right;white-space:nowrap";
const TH = "text-align:left;padding:10px;background:#14142B;color:#fff";
const A = "color:#4B2FE0;text-decoration:underline";
const num = (n: number) => n.toFixed(2).replace(".", ",");
---

<BaseLayout title="Calcolo costo colf e badante 2026: stipendio e contributi" ogImage="/og/calcolo-costo-colf-badante.jpg" description="Quanto costa una colf, una badante o una baby sitter nel 2026: stipendio minimo, tredicesima, contributi INPS e TFR. Calcolatore gratuito del CAF di Roma.">
  <script slot="head" type="application/ld+json" set:html={appLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <section style="background:#F1EEFF">
    <div style="max-width:1120px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:18px">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Calcolatore gratuito · valori 2026</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Quanto costa una colf o una badante?</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A;max-width:780px">Scegli il tipo di rapporto, il livello e le ore: vedi <b>stipendio</b>, <b>tredicesima</b>, <b>contributi INPS</b>, <b>TFR</b> e il <b>costo totale per la famiglia</b>, con i minimi del contratto nazionale e i contributi INPS del 2026.</p>

      <form id="cc" onsubmit="return false" novalidate style="background:#fff;border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:16px;box-shadow:0 6px 0 #14142B;max-width:780px">
        <fieldset class="cc-f"><legend>1. Dove vive la lavoratrice?</legend>
          <label class="cc-o"><input type="radio" name="cc-tipo" value="convivente" checked> Vive in casa con voi (convivente)</label>
          <label class="cc-o"><input type="radio" name="cc-tipo" value="convivente30"> Vive in casa, ma lavora fino a 30 ore a settimana</label>
          <label class="cc-o"><input type="radio" name="cc-tipo" value="orario"> Non vive in casa: lavora a ore</label>
        </fieldset>

        <label class="cc-l" for="cc-liv">2. Cosa fa (livello del contratto)
          <select id="cc-liv" class="cc-in">
            {LIVELLI.map((l) => <option value={l.id} selected={l.id === "CS"}>{l.nome}: {l.esempi}</option>)}
          </select>
        </label>

        <div style="display:flex;flex-wrap:wrap;gap:16px">
          <label class="cc-l" for="cc-ore" style="flex:1 1 200px">3. Ore a settimana
            <input id="cc-ore" class="cc-in" type="number" min="1" max="54" step="1" inputmode="numeric" value="54">
            <small id="cc-ore-h" class="cc-h">Chi vive in casa: massimo 54 ore (10 al giorno).</small>
          </label>
          <label class="cc-l" id="cc-gg-w" for="cc-gg" style="flex:1 1 200px">Giorni di lavoro a settimana
            <input id="cc-gg" class="cc-in" type="number" min="1" max="7" step="1" inputmode="numeric" value="6">
            <small class="cc-h">Serve solo per chi vive in casa e lavora meno di 25 ore.</small>
          </label>
        </div>

        <label class="cc-l" for="cc-paga"><span id="cc-paga-t">4. Stipendio lordo al mese, se è più alto del minimo (facoltativo)</span>
          <input id="cc-paga" class="cc-in" type="number" min="0" step="0.01" inputmode="decimal" placeholder="lascia vuoto per il minimo" style="max-width:260px">
        </label>

        <fieldset class="cc-f"><legend>5. Altre situazioni</legend>
          <label class="cc-o"><input type="checkbox" id="cc-td"> Contratto a tempo determinato</label>
          <label class="cc-o"><input type="checkbox" id="cc-bs"> Baby sitter con bambini fino a 6 anni (livello B super)</label>
          <label class="cc-o"><input type="checkbox" id="cc-pa"> Assiste più di una persona non autosufficiente (C super o D super)</label>
        </fieldset>

        <button id="cc-b" type="button" style="align-self:flex-start;background:#5B3DF5;color:#fff;font-weight:800;border:0;border-radius:999px;padding:14px 26px;font-size:17px;cursor:pointer">Calcola il costo</button>
        <div id="cc-out" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section style="max-width:860px;margin:0 auto;padding:48px 16px 64px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#2A2A40">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: {AGGIORNATO}.</b> Minimi 2026 della tabella del Ministero del Lavoro (decorrenza 1° gennaio 2026), contratto nazionale del lavoro domestico del 28 ottobre 2025 e contributi della circolare INPS n. 9 del 3 febbraio 2026. I valori 2027 escono tra gennaio e febbraio: aggiorneremo il calcolatore.</p>

    <h2 style={H2.replace("24px 0 0", "0")}>Quattro esempi con la paga minima 2026</h2>
    <div style="overflow-x:auto" tabindex="0" role="region" aria-label="Tabella: Esempi di costo 2026"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Rapporto</th><th style={TH}>Stipendio lordo al mese</th><th style={TH}>Costo per la famiglia all'anno</th><th style={TH}>Media al mese</th></tr></thead>
      <tbody>
        {esempi.map((e) => <tr><td style={TD}>{e.t}</td><td style={TDR}>{eur(e.r.mensileLorda)}</td><td style={TDR}><b>{eur(e.r.costoAnno)}</b></td><td style={TDR}>{eur(e.r.costoMese)}</td></tr>)}
      </tbody>
    </table></div>
    <p style="margin:0;font-size:15px;color:#3F3F5A">Il costo per la famiglia comprende 12 stipendi, tredicesima, contributi INPS e Cassa Colf a carico del datore di lavoro e TFR. Non comprende vitto e alloggio dati in natura, scatti di anzianità, straordinari e festività lavorate.</p>

    <h2 style={H2}>Come si calcola</h2>
    <ul style="margin:0;padding-left:22px;display:flex;flex-direction:column;gap:8px">
      <li><b>Stipendio</b>: il minimo dipende dal <b>livello</b> e dal fatto che la lavoratrice <b>viva in casa</b> o lavori <b>a ore</b>. Si può pagare di più, mai di meno.</li>
      <li><b>Vitto e alloggio</b>: per chi vive in casa si danno in natura. Il loro valore ({eur(VITTO_ALLOGGIO_GIORNO)} al giorno, {eur(VITTO_ALLOGGIO_GIORNO * 30)} al mese) entra in tredicesima, TFR e contributi.</li>
      <li><b>Tredicesima</b>: una mensilità in più a dicembre, compreso il valore di vitto e alloggio.</li>
      <li><b>Contributi INPS</b>: si pagano per ogni ora retribuita, ogni tre mesi. Fino a 24 ore a settimana il contributo dipende dalla <b>paga oraria effettiva</b> (paga, più vitto e alloggio e tredicesima divisi per le ore); sopra le 24 ore è fisso.</li>
      <li><b>Cassa Colf</b>: 0,06 € l'ora, di cui 0,02 € a carico della lavoratrice. Si paga insieme ai contributi INPS.</li>
      <li><b>TFR</b>: ogni anno si accantona la somma delle retribuzioni, compresi tredicesima e vitto e alloggio, divisa per 13,5. Si paga quando il rapporto finisce.</li>
    </ul>

    <p class="cta-tool-wrap" style="margin:8px 0 0"><a class="cta-tool" href="/colf-badanti"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Buste paga e contributi li facciamo noi</span><span class="cta-tool-s">Servizio colf e badanti a Roma: un prezzo all'anno, tutto compreso</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>

    <h2 style={H2}>Stipendi minimi 2026 di colf, badanti e baby sitter</h2>
    <p style="margin:0">Valori lordi in vigore dal 1° gennaio 2026. Per i livelli D e D super, chi vive in casa riceve anche l'indennità di funzione di {eur(INDENNITA_FUNZIONE)} al mese (già sommata nel calcolatore).</p>
    <div style="overflow-x:auto" tabindex="0" role="region" aria-label="Tabella: Stipendi minimi 2026"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Livello</th><th style={TH}>Chi è</th><th style={TH}>Vive in casa (al mese)</th><th style={TH}>Vive in casa, fino a 30 ore</th><th style={TH}>A ore (all'ora)</th></tr></thead>
      <tbody>
        {LIVELLI.map((l) => <tr>
          <td style={TD}><b>{l.nome}</b></td><td style={TD}>{l.esempi}</td>
          <td style={TDR}>{num(l.id === "D" || l.id === "DS" ? MENSILE_CONVIVENTI[l.id] - INDENNITA_FUNZIONE : MENSILE_CONVIVENTI[l.id])} €{(l.id === "D" || l.id === "DS") && <><br /><small>+ {num(INDENNITA_FUNZIONE)} € indennità</small></>}</td>
          <td style={TDR}>{MENSILE_CONVIVENTI_30[l.id] ? num(MENSILE_CONVIVENTI_30[l.id]!) + " €" : "-"}</td>
          <td style={TDR}>{num(ORARIA[l.id])} €</td>
        </tr>)}
      </tbody>
    </table></div>
    <ul style="margin:0;padding-left:22px;display:flex;flex-direction:column;gap:6px;font-size:16px">
      <li><b>Vitto e alloggio</b> (valore giornaliero): pranzo o colazione 2,33 €, cena 2,33 €, alloggio 2,00 €, totale {eur(VITTO_ALLOGGIO_GIORNO)}.</li>
      <li><b>Baby sitter con bambini fino a 6 anni</b> (B super): in più {eur(IND_BABYSITTER.convivente)} al mese se vive in casa, {eur(IND_BABYSITTER.convivente30)} se vive in casa fino a 30 ore, {eur(IND_BABYSITTER.orario)} l'ora se lavora a ore.</li>
      <li><b>Badante di più persone non autosufficienti</b> (C super e D super): in più {eur(IND_PIU_ASSISTITI.mensile)} al mese, oppure {eur(IND_PIU_ASSISTITI.orario)} l'ora.</li>
      <li><b>Scatti di anzianità</b>: +4% del minimo ogni due anni con lo stesso datore di lavoro, fino a 7 scatti.</li>
    </ul>

    <h2 style={H2}>Contributi INPS 2026</h2>
    <div style="overflow-x:auto" tabindex="0" role="region" aria-label="Tabella: Contributi INPS 2026"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Paga oraria effettiva</th><th style={TH}>Contributo all'ora</th><th style={TH}>Di cui a carico della lavoratrice</th></tr></thead>
      <tbody>
        <tr><td style={TD}>fino a 9,61 €</td><td style={TDR}>1,70 €</td><td style={TDR}>0,43 €</td></tr>
        <tr><td style={TD}>oltre 9,61 e fino a 11,70 €</td><td style={TDR}>1,92 €</td><td style={TDR}>0,48 €</td></tr>
        <tr><td style={TD}>oltre 11,70 €</td><td style={TDR}>2,34 €</td><td style={TDR}>0,59 €</td></tr>
        <tr><td style={TD}>più di 24 ore a settimana</td><td style={TDR}>1,24 €</td><td style={TDR}>0,31 €</td></tr>
      </tbody>
    </table></div>
    <p style="margin:0;font-size:15px;color:#3F3F5A">Importi con la quota CUAF, per i contratti a tempo indeterminato. Per quelli a termine c'è un contributo in più (1,82, 2,05, 2,50 e 1,32 € l'ora), salvo sostituzione di una lavoratrice assente. Le scadenze sono ogni tre mesi: leggi la <a href="/blog/colf-badanti-roma-contributi-inps-2026-scadenze" style={A}>guida ai contributi e alle scadenze 2026</a>.</p>

    <h2 style={H2}>Domande frequenti</h2>
    {faqs.map((f) => (<><h3 style="margin:12px 0 0;font-size:19px">{f.q}</h3><p style="margin:0">{f.a}</p></>))}

    <h2 style={H2}>Vuoi un preventivo per gestire tutto?</h2>
    <p style="margin:0">Al Centro Pratiche Flaiano, CAF UNSIC a <b>Roma Vigne Nuove</b> (Municipio III, vicino a Tufello, Conca d'Oro, Bufalotta e Porta di Roma), con il servizio <b>Unsicolf</b> facciamo contratto, assunzione all'INPS, buste paga, contributi ogni tre mesi, ferie, malattia e riepilogo annuale. Un prezzo all'anno, tutto compreso: scrivici e te lo mandiamo.</p>
    <p style="margin:0;display:flex;flex-wrap:wrap;gap:10px">
      <a href={`https://wa.me/${WA}?text=${encodeURIComponent("Ciao, vorrei il preventivo annuale del servizio colf e badanti.")}`} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;padding:12px 20px;border-radius:999px;background:#25D366;color:#14142B;font-weight:800;text-decoration:none">Preventivo su WhatsApp</a>
      <a href="/prenota" style="display:inline-flex;align-items:center;padding:12px 20px;border-radius:999px;background:#14142B;color:#fff;font-weight:800;text-decoration:none">Prenota un appuntamento</a>
    </p>

    <p style="margin:12px 0 0;font-size:14px;line-height:1.6;color:#3F3F5A">Fonti: <a href="https://www.lavoro.gov.it/notizie/pagine/lavoro-domestico-accordo-sui-minimi-retributivi-2026" target="_blank" rel="noopener" style={A}>Ministero del Lavoro, accordo sui minimi retributivi 2026 e tabella</a>; <a href="https://associazionedomina.it/ccnl-lavoro-domestico/" target="_blank" rel="noopener" style={A}>CCNL lavoro domestico del 28 ottobre 2025</a> (artt. 9, 14, 34, 36, 37, 39, 41, 54); <a href="https://www.inps.it/it/it/inps-comunica/atti/circolari-messaggi-e-normativa/dettaglio.circolari-e-messaggi.2026.02.circolare-numero-9-del-03-02-2026_15154.html" target="_blank" rel="noopener" style={A}>INPS, circolare n. 9 del 3 febbraio 2026</a>; <a href="https://www.inps.it/it/it/dettaglio-approfondimento.schede-informative.49828.contributi-e-agevolazioni-fiscali-per-chi-assume-un-lavoratore-domestico.html" target="_blank" rel="noopener" style={A}>INPS, contributi e agevolazioni fiscali per chi assume un lavoratore domestico</a>. Il calcolatore dà una stima: per il tuo caso conta il contratto firmato con la lavoratrice.</p>
  </section>

  <style is:global>
    #cc-out{scroll-margin-top:90px}
    .cc-f{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:6px}
    .cc-f legend{font-weight:800;margin-bottom:8px}
    .cc-l{display:flex;flex-direction:column;gap:6px;font-weight:800}
    .cc-h{font-weight:400;color:#5B5B72;font-size:14px}
    .cc-in{border:2px solid #14142B;border-radius:14px;padding:11px 12px;font-size:17px;background:#fff;width:100%;max-width:100%;font-weight:400;color:#14142B}
    .cc-o{display:flex;align-items:center;gap:10px;font-size:16px;cursor:pointer;font-weight:400;min-height:28px}
    .cc-o input{width:20px;height:20px;accent-color:#5B3DF5;flex:none}
    .cc-res{border-radius:20px;padding:18px 20px;line-height:1.5;margin-top:4px}
    .cc-ok{background:#D4FF4F;color:#14142B}
    .cc-warn{background:#FFF4D6;color:#14142B}
    .cc-res b.big{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:40px;line-height:1.05;margin:4px 0}
    .cc-res table{border-collapse:collapse;margin-top:8px;font-size:15px;width:100%}
    .cc-res td{padding:4px 8px 4px 0;vertical-align:top;border-top:1px solid rgba(20,20,43,.15)}
    .cc-res a.cc-btn{display:inline-flex;align-items:center;padding:10px 16px;border-radius:999px;font-weight:800;text-decoration:none;margin:10px 10px 0 0}
  </style>
  <script>
    import { calcola, eur, LIVELLI } from "~/lib/costo-colf";
    const $ = (i: string) => document.getElementById(i) as HTMLInputElement;
    const tipo = () => (document.querySelector('input[name="cc-tipo"]:checked') as HTMLInputElement).value as "convivente" | "convivente30" | "orario";
    function aggiorna() {
      const t = tipo();
      const ore = $("cc-ore");
      $("cc-paga-t").textContent = t === "orario" ? "4. Paga oraria lorda, se è più alta del minimo (facoltativo)" : "4. Stipendio lordo al mese, se è più alto del minimo (facoltativo)";
      $("cc-ore-h").textContent = t === "convivente" ? "Chi vive in casa: massimo 54 ore (10 al giorno)." : t === "convivente30" ? "Massimo 30 ore. Possibile solo per i livelli B, B super e C." : "Orario normale fino a 40 ore a settimana.";
      ore.max = t === "convivente" ? "54" : t === "convivente30" ? "30" : "40";
      if (t === "convivente" && (!ore.value || +ore.value <= 30)) ore.value = "54";
      if (t === "convivente30" && (!ore.value || +ore.value > 30)) ore.value = "30";
      if (t === "orario" && (!ore.value || +ore.value > 40)) ore.value = "10";
      ($("cc-gg-w") as unknown as HTMLElement).style.display = t === "orario" ? "none" : "";
    }
    document.querySelectorAll('input[name="cc-tipo"]').forEach((r) => r.addEventListener("change", aggiorna));
    aggiorna();
    function show(c: string, h: string) { const o = $("cc-out"); o.innerHTML = '<div class="cc-res ' + c + '">' + h + "</div>"; o.scrollIntoView({ behavior: "smooth", block: "nearest" }); }
    $("cc-b").addEventListener("click", () => {
      const t = tipo();
      const liv = ($("cc-liv") as unknown as HTMLSelectElement).value as any;
      const paga = parseFloat(String($("cc-paga").value).replace(",", "."));
      const r = calcola({ tipo: t, livello: liv, ore: parseFloat($("cc-ore").value), giorni: parseFloat($("cc-gg").value), paga: paga > 0 ? paga : undefined, termine: $("cc-td").checked, babysitter: $("cc-bs").checked, piuAssistiti: $("cc-pa").checked });
      if (!r.ok) { show("cc-warn", r.errore || "Controlla i dati."); return; }
      const nomeLiv = LIVELLI.find((l) => l.id === liv)!.nome;
      const desc = (t === "orario" ? "a ore" : "convivente") + ", livello " + nomeLiv + ", " + $("cc-ore").value + " ore a settimana";
      const riga = (a: string, b: number, x = "") => "<tr><td>" + a + "</td><td style=\"text-align:right;white-space:nowrap\"><b>" + eur(b) + "</b>" + x + "</td></tr>";
      const tab = "<table>" +
        riga("Stipendio lordo " + (t === "orario" ? "medio " : "") + "al mese", r.mensileLorda) +
        (r.vittoMese ? riga("Vitto e alloggio (valore, dati in casa)", r.vittoMese, " al mese") : "") +
        riga("Tredicesima (a dicembre)", r.tredicesima) +
        riga("Contributi INPS a carico tuo, all'anno", r.contributiDatore) +
        riga("Contributi trattenuti alla lavoratrice, all'anno", r.contributiLav) +
        riga("Cassa Colf a carico tuo, all'anno", r.cassaDatore) +
        riga("TFR accantonato in un anno", r.tfr) +
        riga("Stipendio netto medio per la lavoratrice", r.nettoMese, " al mese") +
        "</table>";
      const av = r.avvisi.length ? '<ul style="margin:10px 0 0;padding-left:20px">' + r.avvisi.map((x) => "<li>" + x + "</li>").join("") + "</ul>" : "";
      const msg = "Ciao, ho usato il calcolatore colf e badanti: " + desc + ", costo stimato " + eur(r.costoAnno) + " l'anno. Vorrei il preventivo per gestire contratto, buste paga e contributi.";
      show("cc-ok", "Costo stimato per la famiglia:<b class=\"big\">" + eur(r.costoAnno) + " l'anno</b>circa " + eur(r.costoMese) + " al mese in media (" + desc + "). Contributo INPS: " + eur(r.contributoOrario) + " l'ora." + tab +
        '<p style="margin:10px 0 0">Nel 730 puoi dedurre dal reddito <b>' + eur(r.deducibile) + "</b> di contributi pagati da te (massimo 1.549,37 € l'anno).</p>" + av +
        '<p style="margin:10px 0 0;font-size:14px">Stima con i valori 2026. Non comprende vitto e alloggio dati in natura, scatti di anzianità, straordinari e festività lavorate.</p>' +
        '<p style="margin:0"><a class="cc-btn" style="background:#25D366;color:#14142B" target="_blank" rel="noopener" href="https://wa.me/393716230690?text=' + encodeURIComponent(msg) + '">Chiedi il preventivo su WhatsApp</a><a class="cc-btn" style="background:#14142B;color:#fff" href="/prenota">Prenota un appuntamento</a></p>');
    });
  </script>
</BaseLayout>
