---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import body from "~/fragments/naspi.html?raw";
const NASPI_SURVEY = "https://link.arcanis.it/widget/survey/sImJrbagruVY43JLeqA9";
const ld = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Se mi sono dimesso mi spetta?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Di regola no, salvo dimissioni per giusta causa o casi particolari. Raccontaci la tua situazione e verifichiamo.\"}}, {\"@type\": \"Question\", \"name\": \"Quanto prendo e per quanto tempo?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dipende dagli stipendi e dalle settimane lavorate negli ultimi anni. Lo calcoliamo insieme al primo incontro.\"}}, {\"@type\": \"Question\", \"name\": \"Il SIISL è obbligatorio? Posso farlo da solo?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"L'INPS ti iscrive in automatico. Entro 15 giorni dall'inizio della NASpI devi entrare sul SIISL, compilare il curriculum e firmare il Patto di attivazione digitale. Puoi farlo da solo e gratis con SPID o CIE su siisl.lavoro.gov.it. Se preferisci che lo compiliamo noi in ufficio, il servizio costa 25 € (20 € con la tessera).\"}}, {\"@type\": \"Question\", \"name\": \"Se trovo un nuovo lavoro cosa succede?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Va comunicato all'INPS: in alcuni casi la NASpI si riduce, in altri si sospende. Ce ne occupiamo noi.\"}}, {\"@type\": \"Question\", \"name\": \"Chi ha diritto alla NASpI?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Chi ha perso il lavoro involontariamente (licenziamento, fine del contratto a termine) e ha almeno 13 settimane di contributi contro la disoccupazione nei 4 anni prima. Le dimissioni e la risoluzione consensuale di regola la escludono, con eccezioni come le dimissioni per giusta causa (fonte: INPS).\"}}, {\"@type\": \"Question\", \"name\": \"Entro quando devo presentare la domanda?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Entro 68 giorni, a pena di decadenza, di solito dalla data in cui finisce il rapporto di lavoro. Per il licenziamento per giusta causa il termine parte dal trentesimo giorno dopo la cessazione. La domanda si fa solo online: la inviamo noi (fonte: INPS).\"}}, {\"@type\": \"Question\", \"name\": \"Quanto dura la NASpI?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dura la metà delle settimane di contributi degli ultimi 4 anni, e si paga ogni mese. Non si contano i periodi già usati per altre prestazioni di disoccupazione (fonte: INPS).\"}}, {\"@type\": \"Question\", \"name\": \"Da quando mi pagano?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Se presenti la domanda entro l'ottavo giorno dalla fine del lavoro, l'indennità parte dall'ottavo giorno dopo la cessazione. Se la presenti dopo, parte dal giorno successivo alla domanda (fonte: INPS). Per questo conviene muoversi subito.\"}}, {\"@type\": \"Question\", \"name\": \"Mi sono dimesso un anno fa e ora ho perso un altro lavoro: ho la NASpI?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Se nei 12 mesi prima hai lasciato volontariamente un contratto a tempo indeterminato, per disoccupazioni dal 1° gennaio 2025 servono almeno 13 settimane di contributi nel periodo tra le dimissioni e la perdita del nuovo lavoro (INPS, circolare n. 98 del 5 giugno 2025).\"}}, {\"@type\": \"Question\", \"name\": \"Se non vado più al lavoro perdo la NASpI?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sì, se l'azienda considera il rapporto chiuso per dimissioni per fatti concludenti (assenza ingiustificata oltre il termine del contratto o oltre 15 giorni): la NASpI non spetta. Con il licenziamento per giusta causa o con le dimissioni per giusta causa, invece, si può averla (INPS, circolare n. 154 del 22 dicembre 2025).\"}}]}";
---
<BaseLayout title={"Domanda NASpI gratis a Roma"} description={"Domanda NASpI gratuita per tutti al patronato di Vigne Nuove, anche in videochiamata. Ti spieghiamo anche cosa fare sul SIISL entro 15 giorni."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="naspi" name="Domanda NASpI" description={"Domanda di indennità di disoccupazione NASpI all'INPS tramite patronato. Gratuita."} serviceType="Patronato - disoccupazione" offers={[{ name: "Domanda NASpI", price: 0 }]} />
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}
  <div class="lp"><Fragment set:html={body} /></div>
  <section id="richiesta-online" style="background:#F1EEFF;scroll-margin-top:80px">
    <div style="max-width:820px;margin:0 auto;padding:48px 16px;display:flex;flex-direction:column;gap:16px">
      <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(26px,5vw,38px);line-height:1.1;color:#14142B">Richiedi la NASpI online</h2>
      <p style="margin:0;font-size:17px;line-height:1.5;color:#34344A;max-width:60ch">Compila il modulo: ti richiamiamo noi per completare la domanda.</p>
      <div style="background:#fff;border:2px solid #14142B;border-radius:28px;padding:12px;min-width:0">
        <iframe src={NASPI_SURVEY} style="width:100%;min-height:620px;border:none;border-radius:20px" id="sImJrbagruVY43JLeqA9" loading="lazy" scrolling="no" title="Richiesta NASpI"></iframe>
      </div>
    </div>
  </section>
  <script is:inline src="https://link.arcanis.it/js/form_embed.js"></script>
  <LandingArticles categories={["naspi-disoccupazione"]} />
</BaseLayout>
