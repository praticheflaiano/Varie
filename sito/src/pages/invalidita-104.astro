---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import body from "~/fragments/invalidita-104.html?raw";
const ld = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Che differenza c'\u00e8 tra invalidit\u00e0 e 104?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sono riconoscimenti diversi che danno benefici diversi, e spesso si chiedono insieme. Te lo spieghiamo sul tuo caso.\"}}, {\"@type\": \"Question\", \"name\": \"Cosa cambia con la nuova procedura?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A Roma, dal 1\u00b0 marzo 2026, basta il certificato medico introduttivo: non c'\u00e8 pi\u00f9 la domanda a parte e la visita la fa l'INPS.\"}}, {\"@type\": \"Question\", \"name\": \"Se la domanda viene respinta?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Valutiamo insieme se presentare ricorso o una nuova domanda con documentazione migliore.\"}}]}";
---
<BaseLayout title={"Invalidità civile e 104 a Roma, medico in sede"} description={"Invalidità civile, Legge 104 e accompagnamento: medico certificatore e patronato nello stesso ufficio a Vigne Nuove. Primo incontro gratuito."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="invalidita-104" name="Invalidità civile e Legge 104" description={"Certificato medico introduttivo e domanda di invalidità civile, accompagnamento e Legge 104, con medico certificatore in sede. Primo incontro gratuito."} serviceType="Patronato - invalidità civile" offers={[{ name: "Primo incontro", price: 0 }]} />
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}
  <div class="lp"><Fragment set:html={body} /></div>
  <LandingArticles categories={["invalidita-civile", "red-invciv-accas"]} />
</BaseLayout>
