---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
import body from "~/fragments/invalidita-104.html?raw";
const ld = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Che differenza c'è tra invalidità e 104?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sono riconoscimenti diversi che danno benefici diversi, e spesso si chiedono insieme. Te lo spieghiamo sul tuo caso.\"}}, {\"@type\": \"Question\", \"name\": \"Cosa cambia con la nuova procedura?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A Roma, dal 1° marzo 2026, basta il certificato medico introduttivo: non c'è più la domanda a parte e la visita la fa l'INPS.\"}}, {\"@type\": \"Question\", \"name\": \"Se la domanda viene respinta?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Valutiamo insieme se presentare ricorso o una nuova domanda con documentazione migliore.\"}}, {\"@type\": \"Question\", \"name\": \"Quanto tempo ci vuole per avere il verbale?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"L'INPS indica come termine 120 giorni dalla domanda completa nei territori con convenzione INPS-Regione, oppure 45 giorni dalla ricezione del verbale sanitario trasmesso dall'ASL negli altri territori. Al primo incontro ti diciamo quale caso vale per te.\"}}, {\"@type\": \"Question\", \"name\": \"Come funziona il certificato medico introduttivo?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Il medico certificatore lo compila online e lo invia all'INPS: ti dà una ricevuta con il numero della procedura e una copia da portare alla visita. Dove serve ancora la domanda, il certificato vale 90 giorni per presentarla.\"}}, {\"@type\": \"Question\", \"name\": \"Cosa devo portare alla visita?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Un documento di riconoscimento valido e tutta la documentazione sanitaria che hai (referti, cartelle, vecchio verbale). Porta anche la ricevuta e la copia del certificato medico introduttivo.\"}}, {\"@type\": \"Question\", \"name\": \"Cosa succede se non posso andare alla visita?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Se non puoi spostarti, il medico certificatore può chiedere la visita a casa almeno cinque giorni prima. Chi non si presenta viene convocato una seconda volta; con un'altra assenza la domanda decade.\"}}, {\"@type\": \"Question\", \"name\": \"A chi spetta l'indennità di accompagnamento?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Serve il riconoscimento di inabilità totale e permanente (100%), con impossibilità di camminare senza un accompagnatore o di compiere da soli gli atti quotidiani. Non ci sono limiti di reddito né di età. Nel 2026 l'importo è di 551,53 € al mese, per 12 mensilità (fonte: INPS).\"}}, {\"@type\": \"Question\", \"name\": \"Quanto costa farlo con voi?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Il primo incontro è gratuito. I costi del certificato e della pratica te li diciamo prima di iniziare, senza impegno.\"}}]}";
---
<BaseLayout title={"Invalidità civile e 104 a Roma, medico in sede"} description={"Invalidità civile, Legge 104 e accompagnamento: medico certificatore e patronato nello stesso ufficio a Vigne Nuove. Primo incontro gratuito."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="invalidita-104" name="Invalidità civile e Legge 104" description={"Certificato medico introduttivo e domanda di invalidità civile, accompagnamento e Legge 104, con medico certificatore in sede. Primo incontro gratuito."} serviceType="Patronato - invalidità civile" offers={[{ name: "Primo incontro", price: 0 }]} />
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}
  <div class="lp"><Fragment set:html={body} /></div>
  <LandingArticles categories={["invalidita-civile", "red-invciv-accas"]} />
</BaseLayout>
