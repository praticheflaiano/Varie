---
/**
 * Scadenze del mese. Ogni voce viene da un articolo del sito già verificato su fonti ufficiali:
 * aggiungere solo date confermate e sempre con il link all'articolo che le spiega.
 * Lo script in fondo segna come "passate" le date già trascorse, così la pagina resta corretta tra un aggiornamento e l'altro.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import AvvisamiWhatsApp from "~/components/blog/AvvisamiWhatsApp.astro";

type Voce = { d: string; titolo: string; chi: string; href: string };
const VOCI: Voce[] = [
  { d: "2026-11-30", titolo: "Secondo acconto IRPEF con F24", chi: "Chi paga le tasse con il modello Redditi. Con il 730 di solito è già trattenuto in busta paga o sulla pensione.", href: "/blog/scadenze-30-novembre-2026-roma-acconto-irpef-tari" },
  { d: "2026-11-30", titolo: "Rata TARI di Roma", chi: "Chi ha l'avviso AMA con questa scadenza (pagamento PagoPA).", href: "/blog/scadenze-30-novembre-2026-roma-acconto-irpef-tari" },
  { d: "2026-11-30", titolo: "Rottamazione quinquies: terza rata", chi: "Chi ha aderito alla definizione agevolata. La rata dopo scade il 31 gennaio 2027.", href: "/blog/rottamazione-quinquies-terza-rata-30-novembre-2026" },
  { d: "2026-11-30", titolo: "Definizione agevolata Roma Capitale: IMU, TASI e TARI", chi: "Avvisi del Comune non pagati: paghi solo il tributo, senza sanzioni e interessi. Domanda online su Aequa Roma.", href: "/blog/definizione-agevolata-roma-capitale-imu-tari-30-novembre-2026" },
  { d: "2026-11-30", titolo: "APE sociale: domanda di verifica", chi: "Ultima finestra del 2026 per chi ha almeno 63 anni e 5 mesi e rientra nelle categorie previste.", href: "/blog/ape-sociale-2026-ultima-scadenza-30-novembre" },
  { d: "2026-12-16", titolo: "IMU: saldo 2026", chi: "Proprietari di seconde case e altri immobili non esenti.", href: "/blog/imu-saldo-16-dicembre-2026-roma" },
  { d: "2026-12-16", titolo: "Carta Dedicata a te: primo acquisto", chi: "Chi ha ricevuto la carta: senza un acquisto entro questa data si perdono i 500 € del 2026.", href: "/blog/carta-dedicata-a-te-2026-2027-scadenza-16-dicembre" },
  { d: "2026-12-31", titolo: "Scade l'ISEE 2026", chi: "Tutti. Dal 1° gennaio 2027 serve una nuova DSU per Assegno Unico, ADI, bonus e agevolazioni.", href: "/blog/isee-2027-documenti-quando-rinnovare-roma" },
  { d: "2026-12-31", titolo: "Bonus mamme 2026: domanda all'INPS", chi: "Le mamme lavoratrici con i requisiti: il bonus non arriva da solo, serve la domanda.", href: "/blog/nuovo-bonus-mamme-2026-domanda-inps-31-dicembre" },
  { d: "2026-12-31", titolo: "Bonus asilo nido 2026: domanda", chi: "Famiglie con figli al nido. Le ricevute del 2026 si caricano entro il 30 aprile 2027.", href: "/blog/bonus-asilo-nido-2026-3600-euro-domanda-inps" },
  { d: "2026-12-31", titolo: "Bonus donne: assunzioni agevolate", chi: "Vale per le assunzioni a tempo indeterminato fatte entro questa data.", href: "/blog/bonus-donne-2026-assunzione-disoccupate" },
  { d: "2027-01-13", titolo: "Trasporto disabili Roma: domanda allo sportello", chi: "Lista d'attesa 2027, sportello di via Silvio D'Amico 38 (solo il mercoledì, su prenotazione).", href: "/blog/trasporto-disabili-roma-lista-attesa-2027-domanda" },
  { d: "2027-01-15", titolo: "Trasporto disabili Roma: domanda online", chi: "Lista d'attesa 2027 del servizio di Roma Capitale.", href: "/blog/trasporto-disabili-roma-lista-attesa-2027-domanda" },
  { d: "2027-01-31", titolo: "Canone RAI: dichiarazione di non detenzione", chi: "Chi non ha la TV in nessuna casa con la luce a suo nome: vale per tutto il 2027.", href: "/blog/canone-rai-2027-esenzione-over-75-non-detenzione" },
  { d: "2027-01-31", titolo: "Rottamazione quinquies: rata successiva", chi: "Chi ha aderito alla definizione agevolata.", href: "/blog/rottamazione-quinquies-terza-rata-30-novembre-2026" },
  { d: "2027-02-01", titolo: "Definizione agevolata Roma: mensa, asili nido, trasporto scolastico", chi: "Debiti fino al 2024 con Roma Capitale: domanda dal 1° dicembre 2026 al 1° febbraio 2027.", href: "/blog/definizione-agevolata-roma-capitale-imu-tari-30-novembre-2026" },
  { d: "2027-02-28", titolo: "TARI Roma: bonus sociale rifiuti, prima domanda", chi: "Chi ha i requisiti ISEE e chiede la riduzione per la prima volta: prima rinnova l'ISEE.", href: "/blog/tari-roma-esenzione-bonus-sociale-riduzioni" },
  { d: "2027-04-30", titolo: "Canone RAI: esenzione over 75 per il 2027", chi: "Chi compie 75 anni entro il 31 gennaio 2027 e ha i requisiti di reddito.", href: "/blog/canone-rai-2027-esenzione-over-75-non-detenzione" },
];
const MESI = ["gennaio","febbraio","marzo","aprile","maggio","giugno","luglio","agosto","settembre","ottobre","novembre","dicembre"];
const gruppi: { mese: string; voci: Voce[] }[] = [];
for (const v of VOCI) {
  const [y, m] = v.d.split("-");
  const mese = `${MESI[Number(m) - 1]} ${y}`;
  const g = gruppi.find((x) => x.mese === mese);
  g ? g.voci.push(v) : gruppi.push({ mese, voci: [v] });
}
const giorno = (d: string) => Number(d.split("-")[2]);
const ld = JSON.stringify({
  "@context": "https://schema.org", "@type": "ItemList", name: "Scadenze fiscali e INPS a Roma",
  itemListElement: VOCI.map((v, i) => ({ "@type": "ListItem", position: i + 1, name: `${v.titolo} (${giorno(v.d)} ${MESI[Number(v.d.split("-")[1]) - 1]} ${v.d.slice(0, 4)})`, url: `https://praticheflaiano.it${v.href}` })),
});
---

<BaseLayout title="Scadenze fiscali e INPS: dicembre e gennaio" description="Le prossime scadenze a Roma: acconto IRPEF, IMU 16 dicembre, ISEE che scade il 31 dicembre, bonus mamme e nido, canone RAI, TARI. Con le guide per ognuna.">
  <script slot="head" type="application/ld+json" set:html={ld} />

  <section style="background:#F1EEFF">
    <div style="max-width:920px;margin:0 auto;padding:40px 16px 48px;display:flex;flex-direction:column;gap:16px">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Aggiornato il 23 novembre 2026</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Le prossime scadenze</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A">Tasse, ISEE, bonus e pratiche INPS: le date da segnare. Per ogni scadenza c'è la guida con le fonti ufficiali. Le date già passate restano in grigio.</p>
    </div>
  </section>

  <section style="max-width:920px;margin:0 auto;padding:32px 16px 64px;display:flex;flex-direction:column;gap:28px">
    {gruppi.map((g) => (
      <div style="display:flex;flex-direction:column;gap:12px">
        <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(26px,5vw,34px);text-transform:capitalize;color:#14142B">{g.mese}</h2>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px">
          {g.voci.map((v) => (
            <li class="sc-item" data-d={v.d}>
              <a href={v.href} style="display:flex;gap:16px;align-items:flex-start;background:#F7F7FB;border-radius:22px;padding:16px 18px;text-decoration:none;color:#14142B">
                <span class="sc-day" style="flex:none;width:58px;height:58px;border-radius:16px;background:#5B3DF5;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Bricolage Grotesque',sans-serif;line-height:1"><b style="font-size:26px">{giorno(v.d)}</b><span style="font-size:12px;font-weight:700;text-transform:uppercase">{MESI[Number(v.d.split("-")[1]) - 1].slice(0, 3)}</span></span>
                <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
                  <b style="font-size:18px;line-height:1.25">{v.titolo} <span class="sc-past" style="display:none;font-size:13px;font-weight:700;color:#9D174D">· passata</span></b>
                  <span style="font-size:15px;line-height:1.45;color:#3F3F5A">{v.chi}</span>
                  <span style="font-size:15px;font-weight:800;color:#5B3DF5">Leggi la guida →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <AvvisamiWhatsApp scadenze={false} />

    <a href="/prenota" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota un appuntamento</span><span class="cta-tool-s">Ti aiutiamo con F24, ISEE e domande INPS, a Vigne Nuove o in videochiamata</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <p style="margin:0;font-size:14px;color:#5B5B72">Le date vengono dalle nostre guide, ognuna con le fonti ufficiali (Agenzia delle Entrate, INPS, Roma Capitale, Regione Lazio). Le scadenze possono essere spostate dalla legge: prima di pagare controlla sempre la guida o chiedi a noi.</p>
  </section>

  <script is:inline>
  (function(){
    var t=new Date();var oggi=t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0');
    document.querySelectorAll('.sc-item').forEach(function(li){
      if(li.getAttribute('data-d')<oggi){li.style.opacity='.5';var d=li.querySelector('.sc-day');if(d)d.style.background='#8A8AA3';var p=li.querySelector('.sc-past');if(p)p.style.display='inline';}
    });
  })();
  </script>
</BaseLayout>
