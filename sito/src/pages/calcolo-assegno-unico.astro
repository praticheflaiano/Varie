---
/**
 * Calcolo Assegno Unico 2026.
 * Fonte unica dei valori: INPS, Circolare n. 7 del 30/01/2026 e Allegato n. 1 (tabella mensile 2026 per fascia ISEE),
 * salvata in /public/data/auu-2026.json: [soglia ISEE massima della fascia (null = oltre 46.582,71), figlio minorenne,
 * figlio 18-20, figlio con disabilità, magg. non autosufficiente <21, magg. grave <21, magg. media <21,
 * magg. figli ulteriori al secondo, magg. madre <21, bonus secondo percettore].
 * Maggiorazioni dal testo della circolare (par. 2): <1 anno +50%; con almeno 3 figli e ISEE fino a 46.582,71 € +50%
 * per figli da 1 a 3 anni; almeno 4 figli 150 € forfettari. Senza ISEE: importi minimi (par. 1).
 */
import BaseLayout from "~/layouts/BaseLayout.astro";

const BOOK_2027 = "https://link.arcanis.it/widget/booking/PcX3eqVyShnXdizbkN1G";
const faqs = [
  { q: "Quanto spetta di Assegno Unico nel 2026?", a: "Per ogni figlio minorenne da 58,30 € al mese (senza ISEE o con ISEE oltre 46.582,71 €) a 203,80 € al mese (ISEE fino a 17.468,51 €). Per i figli da 18 a 20 anni da 29,10 a 99,10 €. Valori della circolare INPS n. 7 del 30 gennaio 2026." },
  { q: "Quali maggiorazioni ci sono?", a: "+50% per i figli sotto 1 anno; +50% per i figli da 1 a 3 anni nelle famiglie con almeno 3 figli e ISEE fino a 46.582,71 €; 150 € al mese in più con almeno 4 figli; maggiorazioni per figli con disabilità, per i figli dal terzo in poi, per madre sotto i 21 anni e quando entrambi i genitori lavorano (fino a 34,90 € per figlio)." },
  { q: "Senza ISEE quanto prendo?", a: "Solo l'importo minimo: 58,30 € per figlio minorenne e 29,10 € per figlio da 18 a 20 anni. L'ISEE 2026 scade il 31 dicembre: per non scendere al minimo da marzo 2027 serve la nuova DSU." },
  { q: "Il calcolatore è preciso?", a: "È una stima con la tabella ufficiale INPS. L'INPS calcola l'importo con l'ISEE 'neutralizzato' (togliendo l'Assegno Unico già preso) e con i dati della domanda: l'importo esatto è quello dell'INPS." },
  { q: "Gli importi cambiano nel 2027?", a: "Sì: ogni anno l'INPS rivaluta importi e soglie con l'inflazione. Le tabelle 2027 escono di solito a fine gennaio; aggiorneremo il calcolatore appena pubblicate." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo Assegno Unico 2026", url: "https://praticheflaiano.it/calcolo-assegno-unico", applicationCategory: "FinanceApplication", operatingSystem: "Web", isAccessibleForFree: true, inLanguage: "it", offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" } });
const H2 = "margin:24px 0 0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(28px,5vw,40px);line-height:1.05;color:#14142B";
const TD = "padding:10px;border-top:1px solid #E4E0FF";
const TH = "text-align:left;padding:10px;background:#14142B;color:#fff";
---

<BaseLayout title="Calcolo Assegno Unico 2026: quanto spetta per figlio" description="Calcola l'Assegno Unico con la tabella ufficiale INPS 2026: da 58,30 a 203,80 € per figlio, maggiorazioni per figli piccoli, disabilità e genitori che lavorano.">
  <script slot="head" type="application/ld+json" set:html={appLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <section style="background:#F1EEFF">
    <div style="max-width:1120px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:18px">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Calcolatore gratuito · tabella INPS 2026</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Assegno Unico: quanto ti spetta?</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A;max-width:780px">Inserisci il tuo <b>ISEE</b> e i tuoi <b>figli</b>: il calcolatore usa la <b>tabella ufficiale INPS 2026</b> (circolare n. 7 del 30 gennaio 2026) con tutte le maggiorazioni.</p>

      <form id="au" onsubmit="return false" novalidate style="background:#fff;border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:16px;box-shadow:0 6px 0 #14142B;max-width:780px">
        <label class="au-l">1. ISEE (in euro)
          <input id="au-isee" type="number" min="0" step="0.01" inputmode="decimal" placeholder="es. 15000" class="au-in" style="max-width:220px">
          <span class="au-o" style="margin-top:4px"><input type="checkbox" id="au-noisee"> Non ho l'ISEE</span></label>

        <fieldset class="au-f"><legend>2. I tuoi figli</legend>
          <div id="au-figli" style="display:flex;flex-direction:column;gap:10px"></div>
          <button id="au-add" type="button" style="align-self:flex-start;margin-top:8px;background:#fff;color:#5B3DF5;font-weight:800;border:2px solid #5B3DF5;border-radius:999px;padding:8px 16px;font-size:15px;cursor:pointer">+ Aggiungi un figlio</button>
          <small style="display:block;color:#5B5B72;margin-top:6px">I figli da 18 a 20 anni contano se studiano, fanno un tirocinio, sono disoccupati iscritti al Centro per l'impiego, fanno il servizio civile o lavorano con reddito basso. Dai 21 anni l'assegno spetta solo per i figli con disabilità.</small>
        </fieldset>

        <fieldset class="au-f"><legend>3. Altre situazioni</legend>
          <label class="au-o" style="display:flex"><input type="checkbox" id="au-lav"> Entrambi i genitori hanno un reddito da lavoro</label>
          <label class="au-o" style="display:flex"><input type="checkbox" id="au-madre"> La madre ha meno di 21 anni</label>
        </fieldset>

        <button id="au-b" type="button" style="align-self:flex-start;background:#5B3DF5;color:#fff;font-weight:800;border:0;border-radius:999px;padding:14px 26px;font-size:17px;cursor:pointer">Calcola</button>
        <div id="au-out" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section style="max-width:860px;margin:0 auto;padding:48px 16px 64px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#2A2A40">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: 23 novembre 2026.</b> Valori 2026 della circolare INPS n. 7 del 30 gennaio 2026, Allegato 1. Le tabelle 2027 usciranno a inizio anno: aggiorneremo il calcolatore.</p>

    <h2 style={H2.replace("24px 0 0","0")}>Quanto spetta nel 2026</h2>
    <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>ISEE</th><th style={TH}>Figlio minorenne</th><th style={TH}>Figlio 18-20 anni</th></tr></thead>
      <tbody>
        <tr><td style={TD}>fino a 17.468,51 €</td><td style={TD}><b>203,80 €</b></td><td style={TD}><b>99,10 €</b></td></tr>
        <tr><td style={TD}>da 17.468,52 a 46.582,71 €</td><td style={TD} colspan="2">scende man mano che l'ISEE sale</td></tr>
        <tr><td style={TD}>oltre 46.582,71 € o senza ISEE</td><td style={TD}><b>58,30 €</b></td><td style={TD}><b>29,10 €</b></td></tr>
      </tbody>
    </table></div>

    <h2 style={H2}>Le maggiorazioni</h2>
    <ul style="margin:0;padding-left:22px">
      <li><b>Figli sotto 1 anno</b>: +50% dell'importo.</li>
      <li><b>Almeno 3 figli e ISEE fino a 46.582,71 €</b>: +50% per ogni figlio da 1 a 3 anni.</li>
      <li><b>Almeno 4 figli</b>: 150 € al mese in più per la famiglia.</li>
      <li><b>Figli dal terzo in poi</b>: da 17,40 a 99,10 € in più per ciascuno, secondo l'ISEE.</li>
      <li><b>Entrambi i genitori con reddito da lavoro</b>: fino a 34,90 € per ogni figlio minorenne (scende con l'ISEE e si azzera vicino a 46.582,71 €).</li>
      <li><b>Madre con meno di 21 anni</b>: 23,30 € per ogni figlio.</li>
      <li><b>Figli con disabilità sotto i 21 anni</b>: 122,30 € (non autosufficienza), 110,60 € (grave) o 99,10 € (media) in più al mese. Per i figli con disabilità l'assegno spetta a ogni età.</li>
    </ul>

    <h2 style={H2}>L'ISEE 2026 scade il 31 dicembre</h2>
    <p style="margin:0">Senza un ISEE valido, da marzo 2027 l'Assegno Unico scende al <b>minimo</b>. La nuova DSU si fa dal 1° gennaio 2027: da noi l'ISEE è <b>gratis</b>.</p>
    <a href={BOOK_2027} class="cta-tool" style="margin-top:6px"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota l'ISEE 2027 gratis</span><span class="cta-tool-s">In ufficio a Vigne Nuove o in videochiamata</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

    <h2 style={H2}>Domande frequenti</h2>
    {faqs.map((f) => (
      <details style="background:#F7F7FB;border-radius:18px;padding:16px 20px"><summary style="font-weight:800;cursor:pointer">{f.q}</summary><p style="margin:10px 0 0">{f.a}</p></details>
    ))}
    <p style="margin:12px 0 0;font-size:14px;color:#5B5B72">Fonti: <a href="https://www.inps.it/content/dam/inps-site/it/scorporati/circolari-e-messaggi/2026/01/Circolare_15152/Allegati/16548_Circolare-numero-7-del-30-01-2026.pdf" target="_blank" rel="noopener" style="color:#5B3DF5">INPS, circolare n. 7 del 30 gennaio 2026</a> e Allegato n. 1 (tabella importi 2026); D.Lgs. 29 dicembre 2021, n. 230. Il calcolatore dà una stima: l'importo esatto lo calcola l'INPS sulla tua domanda. Leggi anche la <a href="/blog/assegno-unico-2027-rinnovo-isee-scadenze" style="color:#5B3DF5">guida all'Assegno Unico 2027</a> e la pagina <a href="/assegno-unico" style="color:#5B3DF5">Assegno Unico</a>.</p>
  </section>

  <style is:global>
    #au-out{scroll-margin-top:90px}
    .au-f{border:0;padding:0;margin:0}
    .au-f legend{font-weight:800;margin-bottom:8px}
    .au-l{display:flex;flex-direction:column;gap:6px;font-weight:800}
    .au-in{border:2px solid #14142B;border-radius:14px;padding:11px 12px;font-size:17px;background:#fff;width:100%;max-width:100%;font-weight:400}
    .au-o{display:inline-flex;align-items:center;gap:8px;margin:0 16px 8px 0;font-size:16px;cursor:pointer;font-weight:400}
    .au-o input{width:20px;height:20px;accent-color:#5B3DF5;flex:none}
    .au-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:#F7F7FB;border-radius:16px;padding:10px 12px}
    .au-row b{min-width:62px}
    .au-row select{flex:1 1 170px;max-width:100%}
    .au-row .au-x{background:none;border:0;color:#C2185B;font-weight:800;font-size:15px;cursor:pointer;padding:6px}
    .au-res{border-radius:20px;padding:18px 20px;line-height:1.5;margin-top:4px}
    .au-ok{background:#D4FF4F;color:#14142B}
    .au-warn{background:#FFF4D6;color:#14142B}
    .au-res b.big{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:40px;line-height:1.05;margin:4px 0}
    .au-res table{border-collapse:collapse;margin-top:8px;font-size:15px;width:100%}
    .au-res td{padding:3px 8px 3px 0;vertical-align:top}
  </style>
  <script is:inline define:vars={{ BOOK_2027 }}>
  (function(){
    var $=function(i){return document.getElementById(i)};
    var T=null;fetch('/data/auu-2026.json').then(function(r){return r.json()}).then(function(d){T=d});
    var eur=function(n){var p=(Math.round(n*100)/100).toFixed(2).split('.');return p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1]+' €'};
    var AGE=[['lt1','meno di 1 anno'],['1-2','da 1 a 2 anni'],['3-17','da 3 a 17 anni'],['18-20','da 18 a 20 anni'],['21','21 anni o più (solo con disabilità)']];
    var DIS=[['no','nessuna disabilità'],['media','disabilità media'],['grave','disabilità grave'],['na','non autosufficiente']];
    var n=0;
    function opt(a,sel){return a.map(function(x){return '<option value="'+x[0]+'"'+(x[0]===sel?' selected':'')+'>'+x[1]+'</option>'}).join('')}
    function add(age){n++;var d=document.createElement('div');d.className='au-row';d.innerHTML='<b>Figlio</b><select class="au-in au-age" aria-label="Età del figlio">'+opt(AGE,age||'3-17')+'</select><select class="au-in au-dis" aria-label="Disabilità">'+opt(DIS,'no')+'</select><button type="button" class="au-x" aria-label="Togli">Togli</button>';d.querySelector('.au-x').onclick=function(){d.remove();num()};$('au-figli').appendChild(d);num()}
    function num(){[].forEach.call(document.querySelectorAll('.au-row b'),function(b,i){b.textContent='Figlio '+(i+1)})}
    add('3-17');
    $('au-add').onclick=function(){add('3-17')};
    $('au-noisee').onchange=function(){$('au-isee').disabled=this.checked};
    var cta='<p style="margin:10px 0 0"><a href="'+BOOK_2027+'" style="color:#5B3DF5;font-weight:800">Prenota l’ISEE 2027 gratis</a> o <a href="/prenota" style="color:#5B3DF5;font-weight:800">un appuntamento</a> per la domanda di Assegno Unico.</p>';
    function show(c,h){$('au-out').innerHTML='<div class="au-res '+c+'">'+h+'</div>';$('au-out').scrollIntoView({behavior:'smooth',block:'nearest'})}
    $('au-b').onclick=function(){
      if(!T){show('au-warn','Un attimo: sto caricando la tabella INPS. Riprova tra un secondo.');return}
      var no=$('au-noisee').checked,isee=parseFloat(String($('au-isee').value).replace(',','.'));
      if(!no&&!(isee>=0)){show('au-warn','Inserisci l’ISEE oppure spunta "Non ho l’ISEE".');return}
      var row=T[T.length-1];
      if(!no){for(var i=0;i<T.length;i++){if(T[i][0]===null||isee<=T[i][0]){row=T[i];break}}}
      var kids=[].map.call(document.querySelectorAll('.au-row'),function(r){return {a:r.querySelector('.au-age').value,d:r.querySelector('.au-dis').value}});
      if(!kids.length){show('au-warn','Aggiungi almeno un figlio.');return}
      var lav=$('au-lav').checked,madre=$('au-madre').checked,tot=0,righe=[],note=[];
      var eligible=kids.filter(function(k){return k.a!=='21'||k.d!=='no'});
      var nE=eligible.length,low=!no&&isee<=46582.71;
      if(kids.length!==nE) note.push('Dai 21 anni l’Assegno Unico spetta solo per i figli con disabilità: quel figlio non è stato contato.');
      eligible.forEach(function(k,i){
        var dis=k.d!=='no',minor=(k.a!=='18-20'&&k.a!=='21');
        var base=dis?row[3]:(minor?row[1]:row[2]);var s=base,parts=[];
        if(k.a==='lt1'){s+=base*0.5;parts.push('+50% sotto 1 anno')}
        if(k.a==='1-2'&&nE>=3&&low){s+=base*0.5;parts.push('+50% figlio da 1 a 3 anni con 3 o più figli')}
        if(dis&&k.a!=='21'){var m=k.d==='na'?row[4]:k.d==='grave'?row[5]:row[6];s+=m;parts.push('+'+eur(m)+' disabilità')}
        if(i>=2){s+=row[7];parts.push('+'+eur(row[7])+' dal terzo figlio')}
        if(madre&&minor){s+=row[8];parts.push('+'+eur(row[8])+' madre sotto 21 anni')}
        if(lav&&minor&&row[9]>0){s+=row[9];parts.push('+'+eur(row[9])+' entrambi lavorano')}
        tot+=s;righe.push(['Figlio '+(i+1)+': '+eur(base)+(parts.length?' '+parts.join(', '):''),s]);
      });
      if(nE>=4){tot+=150;righe.push(['Famiglia con 4 o più figli',150])}
      if(no) note.push('Senza ISEE spettano solo gli importi minimi: con l’ISEE potresti prendere di più.');
      if(nE>=3&&!low&&kids.some(function(k){return k.a==='1-2'})) note.push('Il +50% per i figli da 1 a 3 anni richiede un ISEE fino a 46.582,71 €.');
      if(lav&&row[9]===0) note.push('Con questo ISEE il bonus per entrambi i genitori che lavorano è pari a zero.');
      var tab='<table>'+righe.map(function(x){return '<tr><td>'+x[0]+'</td><td style="text-align:right;white-space:nowrap"><b>'+eur(x[1])+'</b></td></tr>'}).join('')+'</table>';
      var nn=note.length?'<ul style="margin:10px 0 0;padding-left:20px">'+note.map(function(x){return '<li>'+x+'</li>'}).join('')+'</ul>':'';
      show('au-ok','Assegno Unico stimato:<b class="big">'+eur(tot)+' al mese</b>circa '+eur(tot*12)+' l’anno, con la tabella INPS 2026.'+tab+nn+'<p style="margin:10px 0 0;font-size:14px">Stima: l’INPS calcola con l’ISEE «neutralizzato» e con i dati della tua domanda.</p>'+cta);
    };
  })();
  </script>
</BaseLayout>
