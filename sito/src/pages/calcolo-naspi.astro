---
/**
 * Calcolo NASpI (strumento arrivato dal portale domandedisoccupazione.it il 25/11/2026; dal 26/11/2026 impaginato come gli
 * articoli con ToolGuideLayout e logica ricontrollata).
 * Regole da fonti ufficiali, verificate il 24-26/11/2026:
 * - D.Lgs. 22/2015, artt. 3, 4, 5, 6 (testo vigente): 13 settimane in 4 anni; dal 2025 13 settimane dopo dimissioni da un
 *   tempo indeterminato nei 12 mesi prima (art. 3, c. 1, lett. c-bis, L. 207/2024; circolare INPS 98/2025); 75% della
 *   retribuzione media fino all'importo di riferimento + 25% dell'eccedenza; -3% al mese dal 6° mese (dall'8° per chi ha
 *   55 anni alla domanda); durata metà delle settimane degli ultimi 4 anni, tolte quelle già usate; domanda entro 68 giorni.
 * - INPS, scheda "NASpI: indennità mensile di disoccupazione" (agg. 2/2/2026); circolare INPS 94/2015.
 * - Circolare INPS 28 gennaio 2026, n. 4: importo di riferimento 1.456,72 € e massimo mensile 1.584,70 € per il 2026.
 * I numeri stanno in src/naspi/constants.ts e la logica in src/naspi/calculations.ts: vanno aggiornati ogni gennaio.
 */
import ToolGuideLayout from "~/layouts/ToolGuideLayout.astro";
import PortaleNaspi from "~/components/blog/PortaleNaspi.astro";
import NaspiCalculator from "~/naspi/NaspiCalculator";
import { NASPI_CONSTANTS } from "~/naspi/constants";
import { monthlyAmountFromAverageWage } from "~/naspi/calculations";

// separatore delle migliaia sempre presente (in italiano 1456,72 verrebbe scritto senza punto)
const eur = (n: number) => { const [i, d] = n.toFixed(2).split("."); return i.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "," + d; };
const SOGLIA = NASPI_CONSTANTS.THRESHOLD_AMOUNT, MAX = NASPI_CONSTANTS.MAX_MONTHLY_CAP;
const ESEMPI = [1200, 1800, 3000, 3500].map((r) => { const n = monthlyAmountFromAverageWage(r); return { r, n, max: n >= MAX }; });
const es6 = ESEMPI[1].n * 0.97;

const faqs = [
  { q: "Come si calcola la NASpI?", a: `Si prende la retribuzione media mensile degli ultimi 4 anni. Fino a ${eur(SOGLIA)} € la NASpI è il 75%. Sulla parte che supera questa cifra si aggiunge il 25%. Nel 2026 non si possono superare ${eur(MAX)} € lordi al mese.` },
  { q: "Quanto dura la NASpI?", a: "La metà delle settimane di contributi degli ultimi 4 anni, al massimo 24 mesi. Non contano le settimane che hanno già dato una precedente NASpI." },
  { q: "La NASpI resta uguale per tutti i mesi?", a: "No. Dal sesto mese (dal 151° giorno) scende del 3% ogni mese. Se alla data della domanda hai già 55 anni, la riduzione parte dall'ottavo mese." },
  { q: "Quante settimane servono per avere la NASpI?", a: "Almeno 13 settimane di contributi negli ultimi 4 anni. Dal 2025, se nei 12 mesi prima ti eri dimesso da un altro lavoro a tempo indeterminato, servono anche 13 settimane di contributi da quelle dimissioni." },
  { q: "Entro quando va fatta la domanda?", a: "Entro 68 giorni dalla fine del lavoro. La NASpI parte dall'ottavo giorno dopo la fine del lavoro, se fai la domanda entro quel giorno; altrimenti dal giorno dopo la domanda." },
  { q: "Con le dimissioni spetta la NASpI?", a: "No, salvo le dimissioni per giusta causa (per esempio stipendi non pagati) o durante il periodo tutelato di maternità o paternità. Con la risoluzione consensuale spetta solo in casi precisi, come l'accordo firmato all'Ispettorato del lavoro." },
  { q: "Il risultato del calcolatore è quello ufficiale?", a: "No, è una stima. L'importo esatto lo calcola l'INPS e lo scrive nella lettera di accoglimento della domanda." },
];
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo NASpI 2026", url: "https://praticheflaiano.it/calcolo-naspi", applicationCategory: "FinanceApplication", operatingSystem: "Web", inLanguage: "it-IT", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" }, description: `Stima dell'importo e della durata della NASpI con i valori INPS 2026 (riferimento ${eur(SOGLIA)} €, massimo ${eur(MAX)} € al mese).` });
---

<ToolGuideLayout
  title="Calcolo NASpI 2026: importo e durata"
  description={`Calcola quanto prendi di NASpI e per quanti mesi con i valori INPS 2026: massimo ${eur(MAX)} € al mese, -3% dal sesto mese. Gratis, dal patronato di Roma.`}
  path="/calcolo-naspi"
  h1="Calcolo NASpI 2026: quanto prendi e per quanto tempo"
  kicker="Calcolatore gratuito · disoccupazione"
  crumbs={[{ name: "NASpI", href: "/naspi" }, { name: "Calcolo NASpI", href: "/calcolo-naspi" }]}
  category="naspi-disoccupazione"
  prenota={{ t: "Prenota: la domanda NASpI la facciamo noi", s: "Patronato ENASC a Roma Vigne Nuove o in videochiamata da tutta Italia" }}
  updated="2026-11-26"
  published="2026-11-25"
  image="/og/calcolo-naspi.jpg"
  imageAlt="Calcolo NASpI 2026: importo e durata"
  related={["checklist-primi-7-giorni-perdita-lavoro-roma", "somma-non-imponibile-naspi-cassa-integrazione-2026", "naspi-2026-patronato-vs-caf-cosa-fa-cosa"]}
  sources={[
    { t: "INPS, scheda \"NASpI: indennità mensile di disoccupazione\" (aggiornata al 2 febbraio 2026)", url: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50593.naspi-indennit-mensile-di-disoccupazione.html" },
    { t: "INPS, circolare n. 4 del 28 gennaio 2026 (importi 2026)", url: "https://www.inps.it/it/it/inps-comunica/atti/circolari-messaggi-e-normativa/dettaglio.circolari-e-messaggi.2026.01.circolare-numero-4-del-28-01-2026_15147.html" },
    { t: "Decreto legislativo 4 marzo 2015, n. 22, artt. 3, 4, 5 e 6 (testo vigente)", url: "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:2015-03-04;22" },
    { t: "INPS, circolare n. 94 del 12 maggio 2015 (decorrenza, riduzione e calcolo a giorni)", url: "https://servizi2.inps.it/CircolariZIP/Circolare%20numero%2094%20del%2012-05-2015.pdf" },
    "INPS, circolare n. 98 del 5 giugno 2025 (13 settimane dopo le dimissioni, dal 2025)",
    "INPS, messaggio n. 3649 del 10 novembre 2026 (somma non imponibile sulla NASpI)",
  ]}
  faq={faqs}
>
  <script slot="head" type="application/ld+json" set:html={appLd} />

  <blockquote slot="intro">
    <p><strong>In breve</strong></p>
    <ul>
      <li>La NASpI è il <strong>75%</strong> della retribuzione media mensile fino a <strong>{eur(SOGLIA)} €</strong>, più il <strong>25%</strong> della parte che supera.</li>
      <li>Nel 2026 al massimo <strong>{eur(MAX)} € lordi al mese</strong>.</li>
      <li>Dura la <strong>metà delle settimane</strong> di contributi degli ultimi 4 anni, fino a 24 mesi.</li>
      <li>Dal <strong>sesto mese</strong> scende del <strong>3% al mese</strong> (dall'ottavo se alla domanda hai 55 anni).</li>
      <li>Domanda entro <strong>68 giorni</strong> dalla fine del lavoro: la facciamo noi, gratis.</li>
    </ul>
  </blockquote>

  <div slot="tool" class="nz"><NaspiCalculator client:load /></div>

  <p><strong>Ultimo aggiornamento: 26 novembre 2026.</strong> Valori 2026 della circolare INPS n. 4 del 28 gennaio 2026. Gli importi 2027 escono di solito a fine gennaio: aggiorneremo il calcolatore appena pubblicati.</p>

  <h2>Come si calcola la NASpI nel 2026?</h2>
  <p>La NASpI è il <strong>75% della retribuzione media mensile</strong>, con un'aggiunta del 25% sulla parte che supera {eur(SOGLIA)} €. La retribuzione media è la retribuzione su cui hai versato i contributi negli ultimi 4 anni, divisa per le settimane di contributi e moltiplicata per 4,33.</p>
  <ul>
    <li>Fino a <strong>{eur(SOGLIA)} €</strong>: la NASpI è il <strong>75%</strong> della retribuzione media.</li>
    <li>Sopra questa cifra: 75% di {eur(SOGLIA)} € più il <strong>25%</strong> della parte che la supera.</li>
    <li>In ogni caso non più di <strong>{eur(MAX)} € lordi al mese</strong>.</li>
  </ul>

  <h2>Quanto si prende di NASpI? Quattro esempi</h2>
  <p>Con una retribuzione media di <strong>1.800 €</strong> la NASpI 2026 è di <strong>{eur(ESEMPI[1].n)} € lordi al mese</strong> nei primi 5 mesi.</p>
  <table>
    <thead><tr><th>Retribuzione media mensile</th><th>NASpI lorda nei primi 5 mesi</th></tr></thead>
    <tbody>
      {ESEMPI.map((e) => <tr><td>{eur(e.r)} €</td><td><strong>{eur(e.n)} €</strong>{e.max && " (è il massimo)"}</td></tr>)}
    </tbody>
  </table>
  <p>Sono importi lordi: l'INPS trattiene l'IRPEF. Da novembre 2026, per redditi fino a 20.000 €, l'INPS aggiunge anche la somma non imponibile (<a href="/blog/somma-non-imponibile-naspi-cassa-integrazione-2026">cos'è e quanto vale</a>).</p>

  <h2>Quanto dura la NASpI?</h2>
  <p>La NASpI dura <strong>la metà delle settimane di contributi</strong> degli ultimi 4 anni. Con 4 anni pieni (208 settimane) dura 104 settimane, cioè <strong>24 mesi</strong>. Le settimane che hanno già dato una NASpI precedente non contano di nuovo.</p>

  <h2>Quando scende la NASpI?</h2>
  <p>Dal <strong>151° giorno</strong> (sesto mese) l'importo scende del <strong>3% ogni mese</strong>. Se alla data della domanda hai già <strong>55 anni</strong>, la riduzione parte dal 211° giorno (ottavo mese). Esempio: con {eur(ESEMPI[1].n)} € al mese, nel sesto mese prendi circa {eur(es6)} €. Il calcolatore ti dà la data esatta e il piano mese per mese.</p>

  <h2>Chi ha diritto alla NASpI?</h2>
  <ul>
    <li>Chi ha perso il lavoro <strong>senza volerlo</strong>: licenziamento, fine del contratto a termine, dimissioni per giusta causa o nel periodo tutelato di maternità o paternità.</li>
    <li>Con almeno <strong>13 settimane di contributi</strong> negli ultimi 4 anni.</li>
    <li>Dal 2025, se nei 12 mesi prima ti eri <strong>dimesso da un lavoro a tempo indeterminato</strong>, servono anche 13 settimane di contributi da quelle dimissioni.</li>
  </ul>
  <p>Tutti i passaggi sono nella <a href="/naspi/domanda">guida alla domanda NASpI</a>. Dopo la domanda: <a href="/naspi/pagamento">quando arriva la NASpI</a> e <a href="/naspi/nuovo-lavoro">cosa succede se trovi lavoro</a>.</p>

  <h2>Vuoi aprire un'attività?</h2>
  <p>Se apri una partita IVA o entri in una cooperativa puoi chiedere tutta la NASpI che ti resta, in due rate.</p>
  <p class="cta-tool-wrap"><a href="/anticipo-naspi" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h2M14 10h2M8 14h2M14 14h2M8 18h8"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Apri il calcolatore dell'anticipo NASpI</span><span class="cta-tool-s">Scopri quanto ricevi nelle due rate del 70% e del 30%</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>

  <div slot="after"><PortaleNaspi current="/calcolo-naspi" /></div>
</ToolGuideLayout>
