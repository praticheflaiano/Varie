---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
const props = {"eyebrow": "Cartelle e rate · CAF", "title": "Ti è arrivata una cartella?", "highlight": "Mettiamola a rate.", "lead": "Controlliamo cosa risulta a tuo nome all'Agenzia delle Entrate-Riscossione, verifichiamo le cartelle e chiediamo la rateizzazione più adatta. Per debiti fino a 120.000 € si arriva a 84 rate senza documentare la difficoltà.", "chat": {"q": "Ho tre cartelle e non riesco a pagarle tutte insieme, si possono rateizzare?", "a": "Sì. Scarichiamo l'estratto di ruolo, controlliamo le cartelle e chiediamo il piano a rate. Fino a 120.000 € bastano poche righe di richiesta.", "done": "Rateizzazione chiesta"}, "sticker": "Fino a 84 rate", "strip": ["Estratto di ruolo", "Rateizzazione cartelle", "Piani decaduti", "Avvisi e solleciti"], "needs": [{"t": "ti è arrivata una cartella o un sollecito", "d": "Controlliamo di cosa si tratta, se è corretta e quali strade hai prima che parta un pignoramento."}, {"t": "vuoi pagare a rate", "d": "Per le richieste del 2025 e 2026, fino a 120.000 € si ottengono fino a 84 rate mensili con una semplice dichiarazione di difficoltà."}, {"t": "hai saltato delle rate", "d": "Con 8 rate non pagate, anche non di seguito, il piano decade. Vediamo insieme come rimetterti in regola."}, {"t": "non sai quanto devi", "d": "Scarichiamo l'estratto di ruolo con tutte le cartelle a tuo nome."}], "steps": [{"t": "Ci porti cartelle e lettere", "d": "O ci dai l'accesso con SPID per scaricare insieme la situazione aggiornata."}, {"t": "Controlliamo il debito", "d": "Importi, date di notifica, cartelle già pagate o incluse in definizioni agevolate."}, {"t": "Chiediamo il piano", "d": "Rateizzazione semplice o documentata, e ti spieghiamo scadenze e rischi."}], "docs": ["Documento e codice fiscale", "Cartelle, avvisi e solleciti ricevuti", "SPID o CIE per accedere all'area riservata di AdER", "Eventuali piani di rate o definizioni già in corso", "ISEE, solo se serve documentare la difficoltà per più di 84 rate"], "docsNote": "Non hai le cartelle? Con lo SPID scarichiamo insieme l'estratto di ruolo.", "faqs": [{"q": "In quante rate posso pagare una cartella?", "a": "Per le richieste presentate nel 2025 e nel 2026, con debiti fino a 120.000 € si ottengono fino a 84 rate mensili con una dichiarazione di temporanea difficoltà. Documentando la difficoltà si può arrivare a 120 rate (D.Lgs. 110/2024)."}, {"q": "Quando decade la rateizzazione?", "a": "Per i piani chiesti dal 16 luglio 2022, con 8 rate non pagate, anche non consecutive."}, {"q": "Posso chiedere le rate da solo?", "a": "Sì, online nell'area riservata dell'Agenzia delle Entrate-Riscossione. Se preferisci, controlliamo prima il debito e scegliamo insieme il piano."}, {"q": "Ho aderito alla rottamazione quinquies: cosa devo controllare?", "a": "Le scadenze delle rate indicate nella comunicazione di AdER: un pagamento saltato o in ritardo può far perdere i benefici. Portaci la comunicazione e controlliamo."}], "related": [{"label": "Rottamazione quinquies", "href": "/blog/rottamazione-quinquies-2026"}, {"label": "IMU e TARI", "href": "/imu-tari"}, {"label": "Modello 730", "href": "/730"}, {"label": "Tesseramento", "href": "/tesseramento"}]};
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: props.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
---
<BaseLayout title={"Cartelle esattoriali: rateizzazione fino a 84 rate a Roma"} description={"Estratto di ruolo e rateizzazione delle cartelle fino a 84 rate senza documenti, per debiti fino a 120.000 €. Ti aiutiamo a Vigne Nuove, Roma."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="cartelle-rateizzazione" name={"Cartelle e rateizzazioni"} description={"Verifica dei debiti con l'Agenzia delle Entrate-Riscossione, richiesta di rateizzazione delle cartelle, controllo di piani e definizioni agevolate."} serviceType={"Assistenza fiscale - riscossione"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <LandingArticles categories={["imu-tributi-locali"]} />
</BaseLayout>
