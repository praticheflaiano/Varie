---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import FaqList from "~/components/ui/FaqList.astro";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import PageAside from "~/components/layout/PageAside.astro";

const groups = [
  {
    title: "Generale",
    items: [
      {
        question: "Dove si trova il Centro Pratiche Flaiano?",
        answer: "Siamo a Roma, in <strong>Via Filoteo Alberini 25, interno 10</strong>, dentro il Centro Acquisti Flaiano (quartiere Vigne Nuove, Municipio III). Vengono da noi soprattutto da Vigne Nuove, Tufello, Val Melaina, Conca d'Oro, Talenti, Montesacro, Bufalotta, Porta di Roma, Fidene, Serpentara, Nuovo Salario e Colle Salario: come arrivare dalla tua zona è nelle pagine delle <a href='/zone'>zone servite</a>.",
      },
      {
        question: "Quali sono gli orari del CAF? A che ora aprite e chiudete?",
        answer: "<strong>Dal lunedì al giovedì 9:30-13:00 e 15:30-18:00, il venerdì 9:30-14:00.</strong> Sabato e domenica chiusi. Le chiusure straordinarie, per esempio per le feste, sono nella <a href='/contatti'>pagina contatti</a>.",
      },
      {
        question: "Siete aperti il sabato?",
        answer: "<strong>No, il sabato e la domenica siamo chiusi.</strong> L'ultimo giorno utile della settimana è il venerdì, dalle 9:30 alle 14:00. Puoi comunque prenotare online o scriverci su WhatsApp al 371 623 0690: ti rispondiamo al rientro.",
      },
      {
        question: "Siete aperti oggi?",
        answer: "Dal lunedì al giovedì sì, la mattina (9:30-13:00) e il pomeriggio (15:30-18:00); il venerdì solo la mattina (9:30-14:00); sabato e domenica no. Riceviamo su appuntamento: prima di venire <a href='/prenota'>prenota</a> o chiama lo 06 9784 5429.",
      },
      {
        question: "Qual è il numero di telefono del CAF e patronato?",
        answer: "Telefono <strong>06 9784 5429</strong>, WhatsApp <strong>371 623 0690</strong>, email info@praticheflaiano.it. Su WhatsApp puoi mandarci anche le foto dei documenti.",
      },
      {
        question: "Quanto costano le pratiche? C'è un listino prezzi?",
        answer: "Molte pratiche sono gratuite: la <strong>prima ISEE dell'anno</strong>, la <strong>domanda di pensione</strong> e la <strong>domanda NASpI</strong>. Prezzi già fissati: <a href='/730'>730</a> da 30 € in ufficio (da 35 € da casa), <a href='/successioni'>successione</a> 600 € tutto compreso (imposte e bolli dello Stato a parte), <a href='/dimissioni-online'>dimissioni online</a> da 15 € (in ufficio con il tuo SPID e la tessera), <a href='/tesseramento'>tessera</a> 30 € all'anno per tutta la famiglia. Per le altre pratiche chiedi il preventivo su WhatsApp al 371 623 0690.",
      },
      {
        question: "Come prenoto un appuntamento?",
        answer: "Puoi prenotare online attraverso <a href='/prenota'>la pagina prenota</a> oppure chiamare il numero 06 9784 5429 o scrivere su WhatsApp al 371 6230 690.",
      },
      {
        question: "Posso essere seguito da remoto?",
        answer: "Sì. Offriamo consulenza video o telefonica con prenotazione online dal sito.",
      },
    ],
  },
  {
    title: "Tesseramento",
    items: [
      {
        question: "Quanto costa la tessera?",
        answer: "30 € all'anno per tutto il nucleo familiare. Vedi <a href='/tesseramento'>la pagina tesseramento</a> per tutti i dettagli.",
      },
      {
        question: "Devo essere socio per usare i vostri servizi?",
        answer: "No. Tutti i servizi sono accessibili a soci e non soci. La tessera ti dà consulenze gratuite, appuntamenti prioritari e sconti sulle pratiche, per tutto il nucleo familiare.",
      },
      {
        question: "La tessera vale anche per il Patronato?",
        answer: "Molte pratiche di patronato sono gratuite per tutti, per esempio la domanda NASpI. Dove c'è un costo lo trovi nella pagina del servizio; con la tessera spesso costa meno (es. <a href='/assegno-unico'>Assegno Unico</a>).",
      },
    ],
  },
  {
    title: "730 e Dichiarazione redditi",
    items: [
      {
        question: "Quanto costa fare il 730?",
        answer: "In ufficio da 30 €, da casa a partire da 35 €, in base alla tua situazione: te lo diciamo prima di iniziare. Se l'anno dopo torni da noi, il prezzo resta quello. <a href='/730'>Tutto sul 730</a>.",
      },
      {
        question: "Quali documenti servono per il 730?",
        answer: "Documento d'identita, codice fiscale di tutto il nucleo, Certificazione Unica, ricevute spese sanitarie e detraibili, contratti mutuo/affitto. <a href='/blog/categoria/730-redditi'>Trovi la lista completa nel blog 730</a>.",
      },
      {
        question: "Entro quando si presenta il 730?",
        answer: "Negli ultimi anni il 730 si è presentato da fine aprile/maggio fino al <strong>30 settembre</strong>. Le date ufficiali di ogni anno le pubblica l'Agenzia delle Entrate: appena escono le trovi nel nostro <a href='/blog/categoria/730-redditi'>blog 730</a>.",
      },
    ],
  },
  {
    title: "ISEE",
    items: [
      {
        question: "Quanto costa fare l'ISEE?",
        answer: "Per il cittadino la <strong>prima presentazione annuale dell'ISEE al CAF è gratuita</strong>: il servizio è remunerato direttamente dall'INPS al CAF tramite la convenzione nazionale. Solo eventuali rilasci successivi nello stesso anno per modifiche o integrazioni dovute a omissioni o difformita possono comportare un costo. <strong>Anche l'ISEE corrente</strong> rientra nella convenzione INPS-CAF.",
      },
      {
        question: "Quanto dura l'ISEE?",
        answer: "L'ISEE ordinario scade il <strong>31 dicembre</strong> dell'anno in cui viene rilasciato. Va rifatto ogni gennaio per non perdere benefici come l'Assegno Unico in misura piena.",
      },
      {
        question: "Cos'e l'ISEE corrente?",
        answer: "Una variante dell'ISEE che fotografa la situazione economica recente (12 mesi) invece di quella di 2 anni fa. Utile in caso di calo del reddito (perdita lavoro, riduzione attività). Vale 6 mesi.",
      },
    ],
  },
  {
    title: "Pensioni e Patronato",
    items: [
      {
        question: "Devo pagare per fare domanda di pensione?",
        answer: "No. La <a href='/pensioni'>domanda di pensione</a> con il nostro patronato è gratuita e la tessera non è obbligatoria. Si pagano solo il calcolo approfondito con tutte le possibilità di uscita e la <a href='/stima-pensione'>stima della pensione</a> per chi andrà in pensione più avanti.",
      },
      {
        question: "Quanto tempo ho per fare domanda di NASpI?",
        answer: "<strong>68 giorni</strong> dalla cessazione del rapporto di lavoro. Oltre questo termine il diritto decade.",
      },
      {
        question: "Cos'è il mandato al Patronato ENASC?",
        answer: "È il modulo con cui autorizzi il Patronato ENASC ad assisterti e a presentare le pratiche all'INPS per tuo conto. Puoi compilarlo online nella pagina del <a href='/mandato'>mandato di patronato</a>.",
      },
      {
        question: "Quanto tempo dura la pratica di invalidità civile?",
        answer: "Dipende dai tempi di convocazione della visita, che cambiano da zona a zona. Il primo passo è il certificato medico introduttivo: da noi il medico certificatore è nello stesso ufficio. <a href='/invalidita-104'>Come funziona</a>.",
      },
    ],
  },
];

const allFaq = groups.flatMap((g) => g.items);
// Indice delle sezioni nella colonna laterale (da 1200 px): ogni titolo ha il suo id.
const slug = (t: string) => "faq-" + t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const toc = groups.map((g) => ({ slug: slug(g.title), text: g.title }));
---

<BaseLayout
  title="CAF e patronato Roma: orari, prezzi e domande frequenti"
  description="CAF e patronato a Roma Vigne Nuove: orari (sabato chiuso), telefono, prezzi di 730, ISEE, successioni, pensioni e NASpI. Tutte le risposte."
>
  <JsonLdFaq slot="head" items={allFaq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "FAQ", href: "/faq" }]} class="mb-6" />
      <SectionHeading
        eyebrow="Domande frequenti"
        title="Le risposte a tutto ciò che ci chiedete più spesso"
        subtitle="Se non trovi la tua risposta, scrivici su WhatsApp o telefonaci: rispondiamo in giornata."
        level="h1"
      />
    </div>
  </section>

  <section class="section">
    <div class="container-narrow pl faq-pl">
      <div class="pl-main space-y-12">
      {groups.map((g) => (
        <div>
          <h2 id={slug(g.title)} class="faq-sez font-display text-2xl font-bold text-[var(--color-brand-900)]">{g.title}</h2>
          <div class="mt-6">
            <FaqList items={g.items} />
          </div>
        </div>
      ))}
      </div>
      <PageAside toc={toc} tocTitle="In questa pagina" />
    </div>
  </section>

  <BookingCTA />
</BaseLayout>

<style>
  /* Schermi larghi (27/11/2026): da 1200 px domande a sinistra (circa 800 px, allineate al titolo) e a destra,
     sul bordo del contenitore, la colonna laterale con l'indice delle sezioni, Prenota e calcolatori. Le risposte restano nell'HTML (FaqList, details). */
  .faq-sez { scroll-margin-top: 6rem; }
  @media (min-width: 1200px) {
    .faq-pl { --pl-main: 800px; justify-content: space-between; }
  }
</style>
