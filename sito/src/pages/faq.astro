---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import Accordion from "~/components/ui/Accordion.svelte";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";

const groups = [
  {
    title: "Generale",
    items: [
      {
        question: "Dove si trova il Centro Pratiche Flaiano?",
        answer: "Siamo a Roma, in <strong>Via Filoteo Alberini 25, interno 10</strong>, dentro il Centro Acquisti Flaiano (quartiere Vigne Nuove, Municipio III). Serviamo Vigne Nuove, Tufello, Conca d'Oro, Bufalotta, Porta di Roma e tutta la zona nord di Roma.",
      },
      {
        question: "Quali sono gli orari di apertura?",
        answer: "Lunedi-Giovedi 9:30-13:00 e 15:30-18:00. Venerdì 9:30-14:00 (orario continuato). Sabato e domenica chiusi.",
      },
      {
        question: "Come prenoto un appuntamento?",
        answer: "Puoi prenotare online attraverso <a href='/prenota'>la pagina prenota</a> oppure chiamare il numero 06 9784 5429 o scrivere su WhatsApp al 371 6230 690.",
      },
      {
        question: "Posso essere seguito da remoto?",
        answer: "Sì. Offriamo consulenza video o telefonica con prenotazione online dal sito.",
      },
    ],
  },
  {
    title: "Tesseramento",
    items: [
      {
        question: "Quanto costa la tessera?",
        answer: "30 € all'anno o 20 € a semestre per tutto il nucleo familiare. Vedi <a href='/tesseramento'>la pagina tesseramento</a> per tutti i dettagli.",
      },
      {
        question: "Devo essere socio per usare i vostri servizi?",
        answer: "No. Tutti i servizi sono accessibili a soci e non soci. La tessera ti dà consulenze gratuite, appuntamenti prioritari e sconti sulle pratiche, per tutto il nucleo familiare.",
      },
      {
        question: "La tessera vale anche per il Patronato?",
        answer: "Molte pratiche di patronato sono gratuite per tutti, per esempio la domanda NASpI. Dove c'è un costo lo trovi nella pagina del servizio; con la tessera spesso costa meno (es. <a href='/assegno-unico'>Assegno Unico</a>).",
      },
    ],
  },
  {
    title: "730 e Dichiarazione redditi",
    items: [
      {
        question: "Quanto costa fare il 730?",
        answer: "Da 30 €, in base alla tua situazione: te lo diciamo prima di iniziare. Se l'anno dopo torni da noi, il prezzo resta quello. <a href='/730'>Tutto sul 730</a>.",
      },
      {
        question: "Quali documenti servono per il 730?",
        answer: "Documento d'identita, codice fiscale di tutto il nucleo, Certificazione Unica, ricevute spese sanitarie e detraibili, contratti mutuo/affitto. <a href='/blog/categoria/730-redditi'>Trovi la lista completa nel blog 730</a>.",
      },
      {
        question: "Entro quando si presenta il 730?",
        answer: "Negli ultimi anni il 730 si è presentato da fine aprile/maggio fino al <strong>30 settembre</strong>. Le date ufficiali di ogni anno le pubblica l'Agenzia delle Entrate: appena escono le trovi nel nostro <a href='/blog/categoria/730-redditi'>blog 730</a>.",
      },
    ],
  },
  {
    title: "ISEE",
    items: [
      {
        question: "Quanto costa fare l'ISEE?",
        answer: "Per il cittadino la <strong>prima presentazione annuale dell'ISEE al CAF è gratuita</strong>: il servizio è remunerato direttamente dall'INPS al CAF tramite la convenzione nazionale. Solo eventuali rilasci successivi nello stesso anno per modifiche o integrazioni dovute a omissioni o difformita possono comportare un costo. <strong>Anche l'ISEE corrente</strong> rientra nella convenzione INPS-CAF.",
      },
      {
        question: "Quanto dura l'ISEE?",
        answer: "L'ISEE ordinario scade il <strong>31 dicembre</strong> dell'anno in cui viene rilasciato. Va rifatto ogni gennaio per non perdere benefici come l'Assegno Unico in misura piena.",
      },
      {
        question: "Cos'e l'ISEE corrente?",
        answer: "Una variante dell'ISEE che fotografa la situazione economica recente (12 mesi) invece di quella di 2 anni fa. Utile in caso di calo del reddito (perdita lavoro, riduzione attività). Vale 6 mesi.",
      },
    ],
  },
  {
    title: "Pensioni e Patronato",
    items: [
      {
        question: "Devo pagare per fare domanda di pensione?",
        answer: "No, la tessera non è obbligatoria. Molte pratiche di patronato sono gratuite (es. <a href='/naspi'>domanda NASpI</a>); dove c'è un costo è indicato nella pagina del servizio.",
      },
      {
        question: "Quanto tempo ho per fare domanda di NASpI?",
        answer: "<strong>68 giorni</strong> dalla cessazione del rapporto di lavoro. Oltre questo termine il diritto decade.",
      },
      {
        question: "Quanto tempo dura la pratica di invalidità civile?",
        answer: "Dipende dai tempi di convocazione della visita, che cambiano da zona a zona. Il primo passo è il certificato medico introduttivo: da noi il medico certificatore è nello stesso ufficio. <a href='/invalidita-104'>Come funziona</a>.",
      },
    ],
  },
];

const allFaq = groups.flatMap((g) => g.items);
---

<BaseLayout
  title="Domande frequenti su CAF e patronato"
  description="Domande frequenti al Centro Pratiche Flaiano CAF UNSIC e Patronato ENASC a Roma. Tesseramento, 730, ISEE, pensioni, NASpI: tutte le risposte in un'unica pagina."
>
  <JsonLdFaq slot="head" items={allFaq} />

  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "FAQ", href: "/faq" }]} class="mb-6" />
      <SectionHeading
        eyebrow="Domande frequenti"
        title="Le risposte a tutto ciò che ci chiedete più spesso"
        subtitle="Se non trovi la tua risposta, scrivici su WhatsApp o telefonaci: rispondiamo in giornata."
        level="h1"
      />
    </div>
  </section>

  <section class="section">
    <div class="container-narrow space-y-12">
      {groups.map((g) => (
        <div>
          <h2 class="font-display text-2xl font-bold text-[var(--color-brand-900)]">{g.title}</h2>
          <div class="mt-6">
            <Accordion client:visible items={g.items} multipleOpen />
          </div>
        </div>
      ))}
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
