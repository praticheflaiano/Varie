---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
const props = {"eyebrow": "ADI e SFL · CAF e Patronato", "title": "Un aiuto ti spetta?", "highlight": "Vediamolo insieme.", "lead": "L'Assegno di inclusione e il Supporto formazione e lavoro sono gli aiuti per chi ha un ISEE basso. Controlliamo se ti spettano, facciamo l'ISEE e la domanda, e ti diciamo cosa fare dopo per non perderli.", "chat": {"q": "Ho perso il lavoro e l'ISEE è basso, mi spetta l'ADI?", "a": "Dipende da chi c'è in famiglia. Mandaci i documenti: controlliamo e ti diciamo quale aiuto chiedere.", "done": "Domanda inviata all'INPS"}, "sticker": "ISEE gratis", "strip": ["ISEE fatto da noi, gratis", "Domanda INPS", "Iscrizione SIISL", "Promemoria per non perdere l'aiuto"], "needs": [{"t": "in famiglia ci sono figli o anziani", "d": "L'ADI è pensato per famiglie con minori, persone con disabilità, over 60 o in condizioni di svantaggio."}, {"t": "cerchi lavoro o un corso", "d": "Il Supporto formazione e lavoro accompagna chi partecipa a corsi e progetti per trovare lavoro."}, {"t": "hai già l'aiuto", "d": "Rinnovi, variazioni, ISEE da aggiornare e appuntamenti: ti aiutiamo a non farlo sospendere."}], "steps": [{"t": "Controlliamo i requisiti", "d": "Guardiamo il tuo ISEE e la composizione della famiglia e ti diciamo quale aiuto chiedere."}, {"t": "Facciamo domanda", "d": "Prepariamo ISEE e domanda all'INPS e ti seguiamo nell'iscrizione alla piattaforma SIISL."}, {"t": "Ti seguiamo dopo", "d": "Ti ricordiamo appuntamenti, rinnovi e comunicazioni da fare per non perdere i pagamenti."}], "docs": ["Documento d'identità e codice fiscale di tutti i componenti", "ISEE valido (se non ce l'hai, lo facciamo noi gratis)", "SPID o CIE", "Contratto d'affitto, se sei in affitto", "Certificati di invalidità, se in famiglia c'è una persona con disabilità", "IBAN per l'accredito"], "docsNote": "Le soglie e gli importi li aggiorna l'INPS: li controlliamo sempre al momento della domanda.", "faqs": [{"q": "Che differenza c'è tra ADI e SFL?", "a": "L'ADI è un sostegno per le famiglie con minori, disabili, over 60 o persone in condizione di svantaggio. L'SFL è per chi, tra i 18 e i 59 anni, partecipa a percorsi di formazione o lavoro."}, {"q": "Serve l'ISEE?", "a": "Sì, per entrambi serve un ISEE valido sotto la soglia prevista. Da noi l'ISEE è gratis."}, {"q": "Cos'è il SIISL?", "a": "È la piattaforma del Ministero del Lavoro dove ci si iscrive per firmare il patto di attivazione. Ti aiutiamo a farlo."}, {"q": "Prendo la NASpI: posso chiederli?", "a": "Dipende dalla tua situazione e dal tuo ISEE. Portaci i documenti e verifichiamo."}], "related": [{"label": "ISEE gratis", "href": "/isee"}, {"label": "NASpI", "href": "/naspi"}, {"label": "Assegno Unico", "href": "/assegno-unico"}, {"label": "Carta Dedicata a te", "href": "/blog/carta-dedicata-a-te-2026-2027-scadenza-16-dicembre"}]};
const faqLd = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Che differenza c'è tra ADI e SFL?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"L'ADI è un sostegno per le famiglie con minori, disabili, over 60 o persone in condizione di svantaggio. L'SFL è per chi, tra i 18 e i 59 anni, partecipa a percorsi di formazione o lavoro.\"}}, {\"@type\": \"Question\", \"name\": \"Serve l'ISEE?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sì, per entrambi serve un ISEE valido sotto la soglia prevista. Da noi l'ISEE è gratis.\"}}, {\"@type\": \"Question\", \"name\": \"Cos'è il SIISL?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"È la piattaforma del Ministero del Lavoro dove ci si iscrive per firmare il patto di attivazione. Ti aiutiamo a farlo.\"}}, {\"@type\": \"Question\", \"name\": \"Prendo la NASpI: posso chiederli?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Dipende dalla tua situazione e dal tuo ISEE. Portaci i documenti e verifichiamo.\"}}]}";
---
<BaseLayout title={"ADI e SFL: domanda a Roma Vigne Nuove"} description={"Assegno di inclusione e Supporto formazione e lavoro: verifichiamo i requisiti, facciamo ISEE gratis, domanda INPS e iscrizione SIISL. CAF e patronato a Roma."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="adi-sfl" name={"Assegno di inclusione (ADI) e Supporto formazione e lavoro (SFL)"} description={"Verifica requisiti, ISEE, domanda INPS e adempimenti per ADI e SFL tramite CAF e patronato."} serviceType={"Patronato - sostegno al reddito"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <LandingArticles categories={["isee-dsu", "bonus-fiscali"]} />
</BaseLayout>
