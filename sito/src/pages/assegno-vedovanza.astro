---
/**
 * Assegno di vedovanza: ANF su pensione ai superstiti da lavoro dipendente per il vedovo/la vedova inabile.
 * Fonti verificate il 20/11/2026:
 * - Tabelle ANF dal 1° luglio 2026 (circolare INPS n. 61 del 26/5/2026), Tabella 19 "nuclei composti solo da
 *   maggiorenni inabili", 1 componente: fino a 34.009,98 € -> 52,91 €/mese; 34.009,99-38.150,89 € -> 19,59 €/mese.
 * - Tabella 19 dal 1° luglio 2021: fino a 28.659,42 € -> 52,91; 28.659,43-32.148,87 € -> 19,59 (per gli arretrati).
 * - Requisiti (Money.it 9/11/2026, Studio Cataldi): pensione ai superstiti da lavoro dipendente (escluse gestioni
 *   autonome), inabilità (100% e inabile al lavoro, oppure accompagnamento), redditi IRPEF + esenti > 1.032,91 €;
 *   esclusi accompagnamento, pensioni di guerra, rendite INAIL. Arretrati fino a 5 anni.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";

const faqs = [
  { q: "Cos'è l'assegno di vedovanza?", a: "È un assegno al nucleo familiare (ANF) che l'INPS paga in più sulla pensione di reversibilità o indiretta, al vedovo o alla vedova inabile al lavoro che vive solo. Non è una nuova pensione: si aggiunge a quella che hai già." },
  { q: "Quanto vale l'assegno di vedovanza nel 2026?", a: "Dal 1° luglio 2026 al 30 giugno 2027: 52,91 € al mese con reddito fino a 34.009,98 € l'anno; 19,59 € al mese con reddito da 34.009,99 a 38.150,89 €. Oltre non spetta (tabella 19 delle tabelle ANF INPS)." },
  { q: "Chi ha diritto all'assegno di vedovanza?", a: "Chi prende una pensione di reversibilità o indiretta che viene da lavoro dipendente, pubblico o privato, ed è invalido al 100% e inabile al lavoro oppure ha l'indennità di accompagnamento. Sono escluse le pensioni ai superstiti di artigiani, commercianti e coltivatori diretti." },
  { q: "L'accompagnamento conta nel reddito?", a: "No. Nel reddito non si contano l'indennità di accompagnamento, le pensioni di guerra e le rendite INAIL. Si contano le pensioni e gli altri redditi, anche esenti se superano 1.032,91 € l'anno." },
  { q: "Di quale anno è il reddito che conta?", a: "Per il periodo da luglio 2026 a giugno 2027 conta il reddito del 2025. Ogni periodo da luglio a giugno guarda il reddito dell'anno solare prima." },
  { q: "Si possono avere gli arretrati?", a: "Sì, fino a 5 anni indietro, se in quegli anni c'erano già i requisiti. La domanda si ripresenta per ogni periodo da luglio a giugno." },
  { q: "Come si chiede?", a: "Con la domanda di assegno al nucleo familiare su pensione all'INPS, online, al Contact center o tramite patronato. Va indicato il numero della pensione di reversibilità. Noi del Patronato ENASC la presentiamo per te." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo assegno di vedovanza", url: "https://praticheflaiano.it/assegno-vedovanza", applicationCategory: "FinanceApplication", operatingSystem: "Web", isAccessibleForFree: true, inLanguage: "it", offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" } });
const H2 = "margin:24px 0 0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(28px,5vw,40px);line-height:1.05;color:#14142B";
const TD = "padding:10px;border-top:1px solid #E4E0FF";
const TH = "text-align:left;padding:10px;background:#14142B;color:#fff";
---

<BaseLayout title="Assegno di vedovanza 2026: calcolo e requisiti" description="Calcola se ti spetta l'assegno di vedovanza sulla reversibilità: 52,91 € al mese con reddito fino a 34.009,98 €, arretrati fino a 5 anni. Patronato a Roma.">
  <script slot="head" type="application/ld+json" set:html={appLd} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />

  <section style="background:#F1EEFF">
    <div style="max-width:1120px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:18px">
      <span style="align-self:flex-start;background:#D4FF4F;color:#14142B;font-weight:800;font-size:14px;border-radius:999px;padding:6px 14px">Calcolatore gratuito</span>
      <h1 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:clamp(34px,7vw,56px);line-height:1.02;letter-spacing:-1px;color:#14142B">Assegno di vedovanza: ti spetta?</h1>
      <p style="margin:0;font-size:18px;line-height:1.5;color:#34344A;max-width:780px">Se prendi la <b>pensione di reversibilità</b> e sei <b>invalido al 100%</b> o hai l'<b>accompagnamento</b>, l'INPS può pagarti in più fino a <b>52,91 € al mese</b>, con gli arretrati fino a 5 anni. Molti non lo chiedono perché non lo sanno. Rispondi a 5 domande e scopri se ti spetta.</p>

      <form id="av" onsubmit="return false" novalidate style="background:#fff;border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:16px;box-shadow:0 6px 0 #14142B;max-width:780px">
        <fieldset style="border:0;padding:0;margin:0"><legend style="font-weight:800;margin-bottom:8px">1. Prendi una pensione di reversibilità o indiretta?</legend>
          <label class="av-o"><input type="radio" name="q1" value="si"> Sì</label><label class="av-o"><input type="radio" name="q1" value="no"> No</label></fieldset>
        <fieldset style="border:0;padding:0;margin:0"><legend style="font-weight:800;margin-bottom:8px">2. Il coniuge che è mancato era un lavoratore dipendente (pubblico o privato)?</legend>
          <label class="av-o"><input type="radio" name="q2" value="si"> Sì, dipendente</label><label class="av-o"><input type="radio" name="q2" value="no"> No: artigiano, commerciante o coltivatore</label><label class="av-o"><input type="radio" name="q2" value="nonso"> Non lo so</label>
          <small style="display:block;color:#5B5B72;margin-top:4px">Lo vedi nel certificato di pensione (ObisM): per esempio le pensioni "CTPS" sono dei dipendenti dello Stato.</small></fieldset>
        <fieldset style="border:0;padding:0;margin:0"><legend style="font-weight:800;margin-bottom:8px">3. Hai l'invalidità al 100% o l'indennità di accompagnamento?</legend>
          <label class="av-o"><input type="radio" name="q3" value="si"> Sì</label><label class="av-o"><input type="radio" name="q3" value="no"> No, meno del 100% e senza accompagnamento</label></fieldset>
        <fieldset style="border:0;padding:0;margin:0"><legend style="font-weight:800;margin-bottom:8px">4. Vivi da solo, senza figli o altri familiari nel nucleo?</legend>
          <label class="av-o"><input type="radio" name="q4" value="si"> Sì</label><label class="av-o"><input type="radio" name="q4" value="no"> No, nel nucleo c'è anche qualcun altro</label></fieldset>
        <label style="display:flex;flex-direction:column;gap:6px"><span style="font-weight:800">5. Reddito del 2025, in euro, all'anno</span>
          <input id="av-r" type="number" min="0" step="0.01" inputmode="decimal" placeholder="es. 20787" style="border:2px solid #14142B;border-radius:14px;padding:12px 14px;font-size:18px;max-width:280px">
          <small style="color:#5B5B72">Somma delle pensioni lorde e degli altri redditi. <b>Non contare</b> l'accompagnamento, le pensioni di guerra e le rendite INAIL. Lo trovi nella CU 2026 dell'INPS.</small></label>
        <button id="av-b" type="button" style="align-self:flex-start;background:#5B3DF5;color:#fff;font-weight:800;border:0;border-radius:999px;padding:14px 26px;font-size:17px;cursor:pointer">Calcola</button>
        <div id="av-out" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section style="max-width:860px;margin:0 auto;padding:48px 16px 64px;display:flex;flex-direction:column;gap:14px;font-size:17px;line-height:1.6;color:#2A2A40">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: 20 novembre 2026.</b> Importi e soglie dalle tabelle ANF INPS in vigore dal 1° luglio 2026.</p>

    <h2 style={H2.replace("24px 0 0","0")}>Cos'è l'assegno di vedovanza</h2>
    <p style="margin:0">È un <b>assegno al nucleo familiare (ANF)</b> che l'INPS paga sulla <b>pensione ai superstiti</b>, cioè la reversibilità o la pensione indiretta, al vedovo o alla vedova che è <b>inabile al lavoro</b> e vive da solo. <b>Non è una pensione nuova</b>: è una cifra in più che compare sul cedolino della reversibilità che prendi già.</p>

    <h2 style={H2}>Chi ha diritto</h2>
    <ul style="margin:0;padding-left:22px">
      <li>chi prende una <b>pensione di reversibilità o indiretta</b>;</li>
      <li>che viene da <b>lavoro dipendente</b>, pubblico o privato. Sono escluse le pensioni ai superstiti di <b>artigiani, commercianti, coltivatori diretti, coloni e mezzadri</b>;</li>
      <li>con <b>invalidità al 100% e inabilità al lavoro</b>, oppure con l'<b>indennità di accompagnamento</b>;</li>
      <li>con un <b>reddito</b> sotto le soglie della tabella qui sotto.</li>
    </ul>

    <h2 style={H2}>Quanto spetta dal 1° luglio 2026</h2>
    <div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:16px">
      <thead><tr><th style={TH}>Reddito annuo (anno 2025)</th><th style={TH}>Assegno al mese</th></tr></thead>
      <tbody>
        <tr><td style={TD}>fino a 34.009,98 €</td><td style={TD}><b>52,91 €</b></td></tr>
        <tr><td style={TD}>da 34.009,99 a 38.150,89 €</td><td style={TD}><b>19,59 €</b></td></tr>
        <tr><td style={TD}>oltre 38.150,89 €</td><td style={TD}>non spetta</td></tr>
      </tbody>
    </table></div>
    <p style="margin:0">Sono i valori della <b>tabella 19</b> delle tabelle ANF INPS (nuclei composti solo da maggiorenni inabili, 1 componente), validi dal 1° luglio 2026 al 30 giugno 2027 (circolare INPS n. 61 del 26 maggio 2026, rivalutazione dell'1,4%).</p>

    <h2 style={H2}>Quale reddito conta</h2>
    <p style="margin:0">Per il periodo da <b>luglio 2026 a giugno 2027</b> conta il reddito del <b>2025</b>. Si sommano le <b>pensioni lorde</b> e gli altri redditi, anche quelli esenti se superano 1.032,91 € l'anno. <b>Non si contano</b> l'indennità di accompagnamento, le pensioni di guerra e le rendite INAIL. Il dato lo trovi nella <b>Certificazione Unica (CU)</b> che l'INPS rilascia ogni anno.</p>

    <h2 style={H2}>Un esempio vero</h2>
    <p style="margin:0">Una signora di Roma prende la <b>reversibilità</b> del marito, dipendente dello Stato, una sua piccola <b>pensione di vecchiaia</b> e l'<b>accompagnamento</b>. Nel 2025 le due pensioni fanno <b>20.787,26 €</b>; l'accompagnamento (6.504,24 €) non si conta. È sotto 34.009,98 €: le spettano <b>52,91 € al mese</b>, più gli arretrati degli anni in cui aveva già i requisiti. Non l'aveva mai chiesto.</p>

    <h2 style={H2}>Arretrati e domanda</h2>
    <p style="margin:0">L'assegno si può chiedere anche anni dopo la reversibilità: gli <b>arretrati</b> si recuperano <b>fino a 5 anni</b>, se in quegli anni c'erano già i requisiti. Per ogni periodo da luglio a giugno conta il reddito dell'anno prima. La domanda è quella di <b>assegno al nucleo familiare su pensione</b>, con il numero della pensione di reversibilità.</p>
    <p style="margin:0"><b>Cosa serve:</b> documento d'identità e codice fiscale, verbale di invalidità, data del decesso del coniuge, numero della pensione di reversibilità, le CU degli anni da recuperare.</p>
    <p style="margin:0">La domanda la presentiamo noi come <b>Patronato ENASC</b>, a <b>Vigne Nuove</b> (Roma, Municipio III). <a href="/prenota" style="color:#5B3DF5;font-weight:800">Prenota</a> oppure scrivici su <a href="https://wa.me/393716230690" style="color:#5B3DF5;font-weight:800">WhatsApp 371 623 0690</a>.</p>

    <h2 style={H2}>Domande frequenti</h2>
    {faqs.map((f) => (
      <details style="background:#F7F7FB;border-radius:18px;padding:16px 20px"><summary style="font-weight:800;cursor:pointer">{f.q}</summary><p style="margin:10px 0 0">{f.a}</p></details>
    ))}
    <p style="margin:12px 0 0;font-size:14px;color:#5B5B72">Fonti: INPS, tabelle ANF dal 1° luglio 2026 (circolare n. 61 del 26/5/2026), tabella 19; tabella 19 dal 1° luglio 2021; D.L. 13 marzo 1988, n. 69, art. 2, convertito dalla L. 153/1988 (assegno per il nucleo familiare); <a href="https://www.money.it/assegno-di-vedovanza-requisiti-a-chi-spetta-come-fare-domanda" target="_blank" rel="noopener">Money.it, guida all'assegno di vedovanza</a> (aggiornata il 9/11/2026). Il calcolatore dà una stima: la decisione è dell'INPS. Leggi anche la guida alla <a href="/blog/pensione-reversibilita-quanto-spetta-domanda" style="color:#5B3DF5">pensione di reversibilità</a>.</p>
  </section>

  <style is:global>
    .av-o{display:inline-flex;align-items:center;gap:8px;margin:0 16px 8px 0;font-size:16px;cursor:pointer}
    .av-o input{width:20px;height:20px;accent-color:#5B3DF5}
    .av-res{border-radius:20px;padding:18px 20px;line-height:1.5}
    .av-ok{background:#D4FF4F;color:#14142B}
    .av-ko{background:#FFE4EC;color:#14142B}
    .av-mid{background:#F1EEFF;color:#14142B}
    .av-res b.big{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:40px;line-height:1.05;margin:4px 0}
  </style>
  <script is:inline>
  (function(){
    var f=document.getElementById('av'),out=document.getElementById('av-out');
    var S1=34009.98,S2=38150.89,A1=52.91,A2=19.59;
    var eur=function(n){var p=n.toFixed(2).split('.');return p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1]+' €'};
    var v=function(n){var x=f.querySelector('input[name="'+n+'"]:checked');return x?x.value:''};
    var cta='<p style="margin:10px 0 0">La domanda e gli arretrati li chiediamo noi: <a href="/prenota" style="color:#5B3DF5;font-weight:800">prenota</a> o scrivici su <a href="https://wa.me/393716230690" style="color:#5B3DF5;font-weight:800">WhatsApp</a>.</p>';
    function show(cls,html){out.innerHTML='<div class="av-res '+cls+'">'+html+'</div>';out.scrollIntoView({behavior:'smooth',block:'nearest'})}
    document.getElementById('av-b').addEventListener('click',function(){
      var q1=v('q1'),q2=v('q2'),q3=v('q3'),q4=v('q4'),r=parseFloat(String(document.getElementById('av-r').value).replace(',','.'));
      if(!q1||!q2||!q3||!q4||isNaN(r)){show('av-mid','Rispondi a tutte e 5 le domande.');return}
      if(q1==='no'){show('av-ko','<b>Non spetta:</b> l’assegno di vedovanza si aggiunge solo a una pensione di reversibilità o indiretta.');return}
      if(q2==='no'){show('av-ko','<b>Non spetta:</b> sono escluse le pensioni ai superstiti di artigiani, commercianti e coltivatori diretti.');return}
      if(q3==='no'){show('av-ko','<b>Per ora non spetta:</b> serve l’invalidità al 100% con inabilità al lavoro oppure l’accompagnamento. Se la salute è peggiorata, si può chiedere un aggravamento: ne parliamo insieme.'+cta);return}
      if(q4==='no'){show('av-mid','<b>Da verificare:</b> se nel nucleo ci sono altri familiari si usa una tabella ANF diversa e l’importo può cambiare. Portaci i dati e lo calcoliamo noi.'+cta);return}
      var a=r<=S1?A1:(r<=S2?A2:0);
      if(!a){show('av-ko','<b>Non spetta per il periodo luglio 2026 - giugno 2027:</b> il reddito supera '+eur(S2)+'. Negli anni passati, con redditi più bassi, potrebbe essere spettato: si possono chiedere fino a 5 anni di arretrati.'+cta);return}
      var nota=q2==='nonso'?'<p style="margin:8px 0 0"><b>Attenzione:</b> controlla che la reversibilità venga da lavoro dipendente (certificato ObisM).</p>':'';
      show('av-ok','Ti spetta, secondo i dati inseriti:<b class="big">'+eur(a)+' al mese</b>circa '+eur(a*12)+' l’anno, dal periodo luglio 2026 - giugno 2027.<p style="margin:8px 0 0">Con gli <b>arretrati fino a 5 anni</b> si può arrivare a circa <b>'+eur(a*60)+'</b>, se negli anni passati avevi già i requisiti e il reddito sotto soglia. Il conto esatto lo fa l’INPS.</p>'+nota+cta);
    });
  })();
  </script>
</BaseLayout>
