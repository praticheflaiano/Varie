---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import RomaSkyline from "~/components/illustrations/RomaSkyline.astro";
import { Icon } from "astro-icon/components";
import { ORG_CREDENTIALS, SITE } from "~/consts";

const values = [
  {
    icon: "heroicons:shield-check",
    title: "Zero invenzioni",
    desc: "Ogni dato che ti diamo viene verificato sulle fonti ufficiali (Agenzia delle Entrate, INPS, Gazzetta Ufficiale). Mai numeri inventati, mai date approssimative.",
  },
  {
    icon: "heroicons:hand-raised",
    title: "Linguaggio chiaro",
    desc: "Niente burocratese. Spieghiamo ogni passaggio in italiano semplice, senza far sentire stupido nessuno.",
  },
  {
    icon: "heroicons:user-group",
    title: "Persone, non pratiche",
    desc: "Per noi sei un nome, non un numero. Riconosciamo i nostri soci, ricordiamo le loro situazioni, costruiamo rapporti che durano anni.",
  },
  {
    icon: "heroicons:bolt",
    title: "Niente code",
    desc: "Prenoti online, ci scrivi su WhatsApp, fai molte pratiche anche in videochiamata.",
  },
];
---

<BaseLayout
  title="Chi siamo: Centro Pratiche Flaiano, CAF e patronato a Roma Nord"
  description="Centro Pratiche Flaiano: sede del CAF UNSIC e del Patronato ENASC a Roma Vigne Nuove. Accompagniamo famiglie, lavoratori e pensionati di Roma Nord nelle pratiche fiscali e previdenziali."
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "@id": `${SITE.url}/chi-siamo#webpage`,
      url: `${SITE.url}/chi-siamo`,
      name: "Chi siamo - Centro Pratiche Flaiano",
      inLanguage: "it-IT",
      isPartOf: { "@id": `${SITE.url}/#website` },
      about: { "@id": `${SITE.url}/#organization` },
    })}
  />
  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Chi siamo", href: "/chi-siamo" }]} class="mb-6" />
      <SectionHeading
        eyebrow="Chi siamo"
        title={`Centro Pratiche Flaiano: il tuo CAF e Patronato a Roma Nord`}
        subtitle={SITE.tagline}
        level="h1"
      />
    </div>
  </section>

  <!-- Storia + Mission -->
  <section class="section">
    <div class="container-wide grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-700)]">La nostra storia</p>
        <h2 class="mt-3 font-display">Il tuo CAF e Patronato a Vigne Nuove</h2>
        <div class="mt-5 space-y-4 text-base text-[var(--color-ink-soft)] leading-relaxed">
          <p>
            Il <strong>Centro Pratiche Flaiano</strong> è una sede del <strong>CAF UNSIC</strong> e del <strong>Patronato ENASC</strong>. Il nostro obiettivo è semplice: <em>offrire in un quartiere di Roma servizi fiscali e previdenziali professionali, senza far perdere tempo alle persone</em>.
          </p>
          <p>
            La nostra sede è dentro il <strong>Centro Acquisti Flaiano</strong>, in Via Filoteo Alberini 25 int. 10, 00139 Roma, quartiere Vigne Nuove. Da qui serviamo Tufello, Conca d'Oro, Bufalotta, Porta di Roma e tutto il <strong>Municipio III</strong>.
          </p>
          <p>
            Seguiamo famiglie, lavoratori e pensionati in tutto: dalle dichiarazioni dei redditi alle successioni, dalle pensioni all'assegno unico, dall'invalidità civile ai bonus fiscali. Ogni pratica è una persona con la sua storia, ed è così che ci piace lavorare.
          </p>
        </div>

        <blockquote class="mt-8 rounded-[28px] bg-[var(--color-accent-50)] p-6">
          <p class="font-display text-xl text-[var(--color-brand-950)] italic">
            "{SITE.claim}"
          </p>
          <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
            La nostra promessa.
          </p>
        </blockquote>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[36px] bg-[var(--color-brand-50)] p-8 text-center">
          <RomaSkyline class="mx-auto h-32 w-full text-[var(--color-brand-700)]" />
          <p class="mt-6 font-display text-3xl font-extrabold text-[var(--color-brand-950)]">Municipio III</p>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)]">Roma Nord - Vigne Nuove</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credenziali -->
  <section class="section bg-[var(--color-surface-soft)]">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Credenziali"
        title="Autorizzati e riconosciuti dalla legge"
        subtitle="Siamo una sede del CAF UNSIC e del Patronato ENASC, e lavoriamo secondo la normativa italiana che regola CAF e patronati."
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-[28px] bg-[#F7F7FB] p-7">
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-brand-700)]">CAF UNSIC</p>
          <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-ink)]">{ORG_CREDENTIALS.caf.fullName}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Siamo una sede del CAF (Centro di Assistenza Fiscale) UNSIC. I CAF sono disciplinati dal <strong>{ORG_CREDENTIALS.legalReferences[0]}</strong>.
          </p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
            <strong>Cosa significa per te:</strong> 730, ISEE, IMU, successioni e altre pratiche fiscali seguite dal CAF a cui il Centro appartiene.
          </p>
        </div>
        <div class="rounded-[28px] bg-[#F7F7FB] p-7">
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent-700)]">Patronato ENASC</p>
          <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-ink)]">{ORG_CREDENTIALS.patronato.fullName}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Siamo una sede del Patronato ENASC. I patronati sono disciplinati dalla <strong>{ORG_CREDENTIALS.legalReferences[1]}</strong> e assistono i cittadini nelle pratiche previdenziali e assistenziali.
          </p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
            <strong>Cosa significa per te:</strong> ti assistiamo su pensioni, NASpI, invalidità, ADI e SFL e assegno unico. Molte pratiche sono gratuite; dove c'è un costo, lo trovi scritto nella pagina del servizio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valori -->
  <section class="section">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Come lavoriamo"
        title="I valori in cui crediamo"
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-[28px] bg-[#F7F7FB] p-6 text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-[var(--color-brand-50)] text-[var(--color-brand-700)]">
              <Icon name={v.icon} class="size-7" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-display text-lg font-bold text-[var(--color-ink)]">{v.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)] leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
