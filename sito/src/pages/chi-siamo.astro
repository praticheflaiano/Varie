---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import RomaSkyline from "~/components/illustrations/RomaSkyline.astro";
import { Icon } from "astro-icon/components";
import { ORG_CREDENTIALS, SITE } from "~/consts";

const values = [
  {
    icon: "heroicons:shield-check",
    title: "Zero invenzioni",
    desc: "Ogni dato che ti diamo viene verificato sulle fonti ufficiali (Agenzia delle Entrate, INPS, Gazzetta Ufficiale). Mai numeri inventati, mai date approssimative.",
  },
  {
    icon: "heroicons:hand-raised",
    title: "Linguaggio chiaro",
    desc: "Niente burocratese. Spieghiamo ogni passaggio in italiano semplice, senza far sentire stupido nessuno.",
  },
  {
    icon: "heroicons:user-group",
    title: "Persone, non pratiche",
    desc: "Per noi sei un nome, non un numero. Riconosciamo i nostri soci, ricordiamo le loro situazioni, costruiamo rapporti che durano anni.",
  },
  {
    icon: "heroicons:bolt",
    title: "Tempi rapidi",
    desc: "Appuntamenti entro 48 ore, pratiche urgenti gestite in giornata, risposta WhatsApp veloce.",
  },
];
---

<BaseLayout
  title="Chi siamo: il Centro Pratiche Flaiano"
  description="Centro Pratiche Flaiano: CAF UNSIC e Patronato ENASC a Roma Vigne Nuove. Da anni accompagniamo famiglie, lavoratori e pensionati di Roma Nord nelle pratiche fiscali e previdenziali."
>
  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-16 md:pt-12 md:pb-20">
      <Breadcrumb items={[{ name: "Chi siamo", href: "/chi-siamo" }]} class="mb-6" />
      <SectionHeading
        eyebrow="Chi siamo"
        title={`Centro Pratiche Flaiano: il tuo CAF e Patronato a Roma Nord`}
        subtitle={SITE.tagline}
        level="h1"
      />
    </div>
  </section>

  <!-- Storia + Mission -->
  <section class="section">
    <div class="container-wide grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-700)]">La nostra storia</p>
        <h2 class="mt-3 font-display">Da Vigne Nuove al cuore di Roma Nord</h2>
        <div class="mt-5 space-y-4 text-base text-[var(--color-ink-soft)] leading-relaxed">
          <p>
            Il <strong>Centro Pratiche Flaiano</strong> nasce con un'idea semplice: <em>portare in un quartiere di Roma servizi fiscali e previdenziali professionali, senza far perdere tempo alle persone</em>.
          </p>
          <p>
            La nostra sede e dentro il <strong>Centro Acquisti Flaiano</strong>, in Via Filoteo Alberini 25, quartiere Vigne Nuove. Da qui serviamo Tufello, Conca d'Oro, Bufalotta, Porta di Roma e tutto il <strong>Municipio III</strong>.
          </p>
          <p>
            In questi anni abbiamo seguito centinaia di famiglie, lavoratori e pensionati: dalle dichiarazioni dei redditi alle successioni, dalle pensioni all'assegno unico, dall'invalidita civile ai bonus fiscali. Ogni pratica e una persona con la sua storia, e cosi che ci piace lavorare.
          </p>
        </div>

        <blockquote class="mt-8 rounded-[var(--radius-lg)] border-l-4 border-[var(--color-accent-400)] bg-[var(--color-accent-50)] p-6">
          <p class="font-display text-xl text-[var(--color-brand-950)] italic">
            "{SITE.claim}"
          </p>
          <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
            La nostra promessa, da sempre.
          </p>
        </blockquote>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[var(--radius-2xl)] bg-[var(--color-brand-50)] p-8 text-center">
          <RomaSkyline class="mx-auto h-32 w-full text-[var(--color-brand-700)]" />
          <p class="mt-6 font-display text-3xl font-extrabold text-[var(--color-brand-950)]">Municipio III</p>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)]">Roma Nord - Vigne Nuove</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Credenziali -->
  <section class="section bg-[var(--color-surface-soft)]">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Credenziali"
        title="Autorizzati e riconosciuti dalla legge"
        subtitle="Operiamo come CAF e Patronato in conformita con la normativa italiana, con i requisiti di formazione, organizzazione e responsabilita previsti."
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-brand-700)]">CAF UNSIC</p>
          <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-ink)]">{ORG_CREDENTIALS.caf.fullName}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
            CAF (Centro di Assistenza Fiscale) iscritto all'albo dei CAF dipendenti. Operiamo in conformita con il <strong>{ORG_CREDENTIALS.legalReferences[0]}</strong>.
          </p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
            <strong>Cosa significa per te:</strong> garanzia di formazione del personale, copertura assicurativa professionale, controllo qualita su ogni dichiarazione trasmessa.
          </p>
        </div>
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-7 shadow-[var(--shadow-soft)]">
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent-700)]">Patronato ENASC</p>
          <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-ink)]">{ORG_CREDENTIALS.patronato.fullName}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
            Patronato riconosciuto dal Ministero del Lavoro a norma della <strong>{ORG_CREDENTIALS.legalReferences[1]}</strong>. Tuteliamo gratuitamente i diritti previdenziali e assistenziali dei cittadini.
          </p>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
            <strong>Cosa significa per te:</strong> tutte le pratiche INPS (pensioni, NASpI, invalidita, assegno unico) sono per legge gratuite e seguite da personale specializzato.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valori -->
  <section class="section">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Come lavoriamo"
        title="I valori in cui crediamo"
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-6 shadow-[var(--shadow-soft)] text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-[var(--color-brand-50)] text-[var(--color-brand-700)]">
              <Icon name={v.icon} class="size-7" aria-hidden="true" />
            </div>
            <h3 class="mt-5 font-display text-lg font-bold text-[var(--color-ink)]">{v.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)] leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>
