---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
const props = {"eyebrow": "Dimissioni online · Patronato", "title": "Vuoi dimetterti?", "highlight": "Facciamolo bene.", "lead": "Le dimissioni si fanno solo online. Le inviamo noi come patronato, anche se non hai lo SPID, e prima ti diciamo se con la giusta causa puoi avere la NASpI.", "chat": {"q": "Non mi pagano lo stipendio da tre mesi, posso dimettermi e prendere la NASpI?", "a": "In molti casi sì, con le dimissioni per giusta causa. Vieni con le buste paga: controlliamo e le inviamo noi.", "done": "Dimissioni inviate"}, "sticker": "Anche senza SPID", "strip": ["Anche senza SPID", "Giusta causa e NASpI", "Revoca entro 7 giorni", "Domanda NASpI gratis"], "needs": [{"t": "vuoi cambiare lavoro", "d": "Dimissioni volontarie con il giusto preavviso, per non dover pagare penali al datore di lavoro."}, {"t": "il lavoro è diventato impossibile", "d": "Stipendi non pagati, contributi non versati, mobbing: con la giusta causa puoi avere la NASpI."}, {"t": "ci hai ripensato", "d": "Le dimissioni online si possono revocare entro 7 giorni. Se serve, la revoca la facciamo noi."}], "steps": [{"t": "Ci racconti la situazione", "d": "Capiamo se sono dimissioni volontarie o per giusta causa e quale preavviso serve."}, {"t": "Inviamo le dimissioni", "d": "Compiliamo e inviamo il modulo al Ministero del Lavoro come patronato."}, {"t": "Pensiamo alla NASpI", "d": "Se ne hai diritto, presentiamo subito la domanda NASpI, gratis."}], "docs": ["Documento d'identità e codice fiscale", "Contratto di lavoro o lettera di assunzione", "Ultime buste paga", "Data da cui vuoi che decorrano le dimissioni", "Per la giusta causa: documenti che la provano (stipendi non pagati, comunicazioni)", "Indirizzo email o PEC del datore di lavoro"], "docsNote": "Non firmare dimissioni su carta: senza la procedura online non sono valide.", "faqs": [{"q": "Posso dimettermi senza SPID?", "a": "Sì, tramite un patronato come il nostro: le inviamo noi per te."}, {"q": "Con le dimissioni prendo la NASpI?", "a": "Con le dimissioni volontarie no. Con le dimissioni per giusta causa sì, se hai i requisiti. Valutiamo insieme la tua situazione. <a href='/naspi'>Tutto sulla NASpI</a>."}, {"q": "Posso ripensarci?", "a": "Sì, entro 7 giorni dall'invio le dimissioni si possono revocare."}, {"q": "Ci sono casi in cui non si fanno online?", "a": "Sì, per esempio nel lavoro domestico, durante il periodo di prova o per le lavoratrici madri e i lavoratori padri nei periodi protetti, che seguono una procedura diversa. Ti diciamo noi cosa fare."}], "related": [{"label": "NASpI", "href": "/naspi"}, {"label": "Portale NASpI", "href": "https://domandedisoccupazione.it"}, {"label": "Checklist primi 7 giorni", "href": "/blog/checklist-primi-7-giorni-perdita-lavoro-roma"}, {"label": "ADI e SFL", "href": "/adi-sfl"}]};
const faqLd = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Posso dimettermi senza SPID?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sì, tramite un patronato come il nostro: le inviamo noi per te.\"}}, {\"@type\": \"Question\", \"name\": \"Con le dimissioni prendo la NASpI?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Con le dimissioni volontarie no. Con le dimissioni per giusta causa sì, se hai i requisiti. Valutiamo insieme la tua situazione. Tutto sulla NASpI.\"}}, {\"@type\": \"Question\", \"name\": \"Posso ripensarci?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sì, entro 7 giorni dall'invio le dimissioni si possono revocare.\"}}, {\"@type\": \"Question\", \"name\": \"Ci sono casi in cui non si fanno online?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sì, per esempio nel lavoro domestico, durante il periodo di prova o per le lavoratrici madri e i lavoratori padri nei periodi protetti, che seguono una procedura diversa. Ti diciamo noi cosa fare.\"}}]}";
---
<BaseLayout title={"Dimissioni online: le inviamo noi a Roma"} description={"Dimissioni volontarie o per giusta causa e revoca: le inviamo noi come patronato, anche senza SPID. Ti diciamo se hai diritto alla NASpI. Vigne Nuove, Roma."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="dimissioni-online" name={"Dimissioni telematiche"} description={"Invio delle dimissioni volontarie, per giusta causa e delle revoche tramite patronato, con verifica del diritto alla NASpI."} serviceType={"Patronato - lavoro"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <LandingArticles categories={["naspi-disoccupazione"]} />
</BaseLayout>
