---
/**
 * Strumento interattivo "Quale ISEE ti serve": domande a scelta, risultato con tipo di ISEE,
 * spiegazione, documenti e contatti. Regole tratte dal DPCM 159/2013 e dalle novita 2026
 * (L. 199/2025 c. 208, DM 3/2026): vedi l'articolo /blog/tipi-di-isee-differenze-quale-serve.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import bonus from "~/data/bonus.json";

// Dati del tab "Cosa ti spetta": solo i campi che servono alla pagina, inseriti a build time.
const misure = bonus.misure.map((m: any) => ({
  id: m.id, nome: m.nome, ente: m.ente, a_chi_spetta: m.a_chi_spetta, requisiti: m.requisiti,
  importo: { testo: m.importo.testo }, scadenza: m.scadenza, stato: m.stato, come_si_chiede: m.come_si_chiede,
  il_centro_controlla: m.il_centro_controlla, pagina_sito: m.pagina_sito, articolo_sito: m.articolo_sito,
  cta: { aiuto: m.cta.aiuto, prezzo_testo: m.cta.prezzo_testo }, fonti: m.fonti, nota_motore: m.nota_motore ?? null,
}));
const misureJson = JSON.stringify(misure).replace(/</g, "\\u003c");

const ld = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Quale ISEE ti serve",
  url: "https://praticheflaiano.it/quale-isee",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  isAccessibleForFree: true,
  inLanguage: "it",
  offers: { "@type": "Offer", price: 0, priceCurrency: "EUR" },
  provider: { "@type": "LocalBusiness", name: "Centro Pratiche Flaiano", url: "https://praticheflaiano.it" },
  description: "Due test gratuiti: scopri quale ISEE ti serve (ordinario, minorenni, università, sociosanitario, ristretto, residenze, corrente) e quali bonus e aiuti ti spettano a Roma e nel Lazio.",
};
---

<BaseLayout
  title="Quale ISEE ti serve e cosa ti spetta: test gratis"
  description="Scopri quale ISEE fare e quali bonus e aiuti ti spettano a Roma e nel Lazio. Due test gratuiti di un minuto. Non salviamo le tue risposte."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="qi">
    <div class="qi-wrap">
      <span class="qi-eyebrow">Strumenti gratuiti</span>
      <h1 class="qi-title">Quale ISEE ti serve e cosa ti spetta</h1>
      <p class="qi-lead">Due test di un minuto: scopri quale ISEE chiedere e quali bonus e aiuti puoi avere a Roma e nel Lazio. Non ti chiediamo nessun dato personale.</p>

      <div class="qi-tabs" role="tablist" aria-label="Scegli lo strumento" id="qi-tabs" hidden>
        <button type="button" role="tab" class="qi-tab" id="qi-tab-isee" aria-controls="qi-panel-isee" aria-selected="true" data-modo="isee">Quale ISEE ti serve</button>
        <button type="button" role="tab" class="qi-tab" id="qi-tab-bonus" aria-controls="qi-panel-bonus" aria-selected="false" tabindex="-1" data-modo="bonus">Cosa ti spetta</button>
      </div>

      <div role="tabpanel" id="qi-panel-isee" aria-labelledby="qi-tab-isee" class="qi-panel">
        <div class="qi-card" id="qi-app" aria-live="polite">
          <noscript><p>Per usare il test serve JavaScript. Puoi leggere la <a href="/blog/tipi-di-isee-differenze-quale-serve">guida completa ai tipi di ISEE</a> o chiamarci allo 06 9784 5429.</p></noscript>
        </div>

        <p class="qi-note">Il risultato è un'indicazione generale basata sulle regole ISEE (DPCM 159/2013 e novità 2026). Ogni bando indica il tipo di ISEE richiesto: in caso di dubbio controlliamo noi, gratis. Approfondisci nella <a href="/blog/tipi-di-isee-differenze-quale-serve">guida a tutti i tipi di ISEE</a>.</p>
      </div>

      <div role="tabpanel" id="qi-panel-bonus" aria-labelledby="qi-tab-bonus" class="qi-panel">
        <div class="qi-card qb-card" id="qb-app" aria-live="polite">
          <noscript><p>Per usare il test serve JavaScript. Leggi le pagine su <a href="/bonus-famiglia">bonus famiglia</a>, <a href="/adi-sfl">ADI e SFL</a> e <a href="/caregiver">caregiver</a>, o chiamaci allo 06 9784 5429.</p></noscript>
        </div>
        <script id="qb-data" type="application/json" is:inline set:html={misureJson} />
        <p class="qi-note">Strumento indicativo. Non salviamo le tue risposte. Per verificare davvero cosa ti spetta serve il tuo ISEE e, in alcuni casi, i tuoi documenti. Dati verificati su fonti ufficiali il {bonus.meta.generato_il.split("-").reverse().join("/")}. Leggi la <a href="/privacy">privacy</a>.</p>
      </div>
    </div>
  </section>

  <script is:inline>
  (function () {
    var tabs = document.getElementById('qi-tabs');
    if (!tabs) return;
    var btn = { isee: document.getElementById('qi-tab-isee'), bonus: document.getElementById('qi-tab-bonus') };
    var pan = { isee: document.getElementById('qi-panel-isee'), bonus: document.getElementById('qi-panel-bonus') };
    function show(m, focus, url) {
      ['isee', 'bonus'].forEach(function (k) {
        var on = k === m;
        btn[k].setAttribute('aria-selected', on ? 'true' : 'false');
        btn[k].setAttribute('tabindex', on ? '0' : '-1');
        pan[k].hidden = !on;
      });
      if (focus) btn[m].focus();
      if (url) {
        try { history.replaceState(null, '', m === 'bonus' ? '?modo=bonus' : location.pathname); } catch (e) {}
      }
    }
    var modo = 'isee';
    try { modo = new URLSearchParams(location.search).get('modo') === 'bonus' ? 'bonus' : 'isee'; } catch (e) {}
    tabs.hidden = false;
    show(modo, false, false);
    ['isee', 'bonus'].forEach(function (k) {
      btn[k].addEventListener('click', function () { show(k, false, true); });
      btn[k].addEventListener('keydown', function (ev) {
        var next = null;
        if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') next = k === 'isee' ? 'bonus' : 'isee';
        else if (ev.key === 'Home') next = 'isee';
        else if (ev.key === 'End') next = 'bonus';
        if (next) { ev.preventDefault(); show(next, true, true); }
      });
    });
  })();
  </script>

  <script is:inline>
  (function () {
    var app = document.getElementById('qi-app');
    if (!app) return;
    var WA = 'https://wa.me/393716230690?text=';

    var Q = {
      scopo: {
        q: "Per cosa ti serve l'ISEE?",
        help: "Scegli l'aiuto principale. Se sono più di uno, scegli quello più importante per te.",
        opts: [
          ['figli', 'Assegno unico, bonus nido, bonus nuovi nati o servizi per i figli (nido, mensa)'],
          ['incl', 'Assegno di inclusione (ADI) o Supporto per la formazione e il lavoro (SFL)'],
          ['uni', 'Università: tasse o borsa di studio'],
          ['disab', 'Assistenza a casa o centro diurno per una persona con disabilità o non autosufficiente'],
          ['rsa', 'Ricovero in RSA o in un’altra struttura residenziale'],
          ['bonus', 'Bonus bollette, Carta Dedicata a te, TARI, altri bonus o tariffe'],
          ['noisee', 'NASpI, pensione, invalidità, accompagnamento o Legge 104'],
          ['nonso', 'Non lo so ancora']
        ]
      },
      genitori: {
        q: 'I genitori dei figli sono sposati tra loro oppure vivono insieme?',
        opts: [['si', 'Sì, sposati o conviventi'], ['no', 'No, non sono sposati e non vivono insieme']]
      },
      altroGen: {
        q: 'Il genitore che non vive con i figli si trova in una di queste situazioni?',
        opts: [
          ['escluso', 'Versa un mantenimento deciso dal giudice, è escluso dalla responsabilità genitoriale o è estraneo (accertato dai servizi)'],
          ['aggiuntivo', 'È sposato con un’altra persona o ha figli con un’altra persona'],
          ['nessuna', 'Nessuna delle due'],
          ['nonso', 'Non lo so']
        ]
      },
      autonomo: {
        q: "Lo studente vive fuori dalla casa dei genitori da almeno 2 anni, in una casa non della famiglia, e ha un proprio reddito da lavoro?",
        opts: [['si', 'Sì, entrambe le cose'], ['no', 'No, oppure solo una delle due']]
      },
      uniGen: {
        q: 'I genitori dello studente sono sposati tra loro oppure vivono insieme?',
        opts: [['si', 'Sì'], ['no', 'No, non sono sposati e non vivono insieme']]
      },
      maggiorenne: {
        q: "La persona che riceve l'assistenza è maggiorenne?",
        opts: [['si', 'Sì, ha almeno 18 anni'], ['no', 'No, è minorenne']]
      },
      conParenti: {
        q: 'Vive con genitori, fratelli o altri parenti che non sono il coniuge o i figli?',
        opts: [['si', 'Sì'], ['no', 'No, solo con coniuge e figli, oppure da sola']]
      },
      figliFuori: {
        q: 'La persona da ricoverare ha figli che non vivono con lei?',
        opts: [['si', 'Sì'], ['no', 'No']]
      },
      donazioni: {
        q: 'Negli ultimi 3 anni ha donato case o terreni a coniuge o figli?',
        opts: [['si', 'Sì'], ['no', 'No'], ['nonso', 'Non lo so']]
      },
      calo: {
        q: 'Negli ultimi mesi qualcuno in famiglia ha perso o ridotto il lavoro, oppure il reddito è sceso molto?',
        help: "Ci serve per capire se conviene anche l'ISEE corrente.",
        opts: [['si', 'Sì'], ['no', 'No']]
      }
    };

    var a = {};
    var history = [];

    function next(cur) {
      if (cur === 'scopo') {
        if (a.scopo === 'figli') return 'genitori';
        if (a.scopo === 'uni') return 'autonomo';
        if (a.scopo === 'disab') return 'maggiorenne';
        if (a.scopo === 'rsa') return 'figliFuori';
        if (a.scopo === 'noisee') return null;
        return 'calo';
      }
      if (cur === 'genitori') return a.genitori === 'no' ? 'altroGen' : 'calo';
      if (cur === 'altroGen') return 'calo';
      if (cur === 'autonomo') return a.autonomo === 'si' ? 'calo' : 'uniGen';
      if (cur === 'uniGen') return a.uniGen === 'no' ? 'altroGen' : 'calo';
      if (cur === 'maggiorenne') return a.maggiorenne === 'si' ? 'conParenti' : 'genitori';
      if (cur === 'conParenti') return 'calo';
      if (cur === 'figliFuori') return 'donazioni';
      if (cur === 'donazioni') return 'calo';
      return null;
    }

    var BASE_DOCS = [
      'Documento e codice fiscale di tutti i componenti del nucleo',
      'Redditi del secondo anno precedente (730, Redditi PF o CU)',
      'Saldi e giacenze medie di conti, libretti e carte prepagate al 31 dicembre del secondo anno precedente',
      'Dati di case e terreni, mutuo residuo, contratto d’affitto registrato se sei in affitto',
      'Targhe di auto e moto'
    ];

    function result() {
      var r = { tipo: '', perche: [], docs: BASE_DOCS.slice(), extra: [] };
      var s = a.scopo;
      if (s === 'noisee') {
        r.tipo = "Probabilmente non ti serve l'ISEE";
        r.perche.push("NASpI, pensioni, invalidità civile, accompagnamento e permessi della Legge 104 non dipendono dall'ISEE: contano contributi, redditi o il verbale sanitario.");
        r.perche.push("L'ISEE può servirti per altri aiuti della famiglia, come l'Assegno unico o il bonus bollette: rifai il test scegliendo quell'aiuto.");
        r.docs = [];
        r.cta = 'Come patronato presentiamo NASpI, pensioni e domande di invalidità.';
        return r;
      }
      if (s === 'figli' || (s === 'disab' && a.maggiorenne === 'no')) {
        r.tipo = 'ISEE per le prestazioni ai minorenni';
        if (s === 'disab') r.perche.push('Per gli aiuti sociosanitari a un minorenne si usa l’ISEE minorenni, non il nucleo ristretto.');
        if (a.genitori === 'si') {
          r.perche.push('Con genitori sposati o conviventi il valore è uguale all’ISEE ordinario: basta una normale DSU.');
        } else {
          gen(r);
        }
        if (s === 'figli') r.perche.push("Per Assegno unico, bonus nido e bonus nuovi nati l'INPS applica da solo il calcolo 2026 più favorevole per le famiglie: non devi chiederlo a parte.");
        if (s === 'disab') r.extra.push('Verbale di invalidità o di handicap (Legge 104), con data e numero');
      } else if (s === 'incl') {
        r.tipo = 'ISEE del nucleo familiare (con il calcolo 2026 per l’inclusione)';
        r.perche.push("Per ADI e SFL l'INPS usa il nuovo calcolo 2026, con la casa di proprietà esclusa fino a 91.500 € (120.000 € a Roma) e maggiorazioni per i figli. Lo ricava dalla stessa DSU.");
        r.perche.push('Se in famiglia ci sono figli minorenni con genitori non sposati e non conviventi, servono anche i dati dell’altro genitore.');
      } else if (s === 'uni') {
        if (a.autonomo === 'si') {
          r.tipo = 'ISEE università da studente autonomo';
          r.perche.push('Vivi fuori casa da almeno 2 anni in un alloggio non della famiglia e hai un reddito tuo: l’ISEE comprende solo te (e l’eventuale coniuge e figli).');
          r.perche.push('Controlla nel bando dell’ateneo o dell’ente regionale (in Lazio DiSCo) la soglia di reddito richiesta per essere autonomo.');
          r.extra.push('Contratto d’affitto o residenza fuori casa da almeno 2 anni', 'CU o redditi da lavoro degli ultimi 2 anni');
        } else {
          r.tipo = 'ISEE università con la famiglia d’origine';
          r.perche.push('Lo studente non autonomo entra nel nucleo dei genitori, anche se vive da solo o ha la residenza altrove.');
          if (a.uniGen === 'no') gen(r);
          r.extra.push('Documenti e redditi dei genitori', 'Matricola o iscrizione all’università');
        }
      } else if (s === 'disab') {
        if (a.conParenti === 'si') {
          r.tipo = 'ISEE sociosanitario con nucleo ristretto';
          r.perche.push('La persona con disabilità maggiorenne può presentare un ISEE con solo sé stessa, il coniuge e i figli: genitori, fratelli e altri parenti conviventi restano fuori.');
          r.perche.push('Di solito il valore è molto più basso dell’ordinario. Prima di inviarlo calcoliamo entrambi e scegliamo quello più conveniente.');
        } else {
          r.tipo = 'ISEE sociosanitario';
          r.perche.push('Vive solo con coniuge e figli, oppure da sola: nucleo ordinario e ristretto coincidono.');
        }
        r.extra.push('Verbale di invalidità o di handicap (Legge 104), con data e numero', 'Ricevute delle spese per assistenza o badante');
      } else if (s === 'rsa') {
        r.tipo = 'ISEE sociosanitario per le residenze (RSA)';
        r.perche.push('Serve per l’aiuto sulla quota sociale della retta. Si può usare anche il nucleo ristretto.');
        if (a.figliFuori === 'si') {
          r.perche.push('Per ogni figlio che non vive con lei si aggiunge una quota calcolata sulla sua situazione economica, salvo disabilità o estraneità accertata.');
          r.extra.push('Codice fiscale, redditi e patrimonio di ogni figlio non convivente');
        }
        if (a.donazioni === 'si' || a.donazioni === 'nonso') {
          r.perche.push('Le case donate a coniuge o figli nei 3 anni prima della richiesta, o dopo, contano ancora nel patrimonio di chi le ha donate.');
          r.extra.push('Atti di donazione di immobili degli ultimi 3 anni');
        }
        r.extra.push('Verbale di invalidità o certificazione di non autosufficienza');
      } else if (s === 'bonus') {
        r.tipo = 'ISEE ordinario';
        r.perche.push('Bonus sociale bollette, Carta Dedicata a te, riduzioni TARI e la maggior parte di bonus e tariffe usano l’ISEE ordinario. Se il bando scrive solo "ISEE in corso di validità", vale questo.');
        r.perche.push('Il bonus sociale per luce, gas e acqua si attiva da solo quando presenti la DSU, se rientri nella soglia.');
      } else {
        r.tipo = 'ISEE ordinario (e gli altri, se servono)';
        r.perche.push('Con la stessa DSU l’INPS calcola l’ordinario e, se compili i quadri giusti, anche minorenni, università e sociosanitario.');
        r.perche.push('All’appuntamento ci dici quali aiuti vuoi chiedere e compiliamo la DSU completa, così hai tutti i valori che ti servono.');
      }
      if (a.calo === 'si') {
        r.corrente = true;
        r.perche.push("Valuta anche l'ISEE corrente: aggiorna l'ISEE con i redditi recenti se hai perso o ridotto il lavoro, se il reddito è sceso di oltre il 25% o il patrimonio di oltre il 20%. Vale 6 mesi.");
        r.extra.push('Buste paga o redditi degli ultimi 12 mesi (o degli ultimi 2 mesi)', 'Lettera di licenziamento o comunicazione di riduzione dell’orario');
      }
      return r;
    }

    function gen(r) {
      var g = a.altroGen;
      if (g === 'escluso') {
        r.perche.push('Il genitore che non vive con i figli non conta: versa un mantenimento deciso dal giudice, è escluso dalla responsabilità genitoriale o è estraneo.');
        r.extra.push('Provvedimento del giudice sul mantenimento, oppure atto di esclusione o di accertamento dell’estraneità');
      } else if (g === 'aggiuntivo') {
        r.perche.push('Il genitore che non vive con i figli non entra nel nucleo, ma si aggiunge una "componente aggiuntiva" calcolata sulla sua situazione economica.');
        r.extra.push('Codice fiscale, redditi e patrimonio dell’altro genitore');
      } else if (g === 'nessuna') {
        r.perche.push('Il genitore che non vive con i figli entra nel loro nucleo come se ci vivesse: servono i suoi redditi e il suo patrimonio.');
        r.extra.push('Documento, codice fiscale, redditi e patrimonio dell’altro genitore');
      } else {
        r.perche.push('Conta anche il genitore che non vive con i figli, salvo alcuni casi (mantenimento deciso dal giudice, esclusione dalla responsabilità genitoriale, estraneità accertata). Lo verifichiamo insieme.');
        r.extra.push('Dati dell’altro genitore ed eventuali provvedimenti del giudice');
      }
    }

    function esc(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

    function renderQ(key) {
      var d = Q[key];
      var step = history.length + 1;
      var h = '<p class="qi-step">Domanda ' + step + '</p><h2 class="qi-q">' + esc(d.q) + '</h2>';
      if (d.help) h += '<p class="qi-help">' + esc(d.help) + '</p>';
      h += '<div class="qi-opts">';
      d.opts.forEach(function (o) {
        h += '<button type="button" class="qi-opt" data-v="' + o[0] + '">' + esc(o[1]) + '</button>';
      });
      h += '</div>';
      if (history.length) h += '<button type="button" class="qi-back" data-back="1">← Indietro</button>';
      app.innerHTML = h;
      app.querySelectorAll('.qi-opt').forEach(function (b) {
        b.addEventListener('click', function () {
          a[key] = b.getAttribute('data-v');
          history.push(key);
          var n = next(key);
          n ? renderQ(n) : renderR();
          app.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
      var bk = app.querySelector('[data-back]');
      if (bk) bk.addEventListener('click', back);
      var f = app.querySelector('.qi-q'); if (f && step > 1) { f.setAttribute('tabindex', '-1'); f.focus({ preventScroll: true }); }
    }

    function back() {
      var k = history.pop();
      if (!k) return;
      delete a[k];
      renderQ(k);
    }

    function renderR() {
      var r = result();
      var docs = r.docs.concat(r.extra);
      var msg = 'Ciao, ho fatto il test sul vostro sito: mi serve "' + r.tipo + '". Vorrei fare l’ISEE.';
      var h = '<p class="qi-step">Il tuo risultato</p><h2 class="qi-res">' + esc(r.tipo) + '</h2>';
      if (r.corrente) h += '<p class="qi-tag">+ valuta l’ISEE corrente</p>';
      h += '<h3 class="qi-h3">Perché</h3><ul class="qi-list">' + r.perche.map(function (p) { return '<li>' + esc(p) + '</li>'; }).join('') + '</ul>';
      if (docs.length) h += '<h3 class="qi-h3">Cosa preparare</h3><ul class="qi-list qi-check">' + docs.map(function (p) { return '<li>' + esc(p) + '</li>'; }).join('') + '</ul>';
      if (a.scopo !== 'noisee') h += '<p class="qi-help">Ogni ISEE scade il 31 dicembre dell’anno in cui presenti la DSU. Al Centro Pratiche Flaiano tutti i tipi di ISEE sono <b>gratis</b>.</p>';
      else if (r.cta) h += '<p class="qi-help">' + esc(r.cta) + '</p>';
      h += '<div class="qi-cta"><a class="qi-btn qi-btn-main" href="/prenota">Prenota in ufficio o in videochiamata</a>'
        + '<a class="qi-btn qi-btn-wa" href="' + WA + encodeURIComponent(msg) + '" target="_blank" rel="noopener">Scrivici su WhatsApp</a></div>';
      h += '<div class="qi-row"><button type="button" class="qi-back" data-back="1">← Cambia l’ultima risposta</button><button type="button" class="qi-back" data-reset="1">Ricomincia</button></div>';
      app.innerHTML = h;
      app.querySelector('[data-back]').addEventListener('click', back);
      app.querySelector('[data-reset]').addEventListener('click', function () { a = {}; history = []; renderQ('scopo'); });
      var t = app.querySelector('.qi-res'); t.setAttribute('tabindex', '-1'); t.focus({ preventScroll: true });
      try { window.dataLayer && window.dataLayer.push({ event: 'quale_isee_result', tipo: r.tipo }); } catch (e) {}
    }

    renderQ('scopo');
  })();
  </script>

  <script>
import { trova, dataLunga, testoGiorni } from "~/scripts/bonus-engine.js";

(function () {
  var app = document.getElementById('qb-app');
  var dataEl = document.getElementById('qb-data');
  if (!app || !dataEl) return;
  var misure;
  try { misure = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }
  var WA = 'https://wa.me/393716230690?text=';

  var STEPS = [
    { k: 'residenza', q: 'Dove abiti?', type: 'one', opts: [['roma', 'A Roma'], ['lazio', 'In un altro comune del Lazio'], ['italia', 'Fuori dal Lazio']] },
    { k: 'isee', q: 'Quanto è più o meno il tuo ISEE?', help: 'Va bene un valore indicativo. Se non ce l’hai o non lo sai, scegli «Non lo so»: te lo facciamo noi, gratis.', type: 'one', opts: [
      ['nonso', 'Non lo so o non ho l’ISEE'], ['f1', 'Fino a 6.500 €'], ['f2', 'Da 6.500 a 9.796 €'], ['f3', 'Da 9.796 a 10.140 €'], ['f4', 'Da 10.140 a 15.000 €'],
      ['f5', 'Da 15.000 a 20.668 €'], ['f6', 'Da 20.668 a 28.340 €'], ['f7', 'Da 28.340 a 40.000 €'], ['f8', 'Da 40.000 a 46.583 €'], ['f9', 'Oltre 46.583 €']] },
    { k: 'figli', q: 'Hai figli o ne aspetti uno?', help: 'Scegli tutte le risposte che valgono per te.', type: 'many', none: 'nessuno', opts: [
      ['nessuno', 'Nessun figlio'], ['in_attesa', 'Aspetto un figlio'], ['nato_2026_entro_120gg', 'Un figlio nato o arrivato in famiglia da meno di 120 giorni'], ['sotto_3', 'Figli sotto i 3 anni'],
      ['minorenni', 'Figli minorenni'], ['maggiorenni_18_20', 'Figli tra 18 e 20 anni'], ['universitario_fino_30', 'Un figlio all’università (fino a 30 anni)']] },
    { k: 'lavoro', q: 'Qual è la tua situazione di lavoro?', type: 'one', opts: [
      ['dipendente', 'Lavoro come dipendente'], ['autonomo', 'Lavoro in proprio (partita IVA, autonomo)'], ['disoccupato', 'Sono disoccupato o ho perso il lavoro'], ['studente', 'Sono studente'],
      ['pensionato', 'Sono in pensione'], ['non_lavora', 'Non lavoro (casalinga, in cerca di lavoro, altro)'], ['dipendente_domestico', 'Lavoro come colf o badante']] },
    { k: 'eta', q: 'Quanti anni hai?', type: 'one', opts: [
      ['e18', '18-29'], ['e30', '30-59'], ['e60', '60-64'], ['e65', '65-69'], ['e70', '70-74'], ['e75', '75-79'], ['e80', '80 o più']] },
    { k: 'disabilita', q: 'Hai una disabilità o assisti un familiare?', help: 'Scegli tutte le risposte che valgono per te.', type: 'many', none: 'nessuna', opts: [
      ['nessuna', 'No'], ['invalidita_67', 'Invalidità civile dal 67%'], ['invalidita_74', 'Invalidità civile dal 74%'], ['invalidita_100', 'Invalidità civile al 100%'], ['legge104_grave', 'Legge 104 con gravità (art. 3 comma 3)'],
      ['accompagnamento', 'Indennità di accompagnamento'], ['cieco_sordo', 'Cecità o sordità'], ['assisto_familiare', 'Assisto un familiare con disabilità o non autosufficiente']] },
    { k: 'casa', q: 'Casa e utenze', help: 'Scegli tutte le risposte che valgono per te.', type: 'many', none: 'altro', opts: [
      ['affitto', 'Pago un affitto'], ['proprieta', 'Ho una casa di proprietà'], ['utenze_intestate', 'Ho luce, gas o acqua intestati a me o a un familiare convivente'], ['altro', 'Niente di tutto questo']] }
  ];
  var COUNT_OPTS = [[1, '1'], [2, '2'], [3, '3'], [4, '4 o più']];

  var a = {};
  var idx = 0;

  function esc(t) { return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }

  function renderStep() {
    var s = STEPS[idx];
    var h = '<p class="qi-step">Domanda ' + (idx + 1) + ' di ' + STEPS.length + '</p><h2 class="qi-q" id="qb-q">' + esc(s.q) + '</h2>';
    if (s.help) h += '<p class="qi-help">' + esc(s.help) + '</p>';
    if (s.type === 'one') {
      h += '<div class="qi-opts" role="group" aria-labelledby="qb-q">';
      s.opts.forEach(function (o) {
        h += '<button type="button" class="qi-opt' + (a[s.k] === o[0] ? ' qb-sel' : '') + '" data-v="' + o[0] + '">' + esc(o[1]) + '</button>';
      });
      h += '</div>';
    } else {
      var cur = a[s.k] || [];
      h += '<div class="qi-opts" role="group" aria-labelledby="qb-q">';
      s.opts.forEach(function (o) {
        h += '<label class="qi-opt qb-check"><input type="checkbox" value="' + o[0] + '"' + (cur.indexOf(o[0]) >= 0 ? ' checked' : '') + '><span>' + esc(o[1]) + '</span></label>';
      });
      h += '</div>';
      if (s.k === 'figli') {
        h += '<div class="qb-count" id="qb-count" role="group" aria-labelledby="qb-count-l" hidden><p class="qi-help" id="qb-count-l"><b>Quanti figli hai a carico in tutto?</b></p><div class="qb-count-row">';
        COUNT_OPTS.forEach(function (o) {
          h += '<label class="qb-pill"><input type="radio" name="qb-n" value="' + o[0] + '"' + ((a.nFigli || 1) === o[0] ? ' checked' : '') + '><span>' + o[1] + '</span></label>';
        });
        h += '</div></div>';
      }
      h += '<button type="button" class="qi-btn qi-btn-main qb-go" data-go="1">Continua</button>';
    }
    if (idx > 0) h += '<button type="button" class="qi-back" data-back="1">← Indietro</button>';
    app.innerHTML = h;

    if (s.type === 'one') {
      app.querySelectorAll('.qi-opt').forEach(function (b) {
        b.addEventListener('click', function () { a[s.k] = b.getAttribute('data-v'); avanti(); });
      });
    } else {
      var boxes = app.querySelectorAll('input[type=checkbox]');
      var count = document.getElementById('qb-count');
      function sync() {
        if (count) {
          var any = false;
          boxes.forEach(function (c) { if (c.checked && c.value !== s.none) any = true; });
          count.hidden = !any;
        }
      }
      boxes.forEach(function (c) {
        c.addEventListener('change', function () {
          if (c.checked) {
            if (c.value === s.none) boxes.forEach(function (o) { if (o !== c) o.checked = false; });
            else boxes.forEach(function (o) { if (o.value === s.none) o.checked = false; });
          }
          sync();
        });
      });
      sync();
      app.querySelector('[data-go]').addEventListener('click', function () {
        var v = [];
        boxes.forEach(function (c) { if (c.checked && c.value !== s.none) v.push(c.value); });
        a[s.k] = v;
        if (s.k === 'figli') {
          var r = app.querySelector('input[name=qb-n]:checked');
          a.nFigli = r ? +r.value : 1;
          if (!v.length) delete a.nFigli;
        }
        avanti();
      });
    }
    var bk = app.querySelector('[data-back]');
    if (bk) bk.addEventListener('click', function () { idx--; renderStep(); focusQ(); });
    if (idx > 0) focusQ();
  }
  function focusQ() {
    var f = document.getElementById('qb-q');
    if (f) { f.setAttribute('tabindex', '-1'); f.focus({ preventScroll: true }); }
    app.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function avanti() {
    if (idx < STEPS.length - 1) { idx++; renderStep(); focusQ(); }
    else renderResult();
  }

  var DUBBI = {
    isee: 'Il tuo ISEE è vicino alla soglia: controlliamo il valore esatto.',
    isee_nonso: 'Dipende dal tuo ISEE: te lo facciamo gratis.',
    eta: 'Dipende dalla tua età esatta.',
    figli_altro: 'Serve in famiglia un minorenne, una persona con disabilità, un over 60 o una persona in svantaggio.',
    figli_eta: 'Dipende dall’età del figlio più piccolo.',
    altro: 'Ci sono altri requisiti (reddito, contributi, elenchi) che non vediamo qui: li controlliamo con i tuoi documenti.'
  };
  var CTA = {
    te_lo_facciamo_noi: { label: 'Te lo facciamo noi', msg: function (n) { return 'Ciao, ho visto "Cosa ti spetta" sul vostro sito: vorrei chiedere "' + n + '". Potete occuparvene voi?'; } },
    ti_aiutiamo: { label: 'Chiedi aiuto', msg: function (n) { return 'Ciao, ho visto "Cosa ti spetta" sul vostro sito: vorrei un aiuto per "' + n + '".'; } },
    solo_informazione: { label: 'Controlliamo il tuo ISEE', msg: function (n) { return 'Ciao, ho visto "Cosa ti spetta" sul vostro sito ("' + n + '"). Vorrei far controllare il mio ISEE.'; } },
    isee_uni: { label: 'Ti facciamo l’ISEE universitario', msg: function () { return 'Ciao, mi serve l’ISEE universitario. La domanda DiSCo la presento io. Posso prenotare?'; } }
  };

  function card(it) {
    var m = it.m;
    var cta = CTA[m.cta.aiuto] || CTA.ti_aiutiamo;
    var urg = it.giorni !== null && it.giorni <= 60 && m.stato !== 'finestra_chiusa';
    var h = '<article class="qb-item"><div class="qb-top"><span class="qb-ente">' + esc(m.ente) + '</span>';
    if (m.stato === 'finestra_chiusa') h += '<span class="qb-chip qb-chip-chiuso">Ora chiuso</span>';
    else h += it.stato === 'probabile' ? '<span class="qb-chip qb-chip-ok">Probabilmente ti spetta</span>' : '<span class="qb-chip qb-chip-dub">Controlliamo noi</span>';
    h += '</div><h3 class="qb-nome">' + esc(m.nome) + '</h3>';
    h += '<p class="qb-imp">' + esc(m.importo.testo) + '</p>';
    if (it.giorni !== null) h += '<p class="qb-scad' + (urg ? ' qb-urg' : '') + '"><b>Scadenza: ' + dataLunga(m.scadenza.data) + '</b> · ' + testoGiorni(it.giorni) + '</p>';
    h += '<p class="qb-scad-t">' + esc(m.scadenza.testo) + '</p>';
    if (it.dubbi.length) {
      h += '<ul class="qb-dubbi">' + it.dubbi.map(function (d) { return '<li>' + esc(DUBBI[d] || '') + '</li>'; }).join('') + '</ul>';
    }
    if (m.cta.aiuto === 'isee_uni') h += '<p class="qb-nota"><b>Ti facciamo l’ISEE universitario; la domanda DiSCo la presenti tu</b> sul portale DiSCo.</p>';
    h += '<details class="qb-det"><summary>A chi spetta e come si chiede</summary><p>' + esc(m.a_chi_spetta) + '</p><p><b>Come si chiede.</b> ' + esc(m.come_si_chiede) + '</p>';
    if (m.il_centro_controlla && m.il_centro_controlla.length) h += '<p><b>Cosa controlliamo noi.</b></p><ul>' + m.il_centro_controlla.map(function (c) { return '<li>' + esc(c) + '</li>'; }).join('') + '</ul>';
    h += '</details>';
    if (m.cta.prezzo_testo) h += '<p class="qb-prezzo">' + esc(m.cta.prezzo_testo) + '</p>';
    h += '<p class="qb-links">';
    var guida = m.pagina_sito || m.articolo_sito;
    if (guida) h += '<a href="' + esc(guida) + '">Leggi la guida sul sito</a>';
    (m.fonti || []).slice(0, 1).forEach(function (f) { h += '<a href="' + esc(f.url) + '" target="_blank" rel="noopener">Fonte ufficiale: ' + esc(f.titolo.split(' - ')[0]) + ' ↗</a>'; });
    h += '</p>';
    h += '<div class="qi-cta"><a class="qi-btn qi-btn-wa" href="' + WA + encodeURIComponent(cta.msg(m.nome)) + '" target="_blank" rel="noopener">' + cta.label + '</a><a class="qb-sec" href="/prenota">Oppure prenota</a></div></article>';
    return h;
  }
  function section(titolo, nota, items, cls) {
    if (!items.length) return '';
    return '<section class="qb-sec-w ' + (cls || '') + '"><h3 class="qb-h">' + esc(titolo) + ' <span class="qb-n">(' + items.length + ')</span></h3>' + (nota ? '<p class="qi-help">' + esc(nota) + '</p>' : '') + items.map(card).join('') + '</section>';
  }

  function renderResult() {
    var r = trova(misure, a, new Date());
    var tot = r.urgenti.length + r.probabili.length + r.dipende.length;
    var h = '<p class="qi-step">Il tuo risultato</p><h2 class="qi-res" id="qb-res">' + (tot ? 'Cosa ti spetta: ' + tot + (tot === 1 ? ' aiuto da controllare' : ' aiuti da controllare') : 'Non abbiamo trovato aiuti per le tue risposte') + '</h2>';
    h += '<p class="qi-help">Sono indicazioni di massima. Per sapere se ti spettano davvero controlliamo ISEE e documenti.</p>';
    if (r.nonsoIsee) h += '<div class="qb-isee"><p><b>Non conosci il tuo ISEE? Lo facciamo noi, gratis.</b> Molti aiuti dipendono da quello.</p><div class="qi-cta"><a class="qi-btn qi-btn-wa" href="' + WA + encodeURIComponent('Ciao, ho fatto "Cosa ti spetta" sul vostro sito e non conosco il mio ISEE. Vorrei farlo.') + '" target="_blank" rel="noopener">ISEE gratis su WhatsApp</a><a class="qb-sec" href="/prenota">Oppure prenota</a></div></div>';
    h += section('Scadono presto', 'Ti conviene muoverti subito.', r.urgenti, 'qb-s-urg');
    h += section('Probabilmente ti spettano', '', r.probabili);
    h += section('Possono spettarti: controlliamo noi', 'Mancano alcune informazioni, ci pensiamo noi con i tuoi documenti.', r.dipende);
    h += section('Riapre presto', 'Ora non si può fare domanda. Le date non sono ancora confermate: scrivici per sapere quando riapre.', r.riapre);
    if (!tot && !r.riapre.length) h += '<p>Prova a cambiare qualche risposta, oppure scrivici: controlliamo la tua situazione.</p><div class="qi-cta"><a class="qi-btn qi-btn-wa" href="' + WA + encodeURIComponent('Ciao, ho fatto "Cosa ti spetta" sul vostro sito. Potete controllare cosa mi spetta?') + '" target="_blank" rel="noopener">Scrivici su WhatsApp</a></div>';
    h += '<div class="qi-row"><button type="button" class="qi-back" data-back="1">← Cambia l’ultima risposta</button><button type="button" class="qi-back" data-reset="1">Ricomincia</button></div>';
    app.innerHTML = h;
    app.querySelector('[data-back]').addEventListener('click', function () { renderStep(); focusQ(); });
    app.querySelector('[data-reset]').addEventListener('click', function () { a = {}; idx = 0; renderStep(); app.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    var t = document.getElementById('qb-res'); if (t) { t.setAttribute('tabindex', '-1'); t.focus({ preventScroll: true }); }
    app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    try { window.dataLayer && window.dataLayer.push({ event: 'cosa_ti_spetta_result', n_urgenti: r.urgenti.length, n_probabili: r.probabili.length, n_dipende: r.dipende.length, n_riapre: r.riapre.length }); } catch (e) {}
  }

  renderStep();
})();
  </script>

