---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import BookingCTA from "~/components/home/BookingCTA.astro";
import Accordion from "~/components/ui/Accordion.svelte";
import JsonLdFaq from "~/components/seo/JsonLdFaq.astro";
import { TESSERAMENTO, SITE, GHL } from "~/consts";

/* Solo vantaggi pubblicati su praticheflaiano.it/tesseramento_vantaggi
   o dati dal titolare. Regola progetto: ZERO invenzioni. */
const benefits = [
  { t: "Consulenze gratuite", d: "Hai un dubbio su tasse, INPS o bonus? Chiedi: per i tesserati la consulenza è gratis.", bg: "#D4FF4F", fg: "#14142B", rot: "-1deg" },
  { t: "Appuntamenti prioritari", d: "Quando c'è la fila (730, ISEE di gennaio) passi avanti.", bg: "#5B3DF5", fg: "#fff", rot: "1deg" },
  { t: "Sconti sulle pratiche", d: "Paghi meno le pratiche a pagamento. Esempio: la domanda di Assegno Unico.", bg: "#FFE3EC", fg: "#14142B", rot: "-0.5deg" },
  { t: "Vale per tutta la famiglia", d: "Una tessera sola per tutto il nucleo familiare.", bg: "#14142B", fg: "#fff", rot: "0.8deg" },
];

const examples = [
  { s: "ISEE", non: "gratis", soci: "gratis" },
  { s: "Assegno Unico, domanda in ufficio", non: "15 €", soci: "10 €" },
  { s: "Assegno Unico, domanda online", non: "19 €", soci: "15 €" },
  { s: "Domanda NASpI", non: "gratis", soci: "gratis" },
  { s: "Consulenze", non: "—", soci: "gratis" },
  { s: "Appuntamenti", non: "ordinari", soci: "prioritari" },
];

const faq = [
  {
    question: "Quanto costa la tessera?",
    answer: `<strong>${TESSERAMENTO.annual.price} € l'anno</strong> oppure <strong>${TESSERAMENTO.semester.price} € per sei mesi</strong>. Vale per tutto il nucleo familiare, non per una persona sola.`,
  },
  {
    question: "È obbligatoria?",
    answer: "No. Tutti possono usare i nostri servizi. La tessera conviene se fai più di una pratica nell'anno o se vuoi le consulenze gratuite.",
  },
  {
    question: "E per le pratiche di patronato?",
    answer: "Molte pratiche di patronato sono gratuite per tutti, per esempio la domanda NASpI. Dove c'è un costo lo trovi scritto nella pagina del servizio, e con la tessera spesso costa meno (vedi l'Assegno Unico).",
  },
  {
    question: "Come faccio la tessera?",
    answer: `In ufficio, anche durante l'appuntamento per un'altra pratica. Oppure mandaci una <a href='${GHL.tesseraFunnel}'>richiesta online</a> e ti richiamiamo.`,
  },
];

const offerData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Tessera Centro Pratiche Flaiano",
  description: "Tessera annuale o semestrale per il nucleo familiare: consulenze gratuite, appuntamenti prioritari, sconti sulle pratiche.",
  image: `${SITE.url}/og/p-tesseramento.jpg`,
  brand: { "@type": "Organization", name: SITE.name },
  offers: [
    { "@type": "Offer", name: "Tessera annuale (nucleo familiare)", price: TESSERAMENTO.annual.price, priceCurrency: TESSERAMENTO.currency, availability: "https://schema.org/InStock", url: `${SITE.url}/tesseramento` },
    { "@type": "Offer", name: "Tessera semestrale (nucleo familiare)", price: TESSERAMENTO.semester.price, priceCurrency: TESSERAMENTO.currency, availability: "https://schema.org/InStock", url: `${SITE.url}/tesseramento` },
  ],
};
---
<BaseLayout
  title="Tessera: 30 € l'anno per tutta la famiglia"
  description="Tessera Centro Pratiche Flaiano: 30 € l'anno (20 € a semestre) per tutto il nucleo familiare. Consulenze gratuite, appuntamenti prioritari, sconti sulle pratiche."
>
  <JsonLdFaq slot="head" items={faq} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(offerData)} />

  <section class="wrap" style="padding-block:32px 56px">
    <Breadcrumb items={[{ name: "Tessera", href: "/tesseramento" }]} class="mb-8" />
    <div class="flex flex-wrap items-center gap-12">
      <div class="flex flex-col gap-6" style="flex:999 1 520px;min-width:0">
        <span class="eyebrow">Per tutto il nucleo familiare</span>
        <h1>Una tessera. <span class="hl-lime">Tutta la famiglia.</span></h1>
        <p style="font-size:20px;line-height:1.5;max-width:600px">
          Consulenze gratuite, appuntamenti prioritari e sconti sulle pratiche, per tutto il nucleo familiare.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary btn-lg" href={GHL.tesseraFunnel}>Voglio la tessera</a>
          <a class="btn btn-ghost btn-lg" href="/prenota">Falla in ufficio</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" style="flex:1 1 440px;min-width:0">
        <div style="background:#5B3DF5;color:#fff;border-radius:32px;padding:28px;position:relative;transform:rotate(-1.5deg)">
          <span class="sticker" style="position:absolute;right:-8px;top:-14px;background:#FF5C8A;color:#fff">Consigliata</span>
          <p style="font-weight:700;color:#E4DEFF">Annuale</p>
          <p style="font-family:var(--font-display);font-weight:800;font-size:56px;line-height:1;color:#D4FF4F;white-space:nowrap">{TESSERAMENTO.annual.price} €</p>
          <p style="color:#E4DEFF">12 mesi · tutto il nucleo</p>
        </div>
        <div style="background:#F7F7FB;border-radius:32px;padding:28px;transform:rotate(1deg)">
          <p style="font-weight:700">Semestrale</p>
          <p style="font-family:var(--font-display);font-weight:800;font-size:56px;line-height:1;color:#5B3DF5;white-space:nowrap">{TESSERAMENTO.semester.price} €</p>
          <p>6 mesi · tutto il nucleo</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-block:40px">
    <h2 class="mb-6">Cosa ci guadagni</h2>
    <div class="grid gap-5" style="grid-template-columns:repeat(auto-fit,minmax(min(250px,100%),1fr))">
      {benefits.map((b) => (
        <div style={`background:${b.bg};color:${b.fg};border-radius:28px;padding:28px;transform:rotate(${b.rot})`}>
          <p style={`font-family:var(--font-display);font-weight:800;font-size:24px;line-height:1.1;color:${b.fg}`}>{b.t}</p>
          <p class="mt-2" style={`color:${b.fg};opacity:.9`}>{b.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-block:40px">
    <div style="background:#F7F7FB;border-radius:32px;padding:clamp(24px,4vw,40px)">
      <h2>Con e senza tessera</h2>
      <p class="mt-2">Qualche esempio concreto.</p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-[15px] sm:text-base" style="border-collapse:separate;border-spacing:0 8px">
          <thead>
            <tr style="font-size:14px">
              <th class="px-3">Pratica</th>
              <th class="px-2 text-center">Senza</th>
              <th class="px-2 text-center">Con tessera</th>
            </tr>
          </thead>
          <tbody>
            {examples.map((r) => (
              <tr style="background:#fff">
                <td class="px-3 py-3 font-semibold" style="border-radius:16px 0 0 16px;color:#14142B">{r.s}</td>
                <td class="px-2 py-3 text-center whitespace-nowrap">{r.non}</td>
                <td class="px-2 py-3 text-center font-bold whitespace-nowrap" style="border-radius:0 16px 16px 0;background:#D4FF4F;color:#14142B">{r.soci}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm">Il 730 parte da 30 € e, se torni l'anno dopo, il prezzo resta quello. <a href="/730">Tutto sul 730</a>.</p>
    </div>
  </section>

  <section class="container-narrow" style="padding-block:40px">
    <h2 class="text-center mb-8">Domande sulla tessera</h2>
    <Accordion client:visible items={faq} />
  </section>

  <BookingCTA />
</BaseLayout>
