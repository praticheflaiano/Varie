---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import SectionHeading from "~/components/ui/SectionHeading.astro";
import Button from "~/components/ui/Button.astro";
import { CONTACT } from "~/consts";

const zone = [
  {
    href: "/zone/caf-patronato-talenti-montesacro",
    name: "Talenti e Montesacro",
    text: "Metro B1 (Jonio, Conca d'Oro), linee 38, 336, 86, 339 e 349 verso Vigne Nuove. INPS, Municipio III e ASL Distretto 3.",
  },
  {
    href: "/zone/caf-patronato-fidene-serpentara-nuovo-salario",
    name: "Fidene, Serpentara, Nuovo Salario e Colle Salario",
    text: "Linea 341 da Fidene, linee 339 e 349 da Nuovo Salario. Uffici pubblici di riferimento.",
  },
  {
    href: "/zone/caf-patronato-tufello-conca-oro",
    name: "Tufello, Conca d'Oro e Val Melaina",
    text: "Linee 38, 336 e 86 da Conca d'Oro, linee 339 e 349 da Tufello e Val Melaina. Uffici pubblici di riferimento.",
  },
];
---

<BaseLayout
  title="Zone servite a Roma Nord"
  description="Il Centro Pratiche Flaiano è a Vigne Nuove, nel Municipio III di Roma. Scegli la tua zona: come arrivare e gli uffici pubblici di riferimento. CAF e patronato."
>
  <section class="bg-mesh-brand">
    <div class="container-wide pt-10 pb-12">
      <Breadcrumb items={[{ name: "Zone servite", href: "/zone" }]} class="mb-6" />
      <SectionHeading
        eyebrow="Zone servite"
        level="h1"
        title="CAF e patronato a Roma Nord: le zone che serviamo"
        subtitle="La nostra sede è in Via Filoteo Alberini 25, dentro il Centro Acquisti Flaiano, a Vigne Nuove (Municipio III). Scegli la tua zona per vedere come arrivare e quali uffici pubblici ti riguardano."
      />
    </div>
  </section>

  <section class="section-tight">
    <div class="container-wide">
      <ul class="grid gap-5 md:grid-cols-3">
        {zone.map((z) => (
          <li>
            <a href={z.href} class="block h-full rounded-[28px] bg-[#F7F7FB] p-6 no-underline hover:shadow-[var(--shadow-card)]">
              <h2 class="font-display text-xl font-bold text-[var(--color-ink)]">{z.name}</h2>
              <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">{z.text}</p>
              <p class="mt-4 text-sm font-semibold text-[var(--color-brand-700)]">Vedi la pagina della zona →</p>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 rounded-[28px] bg-[var(--color-brand-50)] p-6">
        <h2 class="font-display text-xl font-bold text-[var(--color-brand-900)]">Abiti a Vigne Nuove, Bufalotta o Porta di Roma?</h2>
        <p class="mt-3 text-sm text-[var(--color-ink-soft)] leading-relaxed">
          Sei già vicino: l'ufficio è in {CONTACT.address.street}, {CONTACT.address.postalCode} {CONTACT.address.locality}. Indicazioni e orari sono nella <a href="/contatti">pagina contatti</a>.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button variant="accent" href="/prenota" icon="heroicons:calendar-days" iconPosition="left">Prenota un appuntamento</Button>
          <Button variant="secondary" href="/contatti">Contatti e indicazioni</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
