    { t: "INPS, scheda Dimissioni, licenziamento e TFR dei lavoratori domestici (ultimo aggiornamento 3 novembre 2026)", url: "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50215.dimissioni-licenziamento-e-tfr-dei-lavoratori-domestici.html" },
    { t: "Codice civile, art. 2120 (trattamento di fine rapporto)", url: "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:regio.decreto:1942-03-16;262~art2120" },
    { t: "Legge 29 maggio 1982, n. 297 (rivalutazione del TFR)", url: "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:1982-05-29;297" },
    { t: "Coefficienti ISTAT di rivalutazione del TFR: Camera di Commercio di Cremona (2019-2023)", url: "https://www.cr.camcom.it/files/Statistica/Prezzi/indicitfr(30).pdf" },
    { t: "Coefficiente di dicembre 2025: Assolombarda, nota TFR", url: "https://www.assolombarda.it/servizi/informazioni-economiche/trattamento-di-fine-rapporto-tfr-nota-informativa-dicembre-2025" },
  ]}
