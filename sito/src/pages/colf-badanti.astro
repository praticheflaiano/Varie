const props = {"eyebrow": "Colf e badanti · Lavoro domestico", "title": "Colf o badante in regola?", "highlight": "Facciamo noi.", "lead": "Assunzione, comunicazione all'INPS, contributi ogni tre mesi, ferie, tredicesima e chiusura del rapporto. Tu pensi alla tua famiglia, alle carte pensiamo noi.", "chat": {"q": "Devo assumere una badante per mia madre, da dove parto?", "a": "Ci servono i tuoi dati, quelli della lavoratrice e gli orari. La comunicazione all'INPS la facciamo noi.", "done": "Assunzione comunicata all'INPS"}, "sticker": "Tutto in regola", "strip": ["Assunzione comunicata all'INPS", "Contributi ogni trimestre", "Variazioni e cessazione", "Anche in videochiamata"], "needs": [{"t": "devi assumere qualcuno", "d": "Colf, badante o babysitter: l'assunzione va comunicata all'INPS prima che inizi il lavoro."}, {"t": "hai già un rapporto in corso", "d": "Contributi trimestrali, aumenti di orario o di stipendio, ferie e tredicesima: teniamo tutto in ordine."}, {"t": "il rapporto finisce", "d": "Dimissioni, licenziamento o decesso dell'assistito: comunichiamo la cessazione e ti diciamo cosa spetta."}], "steps": [{"t": "Ci porti i dati", "d": "I tuoi, quelli del lavoratore, orari e paga concordata."}, {"t": "Comunichiamo all'INPS", "d": "Facciamo l'assunzione e ti diamo il calendario dei contributi da pagare."}, {"t": "Ti seguiamo nel tempo", "d": "Variazioni, contributi e chiusura del rapporto: ti avvisiamo noi quando c'è da fare qualcosa."}], "docs": ["Documento d'identità e codice fiscale del datore di lavoro", "Documento e codice fiscale del lavoratore", "Permesso di soggiorno, se il lavoratore è extra-UE", "Orario settimanale, mansioni e paga concordata", "Data di inizio del lavoro", "SPID o CIE del datore di lavoro"], "docsNote": "L'assunzione va comunicata all'INPS entro il giorno prima dell'inizio: non aspettare l'ultimo momento.", "faqs": [{"q": "Entro quando va comunicata l'assunzione?", "a": "Entro le ore 24 del giorno prima dell'inizio del lavoro, anche se il rapporto inizia di domenica o in un giorno festivo."}, {"q": "Ogni quanto si pagano i contributi?", "a": "Ogni tre mesi, con il bollettino o il pagamento PagoPA dell'INPS. Ti diamo il calendario delle scadenze."}, {"q": "E se il rapporto finisce?", "a": "La cessazione va comunicata all'INPS entro 5 giorni. Ti aiutiamo anche con il calcolo di TFR e ultime spettanze."}, {"q": "Posso detrarre i contributi nel 730?", "a": "I contributi pagati per colf e badanti si possono dedurre nel 730, nei limiti previsti. Te lo facciamo noi nel 730."}], "related": [{"label": "Modello 730", "href": "/730"}, {"label": "Invalidità e 104", "href": "/invalidita-104"}, {"label": "Pensioni", "href": "/pensioni"}, {"label": "ISEE", "href": "/isee"}]};
const faqLd = "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Entro quando va comunicata l'assunzione?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Entro le ore 24 del giorno prima dell'inizio del lavoro, anche se il rapporto inizia di domenica o in un giorno festivo.\"}}, {\"@type\": \"Question\", \"name\": \"Ogni quanto si pagano i contributi?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Ogni tre mesi, con il bollettino o il pagamento PagoPA dell'INPS. Ti diamo il calendario delle scadenze.\"}}, {\"@type\": \"Question\", \"name\": \"E se il rapporto finisce?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"La cessazione va comunicata all'INPS entro 5 giorni. Ti aiutiamo anche con il calcolo di TFR e ultime spettanze.\"}}, {\"@type\": \"Question\", \"name\": \"Posso detrarre i contributi nel 730?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"I contributi pagati per colf e badanti si possono dedurre nel 730, nei limiti previsti. Te lo facciamo noi nel 730.\"}}]}";
