---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceLanding from "~/components/ui/ServiceLanding.astro";
import LandingArticles from "~/components/blog/LandingArticles.astro";
import JsonLdService from "~/components/seo/JsonLdService.astro";
const props = {"eyebrow": "Bonus famiglia · Patronato", "title": "Arriva un bimbo?", "highlight": "Non perdere i bonus.", "lead": "Bonus nuovi nati, bonus asilo nido, maternità e Assegno unico: hanno scadenze diverse e alcuni si perdono se non fai domanda in tempo. Facciamo l'ISEE giusto e presentiamo noi le domande all'INPS.", "chat": {"q": "Mia figlia è nata a settembre, cosa devo chiedere?", "a": "Bonus nuovi nati entro 120 giorni, Assegno unico e, se andrà al nido, il bonus nido. Prima facciamo l'ISEE minorenni, poi le domande.", "done": "Domande inviate"}, "sticker": "Bonus nuovi nati: 120 giorni", "strip": ["ISEE minorenni gratis", "Bonus mamme fino a 720 €", "Bonus nuovi nati 1.000 €", "Bonus nido fino a 3.600 €"], "needs": [{"t": "è appena nato o adottato un figlio", "d": "Bonus nuovi nati di 1.000 € con ISEE fino a 40.000 €: la domanda va fatta entro 120 giorni, poi si perde. Aggiorniamo anche l'Assegno unico."}, {"t": "lavori e hai almeno due figli", "d": "Nuovo bonus mamme 2026: 60 € per ogni mese di lavoro, fino a 720 €, con redditi da lavoro fino a 40.000 €. Domanda entro il 31 dicembre 2026."}, {"t": "tuo figlio va al nido", "d": "Il bonus nido rimborsa la retta fino a 3.000 € l'anno, 3.600 € per i nati dal 2024 con ISEE fino a 40.000 €."}, {"t": "sei in maternità o in congedo", "d": "Indennità di maternità e congedo parentale si chiedono all'INPS: ti diciamo cosa spetta e presentiamo la domanda."}], "steps": [{"t": "Facciamo l'ISEE", "d": "L'ISEE per le prestazioni familiari, gratis. Senza ISEE molti bonus partono dall'importo minimo o non partono."}, {"t": "Controlliamo cosa ti spetta", "d": "Nuovi nati, nido, maternità, Assegno unico: una lista con le scadenze di ciascuno."}, {"t": "Presentiamo le domande", "d": "Le inviamo noi all'INPS come patronato e ti diamo le ricevute."}], "docs": ["Documenti e codici fiscali dei genitori e del bambino", "Permesso di soggiorno, per i cittadini extra-UE", "IBAN intestato o cointestato al richiedente", "ISEE minorenni valido (se non c'è lo facciamo noi)", "Per il nido: iscrizione e ricevute della retta intestate al genitore che paga", "Per la maternità: dati del datore di lavoro e certificato di gravidanza"], "docsNote": "Le ricevute del nido vanno caricate ogni mese: ti spieghiamo come fare o le carichiamo noi.", "faqs": [{"q": "Entro quando si chiede il bonus nuovi nati?", "a": "Entro 120 giorni dalla nascita o dall'ingresso in famiglia. Vale 1.000 € per ogni figlio, con ISEE fino a 40.000 € (legge 207/2024, commi 206-207)."}, {"q": "Chi può chiedere il Nuovo bonus mamme 2026?", "a": "Le lavoratrici dipendenti o autonome con due figli (il più piccolo sotto i 10 anni) o con tre o più figli (il più piccolo sotto i 18 anni) e redditi da lavoro fino a 40.000 €. Sono escluse le lavoratrici domestiche e, per i mesi a tempo indeterminato, le madri con tre o più figli. Vale 60 € al mese fino a 720 €; domanda entro il 31 dicembre 2026 (circolare INPS 106/2026)."}, {"q": "Quanto vale il bonus nido nel 2026?", "a": "Per i nati dal 1° gennaio 2024 fino a 3.600 € l'anno con ISEE fino a 40.000 €. Per i nati prima: 3.000 € con ISEE fino a 25.000 €, 2.500 € fino a 40.000 €, 1.500 € oltre o senza ISEE (circolare INPS 29/2026)."}, {"q": "Serve un altro figlio sotto i 10 anni per i 3.600 €?", "a": "No, quel requisito è stato eliminato dalla legge di bilancio 2025."}, {"q": "La domanda del bonus nido va rifatta ogni anno?", "a": "Dal 2026 la domanda vale fino ai 3 anni del bambino: negli anni dopo si indicano solo i mesi di frequenza."}, {"q": "Le domande di patronato si pagano?", "a": "No, le domande all'INPS presentate dal patronato sono gratuite. Anche l'ISEE da noi è gratis."}], "related": [{"label": "Assegno unico", "href": "/assegno-unico"}, {"label": "Nuovo bonus mamme 2026", "href": "/blog/nuovo-bonus-mamme-2026-domanda-inps-31-dicembre"}, {"label": "Bonus nuovi nati 1.000 €", "href": "/blog/bonus-nuovi-nati-1000-euro-domanda-120-giorni"}, {"label": "Bonus asilo nido 2026", "href": "/blog/bonus-asilo-nido-2026-3600-euro-domanda-inps"}, {"label": "Quale ISEE ti serve", "href": "/quale-isee"}]};
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: props.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
---
<BaseLayout title={"Bonus nido, bonus nuovi nati e maternità: domanda a Roma"} description={"Bonus asilo nido fino a 3.600 €, bonus nuovi nati 1.000 €, maternità e Assegno unico: ISEE gratis e domanda INPS dal patronato di Vigne Nuove, Roma."}>
  <link slot="head" rel="stylesheet" href="/landing.css" />
  <JsonLdService slot="head" slug="bonus-famiglia" name={"Bonus per la famiglia"} description={"Domande INPS per bonus asilo nido, bonus nuovi nati, indennità di maternità e congedi, con ISEE per le prestazioni familiari."} serviceType={"Patronato - prestazioni familiari"} />
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <ServiceLanding {...props} />
  <LandingArticles categories={["assegno-unico", "bonus-fiscali"]} />
</BaseLayout>
