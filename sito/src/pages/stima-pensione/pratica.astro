---
// Pagina della pratica di una stima: stato dopo il pagamento, conferma e avvio del calcolo,
// scarico del prospetto. Il codice arriva nell'ancora dell'indirizzo (non finisce nei log del
// server) oppure dal browser che ha inviato il questionario; serve anche la data di nascita.
import BaseLayout from "~/layouts/BaseLayout.astro";
import Attesa from "~/components/pensione/Attesa.svelte";
// Indirizzo delle funzioni server: sul sito pubblico (progetto statico) stanno su un altro dominio,
// ricavato da PUBLIC_STIMA_PENSIONE_API; altrove sono sullo stesso sito.
const API = (import.meta.env.PUBLIC_STIMA_PENSIONE_API ?? "").replace(/\/api\/stima\/invia$/, "");
---
<BaseLayout title="La tua stima della pensione" description="Stato della tua Stima e Calcolo della pensione." noindex={true} share={false}>
  <section class="mx-auto max-w-2xl px-4 py-12" data-pagefind-ignore="all">
    <h1 class="text-3xl font-extrabold text-[#14142B] sm:text-4xl">La tua stima della pensione</h1>
    <form id="pr-form" class="mt-6 hidden rounded-[28px] bg-[#F7F7FB] p-6" novalidate>
      <p class="mb-4 text-[#3F3F5A]">Inserisci il codice pratica e la tua data di nascita.</p>
      <label class="mb-1.5 block text-sm font-bold text-[#14142B]" for="pr-codice">Codice pratica</label>
      <input id="pr-codice" class="w-full rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 text-[#14142B] focus:border-[#5B3DF5] focus:outline-none" autocomplete="off" />
      <label class="mb-1.5 mt-4 block text-sm font-bold text-[#14142B]" for="pr-nascita">Data di nascita</label>
      <input id="pr-nascita" type="date" class="w-full rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 text-[#14142B] focus:border-[#5B3DF5] focus:outline-none" />
      <button type="submit" class="mt-5 rounded-full bg-[#5B3DF5] px-7 py-3 font-bold text-white shadow-[0_6px_0_#14142B]">Apri la pratica</button>
    </form>
    <div id="pr-box" class="mt-6 hidden rounded-[28px] bg-[#F7F7FB] p-6" aria-live="polite">
      <h2 id="pr-titolo" class="text-2xl font-extrabold text-[#14142B]"></h2>
      <p id="pr-testo" class="mt-3 text-lg text-[#3F3F5A]"></p>
      <form id="pr-abbina" class="mt-5 hidden rounded-2xl border-2 border-[#14142B] bg-white p-4" novalidate>
        <p class="font-bold text-[#14142B]">Abbiamo ricevuto un pagamento, ma con dati diversi da quelli del questionario.</p>
        <label class="mb-1.5 mt-3 block text-sm font-bold text-[#14142B]" for="pr-contatto">Scrivi l'email o il cellulare usati per pagare</label>
        <input id="pr-contatto" class="w-full rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 text-[#14142B] focus:border-[#5B3DF5] focus:outline-none" autocomplete="off" />
        <button type="submit" class="mt-3 rounded-full bg-[#5B3DF5] px-6 py-3 font-bold text-white shadow-[0_6px_0_#14142B] disabled:opacity-50">Collega il pagamento</button>
      </form>
      <div id="pr-azioni" class="mt-5 flex flex-wrap gap-3"></div>
    </div>
    <div id="pr-stima" class="mt-8 hidden text-[#14142B]"></div>
    <Attesa client:load variante="pagamento" evento="stima-attesa-pagamento" />
    <Attesa client:load variante="calcolo" evento="stima-attesa" />
    <div id="pr-link" class="mt-5 hidden rounded-2xl bg-[#F1EEFF] p-4 text-[#14142B]">
      <p class="font-bold">Il link della tua pratica</p>
      <p class="mt-1 text-sm">Salvalo: se si interrompe qualcosa (pagina chiusa, telefono scarico, connessione caduta) lo riapri, inserisci la tua data di nascita e riparti da dove eri. Pagamento e documenti restano salvati.</p>
      <p id="pr-link-testo" class="mt-2 break-all rounded-xl bg-white p-2 text-sm font-semibold"></p>
      <button id="pr-link-copia" type="button" class="mt-2 rounded-full border-2 border-[#14142B] bg-white px-5 py-2 text-sm font-bold text-[#14142B]">Copia il link</button>
    </div>
    <p id="pr-msg" class="mt-4 hidden rounded-2xl bg-[#FFE3EC] p-3 font-semibold text-[#14142B]" role="alert"></p>
    <p class="mt-6 text-sm text-[#6B6B85]">Hai bisogno di aiuto? Scrivici su WhatsApp al 371 623 0690 o chiama lo 06 97845429.</p>
  </section>
  <script is:inline define:vars={{ API }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      const form = $("pr-form"), box = $("pr-box"), msg = $("pr-msg"), azioni = $("pr-azioni"), abbina = $("pr-abbina");
      const PRIMARIO = "rounded-full bg-[#5B3DF5] px-7 py-3 font-bold text-white shadow-[0_6px_0_#14142B] disabled:opacity-50";
      const SECONDARIO = "rounded-full border-2 border-[#14142B] bg-white px-6 py-3 font-bold text-[#14142B] disabled:opacity-50";
      let c = "", n = "", timer = 0, calcolo = false;

      let verificaFinoA = 0, inCalcolo = false;
      // Accende o spegne un riquadro animato (componente Attesa); lo stato resta in window per il
      // componente che si avvia dopo questo momento.
      function accendi(evento, si) {
        (window.stimaAttese ||= {})[evento] = si;
        window.dispatchEvent(new CustomEvent(evento, { detail: si }));
      }
      // Durante il calcolo il browser chiede conferma prima di chiudere o ricaricare la pagina.
      window.addEventListener("beforeunload", (e) => { if (inCalcolo) { e.preventDefault(); e.returnValue = ""; } });
      const avvisa = (t) => { msg.textContent = t; msg.classList.toggle("hidden", !t); };
      const euro = (cent) => (cent / 100).toLocaleString("it-IT", { minimumFractionDigits: cent % 100 ? 2 : 0 }) + " €";
      function bottone(testo, classe, azione) {
        const b = document.createElement("button");
        b.type = "button"; b.className = classe; b.textContent = testo;
        b.addEventListener("click", () => azione(b));
        azioni.append(b);
      }
      async function chiedi(azione, altro) {
        const res = await fetch(API + "/api/stima/pratica", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ c, n, azione, ...altro }) });
        const dati = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error("richiesta"), { stato: res.status });
        return dati;
      }
      async function scarica(b) {
        b.disabled = true;
        try {
          const res = await fetch(API + "/api/stima/prospetto", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ c, n }) });
          if (!res.ok) return avvisa("Non siamo riusciti a scaricare il prospetto. Riprova tra poco.");
          const url = URL.createObjectURL(await res.blob());
          const link = document.createElement("a");
          link.href = url; link.download = "stima-pensione.pdf"; link.click();
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        } catch { avvisa("Non siamo riusciti a scaricare il prospetto. Riprova tra poco."); }
        finally { b.disabled = false; }
      }
      // Il calcolo dura alcuni minuti: la richiesta resta aperta e intanto si rilegge lo stato.
      async function calcola() {
        if (calcolo) return;
        calcolo = true;
        avvisa("");
        mostra({ stato: "in_elaborazione" });
        try { mostra(await chiedi("avvia")); }
        catch { /* se la richiesta cade, lo stato arriva dalle riletture periodiche */ }
        finally { calcolo = false; }
      }
      async function simula(b) {
        b.disabled = true;
        try { mostra(await chiedi("simula-pagamento")); } catch { avvisa("Pagamento simulato non riuscito."); b.disabled = false; }
      }
      // La stima in breve, sulla pagina: stessi dati del prospetto, con caratteri grandi e una scheda per strada.
      const PRECISIONE = { media: "buona", "media-bassa": "discreta", bassa: "di massima", parziale: "incompleta" };
      const dataIt = (d) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(d || ""); return m ? `${m[3]}/${m[2]}/${m[1]}` : "—"; };
      const soldi = (n) => (typeof n === "number" ? n.toLocaleString("it-IT", { style: "currency", currency: "EUR", useGrouping: "always" }) : "—");
      const eta = (s) => { const m = /^\s*(\d+)a\s+(\d+)m\s*$/.exec(s || ""); return m ? `${m[1]} anni` + (+m[2] ? ` e ${+m[2]} ${+m[2] === 1 ? "mese" : "mesi"}` : "") : (s || "—"); };
      function el(tag, classe, testo) { const e = document.createElement(tag); if (classe) e.className = classe; if (testo != null) e.textContent = testo; return e; }
      function cifra(etichetta, valore) {
        const d = el("div");
        d.append(el("dt", "text-xs font-bold uppercase tracking-wide text-[#5C5C78]", etichetta), el("dd", "mt-0.5 text-xl font-extrabold", valore));
        return d;
      }
      function mostraStima(s) {
        const dove = $("pr-stima");
        dove.replaceChildren();
        dove.classList.toggle("hidden", !s);
        if (!s) return;
        if (s.revisione && s.revisione.length) {
          const r = el("div", "mb-5 rounded-[22px] bg-[#FFE3EC] p-5");
          r.append(el("p", "text-xl font-extrabold", "Stima provvisoria: un nostro operatore la sta completando"),
            el("p", "mt-2 text-lg", "Punti da verificare a mano: " + s.revisione.join("; ") + ". Fino alla conferma considera date e importi come indicativi."));
          dove.append(r);
        }
        const primo = s.prima_uscita && (s.canali || []).find((c) => c.canale === s.prima_uscita.canale);
        if (s.prima_uscita) {
          const h = el("div", "rounded-[22px] bg-[#D4FF4F] p-6");
          h.append(el("p", "text-sm font-extrabold uppercase tracking-wide", "Prima uscita possibile"), el("p", "mt-1 text-3xl font-extrabold leading-tight", s.prima_uscita.canale),
            el("p", "mt-1 text-xl font-bold", `dal ${dataIt(s.prima_uscita.decorrenza)}` + (primo && primo.eta ? ` · a ${eta(primo.eta)}` : "")));
          dove.append(h);
        }
        const tre = el("dl", "mt-4 grid gap-4 rounded-[22px] bg-[#F7F7FB] p-5 sm:grid-cols-3");
        tre.append(cifra("Contributi ad oggi", String(s.contributi || "—").replace("a ", " anni ").replace("m", " mesi")), cifra("Netto mensile stimato", soldi(primo && primo.netto)), cifra("Sistema di calcolo", String(s.sistema || "—").split(" (")[0]));
        dove.append(tre);
        if (s.sintesi) dove.append(el("h2", "mt-8 text-2xl font-extrabold text-[#4B2FE0]", "In breve"), el("p", "mt-2 text-lg leading-relaxed", s.sintesi));
        if (s.consigliata && s.consigliata.canale) {
          const c = el("div", "mt-4 rounded-[22px] bg-[#F1EEFF] p-5");
          c.append(el("p", "text-sm font-extrabold uppercase tracking-wide text-[#5C5C78]", "La strada che ti consigliamo"), el("p", "mt-1 text-xl font-extrabold", s.consigliata.canale), el("p", "mt-2 text-lg leading-relaxed", s.consigliata.motivo || ""));
          dove.append(c);
        }
        if (s.canali && s.canali.length) {
          dove.append(el("h2", "mt-8 text-2xl font-extrabold text-[#4B2FE0]", "Le tue strade per la pensione"));
          for (const c of s.canali) {
            const prima = s.prima_uscita && c.canale === s.prima_uscita.canale;
            const k = el("div", `mt-4 rounded-[22px] p-5 ${prima ? "border-2 border-[#14142B] bg-white" : "bg-[#F7F7FB]"}`);
            k.append(el("h3", "text-xl font-extrabold", c.canale), el("p", "text-sm font-semibold text-[#5C5C78]", prima ? "Prima uscita possibile" : (c.stato || "")));
            const dl = el("dl", "mt-3 grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3");
            dl.append(cifra("Maturi il diritto", dataIt(c.maturazione)), cifra("Primo pagamento", dataIt(c.decorrenza)), cifra("Età", eta(c.eta)));
            if (c.lordo != null) dl.append(cifra("Lordo mensile", soldi(c.lordo)), cifra("Netto stimato", soldi(c.netto)), cifra("Precisione", PRECISIONE[c.affidabilita] || "—"));
            else if (c.indennita != null) dl.append(cifra("Indennità mensile lorda", soldi(c.indennita)), cifra("Precisione", PRECISIONE[c.affidabilita] || "—"));
            k.append(dl);
            if (c.lordo != null) k.append(el("p", "mt-2 text-sm text-[#5C5C78]", "Importi al mese, su 13 mensilità."));
            if (c.spiegazione) k.append(el("p", "mt-3 text-lg leading-relaxed", c.spiegazione));
            dove.append(k);
          }
        }
        if (s.alternative && s.alternative.length) {
          dove.append(el("h2", "mt-8 text-2xl font-extrabold text-[#4B2FE0]", "Le alternative a confronto"));
          for (const a of s.alternative) {
            const k = el("div", "mt-3 rounded-[22px] bg-[#F7F7FB] p-5");
            k.append(el("h3", "text-lg font-extrabold", a.nome || ""), el("p", "mt-1 text-lg", `${a.canale || "—"} dal ${dataIt(a.decorrenza)} · netto stimato ${soldi(a.netto)} al mese`));
            if (a.note) k.append(el("p", "mt-1 text-[#3F3F5A]", a.note));
            dove.append(k);
          }
        }
        if (s.decisioni && s.decisioni.length) {
          dove.append(el("h2", "mt-8 text-2xl font-extrabold text-[#4B2FE0]", "Cosa decidere"));
          const ol = el("ol", "mt-2 list-decimal space-y-2 pl-6 text-lg leading-relaxed");
          for (const d of s.decisioni) ol.append(el("li", "", d.cosa + (d.entro ? ` (entro ${d.entro})` : "")));
          dove.append(ol);
        }
        dove.append(el("p", "mt-6 text-[#5C5C78]", "Nel prospetto in PDF trovi anche le note, le avvertenze e il dettaglio del calcolo. Stima indicativa: non sostituisce la certificazione dell'INPS."));
      }
      function mostra(p) {
        clearTimeout(timer);
        form.classList.add("hidden");
        azioni.replaceChildren();
        let titolo = "", testo = "", rileggi = 0;
        if (p.stato === "ricevuta") {
          titolo = "In attesa del pagamento";
          testo = `Abbiamo ricevuto i tuoi dati. Completa il pagamento (${euro(p.totale)}): se l'hai appena fatto, questa pagina si aggiorna da sola entro un minuto.`;
          if (p.pagamento_url) { const a = document.createElement("a"); a.href = p.pagamento_url; a.className = PRIMARIO; a.textContent = "Vai al pagamento"; azioni.append(a); }
          if (p.prova) bottone("Simula il pagamento (solo anteprima)", SECONDARIO, simula);
          rileggi = 10000;
        } else if (p.stato === "pagata") {
          titolo = "Pagamento ricevuto";
          testo = (p.prelettura_settimane ? `Dal tuo estratto abbiamo letto ${Math.round(p.prelettura_settimane)} settimane di contributi. ` : "") +
            "Conferma per avviare il calcolo: richiede alcuni minuti, tieni aperta questa pagina.";
          bottone("Conferma e calcola la stima", PRIMARIO, calcola);
        } else if (p.stato === "in_elaborazione") {
          rileggi = 15000;
        } else if (p.stato === "consegnata") {
          titolo = "La tua stima è pronta";
          testo = "Scarica il prospetto in PDF. Puoi tornare su questa pagina quando vuoi: sul prospetto trovi anche un codice QR per ritrovarlo. " +
            "Nel prezzo è compresa una consulenza con un nostro operatore, al telefono o in chat, per farti spiegare il risultato: è facoltativa, la prenoti quando vuoi.";
          bottone("Scarica il prospetto", PRIMARIO, scarica);
          { const a = document.createElement("a"); a.href = "https://link.arcanis.it/widget/group/bklXY9sZUszt8V2GpkU1"; a.target = "_blank"; a.rel = "noopener"; a.className = SECONDARIO + " no-underline"; a.textContent = "Prenota la consulenza inclusa"; azioni.append(a); }
        } else if (p.stato === "da_rivedere") {
          titolo = "La tua stima è pronta, in versione provvisoria";
          testo = "Puoi già scaricare il prospetto. I controlli automatici hanno segnalato uno o più punti da verificare a mano: li trovi indicati nel prospetto. " +
            "Il nostro operatore ha già ricevuto la segnalazione e completa la stima, senza costi aggiuntivi. " +
            "Per definirla insieme prenota l'appuntamento telefonico compreso nel prezzo, oppure scrivici in chat su WhatsApp al 371 623 0690.";
          bottone("Scarica il prospetto provvisorio", PRIMARIO, scarica);
          { const a = document.createElement("a"); a.href = "https://link.arcanis.it/widget/group/bklXY9sZUszt8V2GpkU1"; a.target = "_blank"; a.rel = "noopener"; a.className = SECONDARIO + " no-underline"; a.textContent = "Prenota l'appuntamento con l'operatore"; azioni.append(a); }
        } else if (p.stato === "attesa_estratto") {
          titolo = "Stiamo richiedendo il tuo estratto contributivo";
          testo = "Pagamento ricevuto. Gli estratti li richiediamo la mattina, dalle 9:30 alle 13:00, nei giorni di apertura dell'ufficio: se hai fatto la richiesta nel pomeriggio o la sera, la stima arriva dal giorno lavorativo successivo. " +
            "Appena l'INPS ci rende disponibile il tuo estratto ti avvisiamo via email. La consulenza con un operatore resta inclusa.";
        } else if (p.stato === "fallita") {
          titolo = "Il calcolo non è riuscito";
          testo = p.riprovabile ? "Qualcosa si è interrotto durante il calcolo. Puoi riprovare ora: non paghi di nuovo." : "Il calcolo non è riuscito. Il nostro ufficio se ne occupa e ti ricontatta: non devi pagare di nuovo.";
          if (p.riprovabile) bottone("Riprova il calcolo", PRIMARIO, calcola);
        }
        $("pr-titolo").textContent = titolo;
        $("pr-testo").textContent = testo;
        mostraStima(p.riepilogo);
        // Durante il calcolo il riquadro di testo lascia il posto a quello animato (componente Attesa).
        box.classList.toggle("hidden", p.stato === "in_elaborazione");
        // Appena tornati dal pagamento la conferma di GHL può metterci fino a un minuto: intanto
        // si mostra la verifica animata; dopo 3 minuti senza conferma torna il riquadro normale.
        const verifica = p.stato === "ricevuta" && !p.da_abbinare && Date.now() < verificaFinoA;
        if (verifica) { box.classList.add("hidden"); rileggi = 5000; }
        accendi("stima-attesa-pagamento", verifica);
        accendi("stima-attesa", p.stato === "in_elaborazione");
        inCalcolo = p.stato === "in_elaborazione";
        $("pr-link").classList.remove("hidden");
        $("pr-link-testo").textContent = `${location.origin}/stima-pensione/pratica#c=${c}`;
        abbina.classList.toggle("hidden", !(p.stato === "ricevuta" && p.da_abbinare));
        if (rileggi) timer = setTimeout(aggiorna, rileggi);
      }
      async function aggiorna() {
        try {
          const p = await chiedi("stato");
          if (!(calcolo && p.stato === "pagata")) mostra(p);
        } catch (e) {
          if (e.stato === 404) { box.classList.add("hidden"); accendi("stima-attesa", false); accendi("stima-attesa-pagamento", false); $("pr-link").classList.add("hidden"); form.classList.remove("hidden"); avvisa("Codice o data di nascita non corrispondono a nessuna pratica."); }
          else if (e.stato === 429) avvisa("Troppi tentativi: riprova tra un'ora.");
          else timer = setTimeout(aggiorna, 20000);
        }
      }

      abbina.addEventListener("submit", async (e) => {
        e.preventDefault();
        const contatto = $("pr-contatto").value.trim();
        if (!contatto) return avvisa("Scrivi l'email o il cellulare usati per pagare.");
        const b = abbina.querySelector("button");
        b.disabled = true;
        avvisa("");
        try {
          const p = await chiedi("reclama", { contatto });
          mostra(p);
          if (p.stato === "ricevuta") avvisa("Non troviamo un pagamento con questa email o questo numero. Controlla e riprova, oppure scrivici su WhatsApp.");
        } catch (err) {
          avvisa(err.stato === 429 ? "Troppi tentativi: riprova tra un'ora o scrivici su WhatsApp." : "Non siamo riusciti a controllare. Riprova tra poco.");
        } finally { b.disabled = false; }
      });

      const ancora = location.hash.match(/c=([A-Za-z0-9_-]{16,40})/);
      let salvata = null;
      try { salvata = JSON.parse(localStorage.getItem("stima-pratica") || "null"); } catch { /* archivio del browser non disponibile */ }
      c = ancora ? ancora[1] : (salvata && salvata.c) || "";
      n = salvata && salvata.c === c ? salvata.n || "" : "";
      if (salvata && salvata.c === c && salvata.checkout && Date.now() - salvata.checkout < 2 * 3600 * 1000) {
        verificaFinoA = Date.now() + 3 * 60 * 1000;
        // Vale per un solo ritorno dal pagamento: alla visita successiva la pagina mostra lo stato normale.
        try { localStorage.setItem("stima-pratica", JSON.stringify({ c: salvata.c, n: salvata.n })); } catch { /* archivio del browser non disponibile */ }
      }
      $("pr-link-copia").addEventListener("click", async () => {
        try { await navigator.clipboard.writeText($("pr-link-testo").textContent); $("pr-link-copia").textContent = "Copiato"; } catch { /* si può selezionare a mano */ }
      });
      $("pr-codice").value = c;
      if (c && n) aggiorna(); else form.classList.remove("hidden");
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        c = $("pr-codice").value.trim(); n = $("pr-nascita").value;
        if (!c || !n) return avvisa("Inserisci il codice pratica e la data di nascita.");
        avvisa("");
        aggiorna();
      });
    })();
  </script>
</BaseLayout>
