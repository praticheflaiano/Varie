---
/**
 * Anticipo NASpI (pagina arrivata dal portale domandedisoccupazione.it il 25/11/2026).
 * Regole verificate il 24/11/2026 su: scheda INPS "NASpI anticipata" (agg. 12/6/2026), messaggio INPS n. 1215 del 7/4/2026,
 * art. 8 del d.lgs. 22/2015 come modificato dall'art. 1, c. 176, legge 199/2025. Testo e calcolo in src/naspi/AnticipoNaspi.tsx.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import PortaleNaspi from "~/components/blog/PortaleNaspi.astro";
import AnticipoNaspi from "~/naspi/AnticipoNaspi";

const faq = [
  { q: "Come viene pagato l'anticipo NASpI nel 2026?", a: "Per le domande presentate dal 1° gennaio 2026 l'anticipo è pagato in due rate: il 70% quando la domanda viene accolta e il 30% alla fine del periodo teorico della NASpI, comunque non oltre 6 mesi dalla domanda (art. 8, c. 3-bis, d.lgs. 22/2015; messaggio INPS 1215/2026)." },
  { q: "Entro quando si presenta la domanda di anticipo NASpI?", a: "Entro 30 giorni dall'inizio dell'attività autonoma o dell'impresa individuale, o dalla sottoscrizione della quota di cooperativa. Se l'attività era iniziata prima della fine del lavoro dipendente, entro 30 giorni dalla domanda NASpI." },
  { q: "Chi può chiedere l'anticipo NASpI?", a: "Chi ha diritto alla NASpI e vuole avviare un lavoro autonomo, un'impresa individuale, sottoscrivere una quota di una cooperativa in cui lavora come socio, oppure portare a tempo pieno un'attività autonoma iniziata prima della fine del lavoro dipendente." },
  { q: "Cosa succede se trovo lavoro come dipendente dopo l'anticipo?", a: "Se il lavoro dipendente inizia prima della fine del periodo teorico della NASpI, il 30% non viene pagato e va restituito anche il 70% già ricevuto, salvo il lavoro con la cooperativa di cui si è soci." },
];
const faqLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
---

<BaseLayout title="Anticipo NASpI 2026: due rate 70% e 30%, calcolo" ogImage="/og/anticipo-naspi.jpg" description="Anticipo NASpI dal 2026: 70% subito e 30% dopo, domanda entro 30 giorni dall'avvio dell'attività. Calcolo delle due rate. Patronato a Roma.">
  <script slot="head" type="application/ld+json" set:html={faqLd} />
  <div class="nz"><AnticipoNaspi client:load /></div>
  <section style="max-width:860px;margin:0 auto;padding:8px 16px 0;display:flex;flex-direction:column;gap:14px">
    <p style="margin:0;font-size:14px;color:#5B5B72"><b>Ultimo aggiornamento: 25 novembre 2026.</b> Regole controllate sulla scheda INPS "NASpI anticipata" e sul messaggio INPS n. 1215 del 7 aprile 2026 (le fonti con i link sono qui sopra).</p>
    <h2 style="margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(26px,5vw,36px);line-height:1.08;color:#14142B">Vuoi aprire la partita IVA con l'anticipo?</h2>
    <p style="margin:0;font-size:17px;line-height:1.6;color:#34344A">Al Centro Pratiche Flaiano, patronato ENASC a <b>Roma Vigne Nuove</b> (Municipio III), controlliamo con te date e requisiti e presentiamo la domanda di anticipo entro i 30 giorni, anche a distanza da tutta Italia.</p>
    <a href="/prenota" class="cta-tool"><span class="cta-tool-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#14142B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15l2 2 4-4"/></svg></span><span class="cta-tool-txt"><span class="cta-tool-t">Prenota: la domanda la facciamo noi</span><span class="cta-tool-s">A Roma Vigne Nuove o in videochiamata da tutta Italia</span></span><svg class="cta-tool-go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </section>
  <div style="max-width:1120px;margin:0 auto;padding:0 16px 48px"><PortaleNaspi current="/anticipo-naspi" /></div>
</BaseLayout>
