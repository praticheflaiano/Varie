---
/**
 * Calcolo dell'importo dell'Assegno di inclusione (ADI) (27/11/2026, richiesta di Antonio).
 * Regole, soglie 2026 e fonti in src/lib/adi.ts. Esempi della pagina calcolati con la stessa funzione.
 * Domande SEO: "quanto si prende di ADI", "come si calcola l'ADI", "importo ADI persona sola / famiglia / affitto",
 * "importo massimo e minimo ADI", "come leggere l'esito INPS". La lettura delle voci dell'esito INPS è un'interpretazione
 * (l'INPS non pubblica una legenda): resta scritta così nella pagina.
 */
import ToolGuideLayout from "~/layouts/ToolGuideLayout.astro";
import { ADI, ADI_AGGIORNATO, calcolaAdi, eurA } from "~/lib/adi";

const A = (eta: number, disabilita: "no" | "media" | "grave" | "nonauto" = "no") => ({ eta, disabilita });
const es = {
  sola: calcolaAdi({ adulti: [A(62)], minori: 0 }, { isee: 0, redditoFamiliare: 0, canoneAnnuo: 0 }),
  solaAffitto: calcolaAdi({ adulti: [A(62)], minori: 0 }, { isee: 0, redditoFamiliare: 0, canoneAnnuo: 4500 }),
  famiglia: calcolaAdi({ adulti: [A(30), A(32)], minori: 2, minoreSotto3: true, carichiDiCura: true }, { isee: 7000, redditoFamiliare: 4000, canoneAnnuo: 5400 }),
  anziano: calcolaAdi({ adulti: [A(68)], minori: 0 }, { isee: 6000, redditoFamiliare: 6000, canoneAnnuo: 3000 }),
  mamma: calcolaAdi({ adulti: [A(35)], minori: 2 }, { isee: 3000, redditoFamiliare: 2000, canoneAnnuo: 0 }),
};
const mese = (n: number) => eurA(n / 12);
const scalaTxt = (n: number) => String(n).replace(".", ",");

const faqs = [
  { q: "Quanto si prende di Assegno di inclusione?", a: `Fino a ${eurA(ADI.soglia)} l'anno moltiplicati per la scala di equivalenza del nucleo, meno il reddito familiare, più fino a ${eurA(ADI.affittoMax)} l'anno per l'affitto. Una persona sola senza reddito prende ${mese(ADI.soglia)} al mese, ${mese(es.solaAffitto.annuo)} se paga un affitto di almeno ${eurA(ADI.affittoMax)} l'anno.` },
  { q: "Come si calcola l'importo dell'ADI?", a: `Si moltiplica ${eurA(ADI.soglia)} (${eurA(ADI.sogliaAnziani)} se in famiglia sono tutti over 67) per la scala di equivalenza, si toglie il reddito familiare e si aggiunge il canone d'affitto fino a ${eurA(ADI.affittoMax)}. Il totale annuo si divide per 12.` },
  { q: "Qual è l'importo minimo dell'ADI?", a: `${eurA(ADI.minimoAnnuo)} l'anno, cioè 40 € al mese: se il conto dà meno, l'INPS paga comunque il minimo.` },
  { q: "L'Assegno di inclusione si somma all'Assegno Unico?", a: "Sì. L'Assegno Unico non conta nel reddito familiare dell'ADI e si paga a parte, con la sua domanda." },
  { q: "La pensione di invalidità o l'accompagnamento abbassano l'ADI?", a: "No. Secondo la scheda INPS i trattamenti ricevuti per la disabilità (pensione di invalidità civile, indennità di accompagnamento, indennità di frequenza) non entrano nel reddito familiare dell'ADI." },
  { q: "Perché al rinnovo la prima rata è più bassa?", a: "Dal 2026 non c'è più il mese di stop dopo i primi 18 mesi: in cambio la prima mensilità di ogni rinnovo è pagata al 50% (legge di bilancio 2026)." },
  { q: "Il calcolatore è preciso?", a: "È una stima fatta con le regole e le soglie ufficiali 2026. L'importo esatto lo decide l'INPS con i dati della DSU e della domanda: se il risultato è molto diverso dalla lettera INPS, portacela e la controlliamo." },
];
const appLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebApplication", name: "Calcolo Assegno di inclusione 2026", url: "https://praticheflaiano.it/calcolo-assegno-inclusione", applicationCategory: "FinanceApplication", operatingSystem: "Web", inLanguage: "it-IT", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" } });
---

