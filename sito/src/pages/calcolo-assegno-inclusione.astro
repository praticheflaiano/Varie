            <select id="ad-min-dis" class="cc-in"><option value="no">No</option><option value="media">Sì, disabilità media</option><option value="grave">Sì, disabilità grave</option><option value="nonauto">Sì, non autosufficiente</option></select>
          </label>
        </div>
        <label class="cc-o"><input id="ad-sotto3" type="checkbox"> C'è un bambino sotto i 3 anni</label>
      </fieldset>

