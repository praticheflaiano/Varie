          <label class="cc-l" for="ad-mob" style="flex:1 1 220px">Patrimonio mobiliare del nucleo
            <input id="ad-mob" class="cc-in" type="text" inputmode="decimal" autocomplete="off" placeholder="conti, libretti, titoli">
          </label>
