const props = {"eyebrow": "IMU e TARI · CAF", "title": "Tasse sulla casa?", "highlight": "Paghi solo il giusto.", "lead": "Calcoliamo l'IMU e ti prepariamo l'F24. Per la TARI controlliamo l'avviso AMA, chiediamo l'esenzione se ti spetta e sistemiamo le rate saltate con il ravvedimento.", "chat": {"q": "Ho una seconda casa a Roma, quanto devo pagare di IMU a dicembre?", "a": "Mandaci la visura o i dati catastali: calcoliamo il saldo con le aliquote di Roma e ti diamo l'F24 pronto da pagare.", "done": "F24 pronto"}, "sticker": "Saldo IMU 16 dicembre", "strip": ["F24 IMU pronto da pagare", "Esenzione TARI con ISEE basso", "Controllo avvisi AMA", "Ravvedimento operoso"], "needs": [{"t": "hai una seconda casa o un negozio", "d": "Calcoliamo acconto e saldo IMU con le aliquote di Roma Capitale e le riduzioni per affitto concordato o comodato."}, {"t": "hai ereditato o comprato casa", "d": "L'IMU si paga dai mesi di possesso e per la tua quota: facciamo i conti giusti."}, {"t": "l'avviso TARI non torna", "d": "Controlliamo metri quadri e occupanti e prepariamo la variazione ad AMA."}, {"t": "il tuo ISEE è basso", "d": "Con ISEE fino a 6.500 € a Roma puoi chiedere l'esenzione totale dalla TARI entro il 28 febbraio."}], "steps": [{"t": "Ci mandi i dati", "d": "Visura catastale o rogito, oppure l'avviso TARI. Se non hai la visura la recuperiamo noi."}, {"t": "Calcoliamo", "d": "Aliquote di Roma, riduzioni, quote e mesi di possesso. Per la TARI verifichiamo esenzione e bonus."}, {"t": "Ti diamo F24 o domanda", "d": "F24 pronto da pagare, domanda di esenzione o comunicazione ad AMA."}], "docs": ["Documento e codice fiscale", "Visura catastale o atto di acquisto (se non li hai, li recuperiamo)", "F24 dell'acconto già pagato", "Contratto di affitto o comodato, se la casa è data a terzi", "Per la TARI: ultimo avviso AMA e ricevute dei pagamenti", "ISEE valido per esenzione e bonus TARI (lo facciamo gratis)"], "docsNote": "Con l'ISEE in corso di validità controlliamo subito se hai diritto all'esenzione TARI.", "faqs": [{"q": "Quando si paga il saldo IMU 2026?", "a": "Entro il 16 dicembre 2026, con il modello F24 (legge 160/2019, comma 762)."}, {"q": "Chi ha solo la prima casa paga l'IMU?", "a": "No, se non è di lusso (categorie A/1, A/8, A/9). L'esenzione vale anche per una pertinenza per categoria: un box, una cantina, una tettoia."}, {"q": "Con che ISEE non pago la TARI a Roma?", "a": "Con un ISEE ordinario fino a 6.500 € puoi chiedere l'esenzione totale per l'abitazione principale, entro il 28 febbraio. Con ISEE fino a 9.796 € c'è invece lo sconto automatico del 25%."}, {"q": "Ho saltato una rata: cosa faccio?", "a": "Si rimedia con il ravvedimento operoso: imposta, sanzione ridotta e interessi con l'F24. Prima lo fai, meno paghi. Lo calcoliamo noi."}, {"q": "L'avviso AMA ha i metri quadri sbagliati?", "a": "Per le abitazioni la superficie tassabile è l'80% di quella catastale. Se l'avviso riporta di più, prepariamo la dichiarazione di variazione ad AMA."}], "related": [{"label": "IMU saldo 16 dicembre 2026", "href": "/blog/imu-saldo-16-dicembre-2026-roma"}, {"label": "TARI Roma: esenzione e bonus", "href": "/blog/tari-roma-esenzione-bonus-sociale-riduzioni"}, {"label": "ISEE gratis", "href": "/isee"}, {"label": "Successioni", "href": "/successioni"}]};
