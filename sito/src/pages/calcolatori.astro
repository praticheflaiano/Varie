---
/**
 * /calcolatori - Tutti gli strumenti gratuiti del sito in una pagina (27/11/2026).
 * L'elenco sta in ~/data/calcolatori.ts (usato anche dalla home e dal riquadro "Altri calcolatori"):
 * quando nasce un calcolatore nuovo aggiungerlo lì, nel tema giusto. La lista alimenta anche i dati ItemList.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/layout/Breadcrumb.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "~/consts";
import { GRUPPI_CALCOLATORI } from "~/data/calcolatori";

const gruppi = GRUPPI_CALCOLATORI;

const tutti = gruppi.flatMap((g) => g.strumenti);
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Calcolatori gratuiti del Centro Pratiche Flaiano",
  numberOfItems: tutti.length,
  itemListElement: tutti.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.nome,
    url: new URL(s.url, SITE.url).toString(),
  })),
};
---

<BaseLayout
  title="Calcolatori gratuiti: NASpI, ADI, Assegno Unico | Roma"
  description="Tutti i calcolatori gratuiti del CAF e Patronato di Roma: NASpI, ADI, Assegno Unico, maternità, bollo auto, successione, colf e badanti."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(itemList)} />

  <section class="bg-mesh-brand">
    <div class="container-narrow pt-10 pb-10">
      <Breadcrumb items={[{ name: "Calcolatori", href: "/calcolatori" }]} class="mb-6" />
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-brand-800)]">Strumenti gratuiti</p>
      <h1 class="mt-2 font-display text-3xl md:text-4xl font-extrabold text-[var(--color-ink)]">Calcolatori gratuiti: NASpI, ADI, Assegno Unico, pensione e altro</h1>
      <p class="mt-4 text-lg text-[var(--color-ink-soft)] leading-relaxed">
        Qui trovi tutti i calcolatori del Centro Pratiche Flaiano, CAF e Patronato a Roma Vigne Nuove. Sono gratis e ci vuole un minuto. Scegli il tema e premi il pulsante.
      </p>
      <nav aria-label="Temi dei calcolatori" class="mt-6">
        <ul class="flex flex-wrap gap-2">
          {gruppi.map((g) => (
            <li>
              <a href={`#${g.id}`} class="inline-flex min-h-11 items-center rounded-full border-2 border-[#14142B] bg-white px-4 py-2 text-sm font-bold text-[#14142B] no-underline hover:bg-[#14142B] hover:text-white">{g.titolo}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-narrow">
      {gruppi.map((g, gi) => (
        <section id={g.id} aria-labelledby={`${g.id}-t`} class:list={["calc-gruppo", gi > 0 && "mt-12"]}>
          <h2 id={`${g.id}-t`} class="flex items-center gap-3 font-display text-2xl font-bold text-[var(--color-ink)]">
            <span class="flex size-11 flex-none items-center justify-center rounded-full bg-[#D4FF4F]">
              <Icon name={g.icona} class="size-6 text-[#14142B]" aria-hidden="true" />
            </span>
            {g.titolo}
          </h2>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2">
            {g.strumenti.map((s) => (
              <li class="flex flex-col rounded-[24px] bg-[#F7F7FB] p-5 sm:p-6">
                {s.nota && <p class="mb-2 text-xs font-bold uppercase tracking-wider text-[#B81F56]">{s.nota}</p>}
                <h3 class="font-display text-xl font-bold text-[var(--color-ink)]">{s.nome}</h3>
                <p class="mt-2 flex-1 text-base text-[var(--color-ink-soft)] leading-relaxed">{s.cosa}</p>
                <a href={s.url} class="calc-btn mt-5">
                  <Icon name="heroicons:calculator" class="size-6 flex-none" aria-hidden="true" />
                  <span>{s.cta}</span>
                  <Icon name="heroicons:arrow-right" class="ml-auto size-5 flex-none" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="mt-14 rounded-[28px] bg-[#14142B] p-6 sm:p-8">
        <h2 class="font-display text-2xl font-bold text-white">I calcoli sono stime: ti aiutiamo noi</h2>
        <p class="mt-3 text-lg leading-relaxed text-[#F1EEFF]">
          I calcolatori danno una stima. Per sapere quanto ti spetta davvero e fare la domanda, ti aiutiamo noi a Roma Vigne Nuove o in videochiamata.
        </p>
        <a href="/prenota" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-[#D4FF4F] px-6 py-3 text-base font-extrabold text-[#14142B] no-underline hover:bg-white">Prenota un appuntamento</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .calc-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 12px 18px;
    border-radius: 999px;
    background: #5b3df5;
    color: #fff;
    font-weight: 800;
    font-size: 1.0625rem;
    line-height: 1.25;
    text-decoration: none;
    box-shadow: 0 4px 0 #14142b;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .calc-btn:hover,
  .calc-btn:focus-visible {
    transform: translateY(2px);
    box-shadow: 0 2px 0 #14142b;
  }
  .calc-gruppo {
    scroll-margin-top: 6rem;
  }
</style>
