---
// Pagina riservata al titolare: richiesta di documenti a Openapi (Report Persona dell'API Risk e tutto il
// catalogo DocuEngine, letto da Openapi con prezzi e tempi), elenco delle richieste, download dei file,
// collegamento al contatto del CRM. Non è collegata da nessun menu, è esclusa dai motori di ricerca e dalla
// sitemap. Si apre con la password REPORT_PERSONA_PASSWORD; la sessione (12 ore) resta solo nella scheda
// del browser. Vedi vault/procedure/07-report-persona.md.
import BaseLayout from "~/layouts/BaseLayout.astro";
// Le funzioni server stanno nel progetto praticheflaiano-sito: sul sito pubblico si ricavano da PUBLIC_STIMA_PENSIONE_API.
const API = (import.meta.env.PUBLIC_STIMA_PENSIONE_API ?? "").replace(/\/api\/stima\/invia$/, "");
const campo = "w-full rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 text-[#14142B] focus:border-[#5B3DF5] focus:outline-none";
const etichetta = "mb-1.5 block text-sm font-bold text-[#14142B]";
const secondario = "rounded-full border-2 border-[#14142B] bg-white px-5 py-2 font-bold text-[#14142B] disabled:opacity-50";
---
<BaseLayout title="Documenti Openapi - area riservata" description="Pagina riservata all'ufficio." noindex={true} share={false}>
  <section class="mx-auto max-w-3xl px-4 py-12" data-pagefind-ignore="all">
    <h1 class="text-3xl font-extrabold text-[#14142B] sm:text-4xl">Documenti Openapi</h1>
    <p class="mt-2 text-[#4E4B66]">Area riservata all'ufficio.</p>

    <form id="rp-accesso" class="mt-6 rounded-[28px] bg-[#F7F7FB] p-6" novalidate>
      <label class={etichetta} for="rp-password">Password</label>
      <input id="rp-password" type="password" class={campo} autocomplete="current-password" />
      <button type="submit" class="mt-5 rounded-full bg-[#5B3DF5] px-7 py-3 font-bold text-white shadow-[0_6px_0_#14142B] disabled:opacity-50">Entra</button>
    </form>

    <p id="rp-msg" class="mt-4 hidden rounded-2xl bg-[#FFE3EC] p-3 font-semibold text-[#14142B]" role="alert"></p>

    <div id="rp-area" class="hidden">
      <p id="rp-config" class="mt-6 hidden rounded-2xl bg-[#FFF4CC] p-3 font-semibold text-[#14142B]"></p>

      <div id="rp-catalogo" class="mt-6 rounded-[28px] bg-[#F7F7FB] p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-2xl font-extrabold text-[#14142B]">Cosa ti serve?</h2>
          <button id="rp-rinnova" type="button" class={secondario}>Aggiorna catalogo</button>
        </div>
        <p id="rp-letto" class="mt-1 text-sm text-[#4E4B66]"></p>
        <input id="rp-cerca" type="search" class={`${campo} mt-4`} placeholder="Cerca: visura, catasto, protesti, DURC…" autocomplete="off" />
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <select id="rp-categoria" class={campo} aria-label="Categoria"><option value="">Tutte le categorie</option></select>
          <label class="flex items-center gap-3 rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 font-semibold text-[#14142B]"><input id="rp-subito" type="checkbox" class="h-5 w-5" /> Solo quelli che arrivano subito</label>
        </div>
        <label class="mt-3 flex items-center gap-3 rounded-2xl border-2 border-[#14142B] bg-[#D4FF4F] px-4 py-3 font-bold text-[#14142B]"><input id="rp-successione" type="checkbox" class="h-5 w-5" /> Documenti per una successione</label>
        <div id="rp-defunto" class="mt-3 hidden rounded-2xl bg-white p-4">
          <p class="font-bold text-[#14142B]">Dati del defunto <span class="font-normal">(li riporto in ogni richiesta, così li scrivi una volta sola)</span></p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input id="rp-dcf" class={`${campo} uppercase tracking-wider`} placeholder="Codice fiscale del defunto" maxlength="16" autocomplete="off" spellcheck="false" />
            <input id="rp-dprov" class={campo} placeholder="Provincia degli immobili (es. RM)" autocomplete="off" />
          </div>
          <p class="mt-3 text-sm text-[#4E4B66]">Ordine consigliato: 1) Ricerca nazionale immobili, per sapere dove sono; 2) Visura catastale per soggetto in ogni provincia trovata; 3) Ispezione ipotecaria se servono mutui e atti di provenienza. Ogni documento si chiede e si paga da solo.</p>
          <p class="mt-2 text-sm text-[#4E4B66]">Da Openapi non arrivano: documenti e codici fiscali degli eredi, dichiarazione sostitutiva, certificato di destinazione urbanistica (Comune), certificazioni di banche e poste, testamento e rinunce, copia del rogito (con l'ispezione ipotecaria hai però notaio, data e repertorio per chiederla).</p>
        </div>
        <p id="rp-conta" class="mt-3 text-sm font-semibold text-[#4E4B66]"></p>
        <div id="rp-voci" class="mt-3 grid gap-3"></div>
        <button id="rp-altri" type="button" class={`${secondario} mt-4 hidden`}>Mostra altri</button>
      </div>

      <form id="rp-form" class="mt-6 hidden rounded-[28px] bg-[#F7F7FB] p-6" novalidate>
        <button id="rp-indietro" type="button" class="font-bold text-[#5B3DF5]">← Torna al catalogo</button>
        <h2 id="rp-titolo" class="mt-3 text-2xl font-extrabold text-[#14142B]"></h2>
        <p id="rp-info" class="mt-1 font-semibold text-[#14142B]"></p>
        <p id="rp-descrizione" class="mt-2 text-sm text-[#4E4B66]"></p>
        <div id="rp-campi" class="mt-2"></div>
        <div id="rp-opzioni" class="mt-2"></div>
        <div id="rp-persona" class="mt-5 hidden rounded-2xl bg-white p-4">
          <p class="font-bold text-[#14142B]">Cliente a cui collegarlo nel CRM <span class="font-normal">(facoltativo)</span></p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input id="rp-pnome" class={campo} placeholder="Nome" autocomplete="off" />
            <input id="rp-pcognome" class={campo} placeholder="Cognome" autocomplete="off" />
          </div>
          <input id="rp-pcf" class={`${campo} mt-3 uppercase tracking-wider`} placeholder="Codice fiscale" maxlength="16" autocomplete="off" spellcheck="false" />
        </div>
        <label class={`${etichetta} mt-5`} for="rp-finalita">Finalità</label>
        <select id="rp-finalita" class={campo}>
          <option value="">Scegli…</option>
          <option value="sovraindebitamento">Pratica di sovraindebitamento</option>
          <option value="successione">Successione</option>
          <option value="isee-redditi">ISEE o dichiarazione dei redditi</option>
          <option value="affitto">Verifica dell'inquilino (contratto di affitto)</option>
          <option value="altro">Altro (scrivi quale)</option>
        </select>
        <label class={`${etichetta} mt-4`} for="rp-nota">Nota <span class="font-normal">(facoltativa; obbligatoria con "Altro")</span></label>
        <input id="rp-nota" class={campo} maxlength="200" autocomplete="off" />
        <label class="mt-5 flex items-start gap-3 font-semibold text-[#14142B]">
          <input id="rp-consenso" type="checkbox" class="mt-1 h-5 w-5 shrink-0" />
          <span>Ho titolo a richiedere questo documento: se riguarda una persona, ho il suo consenso scritto o la sua delega.</span>
        </label>
        <button type="submit" class="mt-5 rounded-full bg-[#5B3DF5] px-7 py-3 font-bold text-white shadow-[0_6px_0_#14142B] disabled:opacity-50">Richiedi (<span id="rp-totale"></span> € + IVA)</button>
        <p id="rp-avviso-ricerca" class="mt-3 text-sm text-[#4E4B66]"></p>
      </form>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-extrabold text-[#14142B]">Richieste</h2>
        <div class="flex gap-3">
          <button id="rp-aggiorna" type="button" class={secondario}>Aggiorna</button>
          <button id="rp-esci" type="button" class={secondario}>Esci</button>
        </div>
      </div>
      <p id="rp-spesa" class="mt-2 text-[#4E4B66]"></p>
      <div id="rp-elenco" class="mt-4 grid gap-4"></div>
      <p class="mt-6 text-sm text-[#4E4B66]">I documenti restano in questo archivio per 12 mesi, poi vengono cancellati. La copia allegata al contatto nel CRM non ha scadenza.</p>
      <details id="rp-diag" class="mt-8 rounded-[28px] bg-[#F7F7FB] p-6">
        <summary class="cursor-pointer text-lg font-extrabold text-[#14142B]">Diagnostica: le ultime risposte di Openapi</summary>
        <p class="mt-2 text-sm text-[#4E4B66]">Ogni chiamata a Openapi con il codice di risposta e il messaggio, senza dati dei clienti (codici fiscali oscurati). Se qualcosa non va, il motivo è qui. 200 e 201 = tutto bene; 401 token, 402 credito, 403 permessi, 404/406/422 di solito "non ancora pronto".</p>
        <button id="rp-diag-rinnova" type="button" class={`${secondario} mt-3`}>Rileggi</button>
        <div id="rp-diag-righe" class="mt-4 grid gap-2 text-sm"></div>
      </details>
    </div>
  </section>
  <script is:inline define:vars={{ API }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      const accesso = $("rp-accesso"), area = $("rp-area"), msg = $("rp-msg"), elenco = $("rp-elenco"), form = $("rp-form"), vetrina = $("rp-catalogo");
      const CAMPO = "w-full rounded-2xl border-2 border-[#E4E4EE] bg-white px-4 py-3 text-[#14142B] focus:border-[#5B3DF5] focus:outline-none";
      const PRIMARIO = "rounded-full bg-[#5B3DF5] px-5 py-2 font-bold text-white disabled:opacity-50";
      const SECONDARIO = "rounded-full border-2 border-[#14142B] bg-white px-5 py-2 font-bold text-[#14142B] disabled:opacity-50";
      const STATI = { invio: "Invio in corso", in_lavorazione: "In lavorazione", da_scegliere: "Scegli il risultato", pronto: "Pronto", errore: "Non riuscita", annullata: "Annullata" };
      const COLORI = { invio: "bg-[#FFF4CC]", in_lavorazione: "bg-[#FFF4CC]", da_scegliere: "bg-[#FFF4CC]", pronto: "bg-[#D4FF4F]", errore: "bg-[#FFE3EC]", annullata: "bg-[#FFE3EC]" };
      let sessione = "", timer = null, voci = [], scelta = null, mostrati = 20;
      try { sessione = sessionStorage.getItem("report-persona") || ""; } catch { /* archivio del browser non disponibile */ }

      const avvisa = (t) => { msg.textContent = t; msg.classList.toggle("hidden", !t); if (t) msg.scrollIntoView({ block: "nearest" }); };
      const quando = (s) => { const d = new Date(s); return isNaN(d) ? "" : d.toLocaleString("it-IT", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }); };
      const giorno = (s) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s || ""); return m ? `${m[3]}/${m[2]}/${m[1]}` : ""; };
      const euro = (c) => (c / 100).toLocaleString("it-IT", { minimumFractionDigits: 2 });
      const breve = (t) => { const s = String(t || "in differita").split(":")[0].trim(); return s.charAt(0).toUpperCase() + s.slice(1); };
      const nodo = (tag, classe, testo) => { const e = document.createElement(tag); if (classe) e.className = classe; if (testo !== undefined) e.textContent = testo; return e; };

      async function chiedi(azione, altro) {
        const res = await fetch(API + "/api/report/persona", { method: "POST", headers: { "Content-Type": "application/json", "x-report-sessione": sessione }, body: JSON.stringify({ azione, ...altro }) });
        const dati = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error("richiesta"), { stato: res.status, dati });
        return dati;
      }
      function esci() {
        sessione = "";
        try { sessionStorage.removeItem("report-persona"); } catch { /* facoltativo */ }
        clearTimeout(timer);
        area.classList.add("hidden"); accesso.classList.remove("hidden");
      }
      function errore(e) {
        if (e.stato === 401) { esci(); return avvisa("Sessione scaduta: inserisci di nuovo la password."); }
        const d = (e.dati && e.dati.errore) || "";
        avvisa(d === "non-configurato" ? "La pagina non è ancora configurata (manca la password o l'archivio su Vercel)."
          : d === "openapi-non-configurato" ? "Manca il token Openapi tra le variabili su Vercel: la richiesta non è partita."
          : d === "dati" ? (e.dati.dettaglio || "Controlla i dati inseriti.")
          : d === "consenso" ? "Serve la conferma che hai titolo a richiedere il documento."
          : d === "troppo-grande" ? "Il file è troppo grande per essere scaricato da qui: aprilo dal contatto nel CRM."
          : e.stato === 404 ? "Non trovato in archivio." : "Operazione non riuscita. Riprova tra poco.");
      }
      function bottone(testo, classe, azione) {
        const b = nodo("button", classe, testo);
        b.type = "button";
        b.addEventListener("click", async () => {
          b.disabled = true; avvisa("");
          try { await azione(); } catch (e) { errore(e); } finally { b.disabled = false; }
        });
        return b;
      }

      // ---------- elenchi a discesa con ricerca ----------
      // Campo di testo con l'elenco che si restringe mentre si scrive. Vale solo una voce scelta dall'elenco:
      // il codice sta in dataset.valore; un testo che non corrisponde a nessuna voce resta segnato in rosso.
      const piano = (t) => String(t || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/\s+/g, " ").trim();
      const territori = {};
      let defunto = null;   // provincia degli immobili del defunto (modalità successione)
      async function territorio(provincia, tipo) {
        const chiave = `${tipo === "T" ? "T" : "F"}-${provincia || ""}`;
        if (!territori[chiave]) territori[chiave] = chiedi("territorio", { provincia: provincia || null, tipo_catasto: tipo }).catch((e) => { delete territori[chiave]; throw e; });
        return territori[chiave];
      }
      function conRicerca(inp, nota, etichetta) {
        const box = nodo("div", "relative");
        inp.replaceWith(box);
        box.append(inp);
        const lista = nodo("ul", "absolute left-0 right-0 z-30 mt-1 hidden max-h-72 overflow-auto rounded-2xl border-2 border-[#14142B] bg-white py-1 shadow-lg");
        lista.id = inp.id + "-lista"; lista.setAttribute("role", "listbox");
        box.append(lista);
        inp.type = "text"; inp.autocomplete = "off"; inp.spellcheck = false; inp.dataset.elenco = "1"; inp.dataset.valore = "";
        inp.setAttribute("role", "combobox"); inp.setAttribute("aria-autocomplete", "list"); inp.setAttribute("aria-controls", lista.id); inp.setAttribute("aria-expanded", "false");
        let voci = [], trovate = [], attiva = -1, cambia = null;
        const testo = (o) => (etichetta ? etichetta(o) : o.nome);
        const segna = (ok, messaggio) => { inp.style.borderColor = ok ? "" : "#E5484D"; if (nota) { nota.textContent = messaggio || ""; nota.classList.toggle("hidden", !messaggio); } };
        const chiudi = () => { lista.classList.add("hidden"); inp.setAttribute("aria-expanded", "false"); };
        function disegna() {
          lista.replaceChildren();
          if (!trovate.length) lista.append(nodo("li", "px-4 py-2 text-sm text-[#4E4B66]", voci.length ? "Nessuna voce corrisponde: controlla cosa hai scritto." : "Elenco vuoto."));
          trovate.slice(0, 80).forEach((o, n) => {
            const li = nodo("li", `cursor-pointer px-4 py-2 text-[#14142B] ${n === attiva ? "bg-[#EDE9FF]" : "hover:bg-[#F7F7FB]"}`, testo(o));
            li.id = `${lista.id}-${n}`; li.setAttribute("role", "option"); li.setAttribute("aria-selected", String(n === attiva));
            li.addEventListener("mousedown", (e) => { e.preventDefault(); scegli(o); });   // prima del blur del campo
            lista.append(li);
          });
          if (trovate.length > 80) lista.append(nodo("li", "px-4 py-2 text-sm text-[#4E4B66]", `Altre ${trovate.length - 80} voci: continua a scrivere per restringere.`));
          inp.setAttribute("aria-activedescendant", attiva >= 0 ? `${lista.id}-${attiva}` : "");
          const li = attiva >= 0 && lista.children[attiva];
          if (li) li.scrollIntoView({ block: "nearest" });
        }
        function filtra() {
          const q = piano(inp.value);
          if (!q) trovate = voci;
          else {
            const inizio = [], dentro = [];
            for (const o of voci) {
              const c = piano(o.codice), t = piano(testo(o));
              if (c === q || t.startsWith(q) || c.startsWith(q)) inizio.push(o); else if (t.includes(q)) dentro.push(o);
            }
            inizio.sort((a, b) => (piano(b.codice) === q) - (piano(a.codice) === q));
            trovate = inizio.concat(dentro);
          }
          attiva = trovate.length ? 0 : -1;
          disegna();
        }
        const apri = () => { if (inp.disabled || !voci.length) return; filtra(); lista.classList.remove("hidden"); inp.setAttribute("aria-expanded", "true"); };
        function scegli(o, zitto) {
          const prima = inp.dataset.valore;
          inp.value = o ? testo(o) : ""; inp.dataset.valore = o ? o.codice : "";
          segna(true); chiudi();
          if (cambia && !zitto && prima !== inp.dataset.valore) cambia(o || null);
        }
        function verifica() {
          if (inp.dataset.valore || !inp.value.trim() || !voci.length) return;
          const q = piano(inp.value);
          const esatta = voci.find((o) => piano(o.codice) === q || piano(o.nome) === q || piano(testo(o)) === q);
          filtra();
          if (esatta || trovate.length === 1) scegli(esatta || trovate[0]);
          else segna(false, "Scegli una voce dall'elenco: il testo scritto così non viene accettato.");
        }
        inp.addEventListener("input", () => { const prima = inp.dataset.valore; inp.dataset.valore = ""; segna(true); apri(); if (prima && cambia) cambia(null); });
        inp.addEventListener("focus", apri);
        inp.addEventListener("click", apri);
        inp.addEventListener("blur", () => { chiudi(); verifica(); });
        inp.addEventListener("keydown", (e) => {
          const aperto = !lista.classList.contains("hidden");
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            if (!aperto) return apri();
            if (trovate.length) { attiva = (attiva + (e.key === "ArrowDown" ? 1 : -1) + Math.min(trovate.length, 80)) % Math.min(trovate.length, 80); disegna(); }
          } else if (e.key === "Enter" && aperto) { e.preventDefault(); if (trovate[attiva]) scegli(trovate[attiva]); }
          else if (e.key === "Escape" && aperto) { e.preventDefault(); chiudi(); }
          else if (e.key === "Tab" && aperto && inp.value.trim() && trovate[attiva] && !inp.dataset.valore) scegli(trovate[attiva]);
        });
        return {
          campo: inp,
          // Elenco pronto: il campo accetta solo le sue voci.
          imposta(nuove, segnaposto) {
            voci = nuove || []; inp.dataset.elenco = "1"; inp.disabled = !voci.length; inp.placeholder = segnaposto || (voci.length ? "Scrivi per cercare…" : "");
            const tenuta = voci.find((o) => o.codice === inp.dataset.valore);
            if (tenuta) scegli(tenuta, true); else { inp.value = ""; inp.dataset.valore = ""; segna(true); }
          },
          // In attesa o senza elenco possibile: campo spento con una spiegazione.
          spento(segnaposto) { voci = []; inp.disabled = true; inp.value = ""; inp.dataset.valore = ""; inp.placeholder = segnaposto; segna(true); chiudi(); },
          // Elenco non leggibile da Openapi: si scrive a mano (il server ricontrolla quando può).
          libero(segnaposto, messaggio) { voci = []; inp.disabled = false; inp.dataset.elenco = ""; inp.placeholder = segnaposto; segna(true, messaggio); },
          scegliCodice(codice) { const o = voci.find((x) => piano(x.codice) === piano(codice)); if (o) scegli(o, true); return !!o; },
          alCambio(f) { cambia = f; },
          valore: () => (inp.dataset.elenco ? inp.dataset.valore : inp.value.trim()),
        };
      }
      // Provincia, comune e sezione del Catasto, collegati: la scelta di uno prepara l'elenco del successivo.
      function territorioCatasto(v, campi, ctl) {
        const tipoCampo = campi.querySelector('[data-chiave="tipo_catasto"]');
        const tipo = () => (tipoCampo && tipoCampo.value === "T" ? "T" : "F");
        let prov = ctl.provincia;
        if (ctl.comune && !prov) {   // l'ispezione per immobile non chiede la provincia: serve solo a trovare il comune
          const lab = nodo("label", "mb-1.5 mt-4 block text-sm font-bold text-[#14142B]", "Provincia del comune *");
          const inp = nodo("input", CAMPO), nota = nodo("p", "mt-1 hidden text-sm font-semibold text-[#E5484D]");
          inp.id = "rp-c-aiuto-provincia"; lab.htmlFor = inp.id;
          const prima = campi.querySelector(`label[for="${ctl.comune.campo.id}"]`);
          prima.before(lab, inp, nota, nodo("p", "mt-1 text-sm text-[#4E4B66]", "Serve solo a trovare il comune: non viene spedita."));
          prov = conRicerca(inp, nota, (o) => `${o.codice} · ${o.nome}`);
        }
        const attuale = () => scelta === v;
        function senzaElenchi() {   // Openapi non dà gli elenchi: si scrive a mano, il server ricontrolla appena può
          if (prov) prov.libero("Sigla, per esempio RM", "Elenco del Catasto non disponibile ora: scrivi la sigla di due lettere.");
          if (ctl.comune) ctl.comune.libero("Nome del comune, per esempio ROMA", "Elenco dei comuni non disponibile ora: scrivi il nome come lo usa il Catasto.");
          if (ctl.sezione) ctl.sezione.libero("Lettera della sezione, se c'è", "");
        }
        async function caricaProvince() {
          if (!prov) return;
          prov.spento("Carico le province del Catasto…");
          try {
            const d = await territorio(null, tipo());
            if (!attuale()) return;
            if (!d.disponibile || !d.voci.length) return senzaElenchi();
            prov.imposta(d.voci);
            const dprov = defunto ? defunto.valore() : "";
            if ($("rp-successione").checked && dprov && !prov.valore()) prov.scegliCodice(dprov);
            caricaComuni(prov.valore());
          } catch (e) { if (attuale()) senzaElenchi(); }
        }
        async function caricaComuni(sigla) {
          if (ctl.sezione) ctl.sezione.spento("Prima scegli il comune");
          if (!ctl.comune) return;
          if (!sigla) return ctl.comune.spento("Prima scegli la provincia");
          ctl.comune.spento("Carico i comuni…");
          try {
