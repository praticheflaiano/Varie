          form.reset(); chiudiVoce();   // il filtro e i dati del defunto stanno fuori dal modulo: restano per la richiesta successiva
          mostra(risposta);
          const nuova = (risposta.richieste || []).find((r) => r.codice === risposta.nuova);
          if (nuova && (nuova.stato === "errore" || nuova.stato === "annullata")) avvisa("La richiesta non è andata a buon fine: leggi il motivo qui sotto.");
          else elenco.scrollIntoView({ block: "start" });
        } catch (err) { errore(err); } finally { b.disabled = false; }
      });
      defunto = conRicerca($("rp-dprov"), null, (o) => `${o.codice} · ${o.nome}`);
      defunto.libero("Provincia degli immobili (es. RM)");
      $("rp-successione").addEventListener("change", async () => {
        if (!$("rp-successione").checked || defunto.campo.dataset.elenco) return;
        try {
          const d = await territorio(null, "F");
          if (d.disponibile && d.voci.length) defunto.imposta(d.voci, "Provincia degli immobili: scrivi per cercare");
        } catch { /* resta il campo libero */ }
      });
            for (const id of ["rp-cerca", "rp-categoria", "rp-subito", "rp-successione"]) $(id).addEventListener("input", () => { mostrati = 20; $("rp-defunto").classList.toggle("hidden", !$("rp-successione").checked); disegnaCatalogo(); });
      $("rp-altri").addEventListener("click", () => { mostrati += 40; disegnaCatalogo(); });
      $("rp-indietro").addEventListener("click", chiudiVoce);
      $("rp-rinnova").addEventListener("click", async () => {
        const b = $("rp-rinnova");
        b.disabled = true; b.textContent = "Leggo…";
        try { mostraCatalogo(await chiedi("catalogo", { rinnova: true })); } catch (e) { errore(e); } finally { b.disabled = false; b.textContent = "Aggiorna catalogo"; }
      });
      async function diagnostica() {
        const box = $("rp-diag-righe");
        box.replaceChildren(nodo("p", "text-[#4E4B66]", "Leggo…"));
        try {
          const righe = (await chiedi("diagnostica")).righe || [];
          box.replaceChildren(...(righe.length ? [] : [nodo("p", "text-[#4E4B66]", "Nessuna chiamata registrata finora.")]));
          for (const r of righe) {
            const ok = typeof r.codice === "number" && r.codice < 300, attesa = [404, 406, 422].includes(r.codice);
            const riga = nodo("div", `rounded-2xl p-3 ${ok ? "bg-white" : attesa ? "bg-[#FFF4CC]" : "bg-[#FFE3EC]"}`);
            riga.append(nodo("p", "font-bold text-[#14142B]", `${quando(r.quando)} · ${r.servizio} ${r.metodo} ${r.percorso} → ${r.codice}${r.volte > 1 ? ` (×${r.volte})` : ""}`),
              nodo("p", "text-[#4E4B66]", `${r.sintesi || "nessun messaggio"} · ${r.ms} ms · ${r.ambiente === "prova" ? "prova" : "vero"}`));
            box.append(riga);
          }
        } catch (e) { box.replaceChildren(); errore(e); }
      }
      $("rp-diag").addEventListener("toggle", () => { if ($("rp-diag").open) diagnostica(); });
      $("rp-diag-rinnova").addEventListener("click", diagnostica);
      $("rp-aggiorna").addEventListener("click", () => aggiorna(false));
      $("rp-esci").addEventListener("click", () => { esci(); avvisa(""); });
      if (sessione) entra().catch((e) => { if (e.stato === 401) esci(); else errore(e); });
    })();
  </script>
</BaseLayout>
