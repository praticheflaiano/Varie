# Pubbliche (esposte al client - prefisso PUBLIC_)
PUBLIC_SITE_URL=https://praticheflaiano.it

# Mostra articoli draft/review/fact-checked/seo-optimized in dev
# In produzione tenere a "false"
SHOW_DRAFTS=true

# Cloudflare Turnstile (form contatto) - public site key
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only (NON committare valori reali)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@praticheflaiano.it

# Stima e Calcolo della pensione: endpoint che riceve questionario e documenti
# e restituisce il link di pagamento. Vuoto = pagina visibile ma invio disattivato e noindex.
PUBLIC_STIMA_PENSIONE_API=

# Lettura automatica dell'estratto contributivo (api/stima/leggi-estratto.ts), via OpenRouter.
# Senza chiave il sito ripiega sulla lettura locale semplificata. Server-only.
OPENROUTER_API_KEY=
# Modello usato per la trascrizione (facoltativo; predefinito anthropic/claude-sonnet-4.5)
STIMA_PENSIONE_MODEL=
