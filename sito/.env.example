# Pubbliche (esposte al client - prefisso PUBLIC_)
PUBLIC_SITE_URL=https://praticheflaiano.it

# Mostra articoli draft/review/fact-checked/seo-optimized in dev
# In produzione tenere a "false"
SHOW_DRAFTS=true

# Cloudflare Turnstile (form contatto) - public site key
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only (NON committare valori reali)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@praticheflaiano.it

# Stima e Calcolo della pensione: endpoint che riceve questionario e documenti
# e restituisce il link di pagamento. Vuoto = pagina visibile ma invio disattivato e noindex.
PUBLIC_STIMA_PENSIONE_API=

# PRELETTURA dell'estratto (prima del pagamento): api/stima/leggi-estratto.ts via OpenRouter.
# Mistral OCR legge il PDF, un modello Mistral di chat struttura le righe. Server-only.
# Senza chiave il sito ripiega sulla lettura locale semplificata.
OPENROUTER_API_KEY=
# Facoltative: modello che struttura le righe (predefinito mistralai/mistral-small-2603)
# e motore di lettura PDF (predefinito mistral-ocr)
STIMA_PENSIONE_MODEL=
STIMA_PENSIONE_PDF_ENGINE=

# STIMA dopo il pagamento: api/stima/elabora.py, Claude Fable 5.2 via API Anthropic + motore.
ANTHROPIC_API_KEY=
# Facoltativa: modello (predefinito claude-fable-5-2)
STIMA_PENSIONE_MODELLO=
# Obbligatoria in produzione: segreto che il flusso post-pagamento presenta alla funzione.
STIMA_PENSIONE_TOKEN=
